                    HorizontalLayout { height: 96px; alignment: center; Rectangle { width: 96px; height: 96px; border-radius: 24px; background: #182530e0; border-width: 1px; border-color: #ffffff44; Text { text: "◇"; color: #38ff66; font-size: 46px; horizontal-alignment: center; vertical-alignment: center; } } }
                    Text { text: "Zink VPN"; color: white; font-size: 28px; font-weight: 650; horizontal-alignment: center; }
                    Text { text: "This isn't available"; color: #b7c8d2; font-size: 17px; horizontal-alignment: center; }
                }
            }

            if root.current-route == "tools": Rectangle {
                border-radius: 24px; background: #06161cde; border-width: 1px; border-color: #ffffff14;
                ZinkScrollView { width: parent.width; height: parent.height; content-height: tools-content.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.as-needed; horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    tools-content := VerticalLayout { width: parent.visible-width - 16px; padding: 30px; spacing: 18px;
                        HorizontalLayout { height: 70px; VerticalLayout { Text { text: "ZINK UTILITIES"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: "Capture & file tools"; color: white; font-size: 31px; font-weight: 750; } Text { text: "Native Windows capture and four independent, recoverable file-move slots."; color: #8da29b; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 176px; height: 38px; border-radius: 19px; background: #38ff6615; border-width: 1px; border-color: #38ff6640; Text { text: "4K UHD • 3840 × 2160"; color: #38ff66; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } } }
                        Rectangle { height: 220px; border-radius: 25px; background: @linear-gradient(125deg, #0d3b3b 0%, #09232b 58%, #071219 100%); border-width: 1px; border-color: #ffffff18; HorizontalLayout { padding: 24px; spacing: 14px;
                            for action in [{icon:"", title:"Screenshot area", detail:"Draw over any part of the desktop", kind:"screenshot"}, {icon:"", title:"Record area", detail:"Open native Windows capture", kind:"record"}, {icon:"", title:"Saved captures", detail:"Browse recordings and screenshots", kind:"library"}]: Rectangle { horizontal-stretch: 1; border-radius: 20px; background: tool-action-touch.has-hover ? #38ff6618 : #ffffff08; border-width: 1px; border-color: tool-action-touch.has-hover ? #38ff6650 : #ffffff0d; VerticalLayout { padding: 18px; Rectangle { width: 50px; height: 50px; border-radius: 16px; background: #38ff6618; FluentGlyph { glyph: action.icon; color: #38ff66; font-size: 20px; } } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: action.title; color: white; font-size: 15px; font-weight: 700; } Text { text: action.detail; color: #82978f; font-size: 9px; } Text { text: "Open  ›"; color: #38ff66; font-size: 8px; } } tool-action-touch := TouchArea { clicked => { if (action.kind == "screenshot") { root.capture-area(); } else if (action.kind == "record") { root.launch-native-recorder(); } else { root.navigate("recordings"); } } } }
                        } }
                        HorizontalLayout { height: 42px; Text { text: "File mover"; color: white; font-size: 21px; font-weight: 700; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.tools-status; color: #8da29b; font-size: 9px; vertical-alignment: center; overflow: elide; } }
                        Text { text: "Select completed µTorrent videos below, or leave them unselected to choose any files manually. Zink never overwrites an existing file."; color: #9db0aa; font-size: 10px; }
                        Rectangle { height: 190px; border-radius: 19px; background: #ffffff05; VerticalLayout { padding: 14px; spacing: 8px; HorizontalLayout { height: 30px; Text { text: "Completed µTorrent downloads"; color: white; font-size: 13px; font-weight: 700; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.torrent-move-items.length + " ready"; color: #38ff66; font-size: 8px; vertical-alignment: center; } Rectangle { width: 82px; border-radius: 15px; background: #ffffff09; Text { text: "Refresh"; color: white; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.refresh-torrent-mover(); } } } } if root.torrent-move-items.length == 0: Text { text: "No completed video jobs were found in µTorrent, or they have already been moved."; color: #71877f; font-size: 9px; vertical-alignment: center; horizontal-alignment: center; } if root.torrent-move-items.length > 0: ZinkScrollView { vertical-stretch: 1; content-height: torrent-list.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.as-needed; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; torrent-list := VerticalLayout { width: parent.visible-width - 12px; spacing: 6px; for torrent in root.torrent-move-items: Rectangle { height: 48px; border-radius: 12px; background: torrent.selected ? #38ff6615 : torrent-touch.has-hover ? #ffffff0c : #ffffff07; HorizontalLayout { padding: 11px; spacing: 10px; Rectangle { width: 24px; height: 24px; border-radius: 7px; background: torrent.selected ? #38ff66 : #ffffff0c; Text { text: torrent.selected ? "✓" : ""; color: #051109; font-size: 11px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } } VerticalLayout { alignment: center; Text { text: torrent.name; color: white; font-size: 9px; font-weight: 650; overflow: elide; } Text { text: torrent.detail; color: #71877f; font-size: 7px; overflow: elide; } } } torrent-touch := TouchArea { clicked => { root.toggle-torrent-move-selection(torrent.key); } } } } } } }
                        GridLayout { height: 310px; spacing: 12px; for status[index] in root.tools-move-statuses: Rectangle { row: index / 2; col: Math.mod(index, 2); border-radius: 19px; background: #ffffff07; border-width: 1px; border-color: #ffffff10; VerticalLayout { padding: 18px; spacing: 8px; HorizontalLayout { height: 34px; Text { text: "Move " + (index + 1); color: white; font-size: 15px; font-weight: 700; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 104px; border-radius: 17px; background: #38ff6616; Text { text: "Choose files"; color: #38ff66; font-size: 8px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.move-files(index); } } } } Text { text: status; color: status == "Ready" ? #82978f : #c6d6d0; font-size: 9px; wrap: word-wrap; } Rectangle { vertical-stretch: 1; background: transparent; } Rectangle { height: 4px; border-radius: 2px; background: status == "Complete" ? #38ff66 : #ffffff12; } } } }
                        Rectangle { height: 110px; border-radius: 20px; background: #ffffff06; HorizontalLayout { padding: 20px; spacing: 16px; FluentGlyph { glyph: ""; color: #38ff66; font-size: 28px; } VerticalLayout { alignment: center; Text { text: "Windows-native and recoverable"; color: white; font-size: 15px; font-weight: 700; } Text { text: "Capture uses Windows tools. File moves preserve the source if copying fails and automatically choose a non-conflicting destination name."; color: #82978f; font-size: 9px; wrap: word-wrap; } } } }
                    }
                }
            }

            if root.current-route == "tv" || root.current-route == "films" || root.current-route == "gaming": Rectangle {
                border-radius: 24px; background: #041219e8; clip: true;
                Rectangle { x: parent.width - 460px; y: -210px; width: 650px; height: 650px; border-radius: 325px; background: root.current-route == "gaming" ? #23a7ff10 : #38ff660b; }
                ZinkScrollView { width: parent.width; height: parent.height; content-height: hub-content.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.always-on; horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    hub-content := VerticalLayout { width: parent.visible-width - 16px; padding: 30px; spacing: 20px;
                        HorizontalLayout { height: 76px; VerticalLayout { spacing: 4px; Text { text: root.current-route == "gaming" ? "ZINK PLAY" : "ZINK WATCH"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: root.current-route == "tv" ? "TV" : root.current-route == "films" ? "Films" : "Gaming"; color: white; font-size: 31px; font-weight: 750; } Text { text: root.current-route == "tv" ? "Live channels and catch-up services in one place." : root.current-route == "films" ? "Your local collection, film tools and streaming services." : "Xbox, capture tools and cloud gaming."; color: #8da29b; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 130px; height: 42px; border-radius: 21px; background: #ffffff0c; Text { text: root.current-route == "gaming" ? "Open captures" : "Open library"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate(root.current-route == "gaming" ? "recordings" : "video-library"); } } } }
                        Rectangle { height: 188px; border-radius: 24px; background: root.current-route == "gaming" ? @linear-gradient(110deg, #082c50 0%, #071925 52%, #051219 100%) : @linear-gradient(110deg, #0d3b2c 0%, #09252a 52%, #051219 100%); border-width: 1px; border-color: #ffffff18; HorizontalLayout { padding: 24px; spacing: 22px; Rectangle { width: 132px; height: 132px; border-radius: 28px; background: #38ff6618; FluentGlyph { glyph: root.current-route == "gaming" ? "" : ""; color: #38ff66; font-size: 52px; } } VerticalLayout { alignment: center; spacing: 8px; Text { text: root.current-route == "tv" ? "Watch your way" : root.current-route == "films" ? "Cinema, without leaving Zink" : "Play anywhere"; color: white; font-size: 25px; font-weight: 720; } Text { text: root.current-route == "tv" ? "Open BBC iPlayer, My5 and more through the managed Zink Connect browser." : root.current-route == "films" ? "Start with your own library or jump into a streaming service." : "Launch Xbox and cloud gaming services, or capture your best moments."; color: #b7cac4; font-size: 11px; wrap: word-wrap; } } } }
                        Text { text: root.current-route == "films" ? "Your film tools" : root.current-route == "gaming" ? "Gaming tools" : "TV services"; color: white; font-size: 21px; font-weight: 700; }
                        GridLayout { height: root.current-route == "films" ? 360px : 530px; spacing: 12px;
                            for service[index] in root.current-route == "tv" ? [
                                { title: "BBC iPlayer", detail: "BBC live TV and catch-up", icon: "BBC", url: "https://www.bbc.co.uk/iplayer" },
                                { title: "My5", detail: "Channel 5 programmes", icon: "5", url: "https://www.channel5.com" },
                                { title: "ITVX", detail: "ITV live and on demand", icon: "ITV", url: "https://www.itv.com" },
                                { title: "Channel 4", detail: "Channel 4 streaming", icon: "4", url: "https://www.channel4.com" },
                                { title: "NOW", detail: "Entertainment and sport", icon: "NOW", url: "https://www.nowtv.com/gb/watch" },
                                { title: "YouTube", detail: "Channels and live video", icon: "▶", url: "https://www.youtube.com" }
                            ] : root.current-route == "films" ? [
                                { title: "Video Library", detail: "Your local films and videos", icon: "", url: "route:video-library" },
                                { title: "Film Information", detail: "Cast, story and details", icon: "ⓘ", url: "route:film-info" },
                                { title: "OneDrive Streaming", detail: "Watch from OneDrive", icon: "☁", url: "route:onedrive-streaming" },
                                { title: "Duplicate Searcher", detail: "Find duplicate videos", icon: "⌕", url: "route:duplicate-video-search" }
                            ] : [
                                { title: "Xbox", detail: "Xbox services and captures", icon: "X", url: "route:xbox" },
                                { title: "FPS Recorder", detail: "Capture performance and clips", icon: "FPS", url: "route:fps-recorder" },
                                { title: "GeForce NOW", detail: "NVIDIA cloud gaming", icon: "G", url: "https://play.geforcenow.com" },
                                { title: "Amazon Luna", detail: "Amazon cloud gaming", icon: "L", url: "https://luna.amazon.com" },
                                { title: "Boosteroid", detail: "Play PC games in the cloud", icon: "B", url: "https://cloud.boosteroid.com" },
                                { title: "Shadow PC", detail: "Your cloud Windows PC", icon: "S", url: "https://pc.shadow.tech" }
                            ]: Rectangle { row: index / 2; col: Math.mod(index, 2); border-radius: 19px; background: service-touch.has-hover ? #12343a : #ffffff08; border-width: 1px; border-color: service-touch.has-hover ? #38ff6650 : #ffffff12; HorizontalLayout { padding: 18px; spacing: 14px; Rectangle { width: 56px; height: 56px; border-radius: 17px; background: #38ff6618; Text { text: service.icon; font-family: "Segoe Fluent Icons"; color: #38ff66; font-size: 16px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } } VerticalLayout { alignment: center; spacing: 3px; Text { text: service.title; color: white; font-size: 14px; font-weight: 700; } Text { text: service.detail; color: #849992; font-size: 9px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "›"; color: #38ff66; font-size: 24px; vertical-alignment: center; } } service-touch := TouchArea { clicked => { if (service.url == "route:video-library") { root.navigate("video-library"); } else if (service.url == "route:film-info") { root.navigate("film-info"); } else if (service.url == "route:onedrive-streaming") { root.navigate("onedrive-streaming"); } else if (service.url == "route:duplicate-video-search") { root.navigate("duplicate-video-search"); } else if (service.url == "route:xbox") { root.navigate("xbox"); } else if (service.url == "route:fps-recorder") { root.navigate("fps-recorder"); } else { root.open-web-service(service.url); } } } }
                        }
                        if root.current-route == "films": Text { text: "Streaming services"; color: white; font-size: 21px; font-weight: 700; }
                        if root.current-route == "films": HorizontalLayout { height: 112px; spacing: 12px; for service in [{title:"Netflix", url:"https://www.netflix.com/browse"}, {title:"Prime Video", url:"https://www.primevideo.com/"}, {title:"Disney+", url:"https://www.disneyplus.com/en-gb/home"}, {title:"Paramount+", url:"https://www.paramountplus.com/"}, {title:"NOW", url:"https://www.nowtv.com/gb/watch"}]: Rectangle { horizontal-stretch: 1; border-radius: 18px; background: film-service-touch.has-hover ? #ffffff18 : #ffffff08; VerticalLayout { alignment: center; spacing: 7px; Text { text: service.title; color: white; font-size: 13px; font-weight: 700; horizontal-alignment: center; } Text { text: "Open in Zink Connect"; color: #38ff66; font-size: 8px; horizontal-alignment: center; } } film-service-touch := TouchArea { clicked => { root.open-web-service(service.url); } } } }
                    }
                }
            }

            if root.current-route == "duplicate-video-search": Rectangle {
                border-radius: 24px; background: #041219e8; clip: true;
                VerticalLayout { padding: 28px; spacing: 16px;
                    HorizontalLayout { height: 68px; VerticalLayout { spacing: 3px; Text { text: "ZINK VIDEO TOOLS"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: "Duplicate Video Searcher"; color: white; font-size: 29px; font-weight: 750; } Text { text: "Full-file SHA-256 verification keeps similarly named videos from being mistaken for duplicates."; color: #8da29b; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 116px; height: 42px; border-radius: 21px; background: root.duplicate-scan-active ? #ffffff08 : #38ff66; Text { text: root.duplicate-scan-active ? "Scanning…" : "↻  Refresh"; color: root.duplicate-scan-active ? #8da29b : #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } scan-duplicates-touch := TouchArea { enabled: !root.duplicate-scan-active; clicked => { root.scan-duplicate-videos(); } } } Rectangle { visible: root.duplicate-video-items.length > 0; width: self.visible ? 164px : 0px; height: 42px; border-radius: 21px; background: #ff455518; border-width: 1px; border-color: #ff687442; Text { text: "Delete extra copies"; color: #ffabb2; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.duplicate-pending-delete = "*"; } } } }
                    Rectangle { height: 54px; border-radius: 16px; background: root.duplicate-scan-active ? #38ff6612 : #ffffff07; border-width: 1px; border-color: root.duplicate-scan-active ? #38ff6630 : #ffffff10; HorizontalLayout { padding: 13px; spacing: 10px; Rectangle { width: 28px; height: 28px; border-radius: 9px; background: #38ff6618; FluentGlyph { glyph: root.duplicate-scan-active ? "" : ""; color: #38ff66; font-size: 13px; } } Text { text: root.duplicate-status; color: #b3c5bf; font-size: 10px; vertical-alignment: center; overflow: elide; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.duplicate-video-items.length + (root.duplicate-video-items.length == 1 ? " duplicate file" : " duplicate files"); color: #38ff66; font-size: 10px; vertical-alignment: center; } } }
                    if root.duplicate-video-items.length == 0 && !root.duplicate-scan-active: Rectangle { vertical-stretch: 1; border-radius: 22px; background: #ffffff06; VerticalLayout { alignment: center; spacing: 12px; HorizontalLayout { height: 72px; alignment: center; Rectangle { width: 72px; height: 72px; border-radius: 22px; background: #38ff6615; FluentGlyph { glyph: ""; color: #38ff66; font-size: 30px; } } } Text { text: "No verified duplicates found"; color: white; font-size: 22px; font-weight: 700; horizontal-alignment: center; } Text { text: "Refresh after adding or rescanning folders in Video Library."; color: #8da29b; font-size: 10px; horizontal-alignment: center; } HorizontalLayout { height: 40px; alignment: center; Rectangle { width: 144px; height: 40px; border-radius: 20px; background: #38ff66; Text { text: "Scan library"; color: #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.scan-duplicate-videos(); } } } } } }
                    if root.duplicate-video-items.length > 0: duplicate-scroll := ZinkScrollView { vertical-stretch: 1; content-height: duplicate-list.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.always-on; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; duplicate-list := VerticalLayout { width: duplicate-scroll.visible-width - 16px; spacing: 9px; for item[index] in root.duplicate-video-items: Rectangle { height: 82px; border-radius: 17px; background: index > 0 && root.duplicate-video-items[index - 1].group == item.group ? #ffffff05 : #ffffff0a; border-width: 1px; border-color: index > 0 && root.duplicate-video-items[index - 1].group == item.group ? #ffffff09 : #38ff6628; HorizontalLayout { padding: 13px; spacing: 12px; Rectangle { width: 52px; height: 52px; border-radius: 15px; background: #38ff6615; FluentGlyph { glyph: ""; color: #38ff66; font-size: 21px; } } VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 3px; Text { text: item.name; color: white; font-size: 12px; font-weight: 700; overflow: elide; } Text { text: item.path; color: #82968f; font-size: 8px; overflow: elide; } Text { text: item.group + " • " + item.size + " • " + item.copies + " verified copies"; color: #38ff66; font-size: 8px; overflow: elide; } } Rectangle { width: 72px; height: 36px; border-radius: 18px; background: #38ff66; Text { text: "Play"; color: #051109; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.play-duplicate-video(item.path); root.navigate("video-player"); } } } Rectangle { width: 96px; height: 36px; border-radius: 18px; background: #ffffff0c; Text { text: "File location"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-duplicate-location(item.path); } } } Rectangle { width: 74px; height: 36px; border-radius: 18px; background: #ff455518; Text { text: "Delete"; color: #ffabb2; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.duplicate-pending-delete = item.path; } } } } } } } }
                }
                if root.duplicate-pending-delete != "": Rectangle { height: 330px; horizontal-stretch: 1; background: #000000a8; Rectangle { x: parent.width / 2 - 260px; y: 15px; width: 520px; height: 300px; border-radius: 26px; background: #0a1a20; border-width: 1px; border-color: #ffffff28; VerticalLayout { padding: 26px; spacing: 14px; Rectangle { width: 58px; height: 58px; border-radius: 18px; background: #ff455518; FluentGlyph { glyph: ""; color: #ff8994; font-size: 24px; } } Text { text: root.duplicate-pending-delete == "*" ? "Recycle extra duplicate copies?" : "Move this video to the Recycle Bin?"; color: white; font-size: 22px; font-weight: 750; } Text { text: root.duplicate-pending-delete == "*" ? "Zink will keep one verified copy from every duplicate group and move the remaining copies to the Windows Recycle Bin." : "The selected file will be recoverable from the Windows Recycle Bin. Other verified copies in its group will be kept."; color: #9db0aa; font-size: 10px; wrap: word-wrap; } Rectangle { vertical-stretch: 1; background: transparent; } HorizontalLayout { height: 42px; spacing: 10px; Rectangle { horizontal-stretch: 1; border-radius: 21px; background: #ffffff0c; Text { text: "Cancel"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.duplicate-pending-delete = ""; } } } Rectangle { horizontal-stretch: 1; border-radius: 21px; background: #ff5968; Text { text: "Move to Recycle Bin"; color: white; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { if (root.duplicate-pending-delete == "*") { root.delete-all-duplicate-videos(); } else { root.delete-duplicate-video(root.duplicate-pending-delete); } root.duplicate-pending-delete = ""; } } } } } } }

            if root.current-route == "film-info": Rectangle {
                border-radius: 24px; background: #041219e8; clip: true;
                ZinkScrollView { width: parent.width; height: parent.height; content-height: film-info-content.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.always-on; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; film-info-content := VerticalLayout { width: parent.visible-width - 16px; padding: 30px; spacing: 20px;
                    HorizontalLayout { height: 66px; Rectangle { width: 42px; height: 42px; border-radius: 21px; background: #ffffff0c; FluentGlyph { glyph: ""; font-size: 16px; } TouchArea { clicked => { root.navigate("video-library"); } } } VerticalLayout { spacing: 3px; Text { text: "ZINK FILMS"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: "Film Information"; color: white; font-size: 29px; font-weight: 750; } } Rectangle { horizontal-stretch: 1; background: transparent; } }
                    HorizontalLayout { height: 48px; spacing: 10px; Rectangle { horizontal-stretch: 1; border-radius: 24px; background: #ffffff0b; border-width: 1px; border-color: film-query-input.has-focus ? #38ff6670 : #ffffff18; FluentGlyph { glyph: ""; x: 16px; width: 20px; color: #8da29b; font-size: 15px; } film-query-input := TextInput { x: 48px; width: parent.width - 60px; height: parent.height; text: root.film-query; color: white; font-size: 12px; single-line: true; edited => { root.film-query = self.text; } accepted => { root.lookup-film-info(self.text); } } } Rectangle { width: 118px; border-radius: 24px; background: root.film-info-loading ? #ffffff0b : #38ff66; Text { text: root.film-info-loading ? "Looking up…" : "Search film"; color: root.film-info-loading ? #8da29b : #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: !root.film-info-loading; clicked => { root.lookup-film-info(root.film-query); } } } }
                    Rectangle { height: 520px; border-radius: 24px; background: #ffffff07; border-width: 1px; border-color: #ffffff12; HorizontalLayout { padding: 26px; spacing: 30px; Rectangle { width: 310px; height: 466px; border-radius: 20px; background: @linear-gradient(145deg, #12343a 0%, #07171d 100%); clip: true; VerticalLayout { alignment: center; spacing: 8px; FluentGlyph { glyph: ""; color: #38ff6640; font-size: 56px; } Text { text: root.film-query == "" ? "Film poster" : root.film-query; color: #ffffff80; font-size: 15px; horizontal-alignment: center; wrap: word-wrap; } } Image { source: root.film-info-poster; image-fit: cover; width: parent.width; height: parent.height; } } VerticalLayout { horizontal-stretch: 1; spacing: 14px; Text { text: root.film-info-title; color: white; font-size: 34px; font-weight: 750; wrap: word-wrap; } Text { text: root.film-info-date; color: #38ff66; font-size: 13px; } if root.film-info-loading: HorizontalLayout { height: 32px; spacing: 10px; FluentGlyph { glyph: ""; color: #38ff66; font-size: 16px; } Text { text: "Looking up film information…"; color: #9db0aa; font-size: 11px; vertical-alignment: center; } } Text { text: root.film-info-overview; color: #c6d4d0; font-size: 14px; wrap: word-wrap; } Rectangle { vertical-stretch: 1; background: transparent; } Rectangle { visible: root.film-info-source-url != ""; width: self.visible ? 154px : 0px; height: 42px; border-radius: 21px; background: #ffffff0c; border-width: 1px; border-color: #ffffff20; Text { text: "Open Wikipedia  ↗"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-web-service(root.film-info-source-url); } } } } } }
                } }
            }

            if root.current-route == "onedrive-streaming": Rectangle {
                border-radius: 24px; background: #041219e8; clip: true;
                VerticalLayout { padding: 26px; spacing: 14px;
                    HorizontalLayout { height: 62px; VerticalLayout { spacing: 3px; Text { text: "ZINK CLOUD PLAYER"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: "OneDrive Streaming"; color: white; font-size: 29px; font-weight: 750; } Text { text: "Play protected OneDrive originals through Microsoft Graph and Windows Media Foundation."; color: #8da29b; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 146px; height: 40px; border-radius: 20px; background: #ffffff0c; border-width: 1px; border-color: #ffffff20; Text { text: "Microsoft sign in  ↗"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.sign-in-onedrive(); } } } }
                    HorizontalLayout { height: 48px; spacing: 10px; Rectangle { horizontal-stretch: 1; border-radius: 24px; background: #ffffff0b; border-width: 1px; border-color: online-link-input.has-focus ? #38ff6670 : #ffffff18; FluentGlyph { glyph: ""; x: 16px; width: 20px; color: #8da29b; font-size: 15px; } online-link-input := TextInput { x: 48px; width: parent.width - 60px; height: parent.height; text: root.online-video-link; color: white; font-size: 11px; single-line: true; edited => { root.online-video-link = self.text; } accepted => { root.play-online-video(self.text); } } } Rectangle { width: 126px; border-radius: 24px; background: #38ff66; Text { text: "Play video"; color: #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.play-online-video(root.online-video-link); } } } }
                    Text { height: 18px; text: root.online-video-status; color: root.playback-error == "" ? #8da29b : #ff9ca5; font-size: 9px; overflow: elide; }
                    Rectangle { vertical-stretch: 1; border-radius: 22px; background: #000000; border-width: 1px; border-color: #ffffff18; clip: true; Rectangle { width: parent.width; height: parent.height; background: @radial-gradient(circle, #0d2c36 0%, #02070b 68%); } Image { visible: root.track-detail == "Online video"; source: root.video-frame; width: parent.width; height: parent.height; image-fit: contain; } VerticalLayout { visible: root.track-detail != "Online video"; x: 16px; y: 80px; width: parent.width - 32px; height: Math.max(0px, parent.height - 212px); alignment: center; spacing: 12px; HorizontalLayout { height: 76px; alignment: center; Rectangle { width: 76px; height: 76px; border-radius: 23px; background: #38ff6615; FluentGlyph { glyph: ""; color: #38ff66; font-size: 31px; } } } Text { text: "Your video will play here"; color: white; font-size: 23px; font-weight: 700; horizontal-alignment: center; } Text { text: "Paste an HTTPS OneDrive sharing link or a direct media URL above."; color: #8da29b; font-size: 10px; horizontal-alignment: center; } } Rectangle { x: 16px; y: 16px; width: parent.width - 32px; height: 58px; border-radius: 16px; background: #07171de8; HorizontalLayout { padding: 14px; VerticalLayout { Text { text: root.track-detail == "Online video" ? root.track-title : "Zink Cloud Player"; color: white; font-size: 15px; font-weight: 700; } Text { text: "Original file • Windows Media Foundation"; color: #7faaa4; font-size: 8px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 94px; height: 32px; border-radius: 16px; background: #ffffff0c; Text { text: root.app-fullscreen ? "Exit full screen" : "Full screen"; color: white; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.set-app-fullscreen(!root.app-fullscreen); } } } } } Rectangle { x: 16px; y: parent.height - 126px; width: parent.width - 32px; height: 110px; border-radius: 18px; background: #07171de8; VerticalLayout { padding: 14px; spacing: 10px; HorizontalLayout { height: 16px; Text { text: root.position-text; color: #9db0aa; font-size: 9px; width: 45px; } cloud-seek := Rectangle { horizontal-stretch: 1; height: 10px; background: transparent; Rectangle { y: 2px; width: parent.width; height: 6px; border-radius: 3px; background: #ffffff2c; Rectangle { width: parent.width * root.position-ratio; height: parent.height; border-radius: 3px; background: #38ff66; } } cloud-seek-touch := TouchArea { clicked => { root.seek(cloud-seek-touch.mouse-x / cloud-seek.width); } } } Text { text: root.duration-text; color: #9db0aa; font-size: 9px; width: 45px; horizontal-alignment: right; } } HorizontalLayout { alignment: center; spacing: 10px; Rectangle { width: 36px; height: 36px; border-radius: 18px; background: #ffffff0c; FluentGlyph { glyph: ""; font-size: 16px; } TouchArea { clicked => { root.seek-relative(-10); } } } Rectangle { width: 46px; height: 46px; border-radius: 23px; background: #f3fff7; FluentGlyph { glyph: root.is-playing ? "" : ""; color: #051109; font-size: 18px; } TouchArea { clicked => { root.toggle-playback(); } } } Rectangle { width: 36px; height: 36px; border-radius: 18px; background: #ffffff0c; FluentGlyph { glyph: ""; font-size: 16px; } TouchArea { clicked => { root.seek-relative(10); } } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 64px; height: 32px; border-radius: 16px; background: #ffffff0c; Text { text: root.playback-rate + "×"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.set-playback-rate(root.playback-rate >= 2 ? 0.5 : root.playback-rate + 0.25); } } } cloud-volume := Rectangle { width: 130px; height: 16px; background: transparent; Rectangle { y: 5px; width: parent.width; height: 6px; border-radius: 3px; background: #ffffff2c; Rectangle { width: parent.width * root.volume-percent / 100; height: parent.height; border-radius: 3px; background: #38ff66; } } cloud-volume-touch := TouchArea { clicked => { root.set-volume(cloud-volume-touch.mouse-x / cloud-volume.width); } } } Text { text: root.volume-percent + "%"; color: #9db0aa; font-size: 9px; width: 34px; } } } } }
                }
            }

            if root.current-route == "bbc-iplayer" || root.current-route == "my5" || root.current-route == "netflix" || root.current-route == "prime-video" || root.current-route == "disney-plus" || root.current-route == "paramount-plus" || root.current-route == "now-tv": Rectangle {
                border-radius: 24px; background: root.current-route == "netflix" ? @linear-gradient(135deg, #35090d 0%, #10080b 58%, #041219 100%) : root.current-route == "disney-plus" ? @linear-gradient(135deg, #10275c 0%, #09172e 58%, #041219 100%) : root.current-route == "prime-video" ? @linear-gradient(135deg, #06374e 0%, #081d2c 58%, #041219 100%) : @linear-gradient(135deg, #12342c 0%, #092125 58%, #041219 100%); clip: true;
                Rectangle { x: parent.width - 430px; y: -190px; width: 620px; height: 620px; border-radius: 310px; background: #ffffff08; }
                VerticalLayout { padding: 34px; spacing: 20px;
                    HorizontalLayout { height: 62px; VerticalLayout { Text { text: "ZINK WATCH"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: root.current-route == "bbc-iplayer" ? "BBC iPlayer" : root.current-route == "my5" ? "My5" : root.current-route == "netflix" ? "Netflix" : root.current-route == "prime-video" ? "Prime Video" : root.current-route == "disney-plus" ? "Disney+" : root.current-route == "paramount-plus" ? "Paramount+" : "NOW"; color: white; font-size: 30px; font-weight: 750; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 118px; height: 40px; border-radius: 20px; background: #ffffff0c; Text { text: "Back to hub"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate(root.current-route == "bbc-iplayer" || root.current-route == "my5" ? "tv" : "films"); } } } }
                    Rectangle { vertical-stretch: 1; border-radius: 28px; background: #02090dc8; border-width: 1px; border-color: #ffffff18; VerticalLayout { alignment: center; spacing: 17px; Rectangle { width: 112px; height: 112px; border-radius: 32px; background: #ffffff0c; Text { text: root.current-route == "bbc-iplayer" ? "BBC" : root.current-route == "my5" ? "5" : root.current-route == "netflix" ? "N" : root.current-route == "prime-video" ? "P" : root.current-route == "disney-plus" ? "D+" : root.current-route == "paramount-plus" ? "P+" : "NOW"; color: white; font-size: 28px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; } } Text { text: "Open in Zink Connect"; color: white; font-size: 25px; font-weight: 700; horizontal-alignment: center; } Text { text: "Your session, history, ad protection and fullscreen handling stay inside Zink's managed browser."; color: #91a49e; font-size: 10px; horizontal-alignment: center; wrap: word-wrap; width: 520px; } Rectangle { width: 178px; height: 46px; border-radius: 23px; background: #38ff66; Text { text: "Open service  ↗"; color: #051109; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-web-service(root.current-route == "bbc-iplayer" ? "https://www.bbc.co.uk/iplayer" : root.current-route == "my5" ? "https://www.channel5.com" : root.current-route == "netflix" ? "https://www.netflix.com/browse" : root.current-route == "prime-video" ? "https://www.primevideo.com/" : root.current-route == "disney-plus" ? "https://www.disneyplus.com/en-gb/home" : root.current-route == "paramount-plus" ? "https://www.paramountplus.com/" : "https://www.nowtv.com/gb/watch"); } } } Text { text: "Uses the installed Microsoft Edge WebView2 runtime"; color: #627970; font-size: 8px; horizontal-alignment: center; } } }
                }
            }

            if root.current-route == "xbox" || root.current-route == "geforce-now" || root.current-route == "amazon-luna" || root.current-route == "boosteroid" || root.current-route == "shadow-pc": Rectangle {
                border-radius: 24px;
                clip: true;
                background: root.current-route == "xbox" ? @linear-gradient(135deg, #0d3a22 0%, #071d19 52%, #050d13 100%) : root.current-route == "geforce-now" ? @linear-gradient(135deg, #17370b 0%, #0b2212 52%, #050d13 100%) : root.current-route == "amazon-luna" ? @linear-gradient(135deg, #34145b 0%, #17132f 52%, #050d13 100%) : root.current-route == "boosteroid" ? @linear-gradient(135deg, #57210b 0%, #2a1511 52%, #050d13 100%) : @linear-gradient(135deg, #162f58 0%, #111c35 52%, #050d13 100%);
                Rectangle { x: parent.width - 430px; y: -210px; width: 650px; height: 650px; border-radius: 325px; background: #ffffff08; }
                VerticalLayout { padding: 34px; spacing: 20px;
                    HorizontalLayout { height: 64px; VerticalLayout { spacing: 3px; Text { text: "ZINK GAMING"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: root.current-route == "xbox" ? "Xbox Cloud Gaming" : root.current-route == "geforce-now" ? "GeForce NOW" : root.current-route == "amazon-luna" ? "Amazon Luna" : root.current-route == "boosteroid" ? "Boosteroid" : "Shadow PC"; color: white; font-size: 30px; font-weight: 750; } Text { text: "Launch, play and return without leaving the Zink experience."; color: #9cb0aa; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 116px; height: 40px; border-radius: 20px; background: #ffffff0d; Text { text: "Gaming hub"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("gaming"); } } } }
                    Rectangle { vertical-stretch: 1; border-radius: 28px; background: #02090dcc; border-width: 1px; border-color: #ffffff18; HorizontalLayout { padding: 30px; spacing: 32px;
                        Rectangle { width: 260px; height: 260px; border-radius: 60px; background: #ffffff0c; Text { text: root.current-route == "xbox" ? "X" : root.current-route == "geforce-now" ? "GFN" : root.current-route == "amazon-luna" ? "LUNA" : root.current-route == "boosteroid" ? "B" : "S"; color: white; font-size: root.current-route == "geforce-now" || root.current-route == "amazon-luna" ? 36px : 72px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } }
                        VerticalLayout { alignment: center; spacing: 14px; Text { text: root.current-route == "xbox" ? "Play your Xbox library from the cloud" : root.current-route == "shadow-pc" ? "Your complete Windows PC in the cloud" : "Stream your game library at high quality"; color: white; font-size: 26px; font-weight: 750; wrap: word-wrap; } Text { text: root.current-route == "xbox" ? "Persistent sign-in, controller support, site fullscreen and achievement notifications are carried into Zink Connect." : "Zink Connect supplies a persistent service session, hardware-accelerated WebView2 rendering and site fullscreen handling."; color: #9cb0aa; font-size: 11px; wrap: word-wrap; } if root.current-route == "xbox": Rectangle { height: 54px; border-radius: 16px; background: #38ff6610; border-width: 1px; border-color: #38ff6635; HorizontalLayout { padding: 13px; spacing: 11px; FluentGlyph { glyph: ""; color: #38ff66; font-size: 19px; width: 26px; } VerticalLayout { alignment: center; Text { text: "Achievement watch is active"; color: white; font-size: 11px; font-weight: 650; } Text { text: "Supported Xbox web notifications appear as native Windows Zink alerts."; color: #82978f; font-size: 8px; } } } } HorizontalLayout { height: 46px; spacing: 10px; Rectangle { width: 180px; border-radius: 23px; background: #38ff66; Text { text: "Play now  ↗"; color: #051109; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-web-service(root.current-route == "xbox" ? "https://www.xbox.com/play" : root.current-route == "geforce-now" ? "https://play.geforcenow.com" : root.current-route == "amazon-luna" ? "https://luna.amazon.com" : root.current-route == "boosteroid" ? "https://play.boosteroid.com" : "https://pc.shadow.tech/login"); } } } Rectangle { width: 142px; border-radius: 23px; background: #ffffff0d; Text { text: "FPS recorder"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("fps-recorder"); } } } } Text { text: "The provider controls account access and game availability; Zink keeps the browser session local to this PC."; color: #617a73; font-size: 8px; wrap: word-wrap; } } } }
                    HorizontalLayout { height: 112px; spacing: 12px; for feature in [{icon:"", title:"Hardware accelerated", detail:"WebView2 GPU rendering"}, {icon:"", title:"Controller ready", detail:"Gamepad input stays native"}, {icon:"", title:"Fullscreen aware", detail:"Site video fills the display"}, {icon:"", title:"Capture ready", detail:"Jump into FPS recording"}]: Rectangle { horizontal-stretch: 1; border-radius: 18px; background: #ffffff08; VerticalLayout { padding: 15px; spacing: 5px; FluentGlyph { glyph: feature.icon; color: #38ff66; font-size: 17px; } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: feature.title; color: white; font-size: 11px; font-weight: 700; } Text { text: feature.detail; color: #82978f; font-size: 8px; } } } }
                }
            }

            if root.current-route == "__legacy-fps-recorder": Rectangle {
                border-radius: 24px; background: @linear-gradient(135deg, #07171e 0%, #0a2028 55%, #071116 100%); border-width: 1px; border-color: #51d6ff28;
                VerticalLayout { padding: 34px; spacing: 20px;
                    HorizontalLayout { height: 66px; VerticalLayout { Text { text: "ZINK PERFORMANCE"; color: #51d6ff; font-size: 10px; font-weight: 750; } Text { text: "FPS Recorder"; color: white; font-size: 30px; font-weight: 750; } Text { text: "Measure gameplay, capture clips and preserve the moments that matter."; color: #92a8ae; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 170px; height: 48px; border-radius: 24px; background: #38ff66; Text { text: "Open screen recorder"; color: #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("screen-recorder"); } } } }
                    GridLayout { height: 178px; spacing: 14px; for stat[index] in [{label:"LIVE FPS", value:"--", detail:"Select a running game"}, {label:"FRAME TIME", value:"-- ms", detail:"Live performance timing"}, {label:"SESSION", value:"00:00", detail:"Ready to monitor"}, {label:"CAPTURE", value:"Ready", detail:"Native Windows recording"}]: Rectangle { row: 0; col: index; border-radius: 20px; background: #ffffff08; border-width: 1px; border-color: #ffffff12; VerticalLayout { padding: 18px; spacing: 5px; Text { text: stat.label; color: #51d6ff; font-size: 8px; font-weight: 750; } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: stat.value; color: white; font-size: 24px; font-weight: 750; } Text { text: stat.detail; color: #82979d; font-size: 8px; } } } }
                    HorizontalLayout { vertical-stretch: 1; spacing: 14px; Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #ffffff07; VerticalLayout { padding: 20px; spacing: 10px; Text { text: "Performance session"; color: white; font-size: 18px; font-weight: 700; } Text { text: "Choose the game you want to monitor, then start the overlay. Zink keeps capture controls close without covering the action."; color: #9aadaf; font-size: 10px; wrap: word-wrap; } Rectangle { vertical-stretch: 1; background: transparent; } Rectangle { height: 42px; border-radius: 21px; background: #51d6ff20; border-width: 1px; border-color: #51d6ff50; Text { text: "Select running game"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } } } } Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #ffffff07; VerticalLayout { padding: 20px; spacing: 10px; Text { text: "Capture options"; color: white; font-size: 18px; font-weight: 700; } for option in [{title:"Manual recording", detail:"Record until you stop"}, {title:"45-second replay", detail:"Save what just happened"}, {title:"System audio + microphone", detail:"Mix both sources"}]: Rectangle { height: 54px; border-radius: 13px; background: #ffffff08; HorizontalLayout { padding: 12px; spacing: 10px; FluentGlyph { glyph: ""; color: #51d6ff; font-size: 16px; } VerticalLayout { Text { text: option.title; color: white; font-size: 10px; font-weight: 650; } Text { text: option.detail; color: #82979d; font-size: 8px; } } } } Rectangle { vertical-stretch: 1; background: transparent; } } } }
                }
            }

            if root.current-route == "fps-recorder": Rectangle {
                border-radius: 24px;
                background: @linear-gradient(135deg, #06151d 0%, #0a222b 55%, #061016 100%);
                border-width: 1px;
                border-color: #51d6ff28;
                ZinkScrollView {
                    width: parent.width;
                    height: parent.height;
                    content-height: fps-content.preferred-height;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-on;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    fps-content := VerticalLayout {
                        width: parent.visible-width - 16px;
                        padding: 30px;
                        spacing: 18px;
                        HorizontalLayout {
                            height: 70px;
                            VerticalLayout {
                                Text { text: "ZINK PERFORMANCE"; color: #51d6ff; font-size: 10px; font-weight: 750; }
                                Text { text: "FPS Recorder"; color: white; font-size: 30px; font-weight: 750; }
                                Text { text: root.fps-target-name + "  •  " + root.fps-status; color: #92a8ae; font-size: 10px; overflow: elide; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Rectangle {
                                width: 126px; height: 42px; border-radius: 21px; background: #ffffff0d;
                                Text { text: "Refresh games"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.refresh-fps-processes(); } }
                            }
                            Rectangle {
                                width: 118px; height: 42px; border-radius: 21px; background: root.fps-selected-pid > 0 ? #ff5968 : #ffffff08;
                                Text { text: "Stop monitor"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { enabled: root.fps-selected-pid > 0; clicked => { root.stop-fps-monitor(); } }
                            }
                        }
                        GridLayout {
                            height: 138px;
                            spacing: 12px;
                            for stat[index] in [
                                {label:"LIVE FPS", value:root.fps-current, detail:"RTSS game framerate"},
                                {label:"FRAME TIME", value:root.fps-frame-time, detail:"Latest presented frame"},
                                {label:"AVERAGE", value:root.fps-average, detail:"Current RTSS session"},
                                {label:"1% LOW", value:root.fps-one-percent-low, detail:"Sustained low performance"},
                                {label:"0.1% LOW", value:root.fps-point-one-percent-low, detail:"Worst frame-time events"},
                                {label:"SESSION", value:root.fps-session-time, detail:root.fps-frame-count + " sampled frames"}
                            ]: Rectangle {
                                row: 0; col: index; border-radius: 18px; background: #ffffff08; border-width: 1px; border-color: #ffffff12;
                                VerticalLayout { padding: 15px; spacing: 4px;
                                    Text { text: stat.label; color: #51d6ff; font-size: 7px; font-weight: 750; }
                                    Rectangle { vertical-stretch: 1; background: transparent; }
                                    Text { text: stat.value; color: white; font-size: 19px; font-weight: 750; overflow: elide; }
                                    Text { text: stat.detail; color: #82979d; font-size: 7px; overflow: elide; }
                                }
                            }
                        }
                        HorizontalLayout {
                            height: 410px;
                            spacing: 14px;
                            Rectangle {
                                horizontal-stretch: 3; border-radius: 22px; background: #ffffff07; border-width: 1px; border-color: #ffffff10;
                                VerticalLayout { padding: 20px; spacing: 11px;
                                    HorizontalLayout { height: 32px;
                                        Text { text: "Running games and windows"; color: white; font-size: 18px; font-weight: 700; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Text { text: root.fps-process-items.length + " available"; color: #51d6ff; font-size: 9px; vertical-alignment: center; }
                                    }
                                    if root.fps-process-items.length == 0: Rectangle {
                                        vertical-stretch: 1; border-radius: 16px; background: #ffffff05;
                                        VerticalLayout { alignment: center; spacing: 10px;
                                            FluentGlyph { glyph: ""; color: #51d6ff; font-size: 34px; }
                                            Text { text: "No eligible windows found"; color: white; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
                                            Text { text: "Open the game, then press Refresh games."; color: #82979d; font-size: 9px; horizontal-alignment: center; }
                                        }
                                    }
                                    if root.fps-process-items.length > 0: fps-process-scroll := ZinkScrollView {
                                        vertical-stretch: 1;
                                        content-height: fps-process-list.preferred-height;
                                        vertical-scrollbar-policy: ScrollBarPolicy.always-on;
                                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                        fps-process-list := VerticalLayout { width: fps-process-scroll.visible-width - 14px; spacing: 8px;
                                            for process in root.fps-process-items: Rectangle {
                                                height: 58px; border-radius: 14px;
                                                background: root.fps-selected-pid == process.pid ? #51d6ff20 : process-touch.has-hover ? #ffffff12 : #ffffff07;
                                                border-width: 1px; border-color: root.fps-selected-pid == process.pid ? #51d6ff70 : #ffffff0c;
                                                HorizontalLayout { padding: 12px; spacing: 11px;
                                                    Rectangle { width: 34px; height: 34px; border-radius: 10px; background: #51d6ff18; FluentGlyph { glyph: ""; color: #51d6ff; font-size: 15px; } }
                                                    VerticalLayout { alignment: center;
                                                        Text { text: process.title; color: white; font-size: 11px; font-weight: 650; overflow: elide; }
                                                        Text { text: "Process " + process.pid; color: #82979d; font-size: 8px; }
                                                    }
                                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                                    Text { text: root.fps-selected-pid == process.pid ? "MONITORING" : "SELECT"; color: #51d6ff; font-size: 8px; font-weight: 700; vertical-alignment: center; }
                                                }
                                                process-touch := TouchArea { clicked => { root.select-fps-process(process.pid, process.title); } }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 2; border-radius: 22px; background: #ffffff07; border-width: 1px; border-color: #ffffff10;
                                VerticalLayout { padding: 20px; spacing: 12px;
                                    Text { text: "Session capture"; color: white; font-size: 18px; font-weight: 700; }
                                    Text { text: "Record live FPS, averages, low-percentile results, frame time and frame count to a CSV file in Videos\\Zink FPS Recorder."; color: #9aadaf; font-size: 9px; wrap: word-wrap; }
                                    Rectangle { height: 66px; border-radius: 16px; background: root.fps-recording ? #ff596818 : #51d6ff12; border-width: 1px; border-color: root.fps-recording ? #ff596850 : #51d6ff40;
                                        HorizontalLayout { padding: 14px; spacing: 12px;
                                            FluentGlyph { glyph: root.fps-recording ? "" : ""; color: root.fps-recording ? #ff8b94 : #51d6ff; font-size: 20px; }
                                            VerticalLayout { alignment: center;
                                                Text { text: root.fps-recording ? "Recording performance" : "Ready to record"; color: white; font-size: 11px; font-weight: 700; }
                                                Text { text: root.fps-recording ? "CSV samples are being written" : "Select a game first"; color: #82979d; font-size: 8px; }
                                            }
                                        }
                                    }
                                    Rectangle { height: 44px; border-radius: 22px; background: root.fps-selected-pid == 0 ? #ffffff08 : root.fps-recording ? #ff5968 : #51d6ff;
                                        Text { text: root.fps-recording ? "Stop CSV recording" : "Record FPS to CSV"; color: root.fps-selected-pid == 0 ? #71877f : #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { enabled: root.fps-selected-pid > 0; clicked => { root.toggle-fps-recording(); } }
                                    }
                                    Rectangle { height: 42px; border-radius: 21px; background: #ffffff0d;
                                        Text { text: "Open screen recorder"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.navigate("screen-recorder"); } }
                                    }
                                    Rectangle { vertical-stretch: 1; background: transparent; }
                                    Text { text: "RTSS integration"; color: white; font-size: 12px; font-weight: 700; }
                                    Text { text: "Zink reads the RTSS shared-memory interface directly. RTSS must be running with application detection enabled for the selected game."; color: #82979d; font-size: 8px; wrap: word-wrap; }
                                    Rectangle { height: 38px; border-radius: 19px; background: #ffffff0b;
                                        Text { text: "Open RTSS download  ↗"; color: #51d6ff; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.open-rtss-download(); } }
                                    }
                                }
                            }
                        }
                        HorizontalLayout { height: 250px; spacing: 14px;
                            Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #ffffff07; border-width: 1px; border-color: #ffffff10; VerticalLayout { padding: 20px; spacing: 11px;
                                Text { text: "Monitor and output"; color: white; font-size: 18px; font-weight: 700; }
                                Text { text: "Settings are saved immediately and restored the next time Zink starts."; color: #82979d; font-size: 8px; }
                                for setting in [{name:"Target FPS", value:root.fps-target-rate + "", kind:"target"}, {name:"Sample window", value:root.fps-sample-window + " seconds", kind:"window"}, {name:"CSV recording", value:root.fps-record-csv ? "On" : "Off", kind:"csv"}]: Rectangle { height: 46px; border-radius: 13px; background: setting-touch.has-hover ? #51d6ff18 : #ffffff08; HorizontalLayout { padding: 12px; Text { text: setting.name; color: white; font-size: 10px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: setting.value + "  ›"; color: #51d6ff; font-size: 9px; vertical-alignment: center; } } setting-touch := TouchArea { clicked => { if setting.kind == "target" { root.fps-target-rate = root.fps-target-rate == 30 ? 45 : root.fps-target-rate == 45 ? 60 : root.fps-target-rate == 60 ? 90 : root.fps-target-rate == 90 ? 120 : root.fps-target-rate == 120 ? 144 : 30; } else if setting.kind == "window" { root.fps-sample-window = root.fps-sample-window >= 10 ? 1 : root.fps-sample-window + 1; } else { root.fps-record-csv = !root.fps-record-csv; } root.save-fps-settings(); } } }
                            } }
                            Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #ffffff07; border-width: 1px; border-color: #ffffff10; VerticalLayout { padding: 20px; spacing: 11px;
                                HorizontalLayout { height: 28px; Text { text: "Pop-out overlay"; color: white; font-size: 18px; font-weight: 700; } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 98px; border-radius: 14px; background: #51d6ff; Text { text: "Open overlay"; color: #051109; font-size: 8px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-fps-widget(); } } } }
                                for setting in [{name:"Open with monitor", value:root.fps-show-widget ? "On" : "Off", kind:"show"}, {name:"Text-only FPS", value:root.fps-widget-text-only ? "On" : "Off", kind:"text"}, {name:"Glass opacity", value:root.fps-widget-opacity + "%", kind:"opacity"}]: Rectangle { height: 42px; border-radius: 13px; background: overlay-setting-touch.has-hover ? #51d6ff18 : #ffffff08; HorizontalLayout { padding: 11px; Text { text: setting.name; color: white; font-size: 10px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: setting.value + "  ›"; color: #51d6ff; font-size: 9px; vertical-alignment: center; } } overlay-setting-touch := TouchArea { clicked => { if setting.kind == "show" { root.fps-show-widget = !root.fps-show-widget; } else if setting.kind == "text" { root.fps-widget-text-only = !root.fps-widget-text-only; } else { root.fps-widget-opacity = root.fps-widget-opacity >= 100 ? 50 : root.fps-widget-opacity + 10; } root.save-fps-settings(); } } }
                                HorizontalLayout { height: 36px; spacing: 8px; Rectangle { horizontal-stretch: 1; border-radius: 18px; background: root.fps-include-cursor ? #51d6ff20 : #ffffff08; Text { text: root.fps-include-cursor ? "Cursor included" : "Cursor hidden"; color: root.fps-include-cursor ? #51d6ff : white; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.fps-include-cursor = !root.fps-include-cursor; root.save-fps-settings(); } } } Rectangle { horizontal-stretch: 1; border-radius: 18px; background: root.fps-hide-capture-border ? #51d6ff20 : #ffffff08; Text { text: root.fps-hide-capture-border ? "Border hidden" : "Border visible"; color: root.fps-hide-capture-border ? #51d6ff : white; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.fps-hide-capture-border = !root.fps-hide-capture-border; root.save-fps-settings(); } } } }
                            } }
                        }
                    }
                }
            }

            if root.current-route != "home" && root.current-route != "music-library" && root.current-route != "video-library" && root.current-route != "music-player" && root.current-route != "equalizer" && root.current-route != "visualizer" && root.current-route != "search" && root.current-route != "radio" && root.current-route != "radio-discovery" && root.current-route != "liked-radio-songs" && root.current-route != "radio-widget" && root.current-route != "youtube-music" && root.current-route != "amazon-music" && root.current-route != "spotify" && root.current-route != "spotify-widget" && root.current-route != "video-player" && root.current-route != "screen-recorder" && root.current-route != "recordings" && root.current-route != "social" && root.current-route != "streaming" && root.current-route != "settings" && root.current-route != "about" && root.current-route != "zink-connect" && root.current-route != "zink-vpn" && root.current-route != "tools" && root.current-route != "tv" && root.current-route != "films" && root.current-route != "gaming" && root.current-route != "duplicate-video-search" && root.current-route != "film-info" && root.current-route != "onedrive-streaming" && root.current-route != "bbc-iplayer" && root.current-route != "my5" && root.current-route != "netflix" && root.current-route != "prime-video" && root.current-route != "disney-plus" && root.current-route != "paramount-plus" && root.current-route != "now-tv" && root.current-route != "xbox" && root.current-route != "fps-recorder" && root.current-route != "geforce-now" && root.current-route != "amazon-luna" && root.current-route != "boosteroid" && root.current-route != "shadow-pc": Rectangle {
                visible: root.current-route != "twitch" && root.current-route != "discord" && root.current-route != "youtube" && root.current-route != "tiktok" && root.current-route != "instagram" && root.current-route != "x" && root.current-route != "facebook" && root.current-route != "telegram" && root.current-route != "whatsapp" && root.current-route != "messenger" && root.current-route != "linkedin" && root.current-route != "threads" && root.current-route != "bluesky" && root.current-route != "mastodon" && root.current-route != "pinterest" && root.current-route != "tumblr" && root.current-route != "reddit" && root.current-route != "social-login" && root.current-route != "social-register" && root.current-route != "friends" && root.current-route != "friend-requests" && root.current-route != "messages" && root.current-route != "call" && root.current-route != "profile" && root.current-route != "social-developer" && root.current-route != "twitch-streaming" && root.current-route != "youtube-streaming" && root.current-route != "kick-streaming" && root.current-route != "instagram-streaming" && root.current-route != "tiktok-streaming" && root.current-route != "facebook-streaming" && root.current-route != "x-streaming" && root.current-route != "background-recording-settings" && root.current-route != "recorder" && root.current-route != "feedback" && root.current-route != "version-history" && root.current-route != "app-theme" && root.current-route != "notifications" && root.current-route != "privacy" && root.current-route != "feature-tour" && root.current-route != "widget-hub" && root.current-route != "review" && root.current-route != "customization" && root.current-route != "social-web";
                vertical-stretch: 1;
                border-radius: 16px;
                background: #182226b2;
                border-color: #ffffff32;
                border-width: 1px;
                VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    Text { text: root.page-title; color: white; font-size: 28px; font-weight: 700; horizontal-alignment: center; }
                    Text { text: "This route is wired into the Rust shell. Its production engine remains gated in the migration inventory."; color: #9fb2ac; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
                }
            }

            if root.current-route == "music-library": Rectangle {
                vertical-stretch: 1;
                border-radius: 24px;
                background: #06171bd8;
                border-width: 1px;
                border-color: #ffffff10;
                clip: true;

                music-library-scroll := ZinkScrollView {
                    width: parent.width;
                    height: parent.height;
                    content-height: music-library-content.preferred-height;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-on;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                    music-library-content := VerticalLayout {
                        width: music-library-scroll.visible-width - 18px;
                        padding: 28px;
                        spacing: 22px;

                        HorizontalLayout {
                            height: 72px;
                            spacing: 14px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                Text { text: "ZINK MUSIC"; color: #38ff66; font-size: 11px; font-weight: 750; }
                                Text { text: "Your Music Library"; color: white; font-size: 31px; font-weight: 750; }
                                Text { text: "Everything on this PC, organised and ready to play."; color: #9db0aa; font-size: 11px; }
                            }
                            Rectangle { width: 126px; height: 42px; border-radius: 21px; background: add-library-touch.has-hover ? #ffffff : #f2fff6; Text { text: "＋  Add music"; color: #07140b; font-size: 11px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } add-library-touch := TouchArea { clicked => { root.import-library(); } } }
                            Rectangle { visible: root.width > 1180px; width: self.visible ? 142px : 0px; height: 42px; border-radius: 21px; background: add-many-library-touch.has-hover ? #ffffff18 : #ffffff0d; border-width: 1px; border-color: #ffffff18; Text { text: "＋  Add folders"; color: white; font-size: 10px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } add-many-library-touch := TouchArea { clicked => { root.import-multiple-libraries(); } } }
                            Rectangle { width: 104px; height: 42px; border-radius: 21px; background: root.library-source-open ? #38ff6622 : library-sources-touch.has-hover ? #ffffff18 : #ffffff0d; border-width: 1px; border-color: root.library-source-open ? #38ff6655 : #ffffff18; Text { text: "Sources " + root.library-source-folders.length; color: root.library-source-open ? #38ff66 : white; font-size: 10px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } library-sources-touch := TouchArea { clicked => { root.library-source-open = !root.library-source-open; } } }
                            Rectangle { visible: root.width > 1280px; width: self.visible ? 44px : 0px; height: 42px; border-radius: 21px; background: refresh-library-touch.has-hover ? #ffffff20 : #ffffff0d; FluentGlyph { glyph: ""; font-size: 16px; } refresh-library-touch := TouchArea { clicked => { root.refresh-library(); } } }
                            Rectangle { visible: root.width > 1450px; width: self.visible ? 44px : 0px; height: 42px; border-radius: 21px; background: library-log-touch.has-hover ? #ffffff20 : #ffffff0d; FluentGlyph { glyph: ""; font-size: 15px; } library-log-touch := TouchArea { clicked => { root.open-log-folder(); } } }
                        }

                        if root.library-source-open: Rectangle {
                            height: 88px; border-radius: 18px; background: #ffffff07; border-width: 1px; border-color: #38ff6630;
                            HorizontalLayout { padding: 13px; spacing: 10px;
                                VerticalLayout { width: 112px; alignment: center; Text { text: "Music sources"; color: white; font-size: 12px; font-weight: 700; } Text { text: "Files stay in place"; color: #82978f; font-size: 8px; } }
                                if root.library-source-folders.length == 0: Text { text: "No folders have been added yet."; color: #82978f; font-size: 10px; vertical-alignment: center; }
                                library-source-scroll := ZinkScrollView { horizontal-stretch: 1; content-width: library-source-row.preferred-width; horizontal-scrollbar-policy: ScrollBarPolicy.always-on; vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                    library-source-row := HorizontalLayout { height: library-source-scroll.visible-height - 14px; spacing: 8px;
                                        for folder in root.library-source-folders: Rectangle { width: 300px; border-radius: 13px; background: #ffffff09; HorizontalLayout { padding: 10px; spacing: 8px; FluentGlyph { glyph: ""; color: #38ff66; width: 18px; font-size: 13px; } Text { text: folder; color: white; font-size: 8px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; } Rectangle { width: 60px; border-radius: 10px; background: remove-music-source-touch.has-hover ? #ff455530 : #ff455518; Text { text: "Remove"; color: #ff9da5; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } remove-music-source-touch := TouchArea { clicked => { root.remove-library-source(folder); } } } } }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 188px;
                            border-radius: 22px;
                            background: @linear-gradient(100deg, #07382bd8 0%, #092329e8 48%, #06181de8 100%);
                            border-width: 1px;
                            border-color: #38ff6635;
                            Rectangle { x: parent.width - 360px; y: -100px; width: 460px; height: 360px; border-radius: 180px; background: #38ff660c; }
                            HorizontalLayout {
                                padding: 24px;
                                spacing: 22px;
                                Rectangle { width: 130px; height: 130px; border-radius: 24px; background: @linear-gradient(135deg, #38ff6645 0%, #11d8e838 100%); FluentGlyph { glyph: ""; color: #8aff9f; font-size: 48px; } }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 8px;
                                    Text { text: root.library-track-count == 0 ? "Build your collection" : root.library-track-count + " songs, ready when you are"; color: white; font-size: 25px; font-weight: 720; }
                                    Text { text: root.library-status; color: #b8cbc5; font-size: 11px; overflow: elide; }
                                    HorizontalLayout { height: 42px; spacing: 10px;
                                        Rectangle { width: 112px; border-radius: 21px; background: root.library-track-count > 0 ? #38ff66 : #38ff6650; Text { text: "▶  Play all"; color: #06110a; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } play-all-library-touch := TouchArea { enabled: root.library-track-count > 0; clicked => { root.play-library-all(false); } } }
                                        Rectangle { width: 124px; border-radius: 21px; background: shuffle-library-touch.has-hover ? #ffffff18 : #ffffff0d; border-width: 1px; border-color: #ffffff20; Text { text: "  Shuffle all"; color: white; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } shuffle-library-touch := TouchArea { enabled: root.library-track-count > 0; clicked => { root.play-library-all(true); } } }
                                    }
                                }
                                HorizontalLayout { visible: root.width > 1500px; width: self.visible ? 520px : 0px; spacing: 10px;
                                    for stat in [
                                        { label: "TRACKS", value: root.library-track-count + "" },
                                        { label: "ALBUMS", value: root.library-album-count + "" },
                                        { label: "ARTISTS", value: root.library-artist-count + "" },
                                        { label: "PLAY TIME", value: root.library-total-duration }
                                    ]: Rectangle { horizontal-stretch: 1; border-radius: 16px; background: #ffffff09; VerticalLayout { alignment: center; spacing: 5px; Text { text: stat.value; color: white; font-size: 17px; font-weight: 700; horizontal-alignment: center; } Text { text: stat.label; color: #83a098; font-size: 8px; font-weight: 650; horizontal-alignment: center; } } }
                                }
                            }
                        }

                        HorizontalLayout {
                            height: 46px;
                            spacing: 10px;
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 23px; background: #ffffff0b; border-width: 1px; border-color: search-library-input.has-focus ? #38ff6680 : #ffffff16;
                                FluentGlyph { glyph: ""; x: 16px; width: 22px; font-size: 15px; color: #9db0aa; }
                                search-library-input := TextInput { x: 48px; width: parent.width - 92px; height: parent.height; text: root.library-search; color: white; font-size: 12px; single-line: true; edited => { root.library-search = self.text; root.search-library(self.text); } accepted => { root.search-library(self.text); } }
                                if root.library-search != "": Rectangle { x: parent.width - 40px; y: 7px; width: 32px; height: 32px; border-radius: 16px; background: clear-library-search-touch.has-hover ? #ffffff18 : transparent; Text { text: "×"; color: white; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; } clear-library-search-touch := TouchArea { clicked => { root.library-search = ""; root.clear-library-search(); } } }
                            }
                            Rectangle { width: 154px; border-radius: 23px; background: library-sort-touch.has-hover ? #ffffff16 : #ffffff0b; border-width: 1px; border-color: #ffffff16; Text { text: "Sort: " + root.library-sort-mode + " ⌄"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } library-sort-touch := TouchArea { clicked => { root.library-sort-mode = root.library-sort-mode == "Title" ? "Artist" : root.library-sort-mode == "Artist" ? "Album" : root.library-sort-mode == "Album" ? "Duration" : "Title"; root.refresh-library(); } } }
                            Rectangle { width: 46px; border-radius: 23px; background: root.library-view-mode == "grid" ? #38ff6622 : grid-view-touch.has-hover ? #ffffff16 : #ffffff0b; FluentGlyph { glyph: ""; color: root.library-view-mode == "grid" ? #38ff66 : white; font-size: 15px; } grid-view-touch := TouchArea { clicked => { root.library-view-mode = "grid"; } } }
                            Rectangle { width: 46px; border-radius: 23px; background: root.library-view-mode == "list" ? #38ff6622 : list-view-touch.has-hover ? #ffffff16 : #ffffff0b; FluentGlyph { glyph: ""; color: root.library-view-mode == "list" ? #38ff66 : white; font-size: 15px; } list-view-touch := TouchArea { clicked => { root.library-view-mode = "list"; } } }
                        }

                        if root.music-playlists.length > 0 || root.recently-played.length > 0: HorizontalLayout {
                            height: 204px; spacing: 18px;
                            Rectangle { horizontal-stretch: 1; border-radius: 20px; background: #ffffff07; VerticalLayout { padding: 16px; spacing: 8px; Text { text: "Your playlists"; color: white; font-size: 18px; font-weight: 700; } library-playlist-scroll := ZinkScrollView { vertical-stretch: 1; content-width: library-playlist-row.preferred-width; horizontal-scrollbar-policy: ScrollBarPolicy.always-on; vertical-scrollbar-policy: ScrollBarPolicy.always-off; library-playlist-row := HorizontalLayout { height: library-playlist-scroll.visible-height - 14px; spacing: 9px; for playlist in root.music-playlists: Rectangle { width: 184px; border-radius: 13px; background: library-playlist-touch.has-hover ? #38ff6618 : #ffffff08; VerticalLayout { padding: 12px; spacing: 4px; FluentGlyph { glyph: ""; color: #38ff66; font-size: 20px; } Rectangle { vertical-stretch: 1; background: transparent; } Text { height: 18px; text: playlist.name; color: white; font-size: 12px; font-weight: 650; overflow: elide; } Text { height: 14px; text: playlist.detail; color: #9db0aa; font-size: 9px; overflow: elide; } } library-playlist-touch := TouchArea { clicked => { root.load-music-playlist(playlist.name); root.navigate("music-player"); } } } } } } }
                            Rectangle { horizontal-stretch: 1; border-radius: 20px; background: #ffffff07; VerticalLayout { padding: 16px; spacing: 8px; Text { text: "Recently played"; color: white; font-size: 18px; font-weight: 700; } library-recent-scroll := ZinkScrollView { vertical-stretch: 1; content-width: library-recent-row.preferred-width; horizontal-scrollbar-policy: ScrollBarPolicy.always-on; vertical-scrollbar-policy: ScrollBarPolicy.always-off; library-recent-row := HorizontalLayout { height: library-recent-scroll.visible-height - 14px; spacing: 9px; for track in root.recently-played: Rectangle { width: 184px; border-radius: 13px; background: library-recent-touch.has-hover ? #38ff6618 : #ffffff08; VerticalLayout { padding: 12px; spacing: 4px; FluentGlyph { glyph: ""; color: #38ff66; font-size: 19px; } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: track.title; color: white; font-size: 12px; font-weight: 650; overflow: elide; } Text { text: track.artist == "" ? "Unknown artist" : track.artist; color: #9db0aa; font-size: 9px; overflow: elide; } } library-recent-touch := TouchArea { clicked => { root.play-library-item(track.path); root.navigate("music-player"); } } } } } } }
                        }

                        HorizontalLayout { height: 38px; spacing: 12px; Text { text: root.library-search == "" ? "All music" : "Search results"; color: white; font-size: 22px; font-weight: 720; vertical-alignment: center; } Text { text: root.library-items.length + (root.library-items.length == 1 ? " track" : " tracks"); color: #9db0aa; font-size: 10px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "Select Play on any track."; color: #617a73; font-size: 9px; vertical-alignment: center; } }

                        if root.library-items.length == 0: Rectangle { height: 210px; border-radius: 20px; background: #ffffff06; border-width: 1px; border-color: #ffffff12; VerticalLayout { alignment: center; spacing: 10px; HorizontalLayout { height: 58px; alignment: center; Rectangle { width: 58px; height: 58px; border-radius: 18px; background: #38ff6615; FluentGlyph { glyph: root.library-search == "" ? "" : ""; color: #38ff66; font-size: 24px; } } } Text { text: root.library-search == "" ? "Your library is ready for music" : "No music matches that search"; color: white; font-size: 17px; font-weight: 700; horizontal-alignment: center; } Text { text: root.library-search == "" ? "Add a folder and Zink will index its songs without moving the originals." : "Try the artist, album, song title or filename."; color: #9db0aa; font-size: 11px; horizontal-alignment: center; } HorizontalLayout { height: 38px; alignment: center; Rectangle { width: 130px; height: 38px; border-radius: 19px; background: #38ff66; Text { text: root.library-search == "" ? "Add music folder" : "Clear search"; color: #06110a; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } music-library-empty-touch := TouchArea { clicked => { if (root.library-search == "") { root.import-library(); } else { root.library-search = ""; root.clear-library-search(); } } } } } } }

                        if root.library-items.length > 0 && root.library-view-mode == "grid": GridLayout {
                            spacing: 14px;
                            for media[index] in root.library-items: Rectangle {
                                row: index / (root.width > 1660px ? 5 : root.width > 1350px ? 4 : 3);
                                col: Math.mod(index, root.width > 1660px ? 5 : root.width > 1350px ? 4 : 3);
                                width: (parent.width - ((root.width > 1660px ? 4 : root.width > 1350px ? 3 : 2) * 14px)) / (root.width > 1660px ? 5 : root.width > 1350px ? 4 : 3);
                                height: 276px;
                                border-radius: 17px;
                                background: library-grid-touch.has-hover ? #ffffff14 : #ffffff07;
                                border-width: 1px;
                                border-color: library-grid-touch.has-hover ? #38ff6655 : #ffffff0d;
                                VerticalLayout { padding: 12px; spacing: 8px;
                                    Rectangle { height: 174px; border-radius: 14px; clip: true; background: @linear-gradient(140deg, #0f5b4d 0%, #0c3338 54%, #071a20 100%); Rectangle { x: parent.width - 78px; y: -22px; width: 128px; height: 128px; border-radius: 64px; background: #38ff6618; } FluentGlyph { glyph: ""; color: #dffff0; font-size: 52px; } Image { source: media.artwork; image-fit: cover; width: parent.width; height: parent.height; } Rectangle { x: parent.width - 50px; y: parent.height - 50px; width: 40px; height: 40px; border-radius: 20px; background: library-grid-touch.has-hover ? #38ff66 : #38ff66d8; FluentGlyph { glyph: ""; color: #06110a; font-size: 16px; } } }
                                    Text { height: 20px; text: media.title; color: white; font-size: 13px; font-weight: 680; overflow: elide; vertical-alignment: center; }
                                    Text { height: 16px; text: (media.artist == "" ? "Unknown artist" : media.artist) + (media.album == "" ? "" : " • " + media.album); color: #9db0aa; font-size: 9px; overflow: elide; vertical-alignment: center; }
                                    HorizontalLayout { height: 22px; Text { text: media.duration; color: #71857f; font-size: 9px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } HorizontalLayout { width: 48px; alignment: center; spacing: 4px; FluentGlyph { glyph: ""; color: #38ff66; width: 13px; font-size: 11px; } Text { text: "Play"; color: #38ff66; font-size: 10px; vertical-alignment: center; } } }
                                }
                                library-grid-touch := TouchArea { clicked => { root.play-library-item(media.path); root.navigate("music-player"); } }
                            }
                        }

                        if root.library-items.length > 0 && root.library-view-mode == "list": VerticalLayout {
                            spacing: 7px;
                            for media[index] in root.library-items: Rectangle { height: 66px; border-radius: 13px; background: library-list-touch.has-hover ? #ffffff12 : Math.mod(index, 2) == 0 ? #ffffff06 : #ffffff03; HorizontalLayout { padding: 9px; spacing: 12px; Text { text: index + 1; color: #71857f; font-size: 10px; width: 24px; vertical-alignment: center; horizontal-alignment: center; } Rectangle { width: 48px; height: 48px; border-radius: 10px; clip: true; background: @linear-gradient(135deg, #38ff6630 0%, #11d8e825 100%); FluentGlyph { glyph: ""; color: #7dff95; font-size: 18px; } Image { source: media.artwork; image-fit: cover; width: parent.width; height: parent.height; } } VerticalLayout { horizontal-stretch: 2; alignment: center; Text { text: media.title; color: white; font-size: 12px; font-weight: 650; overflow: elide; } Text { text: media.artist == "" ? "Unknown artist" : media.artist; color: #9db0aa; font-size: 9px; overflow: elide; } } Text { text: media.album; color: #9db0aa; font-size: 10px; width: 260px; overflow: elide; vertical-alignment: center; } Text { text: media.duration; color: #71857f; font-size: 10px; width: 54px; vertical-alignment: center; horizontal-alignment: right; } Rectangle { width: 72px; height: 34px; border-radius: 17px; background: #38ff661a; HorizontalLayout { alignment: center; spacing: 5px; FluentGlyph { glyph: ""; color: #38ff66; width: 14px; font-size: 12px; } Text { text: "Play"; color: #38ff66; font-size: 9px; vertical-alignment: center; } } } } library-list-touch := TouchArea { clicked => { root.play-library-item(media.path); root.navigate("music-player"); } } }
                        }
                    }
                }
            }

            if root.current-route == "video-library": VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                spacing: 14px;
                HorizontalLayout {
                    height: 62px; spacing: 10px;
                    VerticalLayout { horizontal-stretch: 1; Text { text: "ZINK VIDEO"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: "Video Library"; color: white; font-size: 29px; font-weight: 750; } Text { text: "Your films and videos, organised for native Windows playback."; color: #8da29b; font-size: 10px; } }
                    Rectangle {
                        width: 132px; height: 36px; border-radius: 8px; background: add-touch.has-hover ? #11d8e838 : #00161dbd; border-width: 1px; border-color: #11d8e850;
                        HorizontalLayout { alignment: center; spacing: 7px; FluentGlyph { glyph: ""; width: 16px; color: #38ff66; font-size: 13px; } Text { text: "Add folder"; color: #ffffffe8; font-size: 10px; vertical-alignment: center; } }
                        add-touch := TouchArea { clicked => { root.import-library(); } }
                    }
                    Rectangle {
                        visible: root.current-route == "video-library"; width: self.visible ? 152px : 0px; height: 36px; border-radius: 8px; background: #00161dbd; border-width: 1px; border-color: #11d8e850;
                        Text { text: "  Multiple folders"; font-family: "Segoe Fluent Icons"; color: #ffffffe8; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.import-multiple-libraries(); } }
                    }
                    Rectangle {
                        width: 76px; height: 36px; border-radius: 8px; background: refresh-touch.has-hover ? #11d8e838 : #00161dbd; border-width: 1px; border-color: #11d8e850;
                        Text { text: "  Rescan"; font-family: "Segoe Fluent Icons"; color: #ffffffe8; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                        refresh-touch := TouchArea { clicked => { root.refresh-library(); } }
                    }
                    Rectangle { width: 116px; height: 36px; border-radius: 8px; background: root.library-source-open ? #38ff6618 : #00161dbd; border-width: 1px; border-color: #11d8e850; Text { text: "  Sources (" + root.library-source-folders.length + ")"; font-family: "Segoe Fluent Icons"; color: root.library-source-open ? #38ff66 : #ffffffe8; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.library-source-open = !root.library-source-open; } } }
                    Rectangle {
                        visible: root.current-route == "music-library"; width: self.visible ? 104px : 0px; height: 36px; border-radius: 8px; background: #00161dbd; border-width: 1px; border-color: #11d8e850;
                        Text { text: "Open scan log"; color: #ffffffe8; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        visible: root.current-route == "music-library"; width: self.visible ? 72px : 0px; height: 36px; border-radius: 8px; background: #00101680; border-width: 1px; border-color: #78d9dd30;
                        Text { text: "Play All"; color: #ffffff70; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
                Text { height: root.current-route == "music-library" ? 18px : 0px; vertical-stretch: 0; text: "Browse folders and preview the music inside before adding the folder to Zink."; visible: root.current-route == "music-library"; color: #d6e2eaa9; font-size: 12px; }
                if root.library-source-open: Rectangle {
                    height: 82px; border-radius: 16px; background: #06171dcc; border-width: 1px; border-color: #38ff6630;
                    HorizontalLayout {
                        padding: 12px; spacing: 8px;
                        Text { text: "Indexed folders"; color: white; font-size: 11px; font-weight: 700; width: 100px; vertical-alignment: center; }
                        if root.library-source-folders.length == 0: Text { text: "No folders added yet"; color: #82978f; font-size: 9px; vertical-alignment: center; }
                        source-folder-strip := Flickable {
                            horizontal-stretch: 1; content-width: source-folder-row.preferred-width;
                            source-folder-row := HorizontalLayout {
                                spacing: 8px;
                                for folder in root.library-source-folders: Rectangle {
                                    width: 280px; border-radius: 13px; background: #ffffff09; border-width: 1px; border-color: #ffffff12;
                                    HorizontalLayout {
                                        padding: 10px; spacing: 8px;
                                        FluentGlyph { glyph: ""; color: #38ff66; font-size: 14px; width: 20px; }
                                        Text { text: folder; color: white; font-size: 8px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                        Rectangle { width: 58px; border-radius: 10px; background: #ff455518; Text { text: "Remove"; color: #ff9da5; font-size: 7px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.remove-library-source(folder); } } }
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle { height: 54px; border-radius: 16px; background: #ffffff07; HorizontalLayout { padding: 13px; spacing: 10px; Rectangle { width: 28px; height: 28px; border-radius: 9px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 13px; } } Text { text: root.library-status; color: #b3c5bf; font-size: 10px; vertical-alignment: center; overflow: elide; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.library-items.length + (root.library-items.length == 1 ? " video" : " videos"); color: #38ff66; font-size: 10px; vertical-alignment: center; } } }
                HorizontalLayout {
                    height: 52px; spacing: 10px;
                    Rectangle {
                        horizontal-stretch: 1; height: 34px; border-radius: 6px; background: #001d25b8; border-width: 1px; border-color: #11d8e830;
                        Text { text: root.library-search == "" ? (root.current-route == "music-library" ? "Search by song name, artist, album, or filename" : "Search the films by the name, the file type, the folder, or the duration") : ""; color: #d6e2ea83; font-size: 12px; x: 12px; vertical-alignment: center; }
                        TextInput {
                            x: 12px; width: parent.width - 52px; height: parent.height;
                            text: root.library-search;
                            color: #ffffffe8; font-size: 12px;
                            single-line: true;
                            edited => { root.library-search = self.text; root.search-library(self.text); }
                        }
                        Text { text: "⌕"; color: #d6e2eaa9; font-size: 16px; x: parent.width - 30px; vertical-alignment: center; }
                    }
                    Rectangle {
                        visible: root.current-route == "video-library"; width: self.visible ? 180px : 0px; height: 52px; border-radius: 6px; background: #00161dbd; border-width: 1px; border-color: #11d8e830;
                        VerticalLayout { padding: 5px; Text { text: "Sort by"; color: #d6e2ea83; font-size: 9px; } Text { text: root.library-sort-mode + " ⌄"; color: #ffffffe8; font-size: 11px; } }
                        sort-video-touch := TouchArea { clicked => { root.library-sort-mode = root.library-sort-mode == "Recently added" ? "Title A–Z" : root.library-sort-mode == "Title A–Z" ? "Title Z–A" : root.library-sort-mode == "Title Z–A" ? "Longest first" : root.library-sort-mode == "Longest first" ? "Shortest first" : root.library-sort-mode == "Shortest first" ? "File type" : "Recently added"; root.refresh-library(); } }
                    }
                    Rectangle {
                        visible: root.current-route == "video-library"; width: self.visible ? 64px : 0px; height: 34px; border-radius: 6px; background: clear-touch.has-hover ? #11d8e838 : #00161dbd; border-width: 1px; border-color: #11d8e830;
                        Text { text: "Clear"; color: #ffffffe8; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                        clear-touch := TouchArea { clicked => { root.clear-library-search(); } }
                    }
                    Rectangle { width: 86px; height: 34px; border-radius: 17px; background: #ffffff0b; HorizontalLayout { alignment: center; spacing: 5px; FluentGlyph { glyph: root.library-view-mode == "grid" ? "" : ""; width: 16px; color: #38ff66; font-size: 12px; } Text { text: root.library-view-mode == "grid" ? "Grid" : "List"; color: white; font-size: 9px; vertical-alignment: center; } } TouchArea { clicked => { root.library-view-mode = root.library-view-mode == "grid" ? "list" : "grid"; } } }
                    Rectangle { width: 118px; height: 34px; border-radius: 17px; background: #ffffff0b; Text { text: "Find duplicates"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("duplicate-video-search"); } } }
                }
                if root.library-items.length == 0 && !root.video-empty-dismissed: Rectangle { vertical-stretch: 1; border-radius: 24px; background: @radial-gradient(circle, #103139 0%, #061016 72%); border-width: 1px; border-color: #ffffff14; VerticalLayout { alignment: center; spacing: 12px; HorizontalLayout { height: 78px; alignment: center; Rectangle { width: 78px; height: 78px; border-radius: 24px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 31px; } } } Text { text: "Your video library is empty"; color: white; font-size: 24px; font-weight: 700; horizontal-alignment: center; } Text { text: "Choose the folders Zink should index. They remain on this PC and play through the native Windows media engine."; color: #8da29b; font-size: 10px; horizontal-alignment: center; wrap: word-wrap;  } HorizontalLayout { height: 44px; alignment: center; spacing: 10px; Rectangle { width: 150px; border-radius: 22px; background: #38ff66; Text { text: "Choose folder"; color: #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.import-library(); } } } Rectangle { width: 110px; border-radius: 22px; background: #ffffff0c; Text { text: "Not now"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.video-empty-dismissed = true; } } } } } }
                video-library-scroll := ZinkScrollView {
                    visible: root.library-items.length > 0 && root.library-view-mode == "grid";
                    vertical-stretch: 1; content-height: video-library-grid.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.always-on; horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    video-library-grid := GridLayout {
                        width: video-library-scroll.visible-width - 16px; padding: 14px; spacing: 14px;
                        for media[index] in root.library-items: Rectangle {
                            row: index / (root.width > 1600px ? 5 : root.width > 1250px ? 4 : 3);
                            col: Math.mod(index, root.width > 1600px ? 5 : root.width > 1250px ? 4 : 3);
                            height: media.media-kind == "video" ? 310px : 0px;
                            width: (parent.width - ((root.width > 1600px ? 4 : root.width > 1250px ? 3 : 2) * 14px)) / (root.width > 1600px ? 5 : root.width > 1250px ? 4 : 3);
                            visible: (root.current-route == "music-library" && media.media-kind == "audio") || (root.current-route == "video-library" && media.media-kind == "video");
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #78d9dd50;
                            background: #ffffff07;
                            VerticalLayout {
                                spacing: 7px;
                                Rectangle {
                                    height: 184px; border-radius: 12px; background: #20202090;
                                    Text { text: media.media-kind == "audio" ? "♫" : "▶"; color: #ffffff2b; font-size: 74px; horizontal-alignment: center; vertical-alignment: center; }
                                    Image { source: media.artwork; image-fit: cover; width: parent.width; height: parent.height; }
                                    VerticalLayout {
                                        padding: 18px; alignment: center; spacing: 5px;
                                        Text { text: media.title; color: white; font-size: 16px; font-weight: 650; horizontal-alignment: center; wrap: word-wrap; }
                                        Text { text: media.artist; color: #d6e2eab7; font-size: 12px; horizontal-alignment: center; overflow: elide; }
                                        Text { text: media.album; color: #d6e2ea83; font-size: 10px; horizontal-alignment: center; overflow: elide; }
                                    }
                                }
                                VerticalLayout {
                                    Text { text: media.title; color: white; font-size: 12px; overflow: elide; }
                                    HorizontalLayout { Text { text: media.artist; color: #d6e2eab7; font-size: 10px; overflow: elide; } Text { text: media.duration; color: #d6e2eab7; font-size: 10px; horizontal-alignment: right; } }
                                    Rectangle { height: 30px; border-radius: 15px; background: #38ff66; Text { text: "▶  Play in Zink"; color: #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } play-video-card-touch := TouchArea { clicked => { root.play-library-item(media.path); root.navigate("video-player"); } } }
                                    Rectangle { visible: root.current-route == "video-library"; height: self.visible ? 30px : 0px; border-radius: 15px; background: #ffffff0c; border-width: 1px; border-color: #ffffff20; Text { text: "ⓘ  Learn about this film"; color: #ffffffe8; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.film-query = media.title; root.film-info-poster = media.artwork; root.lookup-film-info(media.title); root.navigate("film-info"); } } }
                                }
                            }
                        }
                    }
                }
                if root.library-items.length > 0 && root.library-view-mode == "list": video-library-list-scroll := ZinkScrollView { vertical-stretch: 1; content-height: video-library-list.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.always-on; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; video-library-list := VerticalLayout { width: video-library-list-scroll.visible-width - 16px; spacing: 8px; for media[index] in root.library-items: Rectangle { visible: media.media-kind == "video"; height: self.visible ? 86px : 0px; border-radius: 16px; background: video-row-touch.has-hover ? #ffffff12 : Math.mod(index, 2) == 0 ? #ffffff08 : #ffffff04; border-width: 1px; border-color: #ffffff0e; HorizontalLayout { padding: 10px; spacing: 13px; Rectangle { width: 112px; height: 64px; border-radius: 11px; clip: true; background: #10262d; FluentGlyph { glyph: ""; color: #38ff6645; font-size: 24px; } Image { source: media.artwork; image-fit: cover; width: parent.width; height: parent.height; } } VerticalLayout { horizontal-stretch: 2; alignment: center; spacing: 3px; Text { text: media.title; color: white; font-size: 13px; font-weight: 700; overflow: elide; } Text { text: media.path; color: #82968f; font-size: 8px; overflow: elide; } } Text { text: media.duration == "" ? "Video" : media.duration; color: #9db0aa; font-size: 9px; width: 90px; vertical-alignment: center; } Rectangle { width: 102px; height: 36px; border-radius: 18px; background: #ffffff0c; Text { text: "Film info"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.film-query = media.title; root.film-info-poster = media.artwork; root.lookup-film-info(media.title); root.navigate("film-info"); } } } Rectangle { width: 82px; height: 36px; border-radius: 18px; background: #38ff66; Text { text: "Play"; color: #051109; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } } } video-row-touch := TouchArea { clicked => { root.play-library-item(media.path); root.navigate("video-player"); } } } } }
            }

            }

            if root.current-route != "video-player": Rectangle {
                visible: !root.app-fullscreen && root.current-route != "music-player" && (root.current-music-path != "" || root.current-route == "radio");
                height: self.visible ? 82px : 0px; border-radius: 14px; background: #001219e0; border-color: #5ae8e035; border-width: 1px;
                VerticalLayout {
                    padding: 10px; spacing: 8px;
                    HorizontalLayout {
                        height: 14px; spacing: 8px;
                        Text { text: root.position-text; width: 42px; color: #8fa49e; font-size: 10px; vertical-alignment: center; }
                        progress-track := Rectangle {
                            height: 5px; horizontal-stretch: 1; border-radius: 3px; background: #ffffff35;
                            Rectangle { width: parent.width * root.position-ratio; height: parent.height; border-radius: 3px; background: #38ff66; }
                            progress-touch := TouchArea { clicked => { root.seek(progress-touch.mouse-x / progress-track.width); } }
                        }
                        Text { text: root.duration-text; width: 42px; color: #8fa49e; font-size: 10px; vertical-alignment: center; horizontal-alignment: right; }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 44px; height: 44px; border-radius: 8px; background: #38ff6626; clip: true;
                            Image { source: root.album-art; image-fit: cover; width: parent.width; height: parent.height; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text { text: root.track-title; color: white; font-size: 14px; font-weight: 650; }
                            Text { text: root.playback-error == "" ? root.track-detail : root.playback-error; color: root.playback-error == "" ? #8fa49e : #ff8a8a; font-size: 12px; overflow: elide; }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        FluentGlyph { glyph: root.current-track-liked ? "" : ""; color: root.current-track-liked ? #38ff66 : white; font-size: 16px; width: 28px; TouchArea { clicked => { root.current-track-liked = !root.current-track-liked; root.set-track-liked(root.current-track-liked); } } }
                        FluentGlyph { glyph: ""; font-size: 17px; width: 28px; TouchArea { clicked => { root.previous-music(); } } }
                        Rectangle { width: 36px; height: 36px; border-radius: 18px; background: #f4fff8; FluentGlyph { glyph: root.is-playing ? "" : ""; color: #06110a; font-size: 16px; } TouchArea { clicked => { root.toggle-playback(); } } }
                        FluentGlyph { glyph: ""; font-size: 17px; width: 28px; TouchArea { clicked => { root.next-music(); } } }
                        FluentGlyph { glyph: ""; font-size: 16px; width: 28px; TouchArea { clicked => { root.artist-panel-open = true; root.request-artist-info(root.track-detail); root.music-fullscreen = true; root.set-app-fullscreen(true); } } }
                        Rectangle {
                            width: 30px; height: 30px; border-radius: 8px; background: #ffffff18;
                            Text { text: "−"; color: white; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.change-volume(-0.1); } }
                        }
                        Text { text: root.volume-percent + "%"; color: #aebfba; font-size: 12px; vertical-alignment: center; horizontal-alignment: center; width: 42px; }
                        Rectangle {
                            width: 30px; height: 30px; border-radius: 8px; background: #ffffff18;
                            Text { text: "+"; color: white; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.change-volume(0.1); } }
                        }
                        Rectangle {
                            width: 92px; height: 38px; border-radius: 9px; background: #ffffff20; border-color: #ffffff40; border-width: 1px;
                            Text { text: "Open media"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.open-media(); } }
                        }
                        Rectangle {
                            width: 30px; height: 30px; border-radius: 8px; background: #ffffff18;
                            Text { text: "■"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.stop-playback(); } }
                        }
                    }
                }
            }
        }
    }

    if root.music-fullscreen: Rectangle {
        width: parent.width; height: parent.height; background: #071113;
        Image { source: root.album-art; image-fit: cover; width: parent.width; height: parent.height; opacity: 0.16; }
        Rectangle { width: parent.width; height: parent.height; background: @linear-gradient(180deg, #07101670 0%, #071113f0 58%, #071113ff 100%); }
        fullscreen-scroll := Flickable {
            width: parent.width; height: parent.height - 104px; content-height: fullscreen-content.preferred-height;
            fullscreen-content := VerticalLayout {
                width: fullscreen-scroll.width; spacing: 24px; padding-left: 72px; padding-right: 72px; padding-top: 34px; padding-bottom: 56px;
                HorizontalLayout { height: 50px; VerticalLayout { Text { text: "ZINK MUSIC"; color: #38ff66; font-size: 11px; font-weight: 750; } Text { text: "Now Playing"; color: white; font-size: 24px; font-weight: 700; } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "Scroll to explore the artist, releases, lyrics and queue"; color: #9db0aa; font-size: 11px; vertical-alignment: center; } }
                Rectangle {
                    height: 650px; border-radius: 28px; background: #06171db8; border-width: 1px; border-color: #ffffff18;
                    HorizontalLayout { padding: 42px; spacing: 64px; alignment: center;
                        Rectangle { width: 510px; height: 510px; border-radius: 24px; background: #001016e8; clip: true; Image { source: root.album-art; image-fit: cover; width: parent.width; height: parent.height; } }
                        VerticalLayout { horizontal-stretch: 1; spacing: 15px; alignment: center; Text { text: root.track-title; color: white; font-size: 43px; font-weight: 750; horizontal-alignment: center; overflow: elide; } Text { text: root.track-detail; color: #38ff66; font-size: 22px; horizontal-alignment: center; } Text { text: root.track-album; color: #aebfba; font-size: 14px; horizontal-alignment: center; } HorizontalLayout { height: 44px; alignment: center; spacing: 12px; Rectangle { width: 126px; border-radius: 22px; background: root.current-track-liked ? #38ff66 : #ffffff12; border-width: 1px; border-color: root.current-track-liked ? #38ff66 : #ffffff35; HorizontalLayout { alignment: center; spacing: 8px; FluentGlyph { glyph: root.current-track-liked ? "" : ""; color: root.current-track-liked ? #06110a : white; font-size: 16px; } Text { text: root.current-track-liked ? "Liked" : "Like song"; color: root.current-track-liked ? #06110a : white; font-size: 11px; vertical-alignment: center; } } TouchArea { clicked => { root.current-track-liked = !root.current-track-liked; root.set-track-liked(root.current-track-liked); } } } Rectangle { width: 126px; border-radius: 22px; background: #ffffff12; border-width: 1px; border-color: #ffffff35; Text { text: "Open queue"; color: white; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.queue-panel-open = true; } } } } Text { text: root.lyrics-status; color: #82958f; font-size: 10px; horizontal-alignment: center; } }
                    }
                }
                HorizontalLayout {
                    height: 330px; spacing: 20px;
                    Rectangle { horizontal-stretch: 3; border-radius: 22px; background: #101b1de8; border-width: 1px; border-color: #ffffff18; VerticalLayout { padding: 22px; spacing: 10px; Text { text: "About the artist"; color: white; font-size: 24px; font-weight: 700; } Text { text: root.artist-info-name == "" ? root.track-detail : root.artist-info-name; color: #38ff66; font-size: 21px; font-weight: 650; } Text { text: root.artist-info-summary; color: #e1ece8; font-size: 13px; wrap: word-wrap; } Text { text: root.artist-info-status; color: #9db0aa; font-size: 11px; wrap: word-wrap; } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: "Artist metadata supplied by MusicBrainz"; color: #71857f; font-size: 9px; } } }
                    VerticalLayout { horizontal-stretch: 3; spacing: 20px;
                        Rectangle { vertical-stretch: 2; border-radius: 22px; background: #171d1ee8; VerticalLayout { padding: 20px; spacing: 7px; Text { text: "Credits"; color: white; font-size: 22px; font-weight: 700; } Text { text: root.track-detail; color: white; font-size: 14px; font-weight: 650; } Text { text: "Primary artist"; color: #9db0aa; font-size: 11px; } Text { text: root.track-album == "Unknown Album" ? "Additional credits are not present in this file." : root.track-album; color: #dce9e5; font-size: 12px; wrap: word-wrap; } } }
                        Rectangle { vertical-stretch: 1; border-radius: 22px; background: #171d1ee8; HorizontalLayout { padding: 18px; VerticalLayout { Text { text: "Next in queue"; color: white; font-size: 20px; font-weight: 700; } Text { text: root.music-current-index + 2 < root.music-queue.length ? root.music-queue[root.music-current-index + 1].title : "End of queue"; color: #dce9e5; font-size: 13px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.music-current-index + 2 < root.music-queue.length ? root.music-queue[root.music-current-index + 1].artist : ""; color: #38ff66; font-size: 11px; vertical-alignment: center; } } }
                    }
                }
                Rectangle { height: 126px; border-radius: 22px; background: #101b1de8; HorizontalLayout { padding: 20px; spacing: 24px; VerticalLayout { width: 250px; Text { text: "Your listening"; color: white; font-size: 22px; font-weight: 700; } Text { text: root.listening-time-summary; color: #38ff66; font-size: 15px; } Text { text: root.listening-plays-summary + " • " + root.listening-tracks-summary; color: #9db0aa; font-size: 10px; } } Rectangle { width: 1px; background: #ffffff18; } fullscreen-top-strip := ZinkScrollView { horizontal-stretch: 1; content-width: fullscreen-top-row.preferred-width; horizontal-scrollbar-policy: ScrollBarPolicy.always-on; vertical-scrollbar-policy: ScrollBarPolicy.always-off; fullscreen-top-row := HorizontalLayout { height: fullscreen-top-strip.visible-height - 14px; spacing: 8px; for track in root.top-tracks: Rectangle { width: 180px; border-radius: 11px; background: fullscreen-stat-touch.has-hover ? #38ff6618 : #ffffff08; VerticalLayout { padding: 10px; spacing: 3px; Text { text: track.title; color: white; font-size: 11px; font-weight: 650; overflow: elide; } Text { text: track.artist; color: #9db0aa; font-size: 9px; overflow: elide; } Text { text: track.detail; color: #38ff66; font-size: 8px; } } fullscreen-stat-touch := TouchArea { clicked => { root.play-library-item(track.path); } } } } } } }
                Text { text: "Latest releases"; color: white; font-size: 27px; font-weight: 700; }
                release-shelf := ZinkScrollView { height: 282px; content-width: release-cards.preferred-width; horizontal-scrollbar-policy: ScrollBarPolicy.always-on; vertical-scrollbar-policy: ScrollBarPolicy.always-off; release-cards := HorizontalLayout { height: release-shelf.visible-height - 20px; spacing: 14px; for release in root.artist-releases: Rectangle { width: 220px; height: 232px; border-radius: 16px; background: shelf-touch.has-hover ? #ffffff18 : #ffffff0b; VerticalLayout { padding: 14px; spacing: 8px; Rectangle { width: 150px; height: 150px; border-radius: 14px; background: @linear-gradient(135deg, #11d8e840 0%, #38ff6638 100%); clip: true; FluentGlyph { glyph: release.release-type == "Single" ? "" : ""; color: #38ff66; font-size: 34px; } Image { source: release.artwork; image-fit: cover; width: parent.width; height: parent.height; } } Text { text: release.title; color: white; font-size: 13px; font-weight: 650; overflow: elide; } Text { text: release.release-type + " • " + release.release-date; color: #9db0aa; font-size: 10px; overflow: elide; } } shelf-touch := TouchArea { clicked => { root.open-artist-release(release.id, release.title); } } } } }
                HorizontalLayout { height: 300px; spacing: 20px;
                    Rectangle { horizontal-stretch: 3; border-radius: 22px; background: #101b1de8; VerticalLayout { padding: 22px; spacing: 10px; Text { text: "Lyrics"; color: white; font-size: 24px; font-weight: 700; } Text { text: root.lyrics-status + " • Select a line to seek"; color: #9db0aa; font-size: 11px; } lyric-preview := ListView { vertical-stretch: 1; for lyric[index] in root.lyric-lines: Rectangle { height: 38px; border-radius: 8px; background: index == root.active-lyric-index ? #38ff6622 : lyric-touch.has-hover ? #ffffff0d : transparent; Text { text: lyric.text; color: index == root.active-lyric-index ? #38ff66 : #dce9e5; font-size: index == root.active-lyric-index ? 14px : 13px; font-weight: index == root.active-lyric-index ? 650 : 400; vertical-alignment: center; x: 8px; width: parent.width - 16px; overflow: elide; } lyric-touch := TouchArea { clicked => { root.seek-to-lyric(lyric.start-ms); } } } } } }
                    Rectangle { horizontal-stretch: 2; border-radius: 22px; background: #101b1de8; VerticalLayout { padding: 22px; spacing: 12px; Text { text: "Playback"; color: white; font-size: 24px; font-weight: 700; } Text { text: "Local Windows media playback"; color: #38ff66; font-size: 13px; } Text { text: root.current-music-path; color: #9db0aa; font-size: 10px; wrap: word-wrap; } Text { text: "Background playback   " + (root.music-background ? "On" : "Off"); color: #dce9e5; font-size: 12px; } Rectangle { height: 40px; border-radius: 20px; background: root.music-background ? #38ff6630 : #ffffff10; Text { text: root.music-background ? "Disable background playback" : "Enable background playback"; color: white; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.music-background = !root.music-background; root.set-music-background(root.music-background); } } } } }
                }
            }
        }
        if root.queue-panel-open: Rectangle {
            x: parent.width - 430px; y: 18px; width: 412px; height: parent.height - 140px; border-radius: 22px;
            background: #101719fa; border-width: 1px; border-color: #ffffff2e;
            VerticalLayout { padding: 18px; spacing: 12px;
                HorizontalLayout { height: 40px; Text { text: "Queue"; color: white; font-size: 25px; font-weight: 700; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 36px; height: 36px; border-radius: 18px; background: queue-close.has-hover ? #ffffff20 : #ffffff0d; FluentGlyph { glyph: ""; font-size: 14px; } queue-close := TouchArea { clicked => { root.queue-panel-open = false; } } } }
                Text { text: root.music-queue.length + " tracks • Select any track to play"; color: #9db0aa; font-size: 11px; }
                AccessibleQueueList {
                    vertical-stretch: 1;
                    tracks: root.music-queue;
                    current-index: root.music-current-index;
                    is-playing: root.is-playing;
                    play(index) => { root.play-music-index(index); }
                    remove(index) => { root.remove-queue-item(index); }
                    move-item(from, to) => { root.move-queue-item(from, to); }
                }
            }
        }
        Rectangle {
            y: parent.height - 104px; width: parent.width; height: 104px; background: #030708f8; border-width: 1px; border-color: #ffffff18;
            HorizontalLayout { padding: 12px; spacing: 20px;
                Rectangle { width: 64px; height: 64px; border-radius: 9px; clip: true; Image { source: root.album-art; image-fit: cover; width: parent.width; height: parent.height; } }
                VerticalLayout { width: 245px; alignment: center; Text { text: root.track-title; color: white; font-size: 13px; font-weight: 650; overflow: elide; } Text { text: root.track-detail; color: #38ff66; font-size: 11px; overflow: elide; } }
                VerticalLayout { horizontal-stretch: 1; spacing: 5px; HorizontalLayout { height: 42px; spacing: 16px; alignment: center; AccessiblePlayerButton { width: 34px; height: 34px; glyph: ""; label: root.music-shuffle ? "Disable shuffle" : "Enable shuffle"; glyph-size: 17px; glyph-color: root.music-shuffle ? #38ff66 : #dce9e5; activated => { root.music-shuffle = !root.music-shuffle; root.set-music-shuffle(root.music-shuffle); } } AccessiblePlayerButton { width: 34px; height: 34px; glyph: ""; label: "Previous track"; glyph-size: 19px; activated => { root.previous-music(); } } AccessiblePlayerButton { width: 42px; height: 42px; glyph: root.is-playing ? "" : ""; label: root.is-playing ? "Pause" : "Play"; glyph-size: 18px; glyph-color: #06110a; normal-background: #f4fff8; hover-background: white; activated => { root.toggle-playback(); } } AccessiblePlayerButton { width: 34px; height: 34px; glyph: ""; label: "Next track"; glyph-size: 19px; activated => { root.next-music(); } } AccessiblePlayerButton { width: 34px; height: 34px; glyph: ""; label: root.music-repeat ? "Disable repeat" : "Repeat current track"; glyph-size: 17px; glyph-color: root.music-repeat ? #38ff66 : #dce9e5; activated => { root.music-repeat = !root.music-repeat; root.set-music-repeat(root.music-repeat); } } } HorizontalLayout { height: 18px; spacing: 8px; Text { text: root.position-text; color: #aebfba; font-size: 9px; width: 40px; } AccessiblePlayerSlider { horizontal-stretch: 1; height: 12px; value: root.position-ratio; label: "Playback position"; keyboard-step: 0.025; changed(value) => { root.seek(value); } } Text { text: root.duration-text; color: #aebfba; font-size: 9px; width: 40px; horizontal-alignment: right; } } }
                HorizontalLayout { width: 325px; spacing: 10px; AccessiblePlayerButton { width: 34px; height: 34px; glyph: root.current-track-liked ? "" : ""; label: root.current-track-liked ? "Remove from liked songs" : "Like song"; glyph-size: 17px; glyph-color: root.current-track-liked ? #38ff66 : white; activated => { root.current-track-liked = !root.current-track-liked; root.set-track-liked(root.current-track-liked); } } AccessiblePlayerButton { width: 34px; height: 34px; glyph: ""; label: root.queue-panel-open ? "Close queue" : "Open queue"; glyph-size: 17px; glyph-color: root.queue-panel-open ? #38ff66 : white; activated => { root.queue-panel-open = !root.queue-panel-open; } } FluentGlyph { glyph: root.volume-percent == 0 ? "" : ""; font-size: 17px; } AccessiblePlayerSlider { horizontal-stretch: 1; height: 16px; value: root.volume-percent / 100; label: "Volume"; keyboard-step: 0.05; changed(value) => { root.set-volume(value); } } Text { text: root.volume-percent + "%"; color: #aebfba; font-size: 10px; width: 34px; vertical-alignment: center; } AccessiblePlayerButton { width: 36px; height: 36px; glyph: ""; label: "Exit full screen"; glyph-size: 15px; normal-background: #ffffff0d; hover-background: #ffffff20; activated => { root.queue-panel-open = false; root.artist-panel-open = false; root.music-fullscreen = false; root.set-app-fullscreen(false); } } }
            }
        }
    }

    // Keyboard controls remain available whenever an editor or search field has
    // not explicitly taken focus. This gives the native player the same fast,
    // predictable controls in its normal and full-screen presentations.
    if root.call-incoming || (root.notifications-social && root.friend-request-alert != ""): Rectangle {
        x: parent.width - self.width - 24px;
        y: 24px;
        width: Math.min(420px, parent.width - 48px);
        height: 128px;
        border-radius: 14px;
        background: #0c2028;
        border-width: 1px;
        border-color: #38ff6690;
        TouchArea {}
        VerticalLayout {
            padding: 14px;
            spacing: 8px;
            Text {
                text: root.call-incoming ? "Incoming Zink call" : "New friend request";
                color: white;
                font-size: 16px;
                font-weight: 700;
            }
            Text {
                text: root.call-incoming ? root.call-incoming-name : root.friend-request-alert;
                color: #d6e2ea;
                overflow: elide;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button {
                    text: root.call-incoming ? "Decline" : "Dismiss";
                    clicked => {
                        if root.call-incoming {
                            root.social-answer-call(false);
                        } else {
                            root.friend-request-alert = "";
                        }
                    }
                }
                Button {
                    text: root.call-incoming ? "Accept call" : "View requests";
                    clicked => {
                        if root.call-incoming {
                            root.social-answer-call(true);
                        } else {
                            root.friend-request-alert = "";
                            if root.music-fullscreen {
                                root.music-fullscreen = false;
                                root.set-app-fullscreen(false);
                            }
                            root.navigate("friend-requests");
                        }
                    }
                }
            }
        }
    }

    if root.call-share-fullscreen: Rectangle {
        width: parent.width;
        height: parent.height;
        background: black;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.call-remote-image;
            image-fit: contain;
        }
        TouchArea {
            width: parent.width;
            height: parent.height;
            moved => { root.reveal-call-share-exit(); }
        }
        if root.call-share-exit-visible: Rectangle {
            x: parent.width - self.width - 12px;
            y: 12px;
            width: 150px;
            height: 40px;
            border-radius: 12px;
            background: exit-share.has-hover ? #273c46 : #16232aee;
            accessible-role: button;
            accessible-label: "Exit fullscreen";
            accessible-action-default => { root.set-call-share-fullscreen(false); }
            Text {
                width: parent.width;
                height: parent.height;
                text: "Exit fullscreen";
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            exit-share := TouchArea {
                moved => { root.reveal-call-share-exit(); }
                clicked => { root.set-call-share-fullscreen(false); }
            }
        }
    }

    player-shortcuts := FocusScope {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if root.call-share-fullscreen {
                if event.text == Key.Escape || event.text == Key.F11 {
                    root.set-call-share-fullscreen(false);
                }
                return accept;
            }
            if event.text == Key.F11 && root.current-route == "call" && root.call-remote-visible {
                root.set-call-share-fullscreen(true);
                return accept;
            }
            if ((event.text == "k" || event.text == "K") && event.modifiers.control) {
                root.home-command-open = true;
                return accept;
            }
            if (event.text == Key.Space) {
                root.toggle-playback();
                return accept;
            }
            if (event.text == Key.LeftArrow && event.modifiers.control) {
                root.previous-music();
                return accept;
            }
            if (event.text == Key.RightArrow && event.modifiers.control) {
                root.next-music();
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.seek-relative(-10);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.seek-relative(10);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.change-volume(0.05);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.change-volume(-0.05);
                return accept;
            }
            if (event.text == "f" || event.text == "F") {
                root.artist-panel-open = true;
                root.request-artist-info(root.track-detail);
                root.music-fullscreen = true;
                root.set-app-fullscreen(true);
                return accept;
            }
            if (event.text == "q" || event.text == "Q") {
                root.queue-panel-open = !root.queue-panel-open;
                return accept;
            }
            if (event.text == "s" || event.text == "S") {
                root.music-shuffle = !root.music-shuffle;
                root.set-music-shuffle(root.music-shuffle);
                return accept;
            }
            if (event.text == "r" || event.text == "R") {
                root.music-repeat = !root.music-repeat;
                root.set-music-repeat(root.music-repeat);
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.home-command-open) {
                    root.home-command-open = false;
                    root.home-command-query = "";
                } else if (root.home-edit-open) {
                    root.home-edit-open = false;
                } else if (root.queue-panel-open) {
                    root.queue-panel-open = false;
                } else if (root.more-menu-open) {
                    root.more-menu-open = false;
                } else if (root.music-fullscreen) {
                    root.artist-panel-open = false;
                    root.music-fullscreen = false;
                    root.set-app-fullscreen(false);
                }
                return accept;
            }
            return reject;
        }
    }
}

export component AreaSelectionWindow inherits Window {
    in property <image> desktop-preview;
    callback completed(float, float, float, float);
    callback canceled();
    private property <length> start-x: 0px;
    private property <length> start-y: 0px;
    private property <length> current-x: 0px;
    private property <length> current-y: 0px;
    private property <bool> selecting: false;
    title: "Zink Area Screenshot";
    background: black;

    Image { source: root.desktop-preview; width: parent.width; height: parent.height; image-fit: fill; }
    Rectangle { width: parent.width; height: parent.height; background: #00000078; }
    selection := Rectangle {
        visible: root.selecting;
        x: Math.min(root.start-x, root.current-x);
        y: Math.min(root.start-y, root.current-y);
        width: Math.abs(root.current-x - root.start-x);
        height: Math.abs(root.current-y - root.start-y);
        background: #38ff6614;
        border-width: 2px;
        border-color: #38ff66;
    }
    Rectangle {
        x: (parent.width - 430px) / 2;
        y: 34px;
        width: 430px;
        height: 54px;
        border-radius: 18px;
        background: #06161cee;
        border-width: 1px;
        border-color: #38ff6660;
        Text {
            text: root.selecting ? "Drag to select  •  " + Math.round(selection.width / 1px) + " × " + Math.round(selection.height / 1px) : "Drag to select an area  •  Esc to cancel";
            color: white;
            font-size: 13px;
            font-weight: 650;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    select-touch := TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                key-handler.focus();
                root.start-x = self.mouse-x;
                root.start-y = self.mouse-y;
                root.current-x = self.mouse-x;
                root.current-y = self.mouse-y;
                root.selecting = true;
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.selecting) {
                root.current-x = self.mouse-x;
                root.current-y = self.mouse-y;
                if (selection.width >= 8px && selection.height >= 8px) {
                    root.completed(selection.x / root.width, selection.y / root.height, selection.width / root.width, selection.height / root.height);
                } else {
                    root.canceled();
                }
                root.selecting = false;
            }
        }
        moved => {
            if (self.pressed && root.selecting) {
                root.current-x = Math.max(0px, Math.min(root.width, self.mouse-x));
                root.current-y = Math.max(0px, Math.min(root.height, self.mouse-y));
            }
        }
    }
    key-handler := FocusScope {
        width: 1px;
        height: 1px;
        key-pressed(event) => {
            if (event.text == "\u{1b}") {
                root.canceled();
                return accept;
            }
            return reject;
        }
    }
}

