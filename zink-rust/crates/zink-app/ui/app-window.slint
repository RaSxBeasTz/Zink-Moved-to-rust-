    callback clear-notifications();
    callback configure-stream-destination(string, string, string);
    callback stop-stream();
    callback save-twitch-streaming-settings(string, string, string);
    callback refresh-twitch-telemetry();
    callback disconnect-twitch-streaming();
    callback open-external-link(string);
    callback submit-feedback(string, string, string);
    callback select-version(string);
    callback update-setting(string, bool);
    callback select-language(string);
    callback filter-settings-languages(string);
    callback move-files(int);
    callback refresh-torrent-mover();
    callback toggle-torrent-move-selection(string);
    callback open-log-folder();
    callback clear-log();
    callback run-health-check();
    callback open-health-report();
    callback send-health-report();
    callback reset-settings();
    callback check-app-updates();
    callback spotify-start-login();
    callback spotify-finish-login(string);
    callback spotify-refresh();
    callback spotify-disconnect();
    callback spotify-play-pause();
    callback spotify-previous();
    callback spotify-next();
    callback spotify-play-track(string);
    callback spotify-save-track(string);
    callback spotify-select-device(string);
    callback spotify-search(string);
    callback open-spotify-widget();
    callback hide-spotify-widget();
    callback open-radio-widget();
    callback hide-radio-widget();
    callback set-app-fullscreen(bool);
    callback browse-music-files();
    callback restore-last-music-session();
    callback play-music-index(int);
    callback previous-music();
    callback next-music();
    callback set-music-shuffle(bool);
    callback set-music-repeat(bool);
    callback set-music-background(bool);
    callback set-volume(float);
    callback request-artist-info(string);
    callback open-artist-release(string, string);
    callback set-track-liked(bool);
    callback remove-queue-item(int);
    callback move-queue-item(int, int);
    callback clear-music-queue();
    callback save-music-queue();
    callback open-current-file-location();
    callback set-sleep-timer(int);
    callback load-music-playlist(string);
    callback set-playback-rate(float);
    callback set-crossfade-seconds(int);
    callback refresh-audio-devices();
    callback select-audio-device(string, string);
    callback select-video-audio-track(int);
    callback set-normalization(bool, int);
    callback set-equalizer-enabled(bool);
    callback set-equalizer-master-gain(float);
    callback set-equalizer-band(int, float);
    callback apply-equalizer-preset(string);
    callback reset-equalizer();
    callback save-equalizer();
    callback set-visualizer-style(string);
    callback set-visualizer-color(string);
    callback set-visualizer-sensitivity(int);
    callback set-visualizer-smoothing(int);
    callback set-visualizer-paused(bool);
    callback reset-visualizer();
    callback save-visualizer();
    callback previous-radio-station();
    callback next-radio-station();
    callback toggle-radio-like();
    callback remove-radio-like(string);
    callback remove-liked-radio-song(string);
    callback add-liked-radio-song-to-spotify(string);
    callback open-liked-radio-song-in-spotify(string);
    callback open-liked-radio-song-in-youtube(string);
    callback save-current-radio-song();
    callback add-radio-station(string, string, string);
    callback remove-radio-station(string);
    callback scan-duplicate-videos();
    callback play-duplicate-video(string);
    callback open-duplicate-location(string);
    callback delete-duplicate-video(string);
    callback delete-all-duplicate-videos();
    callback lookup-film-info(string);
    callback play-online-video(string);
    callback play-resolved-online-video(string, string);
    callback sign-in-onedrive();
    callback refresh-fps-processes();
    callback select-fps-process(int, string);
    callback stop-fps-monitor();
    callback toggle-fps-recording();
    callback save-fps-settings();
    callback open-fps-widget();
    callback hide-fps-widget();
    callback open-rtss-download();
    callback set-home-space(string);
    callback toggle-home-section(string);
    callback toggle-home-pin(string);
    callback execute-home-command(string);

    Image {
        source: @image-url("../../../../Assets/ZinkGeneratedThemeBackground.png");
        image-fit: cover;
        width: parent.width;
        height: parent.height;
        opacity: 0.72;
    }
    Rectangle { width: parent.width; height: parent.height; background: #00080db8; }
    Rectangle { width: parent.width; height: parent.height; background: root.ui-accent-color; opacity: root.ui-theme-choice == "Light" ? 0.08 : 0.035; }
    if root.music-fullscreen: Rectangle {
        width: parent.width; height: parent.height;
        background: @linear-gradient(135deg, #04191ff8 0%, #082d35f8 48%, #07131afc 100%);
        Image { source: root.album-art; image-fit: cover; width: parent.width; height: parent.height; opacity: 0.11; }
        Rectangle { width: parent.width; height: parent.height; background: @linear-gradient(90deg, #001016e8 0%, #001016a8 55%, #001016e8 100%); }
    }

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        visible: !root.call-share-fullscreen;
        spacing: 0px;
        Rectangle {
            width: root.app-fullscreen ? 0px : 270px;
            visible: !root.app-fullscreen;
            background: #001016f0;
            border-width: 1px;
            border-color: #ffffff18;
            border-radius: 0px;
            VerticalLayout {
                padding: 12px;
                spacing: 1px;
                Rectangle { height: 72px; background: transparent; HorizontalLayout { padding-left: 14px; padding-right: 10px; spacing: 12px; Rectangle { width: 40px; height: 40px; border-radius: 13px; background: @linear-gradient(135deg, #11d8e840 0%, #38ff6630 100%); FluentGlyph { glyph: ""; color: #38ff66; font-size: 19px; } } VerticalLayout { alignment: center; Text { text: "Zink"; color: white; font-size: 18px; font-weight: 750; } Text { text: "Music & entertainment"; color: #71857f; font-size: 9px; } } } }
                nav-scroll := ZinkScrollView {
                    vertical-stretch: 1;
                    content-height: Math.max(nav-content.preferred-height, root.nav-items.length * 44px + 520px);
                    vertical-scrollbar-policy: ScrollBarPolicy.always-on;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    nav-content := VerticalLayout {
                        width: nav-scroll.visible-width - 10px;
                        spacing: 1px;
                        for item[index] in root.nav-items: VerticalLayout {
                            spacing: 1px;
                            if index == 0 || root.nav-items[index - 1].group != item.group: Text { height: 28px; text: item.group; color: #71857f; font-size: 9px; font-weight: 700; vertical-alignment: center; x: 14px; }
                            NavButton { label: item.title; route-id: item.id; selected: root.current-route == item.id; accent: root.ui-accent-color; activated(route) => { root.navigate(route); } }
                        }
                    }
                }
                Text { text: "Zink"; color: #d6e2eab7; font-size: 12px; }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            padding-left: root.app-fullscreen || root.current-route == "call" ? 0px : 40px;
            padding-right: root.app-fullscreen || root.current-route == "call" ? 0px : 40px;
            padding-top: root.app-fullscreen || root.current-route == "call" ? 0px : 20px;
            padding-bottom: root.app-fullscreen || root.current-route == "call" ? 0px : 12px;
            spacing: root.app-fullscreen ? 0px : 16px;
            HorizontalLayout {
                height: 0px;
                visible: false;
                Rectangle {
                    width: 180px; height: 42px; border-radius: 12px;
                    background: @linear-gradient(135deg, #0634408f 0%, #07505a70 55%, #11d8e850 100%);
                    border-width: 1px; border-color: #78d9dd70;
                    Text { text: root.page-title; color: white; font-size: 14px; font-weight: 650; vertical-alignment: center; x: 14px; }
                    Rectangle { x: 14px; y: 37px; width: 42px; height: 3px; border-radius: 2px; background: #38ff66; }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Rectangle {
                    width: 104px; height: 38px; border-radius: 19px;
                    background: #38ff6624; border-color: #38ff6666; border-width: 1px;
                    Text { text: "Now playing"; color: #dffff0; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }

            // Every route is layered inside one fixed surface. Keeping route components as
            // direct VerticalLayout children allowed their preferred content size to shrink
            // the page to half of the available workspace.
            page-surface := Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: transparent;

            if root.current-route == "home": revamped-home := Rectangle {
                background: #061217e8;
                border-radius: 22px;
                clip: true;
                Image { source: root.album-art; image-fit: cover; width: parent.width; height: parent.height; opacity: root.track-title == "Nothing playing" ? 0.025 : 0.10; }
                Rectangle { width: parent.width; height: parent.height; background: @linear-gradient(180deg, #061217a8 0%, #061217f8 48%, #061217ff 100%); }
                revamped-home-scroll := ZinkScrollView {
                    width: parent.width; height: parent.height;
                    content-height: revamped-home-content.preferred-height;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-on;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    revamped-home-content := VerticalLayout {
                        width: revamped-home-scroll.visible-width - 14px;
                        padding: 28px;
                        spacing: 22px;
                        HorizontalLayout {
                            height: 54px;
                            VerticalLayout { spacing: 1px; Text { text: "ZINK HOME"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: root.home-greeting; color: white; font-size: 27px; font-weight: 750; } Text { text: root.home-day-mode; color: #839992; font-size: 9px; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Rectangle { width: 148px; border-radius: 22px; background: command-touch.has-hover ? #ffffff20 : #ffffff0c; border-width: 1px; border-color: #ffffff26; HorizontalLayout { alignment: center; spacing: 8px; FluentGlyph { glyph: ""; width: 18px; font-size: 15px; } Text { text: "Command  Ctrl+K"; color: white; font-size: 10px; vertical-alignment: center; } } command-touch := TouchArea { clicked => { root.home-command-open = true; } } }
                            Rectangle { width: 92px; border-radius: 22px; background: edit-home-touch.has-hover || root.home-edit-open ? #38ff6622 : #ffffff0c; border-width: 1px; border-color: root.home-edit-open ? #38ff6660 : #ffffff26; Text { text: "Edit Home"; color: root.home-edit-open ? #38ff66 : white; font-size: 10px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } edit-home-touch := TouchArea { clicked => { root.home-edit-open = !root.home-edit-open; } } }
                            Rectangle { width: 126px; border-radius: 22px; background: add-home-touch.has-hover ? #62ff82 : #38ff66; HorizontalLayout { alignment: center; spacing: 7px; FluentGlyph { glyph: ""; color: #06120a; width: 17px; font-size: 14px; } Text { text: "Add music"; color: #06120a; font-size: 11px; font-weight: 700; vertical-alignment: center; } } add-home-touch := TouchArea { clicked => { root.browse-music-files(); } } }
                        }
                        Rectangle {
                            height: root.width < 1500px ? 340px : 410px; border-radius: 28px; background: #07191fe8; clip: true; border-width: 1px; border-color: #ffffff16;
                            Image { source: root.album-art; image-fit: cover; width: parent.width; height: parent.height; opacity: root.track-title == "Nothing playing" ? 0.0 : 0.19; }
                            Rectangle { width: parent.width; height: parent.height; background: @linear-gradient(90deg, #061217fb 0%, #061217dc 52%, #06121782 100%); }
                            HorizontalLayout { padding: 28px; spacing: 34px;
                                VerticalLayout { horizontal-stretch: 1; spacing: 13px; alignment: center;
                                    Text { text: root.track-title == "Nothing playing" ? "Your music, ready when you are" : "CONTINUE LISTENING"; color: root.track-title == "Nothing playing" ? white : #38ff66; font-size: root.track-title == "Nothing playing" ? 29px : 10px; font-weight: 750; wrap: word-wrap; }
                                    if root.track-title != "Nothing playing": Text { text: root.track-title; color: white; font-size: 34px; font-weight: 750; wrap: word-wrap; max-height: 92px; overflow: elide; }
                                    Text { text: root.track-title == "Nothing playing" ? "Open your library or choose music from this PC to begin." : root.track-detail; color: root.track-title == "Nothing playing" ? #9db0aa : #d5e3df; font-size: 14px; overflow: elide; }
                                    if root.track-title != "Nothing playing": Text { text: root.track-album; color: #839992; font-size: 11px; overflow: elide; }
                                    Rectangle { height: 8px; background: transparent; }
                                    HorizontalLayout { height: 48px; spacing: 10px;
                                        Rectangle { width: 140px; border-radius: 24px; background: hero-play-touch.has-hover ? #62ff82 : #38ff66; HorizontalLayout { alignment: center; spacing: 8px; FluentGlyph { glyph: root.is-playing ? "" : ""; color: #06120a; width: 20px; font-size: 18px; } Text { text: root.track-title == "Nothing playing" ? "Choose music" : root.is-playing ? "Pause" : "Play"; color: #06120a; font-size: 12px; font-weight: 700; vertical-alignment: center; } } hero-play-touch := TouchArea { clicked => { if root.track-title == "Nothing playing" { root.browse-music-files(); } else { root.toggle-playback(); } } } }
                                        Rectangle { width: 142px; border-radius: 24px; background: hero-player-touch.has-hover ? #ffffff20 : #ffffff0d; border-width: 1px; border-color: #ffffff2c; Text { text: "Open player"; color: white; font-size: 12px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } hero-player-touch := TouchArea { clicked => { root.navigate("music-player"); } } }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                    if root.track-title != "Nothing playing": AccessiblePlayerSlider { height: 20px; value: root.position-ratio; label: "Playback position"; keyboard-step: 0.025; changed(value) => { root.seek(value); } }
                                    if root.track-title != "Nothing playing": HorizontalLayout { height: 17px; Text { text: root.position-text; color: #9db0aa; font-size: 10px; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.duration-text; color: #9db0aa; font-size: 10px; horizontal-alignment: right; } }
                                }
                                Rectangle { width: root.width < 1500px ? 280px : 350px; height: self.width; border-radius: 26px; background: @linear-gradient(135deg, #11d8e82c 0%, #38ff661e 100%); clip: true; Image { source: root.album-art; image-fit: cover; width: parent.width; height: parent.height; } if root.track-title == "Nothing playing": FluentGlyph { glyph: ""; color: #38ff66; font-size: 96px; opacity: 0.75; } }
                            }
                        }
                        Text { text: "Your Zink at a glance"; color: white; font-size: 21px; font-weight: 700; }
                        GridLayout { height: 112px; spacing: 12px;
                            Rectangle { row: 0; col: 0; border-radius: 18px; background: library-stat-touch.has-hover ? #38ff6615 : #ffffff08; border-width: 1px; border-color: #ffffff14; VerticalLayout { padding: 16px; spacing: 4px; FluentGlyph { glyph: ""; color: #38ff66; font-size: 18px; } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: root.library-track-count; color: white; font-size: 23px; font-weight: 750; } Text { text: "Songs in your library"; color: #9db0aa; font-size: 10px; } } library-stat-touch := TouchArea { clicked => { root.navigate("music-library"); } } }
                            Rectangle { row: 0; col: 1; border-radius: 18px; background: album-stat-touch.has-hover ? #38ff6615 : #ffffff08; border-width: 1px; border-color: #ffffff14; VerticalLayout { padding: 16px; spacing: 4px; FluentGlyph { glyph: ""; color: #11d8e8; font-size: 18px; } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: root.library-album-count; color: white; font-size: 23px; font-weight: 750; } Text { text: "Albums ready to play"; color: #9db0aa; font-size: 10px; } } album-stat-touch := TouchArea { clicked => { root.navigate("music-library"); } } }
                            Rectangle { row: 0; col: 2; border-radius: 18px; background: radio-stat-touch.has-hover ? #38ff6615 : #ffffff08; border-width: 1px; border-color: #ffffff14; VerticalLayout { padding: 16px; spacing: 4px; FluentGlyph { glyph: ""; color: #f0c75e; font-size: 18px; } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: "Live radio"; color: white; font-size: 18px; font-weight: 700; } Text { text: "Stations and discovery"; color: #9db0aa; font-size: 10px; } } radio-stat-touch := TouchArea { clicked => { root.navigate("radio"); } } }
                            Rectangle { row: 0; col: 3; border-radius: 18px; background: record-stat-touch.has-hover ? #38ff6615 : #ffffff08; border-width: 1px; border-color: #ffffff14; VerticalLayout { padding: 16px; spacing: 4px; FluentGlyph { glyph: ""; color: #ff7777; font-size: 18px; } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: "Capture"; color: white; font-size: 18px; font-weight: 700; } Text { text: "Record or save a replay"; color: #9db0aa; font-size: 10px; } } record-stat-touch := TouchArea { clicked => { root.navigate("screen-recorder"); } } }
                        }
                        Rectangle { height: 88px; border-radius: 20px; background: #ffffff07; VerticalLayout { padding: 14px; spacing: 8px;
                            HorizontalLayout { height: 20px; Text { text: "Smart Spaces"; color: white; font-size: 16px; font-weight: 700; } Text { text: "  Changes what Home puts first"; color: #71857f; font-size: 9px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.home-space; color: #38ff66; font-size: 10px; vertical-alignment: center; } }
                            HorizontalLayout { height: 34px; spacing: 8px; for space in ["Everything", "Music", "Entertainment", "Gaming", "Creator", "Social", "Focus"]: Rectangle { horizontal-stretch: 1; border-radius: 17px; background: root.home-space == space ? #38ff6628 : space-touch.has-hover ? #ffffff18 : #ffffff08; border-width: root.home-space == space ? 1px : 0px; border-color: #38ff6670; Text { text: space; color: root.home-space == space ? #38ff66 : white; font-size: 9px; font-weight: root.home-space == space ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; } space-touch := TouchArea { clicked => { root.set-home-space(space); } } } }
                        } }
                        if root.home-space != "Everything": Rectangle { height: 118px; border-radius: 20px; background: @linear-gradient(100deg, #0b2c2d 0%, #0a1921 100%); HorizontalLayout { padding: 16px; spacing: 12px;
                            VerticalLayout { width: 220px; spacing: 4px; Text { text: root.home-space + " space"; color: white; font-size: 18px; font-weight: 700; } Text { text: root.home-space == "Music" ? "Playback, library and sound" : root.home-space == "Entertainment" ? "Watch, stream and discover" : root.home-space == "Gaming" ? "Play, capture and connect" : root.home-space == "Creator" ? "Record, stream and publish" : root.home-space == "Social" ? "Friends, calls and messages" : "Fewer distractions, your essentials"; color: #9db0aa; font-size: 9px; wrap: word-wrap; } }
                            for slot in [0, 1, 2]: Rectangle { horizontal-stretch: 1; border-radius: 13px; background: space-action-touch.has-hover ? #38ff6618 : #ffffff09; VerticalLayout { padding: 12px; spacing: 4px; FluentGlyph { glyph: slot == 0 ? "" : slot == 1 ? "" : ""; color: #38ff66; font-size: 15px; } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: root.home-space == "Music" ? (slot == 0 ? "Your Daily Mix" : slot == 1 ? "Library" : "Equalizer") : root.home-space == "Entertainment" ? (slot == 0 ? "Video Player" : slot == 1 ? "TV" : "Films") : root.home-space == "Gaming" ? (slot == 0 ? "Gaming" : slot == 1 ? "Xbox" : "FPS Recorder") : root.home-space == "Creator" ? (slot == 0 ? "Recorder" : slot == 1 ? "Streaming" : "Recordings") : root.home-space == "Social" ? (slot == 0 ? "Zink Social" : slot == 1 ? "Messages" : "Calls") : (slot == 0 ? "Music" : slot == 1 ? "Search" : "Settings"); color: white; font-size: 10px; font-weight: 650; overflow: elide; } } space-action-touch := TouchArea { clicked => { if root.home-space == "Music" && slot == 0 { root.play-library-all(true); root.navigate("music-player"); } else { root.navigate(root.home-space == "Music" ? (slot == 1 ? "music-library" : "equalizer") : root.home-space == "Entertainment" ? (slot == 0 ? "video-player" : slot == 1 ? "tv" : "films") : root.home-space == "Gaming" ? (slot == 0 ? "gaming" : slot == 1 ? "xbox" : "fps-recorder") : root.home-space == "Creator" ? (slot == 0 ? "screen-recorder" : slot == 1 ? "streaming" : "recordings") : root.home-space == "Social" ? (slot == 0 ? "social" : slot == 1 ? "messages" : "call") : (slot == 0 ? "music-player" : slot == 1 ? "search" : "settings")); } } } }
                        } }
                        Rectangle { height: 154px; border-radius: 20px; background: #ffffff07; VerticalLayout { padding: 16px; spacing: 9px;
                            HorizontalLayout { height: 28px; Text { text: "Pinned actions"; color: white; font-size: 18px; font-weight: 700; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "Edit Home to change these"; color: #71857f; font-size: 9px; vertical-alignment: center; } }
                            if root.home-pinned-actions.length == 0: Rectangle { vertical-stretch: 1; background: transparent; Text { text: "Use Edit Home to pin the tools you use every day."; color: #839992; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } }
                            if root.home-pinned-actions.length > 0: pinned-home-strip := ZinkScrollView { vertical-stretch: 1; content-width: pinned-home-row.preferred-width; horizontal-scrollbar-policy: ScrollBarPolicy.always-on; vertical-scrollbar-policy: ScrollBarPolicy.always-off; pinned-home-row := HorizontalLayout { height: pinned-home-strip.visible-height - 14px; spacing: 9px; for action in root.home-pinned-actions: Rectangle { width: 195px; border-radius: 13px; background: pinned-action-touch.has-hover ? #38ff6618 : #ffffff08; HorizontalLayout { padding: 12px; spacing: 10px; Rectangle { width: 38px; height: 38px; border-radius: 11px; background: #38ff6618; Text { text: action.id == "music-player" ? "" : action.id == "zink-connect" ? "" : action.id == "screen-recorder" ? "" : action.id == "social" ? "" : action.id == "video-player" ? "" : ""; font-family: "Segoe Fluent Icons"; color: #38ff66; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; } } VerticalLayout { alignment: center; Text { text: action.title; color: white; font-size: 11px; font-weight: 650; overflow: elide; } Text { text: action.group; color: #839992; font-size: 8px; } } } pinned-action-touch := TouchArea { clicked => { root.navigate(action.id); } } } } }
                        } }
                        if root.home-show-live-activities: Rectangle { height: 178px; border-radius: 20px; background: #ffffff07; VerticalLayout { padding: 16px; spacing: 10px;
                            HorizontalLayout { height: 30px; Text { text: "Live Activity Centre"; color: white; font-size: 19px; font-weight: 700; } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 94px; border-radius: 15px; background: #38ff6613; Text { text: root.is-playing ? "1 active" : "All quiet"; color: #38ff66; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } } }
                            HorizontalLayout { vertical-stretch: 1; spacing: 10px;
                                Rectangle { horizontal-stretch: 2; border-radius: 14px; background: #ffffff08; HorizontalLayout { padding: 13px; spacing: 12px; Rectangle { width: 52px; height: 52px; border-radius: 12px; clip: true; Image { source: root.album-art; image-fit: cover; width: parent.width; height: parent.height; } } VerticalLayout { horizontal-stretch: 1; alignment: center; Text { text: root.track-title; color: white; font-size: 12px; font-weight: 650; overflow: elide; } Text { text: root.is-playing ? "Playing now" : "Playback ready"; color: #38ff66; font-size: 9px; } } Rectangle { width: 40px; height: 40px; border-radius: 20px; background: #f4fff8; FluentGlyph { glyph: root.is-playing ? "" : ""; color: #06120a; font-size: 16px; } TouchArea { clicked => { root.toggle-playback(); } } } } }
                                Rectangle { horizontal-stretch: 1; border-radius: 14px; background: #ffffff08; VerticalLayout { padding: 13px; spacing: 5px; FluentGlyph { glyph: ""; color: #ff7777; font-size: 17px; } Text { text: "Replay buffer"; color: white; font-size: 11px; font-weight: 650; } Text { text: "Save the last 45 seconds"; color: #839992; font-size: 8px; } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: "Open recorder  ›"; color: #38ff66; font-size: 9px; } } TouchArea { clicked => { root.navigate("screen-recorder"); } } }
                                Rectangle { horizontal-stretch: 1; border-radius: 14px; background: #ffffff08; VerticalLayout { padding: 13px; spacing: 5px; FluentGlyph { glyph: ""; color: #11d8e8; font-size: 17px; } Text { text: "Zink Connect"; color: white; font-size: 11px; font-weight: 650; } Text { text: "Browser and connected services"; color: #839992; font-size: 8px; } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: "Open browser  ›"; color: #38ff66; font-size: 9px; } } TouchArea { clicked => { root.navigate("zink-connect"); } } }
                            }
                        } }
                        if root.home-show-flow: Rectangle { height: 188px; border-radius: 20px; background: @linear-gradient(100deg, #0b2c2d 0%, #0a1921 100%); VerticalLayout { padding: 16px; spacing: 10px;
                            HorizontalLayout { height: 31px; VerticalLayout { Text { text: "Zink Flow"; color: white; font-size: 19px; font-weight: 700; } Text { text: "Continue across music, entertainment, creation and conversations"; color: #839992; font-size: 8px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "Private on this PC"; color: #38ff66; font-size: 9px; vertical-alignment: center; } }
                            if root.home-activities.length == 0: Rectangle { vertical-stretch: 1; background: transparent; Text { text: "Your flow builds as you use Zink. Open a page to begin."; color: #9db0aa; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } }
                            if root.home-activities.length > 0: flow-strip := ZinkScrollView { vertical-stretch: 1; content-width: flow-row.preferred-width; horizontal-scrollbar-policy: ScrollBarPolicy.always-on; vertical-scrollbar-policy: ScrollBarPolicy.always-off; flow-row := HorizontalLayout { height: flow-strip.visible-height - 14px; spacing: 8px; for activity[index] in root.home-activities: HorizontalLayout { spacing: 8px; Rectangle { width: 174px; border-radius: 13px; background: flow-touch.has-hover ? #38ff661b : #ffffff09; VerticalLayout { padding: 12px; spacing: 5px; Text { text: activity.icon; font-family: "Segoe Fluent Icons"; color: #38ff66; font-size: 17px; } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: activity.title; color: white; font-size: 11px; font-weight: 650; overflow: elide; } Text { text: activity.detail; color: #839992; font-size: 8px; overflow: elide; } } flow-touch := TouchArea { clicked => { root.navigate(activity.route); } } } if index < root.home-activities.length - 1: Text { text: "→"; color: #38ff6670; font-size: 17px; vertical-alignment: center; } } } }
                        } }
                        HorizontalLayout { height: 260px; spacing: 18px;
                            Rectangle { horizontal-stretch: 3; border-radius: 22px; background: #ffffff08; VerticalLayout { padding: 18px; spacing: 10px; HorizontalLayout { height: 34px; Text { text: "Jump back in"; color: white; font-size: 20px; font-weight: 700; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "Recently played"; color: #38ff66; font-size: 10px; vertical-alignment: center; } } if root.recently-played.length == 0: Rectangle { vertical-stretch: 1; background: transparent; Text { text: "Tracks you play will appear here."; color: #839992; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } } if root.recently-played.length > 0: home-recent-scroll := ZinkScrollView { vertical-stretch: 1; content-width: home-recent-row.preferred-width; horizontal-scrollbar-policy: ScrollBarPolicy.always-on; vertical-scrollbar-policy: ScrollBarPolicy.always-off; home-recent-row := HorizontalLayout { height: home-recent-scroll.visible-height - 14px; spacing: 10px; for track in root.recently-played: Rectangle { width: 190px; border-radius: 14px; background: home-recent-touch.has-hover ? #38ff6618 : #ffffff08; VerticalLayout { padding: 13px; spacing: 5px; Rectangle { width: 42px; height: 42px; border-radius: 11px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 17px; } } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: track.title; color: white; font-size: 12px; font-weight: 650; overflow: elide; } Text { text: track.artist == "" ? "Unknown artist" : track.artist; color: #9db0aa; font-size: 9px; overflow: elide; } } home-recent-touch := TouchArea { clicked => { root.play-library-item(track.path); root.navigate("music-player"); } } } } } } }
                            Rectangle { horizontal-stretch: 2; border-radius: 22px; background: #ffffff08; VerticalLayout { padding: 18px; spacing: 10px; Text { text: "Quick launch"; color: white; font-size: 20px; font-weight: 700; } GridLayout { vertical-stretch: 1; spacing: 9px; CompactTile { row: 0; col: 0; icon: ""; title: "Search"; subtitle: "Find anything"; route-id: "search"; activated(route) => { root.navigate(route); } } CompactTile { row: 0; col: 1; icon: ""; title: "Video"; subtitle: "Watch a file"; route-id: "video-player"; activated(route) => { root.navigate(route); } } CompactTile { row: 1; col: 0; icon: ""; title: "Connect"; subtitle: "Browse and share"; route-id: "zink-connect"; activated(route) => { root.navigate(route); } } CompactTile { row: 1; col: 1; icon: ""; title: "Settings"; subtitle: "Make Zink yours"; route-id: "settings"; activated(route) => { root.navigate(route); } } } } }
                        }
                        if root.home-show-insights || root.home-show-devices: HorizontalLayout { height: 178px; spacing: 18px;
                            if root.home-show-insights: Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #ffffff08; VerticalLayout { padding: 18px; spacing: 9px; HorizontalLayout { height: 28px; Text { text: "Private insights"; color: white; font-size: 19px; font-weight: 700; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "Stored locally"; color: #38ff66; font-size: 8px; vertical-alignment: center; } } GridLayout { vertical-stretch: 1; spacing: 8px; Rectangle { row: 0; col: 0; border-radius: 12px; background: #ffffff08; VerticalLayout { padding: 10px; Text { text: root.listening-time-summary; color: white; font-size: 16px; font-weight: 700; } Text { text: "Listening time"; color: #839992; font-size: 8px; } } } Rectangle { row: 0; col: 1; border-radius: 12px; background: #ffffff08; VerticalLayout { padding: 10px; Text { text: root.listening-plays-summary; color: white; font-size: 16px; font-weight: 700; } Text { text: "Plays"; color: #839992; font-size: 8px; } } } Rectangle { row: 0; col: 2; border-radius: 12px; background: #ffffff08; VerticalLayout { padding: 10px; Text { text: root.listening-tracks-summary; color: white; font-size: 16px; font-weight: 700; } Text { text: "Unique tracks"; color: #839992; font-size: 8px; } } } } } }
                            if root.home-show-devices: Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #ffffff08; VerticalLayout { padding: 18px; spacing: 9px; HorizontalLayout { height: 28px; Text { text: "Device Centre"; color: white; font-size: 19px; font-weight: 700; } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 68px; border-radius: 14px; background: device-refresh-touch.has-hover ? #ffffff18 : #ffffff09; Text { text: "Refresh"; color: white; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } device-refresh-touch := TouchArea { clicked => { root.refresh-audio-devices(); } } } } Rectangle { height: 48px; border-radius: 12px; background: #ffffff08; HorizontalLayout { padding: 10px; spacing: 9px; FluentGlyph { glyph: ""; color: #38ff66; width: 19px; font-size: 16px; } VerticalLayout { alignment: center; Text { text: root.selected-audio-device-name; color: white; font-size: 10px; font-weight: 650; overflow: elide; } Text { text: "Audio output • " + root.volume-percent + "%"; color: #839992; font-size: 8px; } } } } HorizontalLayout { height: 35px; spacing: 8px; Rectangle { horizontal-stretch: 1; border-radius: 17px; background: #ffffff09; Text { text: "Equalizer"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("equalizer"); } } } Rectangle { horizontal-stretch: 1; border-radius: 17px; background: #ffffff09; Text { text: "Xbox"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("xbox"); } } } Rectangle { horizontal-stretch: 1; border-radius: 17px; background: #ffffff09; Text { text: "Zink devices"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("zink-connect"); } } } } } }
                        }
                        Rectangle { height: 188px; border-radius: 22px; background: #ffffff08; VerticalLayout { padding: 18px; spacing: 10px;
                            HorizontalLayout { height: 34px; VerticalLayout { Text { text: "Zink Social pulse"; color: white; font-size: 20px; font-weight: 700; } Text { text: root.social-signed-in ? "Friends, messages and calls without leaving Home" : "Sign in to bring your people into Home"; color: #839992; font-size: 8px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 126px; border-radius: 17px; background: root.notification-items.length > 0 ? #38ff6618 : #ffffff09; HorizontalLayout { alignment: center; spacing: 7px; FluentGlyph { glyph: ""; color: root.notification-items.length > 0 ? #38ff66 : #82978f; font-size: 13px; } Text { text: root.notification-items.length + (root.notification-items.length == 1 ? " notification" : " notifications"); color: white; font-size: 8px; vertical-alignment: center; } } TouchArea { clicked => { root.navigate("notifications"); } } } Rectangle { width: 98px; border-radius: 17px; background: #ffffff09; Text { text: root.social-signed-in ? "All friends  ›" : "Sign in  ›"; color: #38ff66; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate(root.social-signed-in ? "friends" : "social-login"); } } } }
                            if !root.social-signed-in: Rectangle { vertical-stretch: 1; border-radius: 15px; background: #ffffff06; HorizontalLayout { padding: 15px; spacing: 13px; Rectangle { width: 52px; height: 52px; border-radius: 18px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 21px; } } VerticalLayout { alignment: center; Text { text: "Connect Zink Social"; color: white; font-size: 13px; font-weight: 700; } Text { text: "See presence, jump into messages and start calls from the dashboard."; color: #8da29b; font-size: 9px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 104px; height: 38px; border-radius: 19px; background: #38ff66; Text { text: "Sign in"; color: #051109; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("social-login"); } } } } }
                            if root.social-signed-in && root.social-friends.length == 0: Rectangle { vertical-stretch: 1; border-radius: 15px; background: #ffffff06; Text { text: "No friends are available yet. Open Friends to find people."; color: #8da29b; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("friends"); } } }
                            if root.social-signed-in && root.social-friends.length > 0: home-friends-scroll := ZinkScrollView { vertical-stretch: 1; content-width: home-friends-row.preferred-width; horizontal-scrollbar-policy: ScrollBarPolicy.always-on; vertical-scrollbar-policy: ScrollBarPolicy.always-off; home-friends-row := HorizontalLayout { height: home-friends-scroll.visible-height - 14px; spacing: 9px; for friend in root.social-friends: Rectangle { width: 238px; border-radius: 15px; background: friend.is-online ? #38ff6612 : #ffffff07; HorizontalLayout { padding: 12px; spacing: 10px; Rectangle { width: 42px; height: 42px; border-radius: 21px; background: friend.is-online ? #38ff6622 : #ffffff0a; Text { text: friend.display-name == "" ? friend.username : friend.display-name; color: friend.is-online ? #38ff66 : #9db0aa; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; overflow: elide; } } VerticalLayout { width: 92px; alignment: center; Text { text: friend.display-name == "" ? friend.username : friend.display-name; color: white; font-size: 10px; font-weight: 700; overflow: elide; } Text { text: friend.is-online ? "Online" : "Offline"; color: friend.is-online ? #38ff66 : #71877f; font-size: 8px; } } Rectangle { width: 34px; height: 34px; border-radius: 17px; background: #ffffff0c; FluentGlyph { glyph: ""; color: white; font-size: 13px; } TouchArea { clicked => { root.social-select-friend(friend.user-id, friend.username, friend.display-name); root.navigate("messages"); } } } Rectangle { width: 34px; height: 34px; border-radius: 17px; background: #38ff661c; FluentGlyph { glyph: ""; color: #38ff66; font-size: 13px; } TouchArea { clicked => { root.social-select-friend(friend.user-id, friend.username, friend.display-name); root.call-auto-share = false; root.navigate("call"); root.social-start-call(friend.user-id); } } } } } } }
                        } }
                        HorizontalLayout { height: 210px; spacing: 18px;
                            Rectangle { horizontal-stretch: 1; border-radius: 22px; background: @linear-gradient(135deg, #0b393a 0%, #0b2028 100%); VerticalLayout { padding: 21px; spacing: 8px; FluentGlyph { glyph: ""; color: #38ff66; font-size: 24px; } Text { text: "Create something"; color: white; font-size: 19px; font-weight: 700; } Text { text: "Record your screen, system audio and microphone, or save the last 45 seconds."; color: #a8bbb5; font-size: 11px; wrap: word-wrap; } Rectangle { vertical-stretch: 1; background: transparent; } Rectangle { height: 38px; border-radius: 19px; background: creator-touch.has-hover ? #ffffff20 : #ffffff0d; Text { text: "Open recorder"; color: white; font-size: 11px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } creator-touch := TouchArea { clicked => { root.navigate("screen-recorder"); } } } } }
                            Rectangle { horizontal-stretch: 1; border-radius: 22px; background: @linear-gradient(135deg, #103250 0%, #0a202b 100%); VerticalLayout { padding: 21px; spacing: 8px; FluentGlyph { glyph: ""; color: #11d8e8; font-size: 24px; } Text { text: "Zink Connect"; color: white; font-size: 19px; font-weight: 700; } Text { text: "Open the Zink browser, keep your sessions together, and connect across the app."; color: #a8bbb5; font-size: 11px; wrap: word-wrap; } Rectangle { vertical-stretch: 1; background: transparent; } Rectangle { height: 38px; border-radius: 19px; background: connect-home-touch.has-hover ? #ffffff20 : #ffffff0d; Text { text: "Open Connect"; color: white; font-size: 11px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } connect-home-touch := TouchArea { clicked => { root.navigate("zink-connect"); } } } } }
                            Rectangle { horizontal-stretch: 1; border-radius: 22px; background: @linear-gradient(135deg, #35263b 0%, #17202c 100%); VerticalLayout { padding: 21px; spacing: 8px; FluentGlyph { glyph: ""; color: #d6a5ff; font-size: 24px; } Text { text: "Zink Social"; color: white; font-size: 19px; font-weight: 700; } Text { text: "Friends, messages, presence, calls and screen sharing in one place."; color: #a8bbb5; font-size: 11px; wrap: word-wrap; } Rectangle { vertical-stretch: 1; background: transparent; } Rectangle { height: 38px; border-radius: 19px; background: social-home-touch.has-hover ? #ffffff20 : #ffffff0d; Text { text: "Open Social"; color: white; font-size: 11px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } social-home-touch := TouchArea { clicked => { root.navigate("social"); } } } } }
                        }
                    }
                }
                if root.home-edit-open: Rectangle { x: parent.width - 404px; y: 18px; width: 386px; height: parent.height - 36px; border-radius: 22px; background: #10191bfc; border-width: 1px; border-color: #ffffff25;
                    VerticalLayout { padding: 18px; spacing: 11px; HorizontalLayout { height: 38px; Text { text: "Edit Home"; color: white; font-size: 22px; font-weight: 750; } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 34px; height: 34px; border-radius: 17px; background: #ffffff0c; FluentGlyph { glyph: ""; font-size: 13px; } TouchArea { clicked => { root.home-edit-open = false; } } } } Text { text: "Choose what appears on your command centre"; color: #839992; font-size: 9px; }
                        for section in ["flow", "live", "insights", "devices"]: Rectangle { height: 46px; border-radius: 12px; background: section-touch.has-hover ? #ffffff14 : #ffffff08; HorizontalLayout { padding: 12px; Text { text: section == "flow" ? "Zink Flow" : section == "live" ? "Live activities" : section == "insights" ? "Private insights" : "Device Centre"; color: white; font-size: 11px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: (section == "flow" ? root.home-show-flow : section == "live" ? root.home-show-live-activities : section == "insights" ? root.home-show-insights : root.home-show-devices) ? "ON" : "OFF"; color: #38ff66; font-size: 9px; vertical-alignment: center; } } section-touch := TouchArea { clicked => { root.toggle-home-section(section); } } }
                        Text { text: "PINNED ACTIONS"; color: #71857f; font-size: 9px; font-weight: 700; } edit-pins := ZinkScrollView { vertical-stretch: 1; content-height: edit-pins-list.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.always-on; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; edit-pins-list := VerticalLayout { width: edit-pins.visible-width - 12px; spacing: 7px; for option in [{id:"music-player", title:"Music Player"}, {id:"music-library", title:"Music Library"}, {id:"video-player", title:"Video Player"}, {id:"radio", title:"Internet Radio"}, {id:"zink-connect", title:"Zink Connect"}, {id:"screen-recorder", title:"Screen Recorder"}, {id:"social", title:"Zink Social"}, {id:"gaming", title:"Gaming"}, {id:"settings", title:"Settings"}]: Rectangle { height: 42px; border-radius: 10px; background: pin-touch.has-hover ? #38ff6618 : #ffffff08; HorizontalLayout { padding: 11px; Text { text: option.title; color: white; font-size: 10px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "Toggle pin"; color: #38ff66; font-size: 8px; vertical-alignment: center; } } pin-touch := TouchArea { clicked => { root.toggle-home-pin(option.id); } } } } } }
                }
                if root.home-command-open: Rectangle { width: parent.width; height: parent.height; background: #000000a5; Rectangle { x: (parent.width - 620px) / 2; y: 94px; width: 620px; height: 360px; border-radius: 22px; background: #11191bfc; border-width: 1px; border-color: #ffffff2c; VerticalLayout { padding: 20px; spacing: 12px; HorizontalLayout { height: 28px; Text { text: "Zink Command"; color: white; font-size: 20px; font-weight: 750; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "Ctrl+K • ESC"; color: #71857f; font-size: 8px; vertical-alignment: center; } } Rectangle { height: 50px; border-radius: 14px; background: #ffffff0d; border-width: 1px; border-color: #38ff6650; FluentGlyph { glyph: ""; x: 15px; width: 22px; font-size: 17px; } TextInput { x: 48px; width: parent.width - 66px; height: parent.height; text: root.home-command-query; color: white; font-size: 13px; single-line: true; edited => { root.home-command-query = self.text; } accepted => { root.execute-home-command(self.text); } } } Text { text: "Try a command"; color: #9db0aa; font-size: 10px; } GridLayout { vertical-stretch: 1; spacing: 8px; for command[index] in ["Play or pause music", "Open Music Library", "Record my screen", "Open Zink Connect", "Open Zink Social", "Play Internet Radio"]: Rectangle { row: Math.floor(index / 2); col: Math.mod(index, 2); border-radius: 11px; background: cmd-touch.has-hover ? #38ff6618 : #ffffff08; Text { text: command; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } cmd-touch := TouchArea { clicked => { root.execute-home-command(command); } } } } } } }
            }

            /* Home overlays are attached inside the Home surface above.
            if root.current-route == "home" && root.home-edit-open: Rectangle {
                x: parent.width - 430px; y: 38px; width: 390px; height: parent.height - 76px; border-radius: 22px; background: #10191bfc; border-width: 1px; border-color: #ffffff25;
                VerticalLayout { padding: 18px; spacing: 12px;
                    HorizontalLayout { height: 38px; VerticalLayout { Text { text: "Edit Home"; color: white; font-size: 22px; font-weight: 750; } Text { text: "Saved automatically"; color: #839992; font-size: 8px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 34px; height: 34px; border-radius: 17px; background: edit-close-touch.has-hover ? #ffffff20 : #ffffff0c; FluentGlyph { glyph: ""; font-size: 13px; } edit-close-touch := TouchArea { clicked => { root.home-edit-open = false; } } } }
                    Text { text: "SHOW ON HOME"; color: #71857f; font-size: 9px; font-weight: 700; }
                    for section in ["flow", "live", "insights", "devices"]: Rectangle { height: 46px; border-radius: 12px; background: section-touch.has-hover ? #ffffff14 : #ffffff08; HorizontalLayout { padding: 12px; Text { text: section == "flow" ? "Zink Flow" : section == "live" ? "Live activities" : section == "insights" ? "Private insights" : "Device Centre"; color: white; font-size: 11px; font-weight: 650; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: (section == "flow" ? root.home-show-flow : section == "live" ? root.home-show-live-activities : section == "insights" ? root.home-show-insights : root.home-show-devices) ? "On" : "Off"; color: (section == "flow" ? root.home-show-flow : section == "live" ? root.home-show-live-activities : section == "insights" ? root.home-show-insights : root.home-show-devices) ? #38ff66 : #71857f; font-size: 9px; vertical-alignment: center; } } section-touch := TouchArea { clicked => { root.toggle-home-section(section); } } }
                    Text { text: "PIN OR UNPIN ACTIONS"; color: #71857f; font-size: 9px; font-weight: 700; }
                    edit-pin-scroll := ZinkScrollView { vertical-stretch: 1; content-height: edit-pin-list.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.always-on; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; edit-pin-list := VerticalLayout { width: edit-pin-scroll.visible-width - 12px; spacing: 7px; for option in [{id:"music-player", title:"Music Player"}, {id:"music-library", title:"Music Library"}, {id:"video-player", title:"Video Player"}, {id:"radio", title:"Internet Radio"}, {id:"zink-connect", title:"Zink Connect"}, {id:"screen-recorder", title:"Screen Recorder"}, {id:"social", title:"Zink Social"}, {id:"gaming", title:"Gaming"}, {id:"settings", title:"Settings"}]: Rectangle { height: 44px; border-radius: 11px; background: option-touch.has-hover ? #38ff6617 : #ffffff08; HorizontalLayout { padding: 11px; Text { text: option.title; color: white; font-size: 10px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "Toggle pin"; color: #38ff66; font-size: 8px; vertical-alignment: center; } } option-touch := TouchArea { clicked => { root.toggle-home-pin(option.id); } } } } }
                }
            }
            if root.current-route == "home" && root.home-command-open: Rectangle {
                x: 270px; width: parent.width - 270px; height: parent.height; background: #000000a5;
                Rectangle { x: (parent.width - 620px) / 2; y: 100px; width: 620px; height: 360px; border-radius: 22px; background: #11191bfc; border-width: 1px; border-color: #ffffff2c;
                    VerticalLayout { padding: 20px; spacing: 12px;
                        HorizontalLayout { height: 28px; Text { text: "Zink Command"; color: white; font-size: 20px; font-weight: 750; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "Ctrl+K • ESC to close"; color: #71857f; font-size: 8px; vertical-alignment: center; } }
                        Rectangle { height: 50px; border-radius: 14px; background: #ffffff0d; border-width: 1px; border-color: #38ff6650; FluentGlyph { glyph: ""; x: 15px; width: 22px; font-size: 17px; } TextInput { x: 48px; width: parent.width - 66px; height: parent.height; text: root.home-command-query; color: white; font-size: 13px; single-line: true; edited => { root.home-command-query = self.text; } accepted => { root.execute-home-command(self.text); } } }
                        Text { text: "Type an action or choose a suggestion"; color: #9db0aa; font-size: 10px; }
                        GridLayout { vertical-stretch: 1; spacing: 8px; for command[index] in ["Play or pause music", "Open Music Library", "Record my screen", "Open Zink Connect", "Open Zink Social", "Play Internet Radio"]: Rectangle { row: Math.floor(index / 2); col: Math.mod(index, 2); border-radius: 11px; background: command-option-touch.has-hover ? #38ff6618 : #ffffff08; Text { text: command; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } command-option-touch := TouchArea { clicked => { root.execute-home-command(command); } } } }
                    }
                }
            }

            */
            if false && root.current-route == "home": home-scroll := Flickable {
                content-height: home-content.preferred-height;
                home-content := HorizontalLayout {
                width: home-scroll.width;
                spacing: 22px;
                VerticalLayout {
                    horizontal-stretch: 3;
                    spacing: 14px;
                    HorizontalLayout {
                        height: 70px; spacing: 12px;
                        Rectangle { width: 52px; height: 52px; border-radius: 18px; background: #05acb718; border-color: #5ae8e078; border-width: 1px; Text { text: "▷"; color: #e7fff6bd; font-size: 25px; horizontal-alignment: center; vertical-alignment: center; } }
                        VerticalLayout { spacing: 0px; Text { text: "Zink"; color: #ffffffe8; font-size: 38px; font-weight: 650; } Text { text: "Play. Watch. Call. Share. Tune. Test."; color: #d6e2eaa9; font-size: 14px; } }
                    }
                    Rectangle {
                        height: 250px; border-radius: 28px; border-width: 1px; border-color: #78d9dd50; background: #062d34c8;
                        VerticalLayout {
                            padding: 18px; spacing: 8px;
                            Text { text: root.track-title == "Nothing playing" ? "Continue your flow" : root.track-title; color: #ffffffe8; font-size: 22px; font-weight: 650; }
                            Text { text: root.track-detail; color: #d6e2eaa9; font-size: 13px; }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                            HorizontalLayout { spacing: 10px; for label in ["Surface", "State", "Time"]: Rectangle { horizontal-stretch: 1; height: 70px; border-radius: 18px; background: #00161dc4; VerticalLayout { padding: 12px; Text { text: label; color: #d6e2ea83; font-size: 11px; } Text { text: label == "Surface" ? (root.track-title == "Nothing playing" ? "Nothing" : "Media") : label == "State" ? (root.is-playing ? "Playing" : "Ready") : root.duration-text; color: #ffffffdf; font-size: 13px; } } } }
                            HorizontalLayout { height: 42px; spacing: 10px;
                                Rectangle { horizontal-stretch: 1; border-radius: 20px; background: #00141ab0; border-width: 1px; border-color: #5ae8e040; Text { text: "▷  Resume"; color: #cfe7df; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.play-media(); } } }
                                Rectangle { horizontal-stretch: 1; border-radius: 20px; background: #00141ab0; border-width: 1px; border-color: #5ae8e040; Text { text: "♲  Reset / Clear"; color: #cfe7df; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.clear-playback(); } } }
                                Rectangle { horizontal-stretch: 1; border-radius: 20px; background: #00141ab0; border-width: 1px; border-color: #5ae8e040; Text { text: "▱  Open file"; color: #cfe7df; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-media(); } } }
                                Rectangle { horizontal-stretch: 1; border-radius: 20px; background: #00141ab0; border-width: 1px; border-color: #5ae8e040; Text { text: "□  Open folder"; color: #cfe7df; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.import-library(); } } }
                            }
                        }
                    }
                    Rectangle {
                        height: 150px; border-radius: 24px; background: #001117a8;
                        VerticalLayout { padding: 14px; spacing: 8px; Text { text: "Creator setup"; color: #ffffffe8; font-size: 20px; font-weight: 600; } Text { text: "Start with capture, streaming, and Zink Connect for the clearest install value."; color: #9fb2ac; font-size: 12px; } HorizontalLayout { spacing: 10px;
                            Rectangle { width: 150px; border-radius: 18px; background: #00161dbd; border-width: 1px; border-color: #5ae8e030; Text { text: "▣\nRecord\nCapture a clip"; color: #ffffffdf; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("recorder"); } } }
                            Rectangle { width: 150px; border-radius: 18px; background: #00161dbd; border-width: 1px; border-color: #5ae8e030; Text { text: "□\nLibrary\nSaved clips"; color: #ffffffdf; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("recordings"); } } }
                            Rectangle { width: 150px; border-radius: 18px; background: #00161dbd; border-width: 1px; border-color: #5ae8e030; Text { text: "◎\nConnect\nCall or share"; color: #ffffffdf; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("zink-connect"); } } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        } }
                    }
                    GridLayout {
                        spacing: 10px;
                        PulseTile { row: 0; col: 0; icon: "♫"; title: "Music"; subtitle: "Player"; route-id: "music-player"; activated(route) => { root.navigate(route); } }
                        PulseTile { row: 0; col: 1; icon: "▣"; title: "Video"; subtitle: "Player"; route-id: "video-player"; activated(route) => { root.navigate(route); } }
                        PulseTile { row: 0; col: 2; icon: "◉"; title: "Radio"; subtitle: "Live stations"; route-id: "radio"; activated(route) => { root.navigate(route); } }
                        PulseTile { row: 0; col: 3; icon: "◫"; title: "Spotify"; subtitle: "Now playing"; route-id: "spotify"; activated(route) => { root.navigate(route); } }
                        PulseTile { row: 1; col: 0; icon: "▥"; title: "Music Library"; subtitle: "Files and albums"; route-id: "music-library"; activated(route) => { root.navigate(route); } }
                        PulseTile { row: 1; col: 1; icon: "▤"; title: "Video Library"; subtitle: "Folders"; route-id: "video-library"; activated(route) => { root.navigate(route); } }
                        PulseTile { row: 1; col: 2; icon: "⌁"; title: "Equalizer"; subtitle: "Audio tuning"; route-id: "equalizer"; activated(route) => { root.navigate(route); } }
                        PulseTile { row: 1; col: 3; icon: "⌇"; title: "Visualizer"; subtitle: "Reactive playback"; route-id: "visualizer"; activated(route) => { root.navigate(route); } }
                        PulseTile { row: 2; col: 0; icon: "◫"; title: "Twitch"; subtitle: "Streams"; route-id: "twitch"; activated(route) => { root.navigate(route); } }
                        PulseTile { row: 2; col: 1; icon: "X"; title: "Xbox"; subtitle: "Gaming"; route-id: "xbox"; activated(route) => { root.navigate(route); } }
                        PulseTile { row: 2; col: 2; icon: "◉"; title: "Discord"; subtitle: "Presence"; route-id: "discord"; activated(route) => { root.navigate(route); } }
                        PulseTile { row: 2; col: 3; icon: "▷"; title: "YouTube"; subtitle: "Watch"; route-id: "youtube"; activated(route) => { root.navigate(route); } }
                        PulseTile { row: 3; col: 0; icon: "⚙"; title: "Settings"; subtitle: "Control"; route-id: "settings"; activated(route) => { root.navigate(route); } }
                        PulseTile { row: 3; col: 1; icon: "◌"; title: "Customise"; subtitle: "Glass and layout"; route-id: "customization"; activated(route) => { root.navigate(route); } }
                        PulseTile { row: 3; col: 2; icon: "↻"; title: "Updates"; subtitle: "Version history"; route-id: "version-history"; activated(route) => { root.navigate(route); } }
                        PulseTile { row: 3; col: 3; icon: "◎"; title: "Zink Connect"; subtitle: "Browser hub"; route-id: "zink-connect"; activated(route) => { root.navigate(route); } }
                        PulseTile { row: 4; col: 0; icon: "⌁"; title: "Streaming"; subtitle: "Live studio"; route-id: "streaming"; activated(route) => { root.navigate(route); } }
                        PulseTile { row: 4; col: 1; icon: "★"; title: "Review"; subtitle: "Leave feedback"; route-id: "review"; activated(route) => { root.navigate(route); } }
                    }
                }
                VerticalLayout {
                    width: 315px; spacing: 12px;
                    Rectangle { height: 96px; background: transparent; VerticalLayout { Text { text: "Zink Social"; color: #ffffffe8; font-size: 23px; font-weight: 650; } Text { text: "Friends, messages, calls, and profiles."; color: #9fb2ac; font-size: 12px; } Rectangle { vertical-stretch: 1; background: transparent; } } }
                    Rectangle { height: 62px; border-radius: 16px; background: #00161da8; border-width: 1px; border-color: #5ae8e040; VerticalLayout { padding: 10px; Text { text: "Sign in to see friends online"; color: #ffffffdf; font-size: 12px; } Text { text: "Open Friends to connect"; color: #9fb2ac; font-size: 11px; } } }
                    Text { text: "Online now"; color: #cfe7df; font-size: 12px; }
                    Text { text: "No friends are online right now."; color: #83958f; font-size: 11px; }
                    GridLayout { spacing: 10px;
                        CompactTile { row: 0; col: 0; icon: "♧"; title: "Friends online"; subtitle: "View status"; route-id: "friends"; activated(route) => { root.navigate(route); } }
                        CompactTile { row: 0; col: 1; icon: "≡"; title: "Messages"; subtitle: "Open chats"; route-id: "messages"; activated(route) => { root.navigate(route); } }
                        CompactTile { row: 1; col: 0; icon: "⌕"; title: "Call"; subtitle: "Voice or video"; route-id: "call"; activated(route) => { root.navigate(route); } }
                        CompactTile { row: 1; col: 1; icon: "▣"; title: "Video call"; subtitle: "Share your screen"; route-id: "call"; activated(route) => { root.navigate(route); } }
                        CompactTile { row: 2; col: 0; icon: "○"; title: "My profile"; subtitle: "View and edit"; route-id: "profile"; activated(route) => { root.navigate(route); } }
                        CompactTile { row: 2; col: 1; icon: "+"; title: "Add friends"; subtitle: "Find people"; route-id: "friends"; activated(route) => { root.navigate(route); } }
                    }
                    Text { text: "Zink Pulse"; color: #ffffffe8; font-size: 21px; font-weight: 650; }
                    GridLayout { spacing: 10px;
                        CompactTile { row: 0; col: 0; icon: "♫"; title: "Music"; subtitle: "Open the player"; route-id: "music-player"; activated(route) => { root.navigate(route); } }
                        CompactTile { row: 0; col: 1; icon: "▣"; title: "Video"; subtitle: "Watch a file"; route-id: "video-player"; activated(route) => { root.navigate(route); } }
                        CompactTile { row: 1; col: 0; icon: "◉"; title: "Radio"; subtitle: "Live stations"; route-id: "radio"; activated(route) => { root.navigate(route); } }
                        CompactTile { row: 1; col: 1; icon: "⌁"; title: "FPS"; subtitle: "Overlay and capture"; route-id: "fps-recorder"; activated(route) => { root.navigate(route); } }
                        CompactTile { row: 2; col: 0; icon: "⚙"; title: "Settings"; subtitle: "App controls"; route-id: "settings"; activated(route) => { root.navigate(route); } }
                        CompactTile { row: 2; col: 1; icon: "◌"; title: "Customise"; subtitle: "Glass and layout"; route-id: "customization"; activated(route) => { root.navigate(route); } }
                    }
                }
                }
            }

            if root.current-route == "music-player" && !root.music-fullscreen: Rectangle {
                background: #061217e8; border-radius: 22px; clip: true;
                Image { source: root.album-art; image-fit: cover; width: parent.width; height: parent.height; opacity: root.music-queue.length == 0 ? 0.03 : 0.13; }
                Rectangle { width: parent.width; height: parent.height; background: root.artwork-accent; opacity: root.music-queue.length == 0 ? 0.02 : 0.09; }
                Rectangle { width: parent.width; height: parent.height; background: @linear-gradient(180deg, #06121758 0%, #061217f4 48%, #061217ff 100%); }
                redesigned-music-scroll := ZinkScrollView { width: parent.width; height: parent.height; content-height: redesigned-music-content.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.always-on; horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    redesigned-music-content := VerticalLayout { width: redesigned-music-scroll.visible-width - 14px; padding: 28px; spacing: 24px;
                        HorizontalLayout { height: 44px; VerticalLayout { Text { text: "ZINK MUSIC"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: "Now Playing"; color: white; font-size: 25px; font-weight: 700; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 118px; border-radius: 20px; background: add-music-touch.has-hover ? #ffffff20 : #ffffff10; border-width: 1px; border-color: #ffffff2d; HorizontalLayout { alignment: center; spacing: 7px; FluentGlyph { glyph: ""; width: 18px; font-size: 15px; } Text { text: root.music-queue.length == 0 ? "Choose music" : "Add music"; color: white; font-size: 11px; vertical-alignment: center; } } add-music-touch := TouchArea { clicked => { root.browse-music-files(); } } } Rectangle { width: 42px; border-radius: 21px; background: page-queue-touch.has-hover || root.queue-panel-open ? #38ff6625 : #ffffff10; FluentGlyph { glyph: ""; color: root.queue-panel-open ? #38ff66 : white; font-size: 17px; } page-queue-touch := TouchArea { clicked => { root.queue-panel-open = !root.queue-panel-open; } } } Rectangle { width: 42px; border-radius: 21px; background: page-full-touch.has-hover ? #ffffff20 : #ffffff10; FluentGlyph { glyph: ""; font-size: 16px; } page-full-touch := TouchArea { clicked => { root.artist-panel-open = true; root.request-artist-info(root.track-detail); root.music-fullscreen = true; root.set-app-fullscreen(true); } } } }
                        if root.music-queue.length == 0: Rectangle { height: 450px; border-radius: 26px; background: #ffffff07; border-width: 1px; border-color: #ffffff15;
                            VerticalLayout {
                                alignment: center; spacing: 14px;
                                HorizontalLayout { height: 142px; alignment: center; Rectangle { width: 142px; height: 142px; border-radius: 36px; background: @linear-gradient(135deg, #11d8e838 0%, #38ff6628 100%); clip: true; Image { source: @image-url("../../../../Assets/QuickAccess/music-player.png"); image-fit: cover; width: parent.width; height: parent.height; } } }
                                Text { text: "Play something you love"; color: white; font-size: 32px; font-weight: 750; horizontal-alignment: center; }
                                Text { text: "Choose one or more songs from this PC"; color: #9db0aa; font-size: 14px; horizontal-alignment: center; }
                                HorizontalLayout { height: 46px; alignment: center; spacing: 10px;
                                    Rectangle { width: 154px; height: 46px; border-radius: 23px; background: empty-browse-touch.has-hover ? #62ff82 : #38ff66; Text { text: "Choose music"; color: #051209; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } empty-browse-touch := TouchArea { clicked => { root.browse-music-files(); } } }
                                    Rectangle { width: 154px; height: 46px; border-radius: 23px; background: empty-library-touch.has-hover ? #ffffff18 : #ffffff0b; border-width: 1px; border-color: #ffffff22; Text { text: "Open library"; color: white; font-size: 12px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } empty-library-touch := TouchArea { clicked => { root.navigate("music-library"); } } }
                                    if root.has-restorable-session: Rectangle { width: 174px; height: 46px; border-radius: 23px; background: restore-session-touch.has-hover ? #38ff6630 : #ffffff0b; border-width: 1px; border-color: #38ff6650; Text { text: "Restore last session"; color: #38ff66; font-size: 12px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } restore-session-touch := TouchArea { clicked => { root.restore-last-music-session(); } } }
                                }
                                Text { text: "Selected songs start automatically • Your original files stay untouched"; color: #71857f; font-size: 10px; horizontal-alignment: center; }
                            }
                        }
                        if root.music-queue.length > 0: HorizontalLayout { height: root.width < 1600px ? 500px : 660px; spacing: root.width < 1600px ? 25px : 60px; alignment: center;
                            Rectangle { width: parent.width < 1250px ? 430px : 530px; height: self.width; border-radius: 28px; background: #001016; clip: true; Image { source: root.album-art; image-fit: cover; width: parent.width; height: parent.height; } Rectangle { y: parent.height - 110px; width: parent.width; height: 110px; background: @linear-gradient(0deg, #001016b8 0%, #00101600 100%); } }
                            VerticalLayout { width: parent.width < 1250px ? 500px : 650px; spacing: 18px; alignment: center; Text { text: root.track-title; color: white; font-size: 38px; font-weight: 750; wrap: word-wrap; height: 98px; vertical-alignment: center; } Text { text: root.track-detail; color: #38ff66; font-size: 21px; } Text { text: root.track-album; color: #9db0aa; font-size: 13px; } HorizontalLayout { height: 42px; spacing: 10px; Rectangle { width: 104px; border-radius: 21px; background: root.current-track-liked ? #38ff66 : #ffffff10; border-width: 1px; border-color: root.current-track-liked ? #38ff66 : #ffffff2d; HorizontalLayout { alignment: center; spacing: 7px; Text { text: root.current-track-liked ? "♥" : "♡"; color: root.current-track-liked ? #06110a : white; width: 18px; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; } Text { text: root.current-track-liked ? "Liked" : "Like"; color: root.current-track-liked ? #06110a : white; font-size: 11px; vertical-alignment: center; } } TouchArea { clicked => { root.current-track-liked = !root.current-track-liked; root.set-track-liked(root.current-track-liked); } } } Rectangle { width: 104px; border-radius: 21px; background: root.more-menu-open ? #ffffff20 : more-actions-touch.has-hover ? #ffffff18 : #ffffff10; Text { text: "•••  More"; color: white; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } more-actions-touch := TouchArea { clicked => { root.more-menu-open = !root.more-menu-open; } } } } AccessiblePlayerSlider { height: 24px; value: root.position-ratio; label: "Playback position"; keyboard-step: 0.025; changed(value) => { root.seek(value); } } HorizontalLayout { height: 18px; Text { text: root.position-text; color: #9db0aa; font-size: 10px; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.duration-text; color: #9db0aa; font-size: 10px; } } HorizontalLayout { height: 68px; spacing: 18px; alignment: center; AccessiblePlayerButton { width: 42px; height: 42px; glyph: ""; label: root.music-shuffle ? "Disable shuffle" : "Enable shuffle"; glyph-size: 18px; glyph-color: root.music-shuffle ? #38ff66 : white; activated => { root.music-shuffle = !root.music-shuffle; root.set-music-shuffle(root.music-shuffle); } } AccessiblePlayerButton { width: 48px; height: 48px; glyph: ""; label: "Previous track"; glyph-size: 23px; activated => { root.previous-music(); } } AccessiblePlayerButton { width: 64px; height: 64px; glyph: root.is-playing ? "" : ""; label: root.is-playing ? "Pause" : "Play"; glyph-size: 24px; glyph-color: #051209; normal-background: #f3fff7; hover-background: #ffffff; activated => { root.toggle-playback(); } } AccessiblePlayerButton { width: 48px; height: 48px; glyph: ""; label: "Next track"; glyph-size: 23px; activated => { root.next-music(); } } AccessiblePlayerButton { width: 42px; height: 42px; glyph: ""; label: root.music-repeat ? "Disable repeat" : "Repeat current track"; glyph-size: 18px; glyph-color: root.music-repeat ? #38ff66 : white; activated => { root.music-repeat = !root.music-repeat; root.set-music-repeat(root.music-repeat); } } } HorizontalLayout { height: 28px; spacing: 9px; FluentGlyph { glyph: root.volume-percent == 0 ? "" : ""; width: 22px; font-size: 16px; } AccessiblePlayerSlider { horizontal-stretch: 1; height: 16px; value: root.volume-percent / 100; label: "Volume"; keyboard-step: 0.05; changed(value) => { root.set-volume(value); } } Text { text: root.volume-percent + "%"; color: #9db0aa; font-size: 10px; width: 34px; vertical-alignment: center; } } }
                        }
                        if root.music-queue.length > 0: Rectangle { height: 314px; border-radius: 20px; background: #ffffff08; border-width: 1px; border-color: #ffffff12;
                            VerticalLayout { padding: 18px; spacing: 10px;
                                HorizontalLayout { height: 42px;
                                    VerticalLayout { Text { text: "Latest releases"; color: white; font-size: 22px; font-weight: 700; } Text { text: root.artist-releases.length > 0 ? "Albums and singles from " + root.track-detail : root.artist-info-status; color: #9db0aa; font-size: 10px; } }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Text { text: root.artist-releases.length + " releases"; color: #38ff66; font-size: 11px; vertical-alignment: center; }
                                }
                                main-release-shelf := ZinkScrollView { vertical-stretch: 1; content-width: main-release-row.preferred-width; horizontal-scrollbar-policy: ScrollBarPolicy.always-on; vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                    main-release-row := HorizontalLayout { height: main-release-shelf.visible-height - 20px; spacing: 12px;
                                        for release in root.artist-releases: Rectangle { width: 190px; height: 194px; border-radius: 15px; background: main-release-touch.has-hover ? #ffffff18 : #ffffff0b; border-width: 1px; border-color: main-release-touch.has-hover ? #38ff6650 : #ffffff10;
                                            VerticalLayout { padding: 11px; spacing: 7px;
                                                Rectangle { width: 138px; height: 138px; border-radius: 12px; background: @linear-gradient(135deg, #11d8e840 0%, #38ff6638 100%); clip: true; FluentGlyph { glyph: release.release-type == "Single" ? "" : ""; color: #38ff66; font-size: 30px; } Image { source: release.artwork; image-fit: cover; width: parent.width; height: parent.height; } }
                                                Text { text: release.title; color: white; font-size: 12px; font-weight: 650; overflow: elide; }
                                                Text { text: release.release-type + " • " + release.release-date; color: #9db0aa; font-size: 9px; overflow: elide; }
                                            }
                                            main-release-touch := TouchArea { clicked => { root.open-artist-release(release.id, release.title); } }
                                        }
                                    }
                                }
                            }
                        }
                        if root.music-queue.length > 0: HorizontalLayout { height: 330px; spacing: 20px;
                            Rectangle { horizontal-stretch: 3; border-radius: 20px; background: #ffffff08; VerticalLayout { padding: 20px; spacing: 9px; HorizontalLayout { height: 32px; Text { text: "Lyrics"; color: white; font-size: 22px; font-weight: 700; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "Select a line to seek"; color: #71857f; font-size: 10px; vertical-alignment: center; } } Text { text: root.lyrics-status; color: #9db0aa; font-size: 10px; } redesigned-lyrics := ListView { vertical-stretch: 1; for lyric[index] in root.lyric-lines: Rectangle { height: 42px; border-radius: 8px; background: index == root.active-lyric-index ? #38ff661c : redesigned-lyric-touch.has-hover ? #ffffff0a : transparent; Text { x: 10px; width: parent.width - 20px; text: lyric.text; color: index == root.active-lyric-index ? #38ff66 : #dce9e5; font-size: index == root.active-lyric-index ? 15px : 13px; font-weight: index == root.active-lyric-index ? 650 : 400; vertical-alignment: center; overflow: elide; } redesigned-lyric-touch := TouchArea { clicked => { root.seek-to-lyric(lyric.start-ms); } } } } } }
                            Rectangle { horizontal-stretch: 2; border-radius: 20px; background: #ffffff08; VerticalLayout { padding: 20px; spacing: 10px; Text { text: "Listening details"; color: white; font-size: 22px; font-weight: 700; } Text { text: "Local Windows playback"; color: #38ff66; font-size: 12px; } Rectangle { height: 34px; border-radius: 17px; background: #38ff6613; border-width: 1px; border-color: #38ff6630; Text { text: root.track-technical-detail; color: #dffff0; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; } } Text { text: root.current-music-path; color: #9db0aa; font-size: 10px; wrap: word-wrap; } Text { text: "Playback speed"; color: white; font-size: 11px; font-weight: 650; } HorizontalLayout { height: 30px; spacing: 5px; for rate in [0.75, 1.0, 1.25, 1.5, 2.0]: Rectangle { horizontal-stretch: 1; border-radius: 8px; background: root.playback-rate == rate ? #38ff6630 : speed-touch.has-hover ? #ffffff15 : #ffffff08; border-width: root.playback-rate == rate ? 1px : 0px; border-color: #38ff6680; Text { text: rate + "×"; color: root.playback-rate == rate ? #38ff66 : white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } speed-touch := TouchArea { clicked => { root.set-playback-rate(rate); } } } } Text { text: "Crossfade"; color: white; font-size: 11px; font-weight: 650; } HorizontalLayout { height: 30px; spacing: 5px; for seconds in [0, 2, 4, 6, 8]: Rectangle { horizontal-stretch: 1; border-radius: 8px; background: root.crossfade-seconds == seconds ? #38ff6630 : fade-touch.has-hover ? #ffffff15 : #ffffff08; border-width: root.crossfade-seconds == seconds ? 1px : 0px; border-color: #38ff6680; Text { text: seconds == 0 ? "Gapless" : seconds + "s"; color: root.crossfade-seconds == seconds ? #38ff66 : white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } fade-touch := TouchArea { clicked => { root.crossfade-seconds = seconds; root.set-crossfade-seconds(seconds); } } } } Rectangle { vertical-stretch: 1; background: transparent; } Rectangle { height: 42px; border-radius: 21px; background: root.music-background ? #38ff6623 : #ffffff0b; border-width: 1px; border-color: root.music-background ? #38ff6660 : #ffffff20; Text { text: root.music-background ? "Background playback on" : "Enable background playback"; color: white; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.music-background = !root.music-background; root.set-music-background(root.music-background); } } } } }
                        }
                        Rectangle { height: 112px; border-radius: 20px; background: #ffffff08; HorizontalLayout { padding: 16px; spacing: 18px; VerticalLayout { width: 280px; spacing: 4px; Text { text: "ReplayGain normalization"; color: white; font-size: 17px; font-weight: 700; } Text { text: "Non-destructive loudness matching with peak protection"; color: #9db0aa; font-size: 9px; wrap: word-wrap; } } Rectangle { width: 108px; border-radius: 18px; background: root.normalization-enabled ? #38ff6630 : #ffffff0b; border-width: 1px; border-color: root.normalization-enabled ? #38ff6670 : #ffffff20; Text { text: root.normalization-enabled ? "Enabled" : "Disabled"; color: root.normalization-enabled ? #38ff66 : white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.normalization-enabled = !root.normalization-enabled; root.set-normalization(root.normalization-enabled, root.normalization-preamp-db); } } } Rectangle { width: 20px; background: transparent; } VerticalLayout { horizontal-stretch: 1; spacing: 5px; Text { text: "Preamp"; color: white; font-size: 11px; font-weight: 650; } HorizontalLayout { height: 34px; spacing: 6px; for gain in [-6, -3, 0, 3, 6]: Rectangle { horizontal-stretch: 1; border-radius: 9px; background: root.normalization-preamp-db == gain ? #38ff6630 : gain-touch.has-hover ? #ffffff15 : #ffffff08; border-width: root.normalization-preamp-db == gain ? 1px : 0px; border-color: #38ff6670; Text { text: gain > 0 ? "+" + gain + " dB" : gain + " dB"; color: root.normalization-preamp-db == gain ? #38ff66 : white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } gain-touch := TouchArea { clicked => { root.normalization-preamp-db = gain; root.set-normalization(root.normalization-enabled, gain); } } } } } } }
                        if root.top-tracks.length > 0 || root.rediscovery-tracks.length > 0: Rectangle { height: 259px; border-radius: 20px; background: #ffffff08; VerticalLayout { padding: 18px; spacing: 10px; HorizontalLayout { height: 52px; VerticalLayout { Text { text: "Your listening"; color: white; font-size: 20px; font-weight: 700; } Text { text: "Built privately from playback on this PC"; color: #9db0aa; font-size: 9px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.listening-time-summary; color: #38ff66; font-size: 12px; vertical-alignment: center; } Text { text: root.listening-plays-summary; color: white; font-size: 11px; vertical-alignment: center; } Text { text: root.listening-tracks-summary; color: #9db0aa; font-size: 11px; vertical-alignment: center; } } HorizontalLayout { vertical-stretch: 1; spacing: 16px; VerticalLayout { horizontal-stretch: 1; spacing: 6px; Text { text: "Most played"; color: white; font-size: 14px; font-weight: 650; } top-strip := ZinkScrollView { vertical-stretch: 1; content-width: top-row.preferred-width; horizontal-scrollbar-policy: ScrollBarPolicy.always-on; vertical-scrollbar-policy: ScrollBarPolicy.always-off; top-row := HorizontalLayout { height: top-strip.visible-height - 14px; spacing: 8px; for track in root.top-tracks: Rectangle { width: 185px; border-radius: 11px; background: top-touch.has-hover ? #38ff6618 : #ffffff08; VerticalLayout { padding: 11px; spacing: 4px; Text { text: "▲"; color: #38ff66; font-size: 13px; } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: track.title; color: white; font-size: 11px; font-weight: 650; overflow: elide; } Text { text: track.artist; color: #9db0aa; font-size: 9px; overflow: elide; } Text { text: track.detail; color: #38ff66; font-size: 8px; overflow: elide; } } top-touch := TouchArea { clicked => { root.play-library-item(track.path); } } } } } } VerticalLayout { horizontal-stretch: 1; spacing: 6px; Text { text: "Rediscover"; color: white; font-size: 14px; font-weight: 650; } rediscover-strip := ZinkScrollView { vertical-stretch: 1; content-width: rediscover-row.preferred-width; horizontal-scrollbar-policy: ScrollBarPolicy.always-on; vertical-scrollbar-policy: ScrollBarPolicy.always-off; rediscover-row := HorizontalLayout { height: rediscover-strip.visible-height - 14px; spacing: 8px; for track in root.rediscovery-tracks: Rectangle { width: 185px; border-radius: 11px; background: rediscover-touch.has-hover ? #38ff6618 : #ffffff08; VerticalLayout { padding: 11px; spacing: 4px; Text { text: "↶"; color: #38ff66; font-size: 15px; } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: track.title; color: white; font-size: 11px; font-weight: 650; overflow: elide; } Text { text: track.artist; color: #9db0aa; font-size: 9px; overflow: elide; } Text { text: track.detail; color: #9db0aa; font-size: 8px; overflow: elide; } } rediscover-touch := TouchArea { clicked => { root.play-library-item(track.path); } } } } } } } } }
                        if root.music-playlists.length > 0 || root.recently-played.length > 0: HorizontalLayout { height: 190px; spacing: 20px;
                            Rectangle { horizontal-stretch: 1; border-radius: 20px; background: #ffffff08; VerticalLayout { padding: 18px; spacing: 8px; Text { text: "Your playlists"; color: white; font-size: 19px; font-weight: 700; } playlist-strip := Flickable { vertical-stretch: 1; content-width: playlist-strip-row.preferred-width; playlist-strip-row := HorizontalLayout { spacing: 9px; for playlist in root.music-playlists: Rectangle { width: 180px; border-radius: 12px; background: playlist-touch.has-hover ? #38ff6618 : #ffffff08; VerticalLayout { padding: 12px; spacing: 5px; Text { text: "≡"; color: #38ff66; font-size: 22px; } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: playlist.name; color: white; font-size: 12px; font-weight: 650; overflow: elide; } Text { text: playlist.detail; color: #9db0aa; font-size: 9px; overflow: elide; } } playlist-touch := TouchArea { clicked => { root.load-music-playlist(playlist.name); } } } } } } }
                            Rectangle { horizontal-stretch: 1; border-radius: 20px; background: #ffffff08; VerticalLayout { padding: 18px; spacing: 8px; Text { text: "Recently played"; color: white; font-size: 19px; font-weight: 700; } recent-strip := ZinkScrollView { vertical-stretch: 1; content-width: recent-strip-row.preferred-width; horizontal-scrollbar-policy: ScrollBarPolicy.always-on; vertical-scrollbar-policy: ScrollBarPolicy.always-off; recent-strip-row := HorizontalLayout { height: recent-strip.visible-height - 14px; spacing: 9px; for track in root.recently-played: Rectangle { width: 190px; border-radius: 12px; background: recent-touch.has-hover ? #38ff6618 : #ffffff08; VerticalLayout { padding: 12px; spacing: 5px; Text { text: "↶"; color: #38ff66; font-size: 20px; } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: track.title; color: white; font-size: 12px; font-weight: 650; overflow: elide; } Text { text: track.artist == "" ? "Unknown artist" : track.artist; color: #9db0aa; font-size: 9px; overflow: elide; } } recent-touch := TouchArea { clicked => { root.play-library-item(track.path); } } } } } } }
                        }
                        Rectangle { height: 118px; border-radius: 20px; background: #ffffff08; VerticalLayout { padding: 16px; spacing: 8px; HorizontalLayout { height: 24px; Text { text: "Play on this device"; color: white; font-size: 17px; font-weight: 700; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.selected-audio-device-name; color: #38ff66; font-size: 10px; vertical-alignment: center; overflow: elide; } Rectangle { width: 74px; border-radius: 12px; background: refresh-device-touch.has-hover ? #ffffff18 : #ffffff0b; Text { text: "Refresh"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } refresh-device-touch := TouchArea { clicked => { root.refresh-audio-devices(); } } } } device-strip := Flickable { vertical-stretch: 1; content-width: device-row.preferred-width; device-row := HorizontalLayout { spacing: 7px; for device in root.audio-output-devices: Rectangle { width: 210px; border-radius: 10px; background: root.selected-audio-device-id == device.id ? #38ff6625 : device-touch.has-hover ? #ffffff15 : #ffffff08; border-width: root.selected-audio-device-id == device.id ? 1px : 0px; border-color: #38ff6670; HorizontalLayout { padding: 10px; spacing: 8px; Text { text: "◉"; color: root.selected-audio-device-id == device.id ? #38ff66 : #9db0aa; vertical-alignment: center; } Text { text: device.name; color: white; font-size: 10px; vertical-alignment: center; overflow: elide; } } device-touch := TouchArea { clicked => { root.select-audio-device(device.id, device.name); } } } } } } }
                        Text { text: root.music-queue.length == 0 ? "Recently added" : "Up next"; color: white; font-size: 23px; font-weight: 700; }
                        if root.music-queue.length == 0 && root.library-items.length == 0: Rectangle { height: 116px; border-radius: 16px; background: #ffffff06; border-width: 1px; border-color: #ffffff12; HorizontalLayout { padding: 18px; spacing: 14px; Rectangle { width: 54px; height: 54px; border-radius: 14px; background: #38ff6615; FluentGlyph { glyph: ""; color: #38ff66; font-size: 20px; } } VerticalLayout { alignment: center; Text { text: "Build your music library"; color: white; font-size: 14px; font-weight: 650; } Text { text: "Index a folder to see recently added albums and songs here."; color: #9db0aa; font-size: 11px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 128px; height: 40px; border-radius: 20px; background: import-library-touch.has-hover ? #ffffff18 : #ffffff0b; Text { text: "Import folder"; color: white; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } import-library-touch := TouchArea { clicked => { root.import-library(); } } } } }
                        if root.music-queue.length == 0 && root.library-items.length > 0: AccessibleLibraryShelf { height: 154px; tracks: root.library-items; play(path) => { root.play-library-item(path); } }
                        if root.music-queue.length > 0: AccessibleTrackShelf { height: 150px; tracks: root.selected-music; current-index: root.music-current-index; is-playing: root.is-playing; play(index) => { root.play-music-index(index); } }
                    }
                }
                if root.more-menu-open: Rectangle {
                    x: parent.width - 430px; y: 210px; width: 300px; height: 310px; border-radius: 18px; background: #11191bfc; border-width: 1px; border-color: #ffffff28;
                    VerticalLayout { padding: 14px; spacing: 6px;
                        Text { text: "Track actions"; color: white; font-size: 16px; font-weight: 700; }
                        Text { text: root.track-title; color: #9db0aa; font-size: 10px; overflow: elide; }
                        Rectangle { height: 38px; border-radius: 9px; background: action-queue.has-hover ? #ffffff15 : transparent; Text { text: "Open queue"; color: white; font-size: 11px; x: 12px; vertical-alignment: center; } action-queue := TouchArea { clicked => { root.more-menu-open = false; root.queue-panel-open = true; } } }
                        Rectangle { height: 38px; border-radius: 9px; background: action-location.has-hover ? #ffffff15 : transparent; Text { text: "Open file location"; color: white; font-size: 11px; x: 12px; vertical-alignment: center; } action-location := TouchArea { clicked => { root.open-current-file-location(); root.more-menu-open = false; } } }
                        Rectangle { height: 38px; border-radius: 9px; background: action-fullscreen.has-hover ? #ffffff15 : transparent; Text { text: "Open full-screen player"; color: white; font-size: 11px; x: 12px; vertical-alignment: center; } action-fullscreen := TouchArea { clicked => { root.more-menu-open = false; root.artist-panel-open = true; root.request-artist-info(root.track-detail); root.music-fullscreen = true; root.set-app-fullscreen(true); } } }
                        Rectangle { height: 38px; border-radius: 9px; background: action-save.has-hover ? #ffffff15 : transparent; Text { text: "Save queue as playlist"; color: white; font-size: 11px; x: 12px; vertical-alignment: center; } action-save := TouchArea { clicked => { root.save-music-queue(); root.more-menu-open = false; } } }
                        Text { text: "Sleep timer • " + root.sleep-timer-status; color: #71857f; font-size: 9px; }
                        HorizontalLayout { height: 34px; spacing: 5px; for minutes in [0, 15, 30, 60]: Rectangle { horizontal-stretch: 1; border-radius: 8px; background: sleep-touch.has-hover ? #38ff6625 : #ffffff0b; Text { text: minutes == 0 ? "Off" : minutes + "m"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } sleep-touch := TouchArea { clicked => { root.set-sleep-timer(minutes); } } } }
                    }
                }
                if root.queue-panel-open: Rectangle { x: parent.width - 390px; y: 16px; width: 374px; height: parent.height - 32px; border-radius: 20px; background: #11191bfc; border-width: 1px; border-color: #ffffff25;
                    VerticalLayout { padding: 16px; spacing: 10px; HorizontalLayout { height: 38px; Text { text: "Queue"; color: white; font-size: 23px; font-weight: 700; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 34px; height: 34px; border-radius: 17px; background: redesigned-close-touch.has-hover ? #ffffff20 : #ffffff0d; FluentGlyph { glyph: ""; font-size: 13px; } redesigned-close-touch := TouchArea { clicked => { root.queue-panel-open = false; } } } } Text { text: root.music-queue.length + " tracks"; color: #9db0aa; font-size: 10px; } AccessibleQueueList { vertical-stretch: 1; tracks: root.music-queue; current-index: root.music-current-index; is-playing: root.is-playing; play(index) => { root.play-music-index(index); } remove(index) => { root.remove-queue-item(index); } move-item(from, to) => { root.move-queue-item(from, to); } } HorizontalLayout { height: 38px; spacing: 8px; Rectangle { horizontal-stretch: 1; border-radius: 19px; background: #ffffff0d; Text { text: "Clear"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.clear-music-queue(); } } } Rectangle { horizontal-stretch: 1; border-radius: 19px; background: #38ff6625; Text { text: "Save playlist"; color: #38ff66; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.save-music-queue(); } } } } }
                }
            }

            if false && root.current-route == "music-player" && !root.music-fullscreen: HorizontalLayout {
                spacing: 16px;
                Rectangle {
                    horizontal-stretch: 9; border-radius: 16px; background: #071b25cc; border-width: 1px; border-color: #bceef238;
                    VerticalLayout { padding: 20px; spacing: 12px;
                        HorizontalLayout { height: 30px; Text { text: "Queue"; color: #fffffff7; font-size: 24px; font-weight: 650; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "☷"; color: #e7fff6a8; font-size: 18px; } }
                        Rectangle { height: 260px; background: transparent;
                            if root.music-queue.length == 0: Text { text: "Your queue is empty"; color: #e7fff6a8; horizontal-alignment: center; vertical-alignment: center; }
                            queue-list := ListView {
                                for track[index] in root.music-queue: Rectangle { height: 56px; border-radius: 8px; background: index == root.music-current-index ? #19a7b538 : queue-touch.has-hover ? #ffffff12 : transparent; border-width: index == root.music-current-index ? 1px : 0px; border-color: #38ff6670;
                                    HorizontalLayout { padding: 9px; spacing: 10px; Text { text: "♫"; color: #38ff66; vertical-alignment: center; } VerticalLayout { Text { text: track.title; color: white; overflow: elide; } Text { text: track.artist == "" ? "Unknown artist" : track.artist; color: #e7fff6a8; font-size: 10px; overflow: elide; } } }
                                    queue-touch := TouchArea { clicked => { root.play-music-index(index); } }
                                }
                            }
                        }
                        Text { text: "Lyrics"; color: #fffffff7; font-size: 20px; font-weight: 650; }
                        Text { text: root.lyrics-status; color: #e7fff6a8; font-size: 11px; wrap: word-wrap; }
                        lyrics-scroll := Flickable { vertical-stretch: 1; content-height: lyrics-content.preferred-height;
                            lyrics-content := VerticalLayout { width: lyrics-scroll.width; spacing: 4px;
                                for lyric[index] in root.lyric-lines: Rectangle { min-height: 38px; border-radius: 8px; background: index == root.active-lyric-index ? #19a7b524 : transparent; Text { text: lyric.text; color: index == root.active-lyric-index ? #38ff66 : #e7fff6a8; font-size: index == root.active-lyric-index ? 14px : 13px; font-weight: index == root.active-lyric-index ? 650 : 400; wrap: word-wrap; x: 10px; width: parent.width - 20px; vertical-alignment: center; } }
                            }
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 15; border-radius: 16px; background: #071b25cc; border-width: 1px; border-color: #bceef238;
                    VerticalLayout { padding: 20px; spacing: 9px; alignment: center;
                        HorizontalLayout { height: 38px; Text { text: "Now Playing"; color: #fffffff7; font-size: 24px; font-weight: 650; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 118px; border-radius: 18px; background: fullscreen-music-touch.has-hover ? #2ddbe740 : #ffffff12; border-width: 1px; border-color: #bceef248; HorizontalLayout { alignment: center; spacing: 7px; FluentGlyph { glyph: ""; width: 18px; font-size: 15px; } Text { text: "Full screen"; color: white; font-size: 11px; vertical-alignment: center; } } fullscreen-music-touch := TouchArea { clicked => { root.artist-panel-open = true; root.request-artist-info(root.track-detail); root.music-fullscreen = true; root.set-app-fullscreen(true); } } } }
                        Rectangle { width: 300px; height: 300px; border-radius: 14px; background: #00080ba5; border-width: 1px; border-color: #bceef238; Image { source: root.album-art; image-fit: contain; width: parent.width; height: parent.height; } }
                        Text { text: root.track-title; color: #fffffff7; font-size: 26px; font-weight: 650; horizontal-alignment: center; overflow: elide; }
                        Text { text: root.track-detail; color: #38ff66; font-size: 16px; horizontal-alignment: center; overflow: elide; }
                        Text { text: root.track-album; color: #e7fff6a8; font-size: 13px; horizontal-alignment: center; }
                        music-progress-track := Rectangle { height: 16px; background: transparent; Rectangle { y: 5px; height: 5px; border-radius: 3px; background: #ffffff5c; Rectangle { width: parent.width * root.position-ratio; height: parent.height; border-radius: 3px; background: #38ff66; } } TouchArea { clicked => { root.seek(self.mouse-x / music-progress-track.width); } } }
                        Text { text: root.position-text + " / " + root.duration-text; color: #e7fff6a8; font-size: 12px; horizontal-alignment: center; }
                        HorizontalLayout { height: 60px; spacing: 13px; alignment: center;
                            Rectangle { width: 44px; height: 44px; border-radius: 22px; background: root.music-shuffle ? #38ff6628 : shuffle-touch.has-hover ? #ffffff12 : transparent; FluentGlyph { glyph: ""; color: root.music-shuffle ? #38ff66 : #dce9e5; font-size: 18px; } shuffle-touch := TouchArea { clicked => { root.music-shuffle = !root.music-shuffle; root.set-music-shuffle(root.music-shuffle); } } }
                            AccessiblePlayerButton { width: 44px; height: 44px; glyph: ""; label: "Previous track"; glyph-size: 18px; activated => { root.previous-music(); } }
                            AccessiblePlayerButton { width: 60px; height: 60px; glyph: root.is-playing ? "" : ""; label: root.is-playing ? "Pause" : "Play"; glyph-size: 24px; normal-background: @linear-gradient(135deg, #19a7b548 0%, #38ff6634 100%); hover-background: #2ddbe748; activated => { root.toggle-playback(); } }
                            AccessiblePlayerButton { width: 44px; height: 44px; glyph: ""; label: "Next track"; glyph-size: 18px; activated => { root.next-music(); } }
                            Rectangle { width: 44px; height: 44px; border-radius: 22px; background: root.music-repeat ? #38ff6628 : repeat-touch.has-hover ? #ffffff12 : transparent; FluentGlyph { glyph: ""; color: root.music-repeat ? #38ff66 : #dce9e5; font-size: 18px; } repeat-touch := TouchArea { clicked => { root.music-repeat = !root.music-repeat; root.set-music-repeat(root.music-repeat); } } }
                        }
                        HorizontalLayout { height: 36px; spacing: 10px; FluentGlyph { glyph: root.volume-percent == 0 ? "" : ""; width: 22px; font-size: 17px; } volume-track := Rectangle { horizontal-stretch: 1; height: 16px; background: transparent; Rectangle { y: 5px; height: 5px; border-radius: 3px; background: #ffffff35; Rectangle { width: parent.width * root.volume-percent / 100; height: parent.height; border-radius: 3px; background: #38ff66; } } TouchArea { clicked => { root.set-volume(self.mouse-x / volume-track.width); } } } Text { text: root.volume-percent + "%"; color: #e7fff6a8; font-size: 12px; vertical-alignment: center; width: 36px; } Rectangle { width: 126px; border-radius: 14px; background: root.music-background ? #38ff6630 : #19a7b524; border-width: 1px; border-color: root.music-background ? #38ff6680 : #bceef238; Text { text: "Play in Background"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.music-background = !root.music-background; root.set-music-background(root.music-background); } } } }
                    }
                }
                Rectangle {
                    horizontal-stretch: 10; border-radius: 16px; background: #071b25cc; border-width: 1px; border-color: #bceef238;
                    VerticalLayout { padding: 20px; spacing: 12px;
                        Text { text: "Browse"; color: #fffffff7; font-size: 24px; font-weight: 650; }
                        Rectangle { height: 44px; border-radius: 10px; background: browse-touch.has-hover ? #23c6d238 : #19a7b524; border-width: 1px; border-color: #bceef238; HorizontalLayout { alignment: center; spacing: 9px; FluentGlyph { glyph: ""; width: 20px; font-size: 17px; } Text { text: "Browse Music Files"; color: white; vertical-alignment: center; } } browse-touch := TouchArea { clicked => { root.browse-music-files(); } } }
                        Text { text: "Selected Files • plays automatically"; color: #e7fff6a8; font-size: 13px; font-weight: 650; }
                        Rectangle { vertical-stretch: 1; background: transparent;
                            if root.selected-music.length == 0: Text { text: "Choose one or more songs."; color: #e7fff6a8; horizontal-alignment: center; vertical-alignment: center; }
                            selected-list := ListView {
                                for track in root.selected-music: Rectangle { height: 52px; border-radius: 7px; background: #ffffff0a; HorizontalLayout { padding: 8px; spacing: 9px; Text { text: "♫"; color: #38ff66; vertical-alignment: center; } VerticalLayout { Text { text: track.title; color: white; overflow: elide; } Text { text: track.artist == "" ? track.path : track.artist; color: #e7fff6a8; font-size: 10px; overflow: elide; } } } }
                            }
                        }
                    }
                }
            }

            if root.current-route == "music-player" && root.music-fullscreen: Rectangle {
                vertical-stretch: 1;
                background: @linear-gradient(135deg, #04191ff8 0%, #082d35f8 48%, #07131afc 100%);
                Image { source: root.album-art; image-fit: cover; width: parent.width; height: parent.height; opacity: 0.11; }
                Rectangle { width: parent.width; height: parent.height; background: @linear-gradient(90deg, #001016e8 0%, #001016a8 55%, #001016e8 100%); }
                VerticalLayout {
                    padding: 38px; spacing: 22px;
                    HorizontalLayout {
                        height: 46px;
                        VerticalLayout { Text { text: "ZINK MUSIC"; color: #38ff66; font-size: 12px; font-weight: 750; } Text { text: "Now Playing"; color: white; font-size: 25px; font-weight: 650; } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Rectangle { width: 132px; border-radius: 22px; background: exit-fullscreen-touch.has-hover ? #ffffff24 : #ffffff12; border-width: 1px; border-color: #ffffff38; HorizontalLayout { alignment: center; spacing: 8px; FluentGlyph { glyph: ""; width: 18px; font-size: 16px; } Text { text: "Exit full screen"; color: white; font-size: 11px; vertical-alignment: center; } } exit-fullscreen-touch := TouchArea { clicked => { root.music-fullscreen = false; root.set-app-fullscreen(false); } } }
                    }
                    HorizontalLayout {
                        vertical-stretch: 1; spacing: 58px; alignment: center;
                        Rectangle {
                            width: 470px; height: 470px; border-radius: 30px; background: #001016d0; border-width: 1px; border-color: #bceef250; clip: true;
                            Image { source: root.album-art; image-fit: cover; width: parent.width; height: parent.height; }
                            Rectangle { y: parent.height - 100px; width: parent.width; height: 100px; background: @linear-gradient(0deg, #001016e8 0%, #00101600 100%); }
                        }
                        VerticalLayout {
                            width: 570px; spacing: 16px; alignment: center;
                            Text { text: root.track-title; color: white; font-size: 38px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; height: 98px; }
                            Text { text: root.track-detail; color: #38ff66; font-size: 22px; horizontal-alignment: center; overflow: elide; }
                            Text { text: root.track-album; color: #c5d6d1c0; font-size: 15px; horizontal-alignment: center; overflow: elide; }
                            Rectangle { height: 20px; background: transparent; }
                            AccessiblePlayerSlider { height: 24px; value: root.position-ratio; label: "Playback position"; keyboard-step: 0.025; changed(value) => { root.seek(value); } }
                            HorizontalLayout { height: 20px; Text { text: root.position-text; color: #dce9e5; font-size: 12px; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.duration-text; color: #dce9e5; font-size: 12px; horizontal-alignment: right; } }
                            HorizontalLayout { height: 90px; spacing: 22px; alignment: center;
                                Rectangle { width: 54px; height: 54px; border-radius: 27px; background: root.music-shuffle ? #38ff6630 : fs-shuffle.has-hover ? #ffffff18 : transparent; FluentGlyph { glyph: ""; color: root.music-shuffle ? #38ff66 : white; font-size: 21px; } fs-shuffle := TouchArea { clicked => { root.music-shuffle = !root.music-shuffle; root.set-music-shuffle(root.music-shuffle); } } }
                                AccessiblePlayerButton { width: 62px; height: 62px; glyph: ""; label: "Previous track"; glyph-size: 24px; normal-background: #ffffff0d; hover-background: #ffffff1d; activated => { root.previous-music(); } }
                                AccessiblePlayerButton { width: 86px; height: 86px; glyph: root.is-playing ? "" : ""; label: root.is-playing ? "Pause" : "Play"; glyph-size: 31px; glyph-color: #052015; normal-background: #38ff66; hover-background: #5cff7b; activated => { root.toggle-playback(); } }
                                AccessiblePlayerButton { width: 62px; height: 62px; glyph: ""; label: "Next track"; glyph-size: 24px; normal-background: #ffffff0d; hover-background: #ffffff1d; activated => { root.next-music(); } }
                                Rectangle { width: 54px; height: 54px; border-radius: 27px; background: root.music-repeat ? #38ff6630 : fs-repeat.has-hover ? #ffffff18 : transparent; FluentGlyph { glyph: ""; color: root.music-repeat ? #38ff66 : white; font-size: 21px; } fs-repeat := TouchArea { clicked => { root.music-repeat = !root.music-repeat; root.set-music-repeat(root.music-repeat); } } }
                            }
                            HorizontalLayout { height: 42px; spacing: 12px; FluentGlyph { glyph: root.volume-percent == 0 ? "" : ""; width: 24px; font-size: 19px; } fullscreen-volume := Rectangle { horizontal-stretch: 1; height: 20px; background: transparent; Rectangle { y: 7px; height: 6px; border-radius: 3px; background: #ffffff35; Rectangle { width: parent.width * root.volume-percent / 100; height: parent.height; border-radius: 3px; background: #38ff66; } } TouchArea { clicked => { root.set-volume(self.mouse-x / fullscreen-volume.width); } } } Text { text: root.volume-percent + "%"; color: #dce9e5; font-size: 12px; width: 40px; vertical-alignment: center; horizontal-alignment: right; } }
                        }
                    }
                }
            }

            if root.current-route == "equalizer": Rectangle {
                border-radius: 24px;
                background: #001218e8;
                eq-page := Flickable {
                    content-height: eq-content.preferred-height;
                    eq-content := VerticalLayout {
                        width: eq-page.width;
                        padding: 28px;
                        spacing: 18px;
                        HorizontalLayout {
                            height: 64px; spacing: 14px;
                            VerticalLayout { spacing: 3px; Text { text: "ZINK AUDIO"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: "Equalizer Studio"; color: white; font-size: 29px; font-weight: 750; } Text { text: "Shape every detail of your music with a profile saved locally on this PC."; color: #8da29b; font-size: 10px; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Rectangle { width: 104px; height: 42px; border-radius: 21px; background: root.equalizer-enabled ? #38ff6625 : #ffffff0c; border-width: 1px; border-color: root.equalizer-enabled ? #38ff6670 : #ffffff25; HorizontalLayout { alignment: center; spacing: 8px; Rectangle { width: 30px; height: 20px; border-radius: 10px; background: root.equalizer-enabled ? #38ff66 : #4b5a56; Rectangle { x: root.equalizer-enabled ? 13px : 3px; y: 3px; width: 14px; height: 14px; border-radius: 7px; background: white; } } Text { text: root.equalizer-enabled ? "On" : "Off"; color: white; font-size: 11px; } } TouchArea { clicked => { root.equalizer-enabled = !root.equalizer-enabled; root.set-equalizer-enabled(root.equalizer-enabled); } } }
                            Rectangle { width: 92px; height: 42px; border-radius: 21px; background: save-eq-touch.has-hover ? #38ff66 : #f4fff7; HorizontalLayout { alignment: center; spacing: 7px; FluentGlyph { width: 20px; glyph: ""; color: #051109; font-size: 15px; } Text { text: "Save"; color: #051109; font-size: 11px; font-weight: 700; vertical-alignment: center; } } save-eq-touch := TouchArea { clicked => { root.save-equalizer(); } } }
                        }
                        Rectangle {
                            height: 154px; border-radius: 20px; background: @linear-gradient(100deg, #0a3935 0%, #08222b 58%, #07161d 100%); border-width: 1px; border-color: #38ff6638;
                            HorizontalLayout { padding: 20px; spacing: 18px;
                                Rectangle { width: 92px; height: 92px; border-radius: 24px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 34px; } }
                                VerticalLayout { width: 280px; alignment: center; spacing: 5px; Text { text: "Sound profile"; color: #9eb4ad; font-size: 10px; } Text { text: root.equalizer-preset; color: white; font-size: 25px; font-weight: 750; } Text { text: root.equalizer-status; color: #a9bbb6; font-size: 9px; wrap: word-wrap; } }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                VerticalLayout { width: 310px; spacing: 8px; Text { text: "MASTER GAIN"; color: #8fa59e; font-size: 9px; font-weight: 700; } HorizontalLayout { height: 30px; spacing: 10px; master-track := Rectangle { horizontal-stretch: 1; height: 18px; background: transparent; Rectangle { y: 6px; height: 6px; border-radius: 3px; background: #ffffff25; Rectangle { width: parent.width * (root.equalizer-master-gain + 12) / 24; height: parent.height; border-radius: 3px; background: @linear-gradient(90deg, #11d8e8 0%, #38ff66 100%); } } master-gain-touch := TouchArea { clicked => { root.equalizer-master-gain = Math.max(-12, Math.min(12, self.mouse-x / master-track.width * 24 - 12)); root.set-equalizer-master-gain(root.equalizer-master-gain); } moved => { if self.pressed { root.equalizer-master-gain = Math.max(-12, Math.min(12, self.mouse-x / master-track.width * 24 - 12)); root.set-equalizer-master-gain(root.equalizer-master-gain); } } } } Text { text: (root.equalizer-master-gain > 0 ? "+" : "") + Math.round(root.equalizer-master-gain) + " dB"; color: white; font-size: 13px; font-weight: 700; width: 58px; horizontal-alignment: right; vertical-alignment: center; } } Text { text: "Keep below 0 dB to avoid clipping on loud recordings."; color: #71857f; font-size: 8px; } }
                            }
                        }
                        Rectangle {
                            height: 116px; border-radius: 18px; background: #ffffff07; border-width: 1px; border-color: #11d8e82d;
                            HorizontalLayout { padding: 16px; spacing: 15px;
                                VerticalLayout { width: 150px; alignment: center; spacing: 4px;
                                    Text { text: "LIVE INPUT"; color: #11d8e8; font-size: 8px; font-weight: 750; }
                                    Text { text: root.is-playing ? "Analysing output" : "Waiting for audio"; color: white; font-size: 14px; font-weight: 700; }
                                    Text { text: "Native WASAPI loopback"; color: #71877f; font-size: 8px; }
                                }
                                Rectangle { horizontal-stretch: 1; border-radius: 14px; background: #021116a0;
                                    HorizontalLayout { padding: 12px; spacing: 4px; alignment: end;
                                        for level in root.visualizer-spectrum: Rectangle {
                                            horizontal-stretch: 1;
                                            height: Math.max(3px, parent.height * (0.05 + level * 0.86));
                                            border-radius: 3px;
                                            background: @linear-gradient(180deg, #38ff66 0%, #11d8e8 100%);
                                            opacity: root.is-playing ? 0.55 + level * 0.45 : 0.22;
                                        }
                                    }
                                }
                                VerticalLayout { width: 76px; alignment: center; spacing: 3px;
                                    Text { text: Math.round(root.visualizer-level * 100) + "%"; color: #38ff66; font-size: 20px; font-weight: 750; horizontal-alignment: right; }
                                    Text { text: "OUTPUT LEVEL"; color: #71877f; font-size: 7px; horizontal-alignment: right; }
                                }
                            }
                        }
                        Rectangle {
                            height: 74px; border-radius: 18px; background: #ffffff08;
                            HorizontalLayout { padding: 14px; spacing: 9px;
                                Text { text: "PRESETS"; color: #8da29b; font-size: 9px; font-weight: 700; width: 62px; vertical-alignment: center; }
                                for preset in ["Flat", "Bass Boost", "Treble Boost", "Rock", "Pop", "Classical"]: Rectangle { horizontal-stretch: 1; border-radius: 18px; background: root.equalizer-preset == preset ? #38ff6628 : preset-touch.has-hover ? #ffffff18 : #ffffff09; border-width: root.equalizer-preset == preset ? 1px : 0px; border-color: #38ff6680; Text { text: preset; color: root.equalizer-preset == preset ? #38ff66 : white; font-size: 10px; font-weight: root.equalizer-preset == preset ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; } preset-touch := TouchArea { clicked => { root.apply-equalizer-preset(preset); } } }
                            }
                        }
                        Rectangle {
                            height: 410px; border-radius: 22px; background: #ffffff07; border-width: 1px; border-color: #ffffff14;
                            VerticalLayout { padding: 20px; spacing: 12px;
                                HorizontalLayout { height: 34px; VerticalLayout { Text { text: "10-band equalizer"; color: white; font-size: 18px; font-weight: 700; } Text { text: "Click or drag each frequency band from −12 dB to +12 dB"; color: #7f948e; font-size: 9px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 114px; border-radius: 17px; background: reset-eq-touch.has-hover ? #ffffff18 : #ffffff0a; border-width: 1px; border-color: #ffffff22; Text { text: "  Reset flat"; color: white; font-family: "Segoe Fluent Icons"; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } reset-eq-touch := TouchArea { clicked => { root.reset-equalizer(); } } } }
                                HorizontalLayout { vertical-stretch: 1; alignment: center; spacing: 7px;
                                    EqualizerBand { frequency: "31 Hz"; gain <=> root.equalizer-band-0; changed(value) => { root.set-equalizer-band(0, value); } }
                                    EqualizerBand { frequency: "62 Hz"; gain <=> root.equalizer-band-1; changed(value) => { root.set-equalizer-band(1, value); } }
                                    EqualizerBand { frequency: "125 Hz"; gain <=> root.equalizer-band-2; changed(value) => { root.set-equalizer-band(2, value); } }
                                    EqualizerBand { frequency: "250 Hz"; gain <=> root.equalizer-band-3; changed(value) => { root.set-equalizer-band(3, value); } }
                                    EqualizerBand { frequency: "500 Hz"; gain <=> root.equalizer-band-4; changed(value) => { root.set-equalizer-band(4, value); } }
                                    EqualizerBand { frequency: "1 kHz"; gain <=> root.equalizer-band-5; changed(value) => { root.set-equalizer-band(5, value); } }
                                    EqualizerBand { frequency: "2 kHz"; gain <=> root.equalizer-band-6; changed(value) => { root.set-equalizer-band(6, value); } }
                                    EqualizerBand { frequency: "4 kHz"; gain <=> root.equalizer-band-7; changed(value) => { root.set-equalizer-band(7, value); } }
                                    EqualizerBand { frequency: "8 kHz"; gain <=> root.equalizer-band-8; changed(value) => { root.set-equalizer-band(8, value); } }
                                    EqualizerBand { frequency: "16 kHz"; gain <=> root.equalizer-band-9; changed(value) => { root.set-equalizer-band(9, value); } }
                                }
                            }
                        }
                        HorizontalLayout { height: 136px; spacing: 16px;
                            Rectangle { horizontal-stretch: 1; border-radius: 18px; background: #ffffff07; VerticalLayout { padding: 16px; spacing: 6px; FluentGlyph { glyph: ""; color: #38ff66; font-size: 20px; width: 24px; } Text { text: "Low frequencies"; color: white; font-size: 14px; font-weight: 700; } Text { text: "31–250 Hz controls sub-bass, kick and warmth."; color: #849992; font-size: 9px; wrap: word-wrap; } } }
                            Rectangle { horizontal-stretch: 1; border-radius: 18px; background: #ffffff07; VerticalLayout { padding: 16px; spacing: 6px; FluentGlyph { glyph: ""; color: #11d8e8; font-size: 20px; width: 24px; } Text { text: "Mid frequencies"; color: white; font-size: 14px; font-weight: 700; } Text { text: "500 Hz–2 kHz shapes vocals and instrument presence."; color: #849992; font-size: 9px; wrap: word-wrap; } } }
                            Rectangle { horizontal-stretch: 1; border-radius: 18px; background: #ffffff07; VerticalLayout { padding: 16px; spacing: 6px; FluentGlyph { glyph: ""; color: #a889ff; font-size: 20px; width: 24px; } Text { text: "High frequencies"; color: white; font-size: 14px; font-weight: 700; } Text { text: "4–16 kHz adds clarity, detail and air."; color: #849992; font-size: 9px; wrap: word-wrap; } } }
                        }
                    }
                }
                ZinkScrollBar { horizontal: false; x: parent.width - 14px; y: 12px; width: 12px; height: parent.height - 24px; maximum: Math.max(0px, eq-page.content-height - eq-page.height); page-size: eq-page.height; value <=> eq-page.content-y; }
            }

            if root.current-route == "visualizer": Rectangle {
                border-radius: 24px; background: #001218e8;
                VerticalLayout { padding: 28px; spacing: 16px;
                    HorizontalLayout { height: 62px; VerticalLayout { spacing: 3px; Text { text: "ZINK AUDIO"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: "Live Visualizer"; color: white; font-size: 29px; font-weight: 750; } Text { text: "Real-time Windows output visualisation for Zink and every app on this PC."; color: #8da29b; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 116px; height: 42px; border-radius: 21px; background: root.visualizer-paused ? #ffffff0d : #38ff6624; border-width: 1px; border-color: root.visualizer-paused ? #ffffff25 : #38ff6670; Text { text: root.visualizer-paused ? "  Resume" : "  Pause"; font-family: "Segoe Fluent Icons"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.visualizer-paused = !root.visualizer-paused; root.set-visualizer-paused(root.visualizer-paused); } } } Rectangle { width: 118px; height: 42px; border-radius: 21px; background: fullscreen-visualizer-touch.has-hover ? #ffffff18 : #ffffff0d; Text { text: root.app-fullscreen ? "  Exit fullscreen" : "  Fullscreen"; font-family: "Segoe Fluent Icons"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } fullscreen-visualizer-touch := TouchArea { clicked => { root.set-app-fullscreen(!root.app-fullscreen); } } } Rectangle { width: 88px; height: 42px; border-radius: 21px; background: #f4fff7; Text { text: "  Save"; font-family: "Segoe Fluent Icons"; color: #06110a; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.save-visualizer(); } } } }
                    Rectangle { height: 82px; border-radius: 18px; background: #ffffff08; HorizontalLayout { padding: 14px; spacing: 10px;
                        Text { text: "STYLE"; color: #7f948e; width: 42px; font-size: 8px; font-weight: 700; vertical-alignment: center; }
                        for style in ["Bars", "Mirror", "Wave", "Circle", "Dots", "Tunnel", "Pulse"]: Rectangle { horizontal-stretch: 1; border-radius: 18px; background: root.visualizer-style == style ? #38ff6628 : style-touch.has-hover ? #ffffff18 : #ffffff08; border-width: root.visualizer-style == style ? 1px : 0px; border-color: #38ff6670; Text { text: style; color: root.visualizer-style == style ? #38ff66 : white; font-size: 9px; font-weight: root.visualizer-style == style ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; } style-touch := TouchArea { clicked => { root.visualizer-style = style; root.set-visualizer-style(style); } } }
                    } }
                    HorizontalLayout { height: 88px; spacing: 14px;
                        Rectangle { horizontal-stretch: 2; border-radius: 18px; background: #ffffff08; HorizontalLayout { padding: 14px; spacing: 9px; Text { text: "COLOUR"; color: #7f948e; width: 50px; font-size: 8px; font-weight: 700; vertical-alignment: center; } for colour in ["Sky", "Fire", "Neon", "Ocean", "Mono"]: Rectangle { horizontal-stretch: 1; border-radius: 16px; background: root.visualizer-color == colour ? #ffffff18 : transparent; border-width: root.visualizer-color == colour ? 1px : 0px; border-color: #ffffff30; Rectangle { width: 12px; height: 12px; x: 12px; y: (parent.height - self.height) / 2; border-radius: 6px; background: colour == "Fire" ? #ff6a32 : colour == "Neon" ? #ff31db : colour == "Ocean" ? #19d7cf : colour == "Mono" ? white : #42a5ff; } Text { x: 31px; text: colour; color: white; font-size: 9px; vertical-alignment: center; } TouchArea { clicked => { root.visualizer-color = colour; root.set-visualizer-color(colour); } } } } }
                        Rectangle { horizontal-stretch: 1; border-radius: 18px; background: #ffffff08; VerticalLayout { padding: 13px; spacing: 7px; HorizontalLayout { Text { text: "Sensitivity"; color: white; font-size: 10px; font-weight: 650; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.visualizer-sensitivity + "%"; color: #38ff66; font-size: 10px; } } sensitivity-track := Rectangle { height: 16px; background: transparent; Rectangle { y: 5px; height: 6px; border-radius: 3px; background: #ffffff25; Rectangle { width: parent.width * root.visualizer-sensitivity / 100; height: parent.height; border-radius: 3px; background: #38ff66; } } sensitivity-touch := TouchArea { clicked => { root.visualizer-sensitivity = Math.round(Math.max(0, Math.min(1, self.mouse-x / sensitivity-track.width)) * 100); root.set-visualizer-sensitivity(root.visualizer-sensitivity); } moved => { if self.pressed { root.visualizer-sensitivity = Math.round(Math.max(0, Math.min(1, self.mouse-x / sensitivity-track.width)) * 100); root.set-visualizer-sensitivity(root.visualizer-sensitivity); } } } } } }
                        Rectangle { horizontal-stretch: 1; border-radius: 18px; background: #ffffff08; VerticalLayout { padding: 13px; spacing: 7px; HorizontalLayout { Text { text: "Smoothing"; color: white; font-size: 10px; font-weight: 650; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.visualizer-smoothing + "%"; color: #11d8e8; font-size: 10px; } } smoothing-track := Rectangle { height: 16px; background: transparent; Rectangle { y: 5px; height: 6px; border-radius: 3px; background: #ffffff25; Rectangle { width: parent.width * root.visualizer-smoothing / 100; height: parent.height; border-radius: 3px; background: #11d8e8; } } smoothing-touch := TouchArea { clicked => { root.visualizer-smoothing = Math.round(Math.max(0, Math.min(1, self.mouse-x / smoothing-track.width)) * 100); root.set-visualizer-smoothing(root.visualizer-smoothing); } moved => { if self.pressed { root.visualizer-smoothing = Math.round(Math.max(0, Math.min(1, self.mouse-x / smoothing-track.width)) * 100); root.set-visualizer-smoothing(root.visualizer-smoothing); } } } } } }
                        Rectangle { width: 90px; border-radius: 18px; background: #ffffff08; Text { text: "  Reset"; font-family: "Segoe Fluent Icons"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.reset-visualizer(); } } }
                    }
                    visual-stage := Rectangle { vertical-stretch: 1; border-radius: 24px; background: @radial-gradient(circle, #0b3848 0%, #061c27 46%, #020c12 100%); border-width: 1px; border-color: #11d8e840;
                        Rectangle { x: parent.width * (0.22 - root.visualizer-level * 0.08); y: parent.height * (0.16 - root.visualizer-level * 0.06); width: parent.width * (0.56 + root.visualizer-level * 0.16); height: parent.height * (0.66 + root.visualizer-level * 0.12); border-radius: parent.height * 0.35; opacity: root.visualizer-paused ? 0.35 : 0.45 + root.visualizer-level * 0.55; background: root.visualizer-color == "Fire" ? #ff491640 : root.visualizer-color == "Neon" ? #ff22d640 : root.visualizer-color == "Ocean" ? #19e1d240 : root.visualizer-color == "Mono" ? #ffffff30 : #168eff40; }
                        if root.visualizer-style == "Circle" || root.visualizer-style == "Pulse" || root.visualizer-style == "Tunnel": Rectangle { width: Math.min(parent.width, parent.height) * (root.visualizer-style == "Pulse" ? 0.34 : 0.52); height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; border-radius: self.width / 2; background: transparent; border-width: root.visualizer-style == "Tunnel" ? 12px : 5px; border-color: root.visualizer-color == "Fire" ? #ff7838 : root.visualizer-color == "Neon" ? #ff3ee8 : root.visualizer-color == "Ocean" ? #21e0d2 : root.visualizer-color == "Mono" ? white : #42a5ff; }
                        if root.visualizer-style != "Circle" && root.visualizer-style != "Pulse" && root.visualizer-style != "Tunnel": HorizontalLayout { padding: 38px; spacing: root.visualizer-style == "Dots" ? 11px : 7px; alignment: center; for level in root.visualizer-style == "Wave" ? root.visualizer-waveform : root.visualizer-spectrum: Rectangle { horizontal-stretch: 1; height: root.visualizer-style == "Dots" ? self.width : Math.max(8px, parent.height * (0.04 + level * 0.82)); border-radius: root.visualizer-style == "Dots" ? self.width / 2 : 6px; background: root.visualizer-color == "Fire" ? @linear-gradient(180deg, #ffd33d 0%, #ff3d24 100%) : root.visualizer-color == "Neon" ? @linear-gradient(180deg, #ff31db 0%, #38ff66 100%) : root.visualizer-color == "Ocean" ? @linear-gradient(180deg, #24efd8 0%, #167bff 100%) : root.visualizer-color == "Mono" ? @linear-gradient(180deg, white 0%, #73807c 100%) : @linear-gradient(180deg, #42a5ff 0%, #11d8e8 100%); opacity: root.visualizer-paused ? 0.45 : 0.45 + level * 0.55; } }
                        Rectangle { x: 18px; y: parent.height - 50px; width: parent.width - 36px; height: 34px; border-radius: 17px; background: #00090dbd; HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 9px; alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.visualizer-paused ? #f3b43a : #38ff66; } Text { text: root.visualizer-paused ? "Animation paused" : (root.is-playing ? "Reacting to " + root.track-title : "Play music in Zink to drive the visualizer"); color: white; font-size: 9px; vertical-alignment: center; overflow: elide; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.visualizer-status; color: #8ea39c; font-size: 8px; vertical-alignment: center; } } }
                    }
                }
            }

            if root.current-route == "search": Rectangle {
                border-radius: 24px; background: #06161cde; border-width: 1px; border-color: #ffffff14;
                VerticalLayout { padding: 28px; spacing: 16px;
                    HorizontalLayout { height: 66px; VerticalLayout { Text { text: "FIND ANYTHING"; color: #38ff66; font-size: 9px; font-weight: 750; } Text { text: "Search Zink"; color: white; font-size: 30px; font-weight: 750; } Text { text: root.library-search == "" ? "Music, albums, artists, video and live radio in one search." : "Results for “" + root.library-search + "”"; color: #8da29b; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } }
                    Rectangle { height: 54px; border-radius: 27px; background: #ffffff0a; border-width: 1px; border-color: search-input.has-focus ? #38ff6680 : #ffffff18; FluentGlyph { x: 18px; width: 22px; glyph: ""; color: #38ff66; font-size: 16px; } Text { x: 48px; width: parent.width - 96px; text: root.library-search == "" ? "Search songs, albums, artists, videos or stations" : ""; color: #71877f; font-size: 11px; vertical-alignment: center; } search-input := TextInput { x: 48px; width: parent.width - 96px; height: parent.height; text: root.library-search; color: white; font-size: 12px; single-line: true; edited => { root.library-search = self.text; root.search-library(self.text); } accepted => { root.search-library(self.text); } } if root.library-search != "": Rectangle { x: parent.width - 44px; y: 9px; width: 36px; height: 36px; border-radius: 18px; background: clear-search.has-hover ? #ffffff18 : transparent; Text { text: "×"; color: white; font-size: 17px; horizontal-alignment: center; vertical-alignment: center; } clear-search := TouchArea { clicked => { root.library-search = ""; root.clear-library-search(); } } } }
                    if root.library-search == "": Rectangle { vertical-stretch: 1; border-radius: 24px; background: @linear-gradient(125deg, #0d3d35 0%, #09232b 58%, #071219 100%); VerticalLayout { alignment: center; spacing: 12px; HorizontalLayout { height: 76px; alignment: center; Rectangle { width: 76px; height: 76px; border-radius: 24px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 31px; } } } Text { text: "One search across Zink"; color: white; font-size: 23px; font-weight: 720; horizontal-alignment: center; } Text { text: "Results appear while you type and open in the correct player automatically."; color: #9db0aa; font-size: 10px; horizontal-alignment: center; } } }
                    if root.library-search != "": search-results := ZinkScrollView { vertical-stretch: 1; content-height: search-content.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.always-on; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; search-content := VerticalLayout { width: search-results.visible-width - 14px; spacing: 14px;
                        if root.library-items.length == 0 && root.search-albums.length == 0 && root.search-artists.length == 0 && root.search-stations.length == 0: Rectangle { height: 170px; border-radius: 20px; background: #ffffff06; VerticalLayout { alignment: center; spacing: 7px; Text { text: "No results found"; color: white; font-size: 18px; font-weight: 700; } Text { text: "Try a song title, artist, album, video filename, station or genre."; color: #82978f; font-size: 10px; } } }
                        if root.search-artists.length > 0: Text { text: "Artists"; color: white; font-size: 20px; font-weight: 700; }
                        if root.search-artists.length > 0: HorizontalLayout { height: 132px; spacing: 10px; for artist in root.search-artists: Rectangle { width: 190px; border-radius: 18px; background: artist-touch.has-hover ? #ffffff13 : #ffffff07; HorizontalLayout { padding: 13px; spacing: 11px; Rectangle { width: 72px; height: 72px; border-radius: 36px; clip: true; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 25px; } Image { source: artist.artwork; width: parent.width; height: parent.height; image-fit: cover; } } VerticalLayout { alignment: center; Text { text: artist.name; color: white; font-size: 12px; font-weight: 700; overflow: elide; } Text { text: artist.detail; color: #82978f; font-size: 8px; wrap: word-wrap; } Text { text: "Play artist  ›"; color: #38ff66; font-size: 8px; } } } artist-touch := TouchArea { clicked => { root.play-search-collection("artist", artist.name); } } } }
                        if root.search-albums.length > 0: Text { text: "Albums"; color: white; font-size: 20px; font-weight: 700; }
                        if root.search-albums.length > 0: HorizontalLayout { height: 150px; spacing: 10px; for album in root.search-albums: Rectangle { width: 220px; border-radius: 18px; background: album-touch.has-hover ? #ffffff13 : #ffffff07; HorizontalLayout { padding: 13px; spacing: 11px; Rectangle { width: 92px; height: 92px; border-radius: 14px; clip: true; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 25px; } Image { source: album.artwork; width: parent.width; height: parent.height; image-fit: cover; } } VerticalLayout { alignment: center; Text { text: album.name; color: white; font-size: 12px; font-weight: 700; overflow: elide; } Text { text: album.detail; color: #82978f; font-size: 8px; wrap: word-wrap; } Text { text: "Play album  ›"; color: #38ff66; font-size: 8px; } } } album-touch := TouchArea { clicked => { root.play-search-collection("album", album.name); } } } }
                        Text { text: "Songs and videos"; color: white; font-size: 20px; font-weight: 700; }
                        for media in root.library-items: Rectangle { height: 66px; border-radius: 14px; background: media-touch.has-hover ? #ffffff12 : #ffffff06; HorizontalLayout { padding: 9px; spacing: 12px; Rectangle { width: 48px; height: 48px; border-radius: 11px; clip: true; background: media.media-kind == "audio" ? #38ff6618 : #11d8e818; FluentGlyph { glyph: media.media-kind == "audio" ? "" : ""; color: media.media-kind == "audio" ? #38ff66 : #11d8e8; font-size: 18px; } Image { source: media.artwork; width: parent.width; height: parent.height; image-fit: cover; } } VerticalLayout { alignment: center; Text { text: media.title; color: white; font-size: 11px; font-weight: 650; overflow: elide; } Text { text: media.media-kind == "audio" ? (media.artist + (media.album == "" ? "" : " • " + media.album)) : media.path; color: #82978f; font-size: 8px; overflow: elide; } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: media.media-kind == "audio" ? "Play  ›" : "Watch  ›"; color: #38ff66; font-size: 9px; vertical-alignment: center; } } media-touch := TouchArea { clicked => { root.play-library-item(media.path); root.navigate(media.media-kind == "audio" ? "music-player" : "video-player"); } } }
                        if root.search-stations.length > 0: Text { text: "Stations"; color: white; font-size: 20px; font-weight: 700; }
                        for station in root.search-stations: Rectangle { height: 64px; border-radius: 14px; background: search-station-touch.has-hover ? #ffffff12 : #ffffff06; HorizontalLayout { padding: 10px; spacing: 12px; Rectangle { width: 44px; height: 44px; border-radius: 14px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 18px; } } VerticalLayout { alignment: center; Text { text: station.name; color: white; font-size: 11px; font-weight: 700; } Text { text: station.genre; color: #82978f; font-size: 8px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "Play live  ›"; color: #38ff66; font-size: 9px; vertical-alignment: center; } } search-station-touch := TouchArea { clicked => { root.play-radio-station(station.name, station.stream-url); root.navigate("radio"); } } }
                    } }
                }
            }

            if root.current-route == "radio": Rectangle {
                border-radius: 24px; background: #001218e8;
                VerticalLayout { padding: 26px; spacing: 16px;
                    HorizontalLayout { height: 58px; VerticalLayout { spacing: 3px; Text { text: "ZINK RADIO"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: "Internet Radio"; color: white; font-size: 29px; font-weight: 750; } Text { text: "Live stations, music, news and sport in one place."; color: #8da29b; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 112px; height: 40px; border-radius: 20px; background: root.radio-manager-open ? #38ff6620 : #ffffff0b; Text { text: "＋  Stations"; color: root.radio-manager-open ? #38ff66 : white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.radio-manager-open = !root.radio-manager-open; } } } Rectangle { width: 118px; height: 40px; border-radius: 20px; background: #ffffff0b; Text { text: "  Discover"; font-family: "Segoe Fluent Icons"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("radio-discovery"); } } } Rectangle { width: 118px; height: 40px; border-radius: 20px; background: #ffffff0b; Text { text: "  Liked songs"; font-family: "Segoe Fluent Icons"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("liked-radio-songs"); } } } Rectangle { width: 104px; height: 40px; border-radius: 20px; background: #38ff6618; Text { text: "  Widget"; font-family: "Segoe Fluent Icons"; color: #38ff66; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("radio-widget"); } } } }
                    if root.radio-manager-open: Rectangle { height: 154px; border-radius: 20px; background: #ffffff08; border-width: 1px; border-color: #38ff6630; VerticalLayout { padding: 16px; spacing: 9px; HorizontalLayout { height: 28px; Text { text: "Add a station"; color: white; font-size: 16px; font-weight: 700; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "Custom stations are saved on this PC"; color: #71877f; font-size: 8px; vertical-alignment: center; } } HorizontalLayout { height: 44px; spacing: 9px; Rectangle { horizontal-stretch: 2; border-radius: 12px; background: #ffffff09; TextInput { x: 12px; width: parent.width - 24px; height: parent.height; text: root.radio-new-name; color: white; font-size: 9px; single-line: true; edited => { root.radio-new-name = self.text; } } } Rectangle { horizontal-stretch: 1; border-radius: 12px; background: #ffffff09; TextInput { x: 12px; width: parent.width - 24px; height: parent.height; text: root.radio-new-genre; color: white; font-size: 9px; single-line: true; edited => { root.radio-new-genre = self.text; } } } Rectangle { horizontal-stretch: 4; border-radius: 12px; background: #ffffff09; TextInput { x: 12px; width: parent.width - 24px; height: parent.height; text: root.radio-new-url; color: white; font-size: 9px; single-line: true; edited => { root.radio-new-url = self.text; } } } Rectangle { width: 116px; border-radius: 22px; background: #38ff66; Text { text: "Add station"; color: #051109; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.add-radio-station(root.radio-new-name, root.radio-new-genre, root.radio-new-url); } } } } Text { text: "Name • Genre • Direct HTTP/HTTPS audio stream URL"; color: #82978f; font-size: 8px; } } }
                    HorizontalLayout { vertical-stretch: 1; spacing: 18px;
                        Rectangle { horizontal-stretch: 12; border-radius: 22px; background: #ffffff07; VerticalLayout { padding: 18px; spacing: 12px;
                            HorizontalLayout { height: 34px; Text { text: "Featured stations"; color: white; font-size: 19px; font-weight: 700; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.radio-stations.length + " stations"; color: #71857f; font-size: 9px; vertical-alignment: center; } }
                            Rectangle { vertical-stretch: 1; background: transparent;
                                radio-scroll := Flickable { width: parent.width; height: parent.height; content-height: radio-list.preferred-height; radio-list := VerticalLayout { width: radio-scroll.width - 12px; spacing: 9px; for station in root.radio-stations: Rectangle { height: 76px; border-radius: 16px; background: radio-station-touch.has-hover ? #0c3a3d : #ffffff08; border-width: root.track-detail == "Internet radio" && root.track-title == station.name ? 1px : 0px; border-color: #38ff6670; HorizontalLayout { padding: 12px; spacing: 12px; Rectangle { width: 50px; height: 50px; border-radius: 14px; clip: true; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 18px; } Image { width: parent.width; height: parent.height; image-fit: cover; source: station.name == "Capital FM" || station.name == "Capital Dance" || station.name == "Capital Anthems" || station.name == "Capital Chill" || station.name == "Capital Scotland" ? @image-url("../../../../Assets/Radio/capitalfm.png") : station.name == "Heart" || station.name == "Heart Milton Keynes" || station.name == "Heart 70s" || station.name == "Heart 80s" || station.name == "Heart 90s" || station.name == "Heart Dance" || station.name == "Heart Love" ? @image-url("../../../../Assets/Radio/heartfm.png") : station.name == "Kiss FM" || station.name == "Kisstory" || station.name == "Kiss Fresh" ? @image-url("../../../../Assets/Radio/kissfm.png") : station.name == "Classic FM" || station.name == "Gold Radio" || station.name == "Scala Radio" ? @image-url("../../../../Assets/Radio/classicfm.png") : station.name == "LBC" || station.name == "LBC News" ? @image-url("../../../../Assets/Radio/lbc.png") : station.name == "talkSPORT" || station.name == "talkRADIO" ? @image-url("../../../../Assets/Radio/talksport.png") : station.name == "Absolute Radio" || station.name == "Kerrang! Radio" || station.name == "Planet Rock" ? @image-url("../../../../Assets/Radio/absolute.png") : station.name == "Radio X" || station.name == "Radio X Classic Rock" || station.name == "Radio X Chilled" || station.name == "Union JACK Radio" ? @image-url("../../../../Assets/Radio/radiox.png") : station.name == "Capital Xtra" ? @image-url("../../../../Assets/Radio/capitalxtra.png") : station.name == "Hits Radio" ? @image-url("../../../../Assets/Radio/hitsradio.png") : station.name == "Greatest Hits Radio" ? @image-url("../../../../Assets/Radio/greatesthitsradio.png") : station.name == "Jazz FM" ? @image-url("../../../../Assets/Radio/jazzfm.png") : station.name == "MKFM" ? @image-url("../../../../Assets/Radio/mkfm.png") : station.name == "Radio Essex" ? @image-url("../../../../Assets/Radio/radioessex.png") : station.name == "BBC Radio 1Xtra" || station.name == "BBC Asian Network" ? @image-url("../../../../Assets/Radio/bbc1xtra.png") : station.name == "BBC Radio 1" || station.name == "BBC Radio 6 Music" ? @image-url("../../../../Assets/Radio/bbcradio1.png") : station.name == "BBC Radio 2" ? @image-url("../../../../Assets/Radio/bbcradio2.png") : station.name == "BBC Radio 5 Live" || station.name == "BBC Radio 5 Sports Extra" ? @image-url("../../../../Assets/Radio/bbcradio5live.png") : station.name == "BBC Radio Derby" ? @image-url("../../../../Assets/Radio/radioderby.png") : station.name.starts-with("BBC") ? @image-url("../../../../Assets/Radio/bbcworld.png") : station.name.starts-with("Smooth") ? @image-url("../../../../Assets/Radio/smoothfm.png") : station.name.starts-with("Virgin") || station.name == "Times Radio" ? @image-url("../../../../Assets/Radio/timesradio.png") : @image-url("../../../../Assets/ZinkLogo.png"); } } VerticalLayout { alignment: center; spacing: 3px; Text { text: station.name; color: white; font-size: 13px; font-weight: 700; } Text { text: station.genre; color: #849992; font-size: 9px; } } Rectangle { horizontal-stretch: 1; background: transparent; } if station.user-defined: Rectangle { width: 34px; height: 34px; border-radius: 17px; background: #ff455518; FluentGlyph { glyph: ""; color: #ff8b96; font-size: 13px; } TouchArea { clicked => { root.remove-radio-station(station.name); } } } Rectangle { width: 40px; height: 40px; border-radius: 20px; background: root.track-detail == "Internet radio" && root.track-title == station.name && root.is-playing ? #38ff66 : #ffffff10; FluentGlyph { glyph: root.track-detail == "Internet radio" && root.track-title == station.name && root.is-playing ? "" : ""; color: root.track-detail == "Internet radio" && root.track-title == station.name && root.is-playing ? #051109 : white; font-size: 16px; } } } radio-station-touch := TouchArea { clicked => { if (root.track-detail == "Internet radio" && root.track-title == station.name && root.is-playing) { root.pause-media(); } else { root.play-radio-station(station.name, station.stream-url); } } } }
                                } }
                                ZinkScrollBar { horizontal: false; x: parent.width - 12px; y: 0px; width: 12px; height: parent.height; maximum: Math.max(0px, radio-scroll.content-height - radio-scroll.height); page-size: radio-scroll.height; value <=> radio-scroll.content-y; }
                            }
                        } }
                        Rectangle { horizontal-stretch: 10; border-radius: 22px; background: @linear-gradient(145deg, #0b3438 0%, #071b24 58%, #061218 100%); border-width: 1px; border-color: #38ff6635; VerticalLayout { padding: 22px; spacing: 13px; alignment: center;
                            Text { text: "NOW PLAYING"; color: #38ff66; font-size: 9px; font-weight: 750; horizontal-alignment: center; }
                            Rectangle { width: 184px; height: 184px; border-radius: 46px; background: @radial-gradient(circle, #143f42 0%, #09252c 58%, #06151c 100%); border-width: 1px; border-color: #38ff6640; Rectangle { width: 128px; height: 128px; x: 28px; y: 28px; border-radius: 64px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 58px; } } }
                            Text { text: root.track-detail == "Internet radio" ? root.track-title : "Choose a station"; color: white; font-size: 23px; font-weight: 750; horizontal-alignment: center; overflow: elide; }
                            Text { text: root.current-radio-track-title != "" ? root.current-radio-track-title : root.track-detail == "Internet radio" ? "Waiting for live track metadata…" : "Select a station from the list"; color: root.current-radio-track-title != "" ? white : #879b95; font-size: 10px; font-weight: root.current-radio-track-title != "" ? 700 : 400; horizontal-alignment: center; overflow: elide; }
                            Text { text: root.current-radio-track-artist; visible: root.current-radio-track-artist != ""; color: #38ff66; font-size: 9px; horizontal-alignment: center; overflow: elide; }
                            HorizontalLayout { height: 58px; spacing: 14px; alignment: center; AccessiblePlayerButton { width: 42px; height: 42px; glyph: ""; label: "Previous station"; glyph-size: 18px; normal-background: #ffffff0b; activated => { root.previous-radio-station(); } } AccessiblePlayerButton { width: 58px; height: 58px; glyph: root.is-playing ? "" : ""; label: root.is-playing ? "Pause" : "Play"; glyph-size: 22px; glyph-color: #051109; normal-background: #f2fff6; hover-background: white; activated => { if root.is-playing { root.pause-media(); } else { root.play-media(); } } } AccessiblePlayerButton { width: 42px; height: 42px; glyph: ""; label: "Next station"; glyph-size: 18px; normal-background: #ffffff0b; activated => { root.next-radio-station(); } } AccessiblePlayerButton { width: 42px; height: 42px; glyph: ""; label: "Stop radio"; glyph-size: 16px; normal-background: #ffffff0b; activated => { root.stop-playback(); } } }
                            HorizontalLayout { height: 30px; spacing: 9px; FluentGlyph { glyph: root.volume-percent == 0 ? "" : ""; width: 20px; font-size: 15px; } radio-volume := Rectangle { horizontal-stretch: 1; height: 16px; background: transparent; Rectangle { y: 5px; height: 6px; border-radius: 3px; background: #ffffff25; Rectangle { width: parent.width * root.volume-percent / 100; height: parent.height; border-radius: 3px; background: #38ff66; } } radio-volume-touch := TouchArea { clicked => { root.set-volume(Math.max(0, Math.min(1, self.mouse-x / radio-volume.width))); } moved => { if self.pressed { root.set-volume(Math.max(0, Math.min(1, self.mouse-x / radio-volume.width))); } } } } Text { text: root.volume-percent + "%"; color: #91a59f; font-size: 9px; width: 32px; vertical-alignment: center; } }
                            HorizontalLayout { height: 40px; spacing: 9px; Rectangle { horizontal-stretch: 1; border-radius: 20px; background: root.current-radio-liked ? #38ff6628 : #ffffff09; Text { text: root.current-radio-liked ? "♥  Station saved" : "♡  Save station"; color: root.current-radio-liked ? #38ff66 : white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.toggle-radio-like(); } } } Rectangle { horizontal-stretch: 1; border-radius: 20px; background: root.current-radio-track-title != "" ? #38ff66 : #ffffff06; Text { text: "♥  Save song"; color: root.current-radio-track-title != "" ? #051109 : #60706b; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: root.current-radio-track-title != ""; clicked => { root.save-current-radio-song(); } } } Rectangle { horizontal-stretch: 1; border-radius: 20px; background: root.music-background ? #38ff6628 : #ffffff09; Text { text: root.music-background ? "Background on" : "Background play"; color: root.music-background ? #38ff66 : white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.music-background = !root.music-background; root.set-music-background(root.music-background); } } } }
                        } }
                    }
                }
            }

            if root.current-route == "youtube-music" || root.current-route == "amazon-music": service-page := Rectangle {
                border-radius: 24px; background: #001218e8;
                property <string> service-name: root.current-route == "youtube-music" ? "YouTube Music" : root.current-route == "amazon-music" ? "Amazon Music" : root.current-route == "spotify-widget" ? "Spotify Widget" : "Spotify";
                property <string> service-url: root.current-route == "youtube-music" ? "https://music.youtube.com/?gl=GB&hl=en-GB" : root.current-route == "amazon-music" ? "https://music.amazon.co.uk/" : "https://open.spotify.com/";
                property <color> service-accent: root.current-route == "youtube-music" ? #ff304a : root.current-route == "amazon-music" ? #25c5f5 : #1ed760;
                VerticalLayout { padding: 28px; spacing: 18px;
                    HorizontalLayout { height: 62px; VerticalLayout { spacing: 3px; Text { text: "STREAMING MUSIC"; color: service-page.service-accent; font-size: 10px; font-weight: 750; } Text { text: service-page.service-name; color: white; font-size: 29px; font-weight: 750; } Text { text: "Your web music services, opened through Zink Connect."; color: #8da29b; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 148px; height: 42px; border-radius: 21px; background: service-page.service-accent; Text { text: "Open " + service-page.service-name; color: #041008; font-size: 10px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-web-service(service-page.service-url); } } } }
                    Rectangle { height: 286px; border-radius: 24px; background: root.current-route == "youtube-music" ? @linear-gradient(120deg, #4b101a 0%, #160b11 64%, #071319 100%) : root.current-route == "amazon-music" ? @linear-gradient(120deg, #073b51 0%, #0a1a2d 64%, #071319 100%) : @linear-gradient(120deg, #0b4224 0%, #0a2217 64%, #071319 100%); border-width: 1px; border-color: #ffffff1c;
                        HorizontalLayout { padding: 28px; spacing: 28px; Rectangle { width: 190px; height: 190px; border-radius: 48px; background: service-page.service-accent; Text { text: root.current-route == "youtube-music" ? "▶" : root.current-route == "amazon-music" ? "a" : "◉"; color: root.current-route == "amazon-music" ? #071319 : white; font-size: 72px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } } VerticalLayout { alignment: center; spacing: 10px; Text { text: service-page.service-name; color: white; font-size: 31px; font-weight: 800; } Text { text: root.current-route == "youtube-music" ? "Albums, videos, mixes and your YouTube Music library." : root.current-route == "amazon-music" ? "Your Amazon Music library, stations, podcasts and playlists." : root.current-route == "spotify-widget" ? "Open Spotify and keep playback close to Zink." : "Your Spotify library, playlists, podcasts and recommendations."; color: #b7c8c2; font-size: 12px; wrap: word-wrap; } HorizontalLayout { height: 42px; spacing: 10px; Rectangle { width: 144px; border-radius: 21px; background: service-page.service-accent; Text { text: "  Start listening"; font-family: "Segoe Fluent Icons"; color: #041008; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-web-service(service-page.service-url); } } } Rectangle { width: 144px; border-radius: 21px; background: #ffffff0e; Text { text: "  Open Connect"; font-family: "Segoe Fluent Icons"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-zink-connect(); } } } } } }
                    }
                    HorizontalLayout { height: 154px; spacing: 16px;
                        Rectangle { horizontal-stretch: 1; border-radius: 20px; background: #ffffff07; VerticalLayout { padding: 18px; spacing: 8px; FluentGlyph { glyph: ""; color: #38ff66; font-size: 22px; width: 26px; } Text { text: "Zink Connect browser"; color: white; font-size: 15px; font-weight: 700; } Text { text: "Opens in Zink’s managed WebView window with tabs, history, settings and ad blocking."; color: #849992; font-size: 9px; wrap: word-wrap; } } }
                        Rectangle { horizontal-stretch: 1; border-radius: 20px; background: #ffffff07; VerticalLayout { padding: 18px; spacing: 8px; FluentGlyph { glyph: ""; color: #11d8e8; font-size: 22px; width: 26px; } Text { text: "Persistent sign-in"; color: white; font-size: 15px; font-weight: 700; } Text { text: "Keep the service signed in using the same private Zink Connect profile."; color: #849992; font-size: 9px; wrap: word-wrap; } } }
                        Rectangle { horizontal-stretch: 1; border-radius: 20px; background: #ffffff07; VerticalLayout { padding: 18px; spacing: 8px; FluentGlyph { glyph: ""; color: #a889ff; font-size: 22px; width: 26px; } Text { text: "Browser controls"; color: white; font-size: 15px; font-weight: 700; } Text { text: "Use Connect settings for privacy, WebView updates and memory options."; color: #849992; font-size: 9px; wrap: word-wrap; } } }
                    }
                    Rectangle { vertical-stretch: 1; border-radius: 20px; background: #ffffff06; HorizontalLayout { padding: 18px; spacing: 14px; Text { text: "Switch service"; color: white; font-size: 14px; font-weight: 700; vertical-alignment: center; width: 100px; } for route in ["youtube-music", "amazon-music", "spotify", "spotify-widget"]: Rectangle { horizontal-stretch: 1; border-radius: 18px; background: root.current-route == route ? #38ff6624 : #ffffff08; Text { text: route == "youtube-music" ? "YouTube Music" : route == "amazon-music" ? "Amazon Music" : route == "spotify-widget" ? "Spotify Widget" : "Spotify"; color: root.current-route == route ? #38ff66 : white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate(route); } } } } }
                }
            }

            if root.current-route == "spotify": Rectangle {
                border-radius: 24px; background: @linear-gradient(145deg, #103c25 0%, #071a17 44%, #041118 100%); border-width: 1px; border-color: #1ed76048; clip: true;
                ZinkScrollView { width: parent.width; height: parent.height; content-height: spotify-content.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.as-needed; horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    spotify-content := VerticalLayout { width: parent.visible-width - 16px; padding: 30px; spacing: 18px;
                        HorizontalLayout { height: 62px; VerticalLayout { spacing: 3px; Text { text: "ZINK + SPOTIFY"; color: #1ed760; font-size: 10px; font-weight: 750; } Text { text: root.spotify-connected ? "Welcome, " + root.spotify-display-name : "Spotify"; color: white; font-size: 31px; font-weight: 780; } Text { text: root.spotify-status; color: #a9bcb4; font-size: 10px; overflow: elide; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 128px; height: 42px; border-radius: 21px; background: #ffffff0d; Text { text: "Open Spotify  ↗"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-web-service("https://open.spotify.com/"); } } } }
                        Rectangle { height: 246px; border-radius: 25px; background: @linear-gradient(115deg, #1ed760 0%, #12883f 38%, #0a3022 100%); HorizontalLayout { padding: 28px; spacing: 28px; Rectangle { width: 186px; height: 186px; border-radius: 54px; background: #06140bd0; Text { text: "◉"; color: #1ed760; font-size: 82px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } } VerticalLayout { alignment: center; spacing: 10px; Text { text: root.spotify-connected ? "Your Spotify is connected" : "Bring Spotify into Zink"; color: white; font-size: 27px; font-weight: 780; wrap: word-wrap; } Text { text: root.spotify-connected ? root.spotify-product + " account • Refresh your live library and playback state whenever you need it." : "Connect with Spotify's secure PKCE sign-in. Zink never stores your Spotify password."; color: #e7fff0d8; font-size: 11px; wrap: word-wrap; } HorizontalLayout { height: 44px; spacing: 10px; Rectangle { width: 156px; border-radius: 22px; background: #f6fff8; Text { text: root.spotify-connected ? "Refresh account" : "Connect Spotify"; color: #07140b; font-size: 10px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { if (root.spotify-connected) { root.spotify-refresh(); } else { root.spotify-start-login(); } } } } Rectangle { visible: root.spotify-connected; width: self.visible ? 118px : 0px; border-radius: 22px; background: #07140b99; Text { text: "Disconnect"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.spotify-disconnect(); } } } } } } }
                        if !root.spotify-connected: Rectangle { height: 146px; border-radius: 20px; background: #ffffff08; border-width: 1px; border-color: #ffffff18; VerticalLayout { padding: 18px; spacing: 9px; Text { text: "Finish connecting"; color: white; font-size: 17px; font-weight: 700; } Text { text: "After Spotify redirects, paste the complete callback address or the code value below."; color: #8da29b; font-size: 9px; } HorizontalLayout { height: 44px; spacing: 10px; Rectangle { horizontal-stretch: 1; border-radius: 12px; background: #020b0f99; TextInput { x: 13px; width: parent.width - 26px; height: parent.height; text: root.spotify-auth-input; color: white; single-line: true; edited => { root.spotify-auth-input = self.text; } accepted => { root.spotify-finish-login(self.text); } } } Rectangle { width: 132px; border-radius: 22px; background: #1ed760; Text { text: "Finish sign-in"; color: #06110a; font-size: 10px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.spotify-finish-login(root.spotify-auth-input); } } } } } }
                        Text { text: "Your Spotify home"; color: white; font-size: 21px; font-weight: 720; }
                        Rectangle { height: 58px; border-radius: 29px; background: #050d11c8; border-width: 1px; border-color: spotify-search-input.has-focus ? #1ed76080 : #ffffff16; FluentGlyph { x: 18px; width: 24px; glyph: ""; color: #1ed760; font-size: 17px; } Text { x: 50px; width: parent.width - 190px; text: root.spotify-search-query == "" ? "Search Spotify tracks, artists and albums" : ""; color: #789087; font-size: 10px; vertical-alignment: center; } spotify-search-input := TextInput { x: 50px; width: parent.width - 190px; height: parent.height; text: root.spotify-search-query; color: white; font-size: 11px; single-line: true; edited => { root.spotify-search-query = self.text; } accepted => { root.spotify-search(self.text); } } Rectangle { x: parent.width - 130px; y: 8px; width: 120px; height: 42px; border-radius: 21px; background: root.spotify-connected && root.spotify-search-query != "" ? #1ed760 : #ffffff08; Text { text: "Search"; color: root.spotify-connected && root.spotify-search-query != "" ? #06110a : #61746c; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: root.spotify-connected && root.spotify-search-query != ""; clicked => { root.spotify-search(root.spotify-search-query); } } } }
                        if root.spotify-search-query != "": Text { text: "Search results"; color: white; font-size: 19px; font-weight: 700; }
                        if root.spotify-search-query != "": spotify-search-strip := ZinkScrollView { height: 150px; content-width: spotify-search-row.preferred-width; horizontal-scrollbar-policy: ScrollBarPolicy.always-on; vertical-scrollbar-policy: ScrollBarPolicy.always-off; spotify-search-row := HorizontalLayout { height: spotify-search-strip.visible-height - 18px; spacing: 10px; for track in root.spotify-search-results: Rectangle { width: 230px; border-radius: 18px; background: spotify-result-touch.has-hover ? #ffffff14 : #ffffff08; HorizontalLayout { padding: 13px; spacing: 11px; Rectangle { width: 52px; height: 52px; border-radius: 14px; background: #1ed76020; FluentGlyph { glyph: ""; color: #1ed760; font-size: 20px; } } VerticalLayout { alignment: center; Text { text: track.title; color: white; font-size: 11px; font-weight: 700; overflow: elide; } Text { text: track.artist; color: #8ca199; font-size: 9px; overflow: elide; } Text { text: track.album; color: #61746c; font-size: 8px; overflow: elide; } HorizontalLayout { height: 22px; Text { text: "Play  ›"; color: #1ed760; font-size: 8px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 36px; border-radius: 11px; background: #ffffff0b; Text { text: "+♥"; color: white; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.spotify-save-track(track.id); } } } } } } spotify-result-touch := TouchArea { clicked => { root.spotify-play-track(track.id); } } } } }
                        Rectangle { height: 112px; border-radius: 20px; background: #050d11c8; border-width: 1px; border-color: #ffffff12; HorizontalLayout { padding: 17px; spacing: 14px; Rectangle { width: 76px; height: 76px; border-radius: 18px; background: #1ed76020; FluentGlyph { glyph: root.spotify-is-playing ? "" : ""; color: #1ed760; font-size: 28px; } } VerticalLayout { alignment: center; spacing: 3px; Text { text: root.spotify-now-title; color: white; font-size: 16px; font-weight: 700; overflow: elide; } Text { text: root.spotify-now-artist + (root.spotify-now-album == "" ? "" : " • " + root.spotify-now-album); color: #9aafa7; font-size: 10px; overflow: elide; } Text { text: "Playing on " + root.spotify-device-name; color: #1ed760; font-size: 9px; overflow: elide; } } Rectangle { horizontal-stretch: 1; background: transparent; } AccessiblePlayerButton { width: 42px; height: 42px; glyph: ""; label: "Previous Spotify track"; glyph-size: 17px; normal-background: #ffffff0d; activated => { root.spotify-previous(); } } AccessiblePlayerButton { width: 54px; height: 54px; glyph: root.spotify-is-playing ? "" : ""; label: root.spotify-is-playing ? "Pause Spotify" : "Play Spotify"; glyph-size: 21px; glyph-color: #07140b; normal-background: #1ed760; activated => { root.spotify-play-pause(); } } AccessiblePlayerButton { width: 42px; height: 42px; glyph: ""; label: "Next Spotify track"; glyph-size: 17px; normal-background: #ffffff0d; activated => { root.spotify-next(); } } Rectangle { width: 118px; height: 38px; border-radius: 19px; background: #ffffff0c; Text { text: "Open widget"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("spotify-widget"); } } } } }
Text { text: "Recently played"; color: white; font-size: 19px; font-weight: 700; }
                        HorizontalLayout { height: 146px; spacing: 10px; for track in root.spotify-recent-tracks: Rectangle { width: 196px; border-radius: 18px; background: spotify-recent-touch.has-hover ? #ffffff14 : #ffffff08; VerticalLayout { padding: 14px; spacing: 5px; Rectangle { width: 42px; height: 42px; border-radius: 12px; background: #1ed76020; FluentGlyph { glyph: ""; color: #1ed760; font-size: 18px; } } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: track.title; color: white; font-size: 12px; font-weight: 700; overflow: elide; } Text { text: track.artist; color: #8ca199; font-size: 9px; overflow: elide; } Text { text: "Play  ›"; color: #1ed760; font-size: 9px; } } spotify-recent-touch := TouchArea { clicked => { root.spotify-play-track(track.id); } } } }
                        if root.spotify-queue.length > 0: Text { text: "Next in queue"; color: white; font-size: 19px; font-weight: 700; }
                        if root.spotify-queue.length > 0: spotify-queue-strip := ZinkScrollView { height: 132px; content-width: spotify-queue-row.preferred-width; horizontal-scrollbar-policy: ScrollBarPolicy.always-on; vertical-scrollbar-policy: ScrollBarPolicy.always-off; spotify-queue-row := HorizontalLayout { height: spotify-queue-strip.visible-height - 18px; spacing: 10px; for track[index] in root.spotify-queue: Rectangle { width: 220px; border-radius: 17px; background: spotify-queue-touch.has-hover ? #ffffff14 : #ffffff08; HorizontalLayout { padding: 13px; spacing: 11px; Text { text: index + 1; color: #1ed760; font-size: 12px; font-weight: 750; width: 22px; vertical-alignment: center; horizontal-alignment: center; } VerticalLayout { alignment: center; Text { text: track.title; color: white; font-size: 11px; font-weight: 700; overflow: elide; } Text { text: track.artist; color: #8ca199; font-size: 9px; overflow: elide; } Text { text: track.album; color: #61746c; font-size: 8px; overflow: elide; } } } spotify-queue-touch := TouchArea { clicked => { root.spotify-play-track(track.id); } } } } }
                        Text { text: "Your top tracks"; color: white; font-size: 19px; font-weight: 700; }
                        HorizontalLayout { height: 146px; spacing: 10px; for track in root.spotify-top-tracks: Rectangle { width: 196px; border-radius: 18px; background: spotify-top-touch.has-hover ? #ffffff14 : #ffffff08; VerticalLayout { padding: 14px; spacing: 5px; Rectangle { width: 42px; height: 42px; border-radius: 12px; background: #1ed76020; FluentGlyph { glyph: ""; color: #1ed760; font-size: 18px; } } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: track.title; color: white; font-size: 12px; font-weight: 700; overflow: elide; } Text { text: track.artist; color: #8ca199; font-size: 9px; overflow: elide; } HorizontalLayout { height: 22px; Text { text: "Play  ›"; color: #1ed760; font-size: 9px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 40px; border-radius: 11px; background: #ffffff0b; Text { text: "+♥"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.spotify-save-track(track.id); } } } } } spotify-top-touch := TouchArea { clicked => { root.spotify-play-track(track.id); } } } }
                        Text { text: "Playback devices"; color: white; font-size: 19px; font-weight: 700; }
                        HorizontalLayout { height: 88px; spacing: 10px; for device in root.spotify-devices: Rectangle { width: 220px; border-radius: 18px; background: device.active ? #1ed76020 : spotify-device-touch.has-hover ? #ffffff14 : #ffffff08; border-width: device.active ? 1px : 0px; border-color: #1ed76080; HorizontalLayout { padding: 14px; spacing: 11px; FluentGlyph { glyph: ""; color: #1ed760; font-size: 22px; width: 30px; } VerticalLayout { alignment: center; Text { text: device.name; color: white; font-size: 12px; font-weight: 700; overflow: elide; } Text { text: device.detail; color: #8ca199; font-size: 8px; overflow: elide; } } } spotify-device-touch := TouchArea { clicked => { root.spotify-select-device(device.id); } } } }
                    }
                }
            }

            if root.current-route == "spotify-widget": Rectangle {
                border-radius: 24px; background: @linear-gradient(145deg, #0b2d20 0%, #07171b 55%, #041016 100%); border-width: 1px; border-color: #1ed76036;
                VerticalLayout { padding: 30px; spacing: 18px;
                    HorizontalLayout { height: 64px; VerticalLayout { Text { text: "SPOTIFY WIDGET"; color: #1ed760; font-size: 10px; font-weight: 750; } Text { text: "Playback at a glance"; color: white; font-size: 29px; font-weight: 750; } Text { text: "A real floating widget that stays available outside the main Zink window."; color: #8da29b; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 118px; height: 40px; border-radius: 20px; background: #1ed760; Text { text: "Open widget"; color: #06110a; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-spotify-widget(); } } } Rectangle { width: 106px; height: 40px; border-radius: 20px; background: #ffffff0d; Text { text: "Hide widget"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.hide-spotify-widget(); } } } Rectangle { width: 118px; height: 40px; border-radius: 20px; background: #ffffff0d; Text { text: "Spotify home"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("spotify"); } } } }
                    Rectangle { vertical-stretch: 1; border-radius: 26px; background: #07130fd9; border-width: 1px; border-color: #ffffff18; HorizontalLayout { padding: 34px; spacing: 34px; Rectangle { width: 300px; height: 300px; border-radius: 58px; background: #1ed76018; Text { text: "◉"; color: #1ed760; font-size: 112px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } } VerticalLayout { alignment: center; spacing: 10px; Text { text: root.spotify-now-title; color: white; font-size: 29px; font-weight: 780; overflow: elide; } Text { text: root.spotify-now-artist; color: #1ed760; font-size: 14px; overflow: elide; } Text { text: root.spotify-now-album; color: #9db0aa; font-size: 10px; overflow: elide; } Text { text: "Playing on " + root.spotify-device-name; color: #71877f; font-size: 9px; overflow: elide; } HorizontalLayout { height: 58px; spacing: 12px; AccessiblePlayerButton { width: 46px; height: 46px; glyph: ""; label: "Previous"; glyph-size: 18px; normal-background: #ffffff0d; activated => { root.spotify-previous(); } } AccessiblePlayerButton { width: 58px; height: 58px; glyph: root.spotify-is-playing ? "" : ""; label: root.spotify-is-playing ? "Pause Spotify" : "Play Spotify"; glyph-size: 22px; glyph-color: #07140b; normal-background: #1ed760; activated => { root.spotify-play-pause(); } } AccessiblePlayerButton { width: 46px; height: 46px; glyph: ""; label: "Next"; glyph-size: 18px; normal-background: #ffffff0d; activated => { root.spotify-next(); } } } HorizontalLayout { height: 42px; spacing: 10px; Rectangle { width: 138px; border-radius: 21px; background: #1ed760; Text { text: root.spotify-connected ? "Refresh state" : "Connect"; color: #06110a; font-size: 10px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { if (root.spotify-connected) { root.spotify-refresh(); } else { root.navigate("spotify"); } } } } Rectangle { width: 138px; border-radius: 21px; background: #ffffff0d; Text { text: "Open Spotify"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-web-service("https://open.spotify.com/"); } } } } Text { text: root.spotify-status; color: #789087; font-size: 9px; wrap: word-wrap; } } } }
                }
            }

            if root.current-route == "radio-discovery": Rectangle {
                border-radius: 24px; background: #001218e8;
                VerticalLayout { padding: 28px; spacing: 18px;
                    VerticalLayout { height: 64px; spacing: 3px; Text { text: "ZINK RADIO"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: "Radio Discovery"; color: white; font-size: 29px; font-weight: 750; } Text { text: "Find live music, news and sport faster."; color: #8da29b; font-size: 10px; } }
                    GridLayout { height: 264px; spacing: 14px;
                        for slot in [0, 1, 2, 3]: Rectangle { row: slot / 2; col: Math.mod(slot, 2); border-radius: 20px; background: discovery-touch.has-hover ? #0b3b3d : #ffffff08; border-width: 1px; border-color: #ffffff16; HorizontalLayout { padding: 18px; spacing: 14px; Rectangle { width: 52px; height: 52px; border-radius: 16px; background: #38ff6618; FluentGlyph { glyph: slot == 0 ? "" : slot == 1 ? "" : slot == 2 ? "" : ""; color: #38ff66; font-size: 22px; } } VerticalLayout { alignment: center; spacing: 4px; Text { text: slot == 0 ? "All Stations" : slot == 1 ? "Liked Radio Songs" : slot == 2 ? "Radio Widget" : "Search Radio"; color: white; font-size: 15px; font-weight: 700; } Text { text: slot == 0 ? "Browse every built-in Zink station" : slot == 1 ? "Review songs saved while listening" : slot == 2 ? "Compact playback controls" : "Search Zink stations and media"; color: #849992; font-size: 9px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "›"; color: #38ff66; font-size: 24px; vertical-alignment: center; } } discovery-touch := TouchArea { clicked => { root.navigate(slot == 0 ? "radio" : slot == 1 ? "liked-radio-songs" : slot == 2 ? "radio-widget" : "search"); } } }
                    }
                    Text { text: "Start listening"; color: white; font-size: 19px; font-weight: 700; }
                    HorizontalLayout { height: 164px; spacing: 14px; for station in ["Capital FM", "Heart", "Classic FM", "LBC", "talkSPORT", "Virgin Radio UK"]: Rectangle { horizontal-stretch: 1; border-radius: 20px; background: station-discovery-touch.has-hover ? #ffffff13 : #ffffff07; VerticalLayout { padding: 14px; spacing: 8px; Rectangle { width: 42px; height: 42px; border-radius: 13px; background: station == "Capital FM" ? #e21f35 : station == "Heart" ? #d92866 : station == "Classic FM" ? #b89a45 : station == "LBC" ? #2669b3 : station == "talkSPORT" ? #f0d31c : #df342f; FluentGlyph { glyph: ""; color: white; font-size: 18px; } } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: station; color: white; font-size: 11px; font-weight: 700; overflow: elide; } Text { text: "Play live  ›"; color: #38ff66; font-size: 8px; } } station-discovery-touch := TouchArea { clicked => { root.play-radio-station(station, station == "Capital FM" ? "https://media-ssl.musicradio.com/CapitalUK" : station == "Heart" ? "https://media-ssl.musicradio.com/HeartUK" : station == "Classic FM" ? "https://media-ssl.musicradio.com/ClassicFM" : station == "LBC" ? "https://media-ssl.musicradio.com/LBCUK" : station == "talkSPORT" ? "https://radio.talksport.com/stream" : "https://radio.virginradio.co.uk/stream"); root.navigate("radio"); } } } }
                    Rectangle { vertical-stretch: 1; border-radius: 20px; background: @linear-gradient(100deg, #0b3438 0%, #071820 100%); HorizontalLayout { padding: 18px; spacing: 14px; FluentGlyph { glyph: ""; color: #11d8e8; font-size: 24px; width: 34px; } VerticalLayout { alignment: center; Text { text: "Search everything in Zink"; color: white; font-size: 15px; font-weight: 700; } Text { text: "Find stations alongside music, video and the rest of your library."; color: #849992; font-size: 9px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 120px; height: 38px; border-radius: 19px; background: #ffffff10; Text { text: "Open Search"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("search"); } } } } }
                }
            }

            if root.current-route == "liked-radio-songs": Rectangle {
                border-radius: 24px; background: #001218e8;
                VerticalLayout { padding: 28px; spacing: 16px;
                    HorizontalLayout { height: 62px; VerticalLayout { Text { text: "LIKED RADIO"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: "Liked Radio Songs"; color: white; font-size: 29px; font-weight: 750; } Text { text: root.liked-radio-songs.length + " tracks captured from live radio"; color: #8da29b; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 126px; height: 40px; border-radius: 20px; background: #ffffff0b; Text { text: "Browse stations"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("radio"); } } } }
                    if root.liked-radio-songs.length == 0: Rectangle { vertical-stretch: 1; border-radius: 22px; background: #ffffff06; VerticalLayout { alignment: center; spacing: 12px; FluentGlyph { glyph: ""; color: #38ff66; font-size: 52px; horizontal-alignment: center; } Text { text: "No liked radio songs yet"; color: white; font-size: 22px; font-weight: 700; horizontal-alignment: center; } Text { text: "When live track metadata appears, save the song from Internet Radio."; color: #879b95; font-size: 10px; horizontal-alignment: center; } HorizontalLayout { height: 40px; alignment: center; Rectangle { width: 142px; height: 40px; border-radius: 20px; background: #38ff66; Text { text: "Explore radio"; color: #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("radio"); } } } } } }
                    if root.liked-radio-songs.length > 0: liked-radio-scroll := Flickable { vertical-stretch: 1; content-height: liked-radio-list.preferred-height; liked-radio-list := VerticalLayout { width: liked-radio-scroll.width; spacing: 10px; for item in root.liked-radio-songs: Rectangle { height: 96px; border-radius: 17px; background: #ffffff08; border-width: 1px; border-color: #ffffff10; HorizontalLayout { padding: 13px; spacing: 12px; Rectangle { width: 68px; height: 68px; border-radius: 14px; clip: true; background: #38ff6618; Image { source: item.artwork; image-fit: cover; } } VerticalLayout { alignment: center; spacing: 3px; Text { text: item.title; color: white; font-size: 14px; font-weight: 700; overflow: elide; } Text { text: item.artist; color: #38ff66; font-size: 10px; overflow: elide; } Text { text: (item.album == "" ? "Unknown album" : item.album) + "  •  " + item.station; color: #849992; font-size: 9px; overflow: elide; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 116px; height: 36px; border-radius: 18px; background: item.added-to-spotify ? #38ff6618 : #38ff66; Text { text: item.added-to-spotify ? "✓ In Liked Songs" : "+ Spotify Like"; color: item.added-to-spotify ? #38ff66 : #051109; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: !item.added-to-spotify; clicked => { root.add-liked-radio-song-to-spotify(item.id); } } } Rectangle { width: 88px; height: 36px; border-radius: 18px; background: #ffffff0b; Text { text: "Spotify ↗"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-liked-radio-song-in-spotify(item.id); } } } Rectangle { width: 92px; height: 36px; border-radius: 18px; background: #ff383815; Text { text: "YouTube ▶"; color: #ff9a9a; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-liked-radio-song-in-youtube(item.id); } } } Rectangle { width: 38px; height: 38px; border-radius: 19px; background: #ff455515; FluentGlyph { glyph: ""; color: #ff8b96; font-size: 14px; } TouchArea { clicked => { root.remove-liked-radio-song(item.id); } } } } } } } }
                }

            if root.current-route == "radio-widget": Rectangle {
                border-radius: 24px; background: @linear-gradient(135deg, #082f36 0%, #071820 55%, #040d13 100%);
                VerticalLayout { padding: 34px; alignment: center;
                    Rectangle { horizontal-stretch: 1; height: 430px; border-radius: 30px; background: #071820df; border-width: 1px; border-color: #ffffff28; VerticalLayout { padding: 26px; spacing: 20px;
                        HorizontalLayout { height: 56px; VerticalLayout { Text { text: "Radio Widget"; color: white; font-size: 27px; font-weight: 750; } Text { text: "Compact live controls in a separate floating window"; color: #8da29b; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 118px; height: 40px; border-radius: 20px; background: #38ff66; Text { text: "Open widget"; color: #051109; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-radio-widget(); } } } Rectangle { width: 104px; height: 40px; border-radius: 20px; background: #ffffff10; Text { text: "Hide widget"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.hide-radio-widget(); } } } Rectangle { width: 128px; height: 40px; border-radius: 20px; background: #ffffff10; Text { text: "Open full radio"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("radio"); } } } }
                        Rectangle { vertical-stretch: 1; border-radius: 26px; background: #ffffff08; HorizontalLayout { padding: 20px; spacing: 22px; Rectangle { width: 170px; height: 170px; border-radius: 28px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 62px; } } VerticalLayout { alignment: center; spacing: 9px; Text { text: root.track-detail == "Internet radio" ? root.track-title : "No station selected"; color: white; font-size: 24px; font-weight: 750; overflow: elide; } Text { text: root.track-detail == "Internet radio" ? "Live internet stream" : "Open Radio to choose a station"; color: #8da29b; font-size: 10px; } HorizontalLayout { height: 60px; spacing: 12px; AccessiblePlayerButton { width: 56px; height: 56px; glyph: root.is-playing ? "" : ""; label: root.is-playing ? "Pause" : "Play"; glyph-size: 22px; glyph-color: #051109; normal-background: #f2fff6; activated => { if root.is-playing { root.pause-media(); } else { root.play-media(); } } } AccessiblePlayerButton { width: 48px; height: 48px; glyph: ""; label: "Stop"; glyph-size: 17px; normal-background: #ffffff0d; activated => { root.stop-playback(); } } AccessiblePlayerButton { width: 48px; height: 48px; glyph: ""; label: "Next station"; glyph-size: 18px; normal-background: #ffffff0d; activated => { root.next-radio-station(); } } } HorizontalLayout { height: 28px; spacing: 9px; FluentGlyph { glyph: root.volume-percent == 0 ? "" : ""; width: 20px; font-size: 15px; } widget-volume := Rectangle { horizontal-stretch: 1; height: 16px; background: transparent; Rectangle { y: 5px; height: 6px; border-radius: 3px; background: #ffffff25; Rectangle { width: parent.width * root.volume-percent / 100; height: parent.height; border-radius: 3px; background: #38ff66; } } TouchArea { clicked => { root.set-volume(self.mouse-x / widget-volume.width); } } } Text { text: root.volume-percent + "%"; color: #91a59f; font-size: 9px; width: 34px; vertical-alignment: center; } } } } }
                    } }
                }
            }

            if root.current-route == "video-player": video-page := Rectangle {
                property <bool> local-video-loaded: root.track-title != "Nothing playing" && root.current-video-path != "" && root.current-video-path == root.current-music-path && root.track-detail != "Internet radio" && root.track-detail != "Online video";
                border-radius: root.app-fullscreen ? 0px : 24px;
                background: #02080ce8;
                clip: true;
                Image { source: root.album-art; image-fit: cover; width: parent.width; height: parent.height; opacity: 0.08; }
                Rectangle { width: parent.width; height: parent.height; background: @linear-gradient(180deg, #02101580 0%, #02070cf2 72%, #02070cff 100%); }

                VerticalLayout {
                    padding: root.app-fullscreen ? 22px : 26px;
                    spacing: 16px;
                    HorizontalLayout {
                        height: 52px;
                        VerticalLayout { spacing: 2px; Text { text: "ZINK VIDEO"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: !video-page.local-video-loaded ? "Video Player" : root.track-title; color: white; font-size: 25px; font-weight: 750; overflow: elide; } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Rectangle { width: 126px; border-radius: 20px; background: browse-video-touch.has-hover ? #ffffff20 : #ffffff0c; border-width: 1px; border-color: #ffffff28; HorizontalLayout { alignment: center; spacing: 7px; FluentGlyph { glyph: ""; width: 18px; font-size: 15px; } Text { text: "Open video"; color: white; font-size: 10px; vertical-alignment: center; } } browse-video-touch := TouchArea { clicked => { root.open-media(); } } }
                        Rectangle { width: 42px; border-radius: 21px; background: #ffffff0c; FluentGlyph { glyph: root.app-fullscreen ? "" : ""; font-size: 16px; } TouchArea { clicked => { root.set-app-fullscreen(!root.app-fullscreen); } } }
                    }

                    Rectangle {
                        vertical-stretch: 1; border-radius: 22px; background: #000000; border-width: 1px; border-color: #ffffff18; clip: true;
                        Image {
                            visible: video-page.local-video-loaded;
                            source: root.video-frame;
                            width: parent.width;
                            height: parent.height;
                            image-fit: root.video-aspect-mode == "Fill" ? cover : contain;
                        }
                        Rectangle { visible: !video-page.local-video-loaded; width: parent.width; height: parent.height; background: @radial-gradient(circle, #103139 0%, #030a0e 68%); VerticalLayout { alignment: center; spacing: 13px; HorizontalLayout { height: 82px; alignment: center; Rectangle { width: 82px; height: 82px; border-radius: 25px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 34px; } } } Text { text: "Open a video to begin"; color: white; font-size: 25px; font-weight: 700; horizontal-alignment: center; } Text { text: "Windows-native playback with transport, subtitles and display controls"; color: #8ca09a; font-size: 10px; horizontal-alignment: center; } HorizontalLayout { height: 42px; alignment: center; Rectangle { width: 148px; height: 42px; border-radius: 21px; background: #38ff66; Text { text: "Choose a video"; color: #06110a; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-media(); } } } } } }
                        Rectangle { x: 16px; y: 16px; width: 54px; height: 26px; border-radius: 8px; background: #06161de8; Text { text: "SDR"; color: #dfffe8; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } }
                        Text { visible: root.playback-error != ""; x: 18px; y: parent.height - 46px; width: parent.width - 36px; height: 36px; text: root.playback-error; color: #ff9ca5; horizontal-alignment: center; overflow: elide; }
                        Rectangle { x: 76px; y: 16px; width: 54px; height: 26px; border-radius: 8px; background: #06161de8; Text { text: "HD"; color: #dfffe8; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } }
                        for cue in root.video-subtitle-items: Rectangle { visible: root.video-subtitles-enabled && root.playback-position-ms >= cue.start-ms && root.playback-position-ms < cue.end-ms; x: parent.width / 2 - 300px; y: parent.height - 108px; width: 600px; min-height: self.visible ? 48px : 0px; border-radius: 9px; background: #000000dc; Text { x: 14px; width: parent.width - 28px; text: cue.text; color: white; font-size: 14px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; } }
                    }

                    Rectangle {
                        height: root.video-sound-open ? (root.video-audio-tracks.length > 1 ? 260px : 214px) : 150px; border-radius: 20px; background: #07171de8; border-width: 1px; border-color: #ffffff20;
                        VerticalLayout { padding: 16px; spacing: 12px;
                            HorizontalLayout { height: 18px; Text { text: root.position-text; color: #9db0aa; font-size: 10px; width: 48px; } video-seek := Rectangle { horizontal-stretch: 1; height: 6px; border-radius: 3px; background: #ffffff2c; Rectangle { width: parent.width * root.position-ratio; height: parent.height; border-radius: 3px; background: #38ff66; } video-seek-touch := TouchArea { clicked => { root.seek(Math.max(0, Math.min(1, self.mouse-x / video-seek.width))); } moved => { if self.pressed { root.seek(Math.max(0, Math.min(1, self.mouse-x / video-seek.width))); } } } } Text { text: root.duration-text; color: #9db0aa; font-size: 10px; width: 48px; horizontal-alignment: right; } }
                            HorizontalLayout { spacing: 8px; alignment: center;
                                Rectangle { width: 38px; height: 38px; border-radius: 19px; background: #ffffff0c; FluentGlyph { glyph: ""; font-size: 17px; } TouchArea { clicked => { root.seek-relative(-10); } } }
                                Rectangle { width: 48px; height: 48px; border-radius: 24px; background: #f3fff7; FluentGlyph { glyph: root.is-playing ? "" : ""; color: #051109; font-size: 19px; } TouchArea { clicked => { root.toggle-playback(); } } }
                                Rectangle { width: 38px; height: 38px; border-radius: 19px; background: #ffffff0c; FluentGlyph { glyph: ""; font-size: 17px; } TouchArea { clicked => { root.seek-relative(10); } } }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                for option in ["Aspect: " + root.video-aspect-mode, root.video-subtitles-enabled ? "Subtitles on" : "Subtitles", root.playback-rate + "×", root.video-loop ? "Loop on" : "Loop", "Translate", "Sound", "Info"]: Rectangle { width: option == "Info" ? 64px : 94px; height: 38px; border-radius: 19px; background: option-touch.has-hover || option == "Loop on" || (option == "Translate" && root.video-translation-active) ? #38ff6624 : #ffffff0c; border-width: 1px; border-color: #ffffff1e; Text { text: option == "Translate" && root.video-translation-active ? "Translating…" : option; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; } option-touch := TouchArea { enabled: option != "Translate" || !root.video-translation-active; clicked => { if (option == "Aspect: " + root.video-aspect-mode) { root.video-aspect-mode = root.video-aspect-mode == "Original" ? "16:9" : root.video-aspect-mode == "16:9" ? "4:3" : root.video-aspect-mode == "4:3" ? "21:9" : root.video-aspect-mode == "21:9" ? "Fill" : "Original"; } else if (option == "Subtitles" || option == "Subtitles on") { root.video-subtitles-enabled = !root.video-subtitles-enabled; } else if (option == root.playback-rate + "×") { root.set-playback-rate(root.playback-rate >= 2 ? 0.5 : root.playback-rate + 0.25); } else if (option == "Loop" || option == "Loop on") { root.video-loop = !root.video-loop; root.set-music-repeat(root.video-loop); } else if (option == "Translate") { root.translate-video-audio(); } else if (option == "Sound") { root.video-sound-open = !root.video-sound-open; } else if (option == "Info") { root.video-info-open = !root.video-info-open; } } } }
                            }
                            if root.video-sound-open: VerticalLayout { height: root.video-audio-tracks.length > 1 ? 130px : 84px; spacing: 8px; HorizontalLayout { height: 26px; spacing: 9px; Rectangle { width: 62px; height: 26px; border-radius: 13px; background: root.video-muted ? #38ff6624 : #ffffff0c; Text { text: root.video-muted ? "Unmute" : "Mute"; color: root.video-muted ? #38ff66 : white; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { if root.video-muted { root.video-muted = false; root.set-volume(root.video-volume-before-mute); } else { root.video-volume-before-mute = root.volume-percent / 100; root.video-muted = true; root.set-volume(0); } } } } FluentGlyph { glyph: root.volume-percent == 0 ? "" : ""; font-size: 15px; } video-volume := Rectangle { horizontal-stretch: 1; height: 16px; background: transparent; Rectangle { y: 5px; width: parent.width; height: 6px; border-radius: 3px; background: #ffffff2c; Rectangle { width: parent.width * root.volume-percent / 100; height: parent.height; border-radius: 3px; background: #38ff66; } } video-volume-touch := TouchArea { clicked => { root.video-muted = false; root.set-volume(Math.max(0, Math.min(1, self.mouse-x / video-volume.width))); } moved => { if self.pressed { root.video-muted = false; root.set-volume(Math.max(0, Math.min(1, self.mouse-x / video-volume.width))); } } } } Text { text: root.volume-percent + "%"; color: #9db0aa; font-size: 9px; width: 34px; } } HorizontalLayout { height: 42px; spacing: 7px; Text { text: "Output"; color: #8da29b; font-size: 8px; width: 42px; vertical-alignment: center; } video-device-strip := Flickable { horizontal-stretch: 1; content-width: video-device-row.preferred-width; video-device-row := HorizontalLayout { spacing: 6px; for device in root.audio-output-devices: Rectangle { width: 170px; border-radius: 12px; background: root.selected-audio-device-id == device.id ? #38ff6625 : video-device-touch.has-hover ? #ffffff16 : #ffffff09; border-width: root.selected-audio-device-id == device.id ? 1px : 0px; border-color: #38ff6670; Text { text: device.name; color: white; font-size: 8px; x: 10px; width: parent.width - 20px; vertical-alignment: center; overflow: elide; } video-device-touch := TouchArea { clicked => { root.select-audio-device(device.id, device.name); } } } } } Rectangle { width: 62px; border-radius: 12px; background: #ffffff0c; Text { text: "Refresh"; color: white; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.refresh-audio-devices(); } } } } if root.video-audio-tracks.length > 1: HorizontalLayout { height: 38px; spacing: 7px; Text { text: "Audio"; color: #8da29b; font-size: 8px; width: 42px; vertical-alignment: center; } video-track-strip := Flickable { horizontal-stretch: 1; content-width: video-track-row.preferred-width; video-track-row := HorizontalLayout { spacing: 6px; for track in root.video-audio-tracks: Rectangle { width: 142px; border-radius: 12px; background: track.selected ? #38ff6625 : video-track-touch.has-hover ? #ffffff16 : #ffffff09; border-width: track.selected ? 1px : 0px; border-color: #38ff6670; Text { x: 10px; width: parent.width - 20px; text: track.name + (track.language == "" ? "" : " • " + track.language); color: track.selected ? #38ff66 : white; font-size: 8px; vertical-alignment: center; overflow: elide; } video-track-touch := TouchArea { clicked => { root.select-video-audio-track(track.index); } } } } } } }
                        }
                    }
                }

                if root.video-info-open: Rectangle { x: parent.width - 410px; y: 94px; width: 370px; height: 370px; border-radius: 22px; background: #07171df5; border-width: 1px; border-color: #ffffff28; VerticalLayout { padding: 22px; spacing: 10px; HorizontalLayout { Text { text: "Video information"; color: white; font-size: 19px; font-weight: 700; } Rectangle { horizontal-stretch: 1; background: transparent; } FluentGlyph { glyph: ""; font-size: 14px; width: 28px; TouchArea { clicked => { root.video-info-open = false; } } } } Text { text: root.track-title; color: #38ff66; font-size: 13px; font-weight: 650; wrap: word-wrap; } Text { text: root.track-detail; color: #9db0aa; font-size: 9px; wrap: word-wrap; } Text { text: root.track-technical-detail; color: white; font-size: 10px; wrap: word-wrap; } Text { text: root.video-subtitle-status; color: root.video-subtitle-items.length > 0 ? #38ff66 : #71877f; font-size: 9px; wrap: word-wrap; } Text { text: root.video-translation-status; color: root.video-translation-active ? #ffcc66 : #82978f; font-size: 9px; wrap: word-wrap; } Rectangle { height: 36px; border-radius: 18px; background: #ffffff0d; Text { text: "Choose SRT or WebVTT subtitles"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.browse-video-subtitles(); } } } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: "Playback: Windows Media Foundation"; color: #71877f; font-size: 9px; } } }
            }

            if root.current-route == "screen-recorder": VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                spacing: 14px;
                HorizontalLayout { height: 66px; spacing: 9px; VerticalLayout { Text { text: "ZINK CREATE"; color: #ff666f; font-size: 10px; font-weight: 750; } Text { text: "Screen Recorder"; color: white; font-size: 30px; font-weight: 750; } Text { text: "Capture a display, window or region with Windows-native recording."; color: #9db0aa; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 142px; height: 44px; border-radius: 22px; background: #ffffff0d; VerticalLayout { alignment: center; Text { text: "QUALITY"; color: #71877f; font-size: 7px; horizontal-alignment: center; } Text { text: root.recorder-quality; color: white; font-size: 9px; horizontal-alignment: center; } } TouchArea { clicked => { root.recorder-quality = root.recorder-quality == "1080p 60 FPS" ? "1440p 60 FPS" : root.recorder-quality == "1440p 60 FPS" ? "4K 60 FPS" : root.recorder-quality == "4K 60 FPS" ? "1080p 30 FPS" : "1080p 60 FPS"; } } } Rectangle { width: 112px; height: 44px; border-radius: 22px; background: root.recorder-capture-cursor ? #38ff6618 : #ffffff0d; Text { text: root.recorder-capture-cursor ? "Cursor on" : "Cursor off"; color: root.recorder-capture-cursor ? #38ff66 : white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.recorder-capture-cursor = !root.recorder-capture-cursor; } } } Rectangle { width: 152px; height: 44px; border-radius: 22px; background: #ffffff0d; Text { text: "Recordings library"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("recordings"); } } } }
                Rectangle { height: 54px; border-radius: 16px; background: root.recorder-active ? #ff5b6518 : #38ff6610; border-width: 1px; border-color: root.recorder-active ? #ff5b6555 : #38ff6635; HorizontalLayout { padding: 14px; spacing: 10px; Rectangle { width: 10px; height: 10px; border-radius: 5px; background: root.recorder-active ? #ff5b65 : #38ff66; } VerticalLayout { alignment: center; Text { text: root.recorder-status; color: white; font-size: 10px; vertical-alignment: center; overflow: elide; } Text { text: "Target: " + root.recorder-selected-target; color: #9db0aa; font-size: 8px; overflow: elide; } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.recorder-active ? "RECORDING" : "READY"; color: root.recorder-active ? #ff8d94 : #38ff66; font-size: 8px; font-weight: 750; vertical-alignment: center; } } }
                GridLayout { spacing: 14px;
                    Rectangle { row: 0; col: 0; border-radius: 20px; background: #00161dbd; VerticalLayout { padding: 18px; spacing: 8px; HorizontalLayout { height: 30px; Text { text: "Capture target"; color: white; font-size: 20px; font-weight: 700; } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 84px; border-radius: 15px; background: #ffffff0d; Text { text: "Refresh"; color: white; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.refresh-recorder-targets(); } } } } Rectangle { height: 42px; border-radius: 12px; background: root.recorder-selected-pid == 0 ? #38ff6618 : #ffffff08; border-width: 1px; border-color: root.recorder-selected-pid == 0 ? #38ff6650 : #ffffff10; HorizontalLayout { padding: 10px; FluentGlyph { glyph: ""; color: #38ff66; font-size: 14px; width: 24px; } Text { text: "Primary display"; color: white; font-size: 10px; vertical-alignment: center; } } TouchArea { clicked => { root.recorder-selected-pid = 0; root.recorder-selected-target = "Primary display"; root.select-recorder-target(0, "Primary display"); } } } recorder-target-scroll := ZinkScrollView { vertical-stretch: 1; content-height: recorder-target-list.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.always-on; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; recorder-target-list := VerticalLayout { width: recorder-target-scroll.visible-width - 14px; spacing: 6px; for target in root.recorder-target-items: Rectangle { height: 38px; border-radius: 11px; background: root.recorder-selected-pid == target.pid ? #38ff6618 : target-touch.has-hover ? #ffffff12 : #ffffff07; Text { text: target.title; color: white; font-size: 9px; x: 11px; width: parent.width - 22px; vertical-alignment: center; overflow: elide; } target-touch := TouchArea { clicked => { root.recorder-selected-pid = target.pid; root.recorder-selected-target = target.title; root.select-recorder-target(target.pid, target.title); } } } } } } }
                    Rectangle { row: 0; col: 1; border-radius: 20px; background: @linear-gradient(135deg, #102c32 0%, #111a20 100%); border-width: 1px; border-color: #38ff6640; VerticalLayout { padding: 20px; spacing: 9px; HorizontalLayout { height: 28px; Text { text: "Audio and capture"; color: white; font-size: 21px; font-weight: 700; } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 72px; border-radius: 14px; background: #ffffff0d; Text { text: "Refresh"; color: white; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.refresh-recorder-audio-devices(); } } } } Text { text: "Choose exact WASAPI endpoints for recording, replay and streaming."; color: #9db0aa; font-size: 9px; wrap: word-wrap; } HorizontalLayout { height: 34px; spacing: 7px; Text { text: "OUTPUT"; color: #71877f; font-size: 7px; width: 46px; vertical-alignment: center; } recorder-output-scroll := Flickable { horizontal-stretch: 1; content-width: recorder-output-row.preferred-width; recorder-output-row := HorizontalLayout { spacing: 6px; Rectangle { width: 110px; border-radius: 10px; background: root.recorder-output-device-id == "" ? #38ff6624 : #ffffff09; Text { text: "Windows default"; color: white; font-size: 7px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.recorder-output-device-id = ""; root.save-recorder-audio-devices(root.recorder-output-device-id, root.recorder-input-device-id); } } } for device in root.recorder-output-devices: Rectangle { width: 142px; border-radius: 10px; background: root.recorder-output-device-id == device.id ? #38ff6624 : #ffffff09; Text { x: 8px; width: parent.width - 16px; text: device.name; color: white; font-size: 7px; vertical-alignment: center; overflow: elide; } TouchArea { clicked => { root.recorder-output-device-id = device.id; root.save-recorder-audio-devices(root.recorder-output-device-id, root.recorder-input-device-id); } } } } } } HorizontalLayout { height: 34px; spacing: 7px; Text { text: "INPUT"; color: #71877f; font-size: 7px; width: 46px; vertical-alignment: center; } recorder-input-scroll := Flickable { horizontal-stretch: 1; content-width: recorder-input-row.preferred-width; recorder-input-row := HorizontalLayout { spacing: 6px; Rectangle { width: 110px; border-radius: 10px; background: root.recorder-input-device-id == "" ? #38ff6624 : #ffffff09; Text { text: "Windows default"; color: white; font-size: 7px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.recorder-input-device-id = ""; root.save-recorder-audio-devices(root.recorder-output-device-id, root.recorder-input-device-id); } } } for device in root.recorder-input-devices: Rectangle { width: 142px; border-radius: 10px; background: root.recorder-input-device-id == device.id ? #38ff6624 : #ffffff09; Text { x: 8px; width: parent.width - 16px; text: device.name; color: white; font-size: 7px; vertical-alignment: center; overflow: elide; } TouchArea { clicked => { root.recorder-input-device-id = device.id; root.save-recorder-audio-devices(root.recorder-output-device-id, root.recorder-input-device-id); } } } } } } for option in [{title:"System audio", enabled:root.replay-system-audio, id:"system"}, {title:"Microphone", enabled:root.replay-microphone, id:"microphone"}, {title:"Capture cursor", enabled:root.recorder-capture-cursor, id:"cursor"}]: Rectangle { height: 34px; border-radius: 11px; background: option.enabled ? #38ff6617 : #ffffff08; HorizontalLayout { padding: 9px; Text { text: option.title; color: white; font-size: 9px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: option.enabled ? "ON" : "OFF"; color: option.enabled ? #38ff66 : #71877f; font-size: 7px; font-weight: 700; vertical-alignment: center; } } TouchArea { clicked => { if option.id == "system" { root.replay-system-audio = !root.replay-system-audio; } else if option.id == "microphone" { root.replay-microphone = !root.replay-microphone; } else { root.recorder-capture-cursor = !root.recorder-capture-cursor; } root.save-replay-settings(root.replay-duration-seconds, root.replay-system-audio, root.replay-microphone, root.replay-separate-tracks, root.replay-audio-bitrate); } } } } }
                    Rectangle { row: 1; col: 0; border-radius: 20px; background: #00161dbd; VerticalLayout { padding: 20px; spacing: 12px; Text { text: "Manual recording"; color: white; font-size: 20px; font-weight: 700; } Text { text: "Record the primary display directly with Windows Graphics Capture, Media Foundation H.264 and native AAC, or use the Windows picker for an exact region."; color: #9db0aa; font-size: 10px; wrap: word-wrap; } Rectangle { vertical-stretch: 1; background: transparent; } HorizontalLayout { height: 44px; spacing: 9px; Rectangle { horizontal-stretch: 1; border-radius: 22px; background: root.recorder-active ? #ff5b65 : #ffffff0d; border-width: 1px; border-color: root.recorder-active ? #ff8d94 : #ffffff20; Text { text: root.recorder-active ? "Stop recording" : "Start native recording"; color: white; font-size: 10px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.recorder-command("toggle-recording"); } } } Rectangle { width: 150px; border-radius: 22px; background: #ffffff0d; Text { text: "Capture region"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.launch-native-recorder(); } } } } } }
                    Rectangle { row: 1; col: 1; border-radius: 14px; background: #00161dbd; VerticalLayout { padding: 18px; spacing: 10px; Text { text: "Background clipping"; color: white; font-size: 20px; font-weight: 650; } Text { text: "Keep recent gameplay in Zink's native encoded-memory buffer and save it directly as H.264/AAC MP4."; color: #d6e2eaa9; font-size: 10px; wrap: word-wrap; } HorizontalLayout { height: 44px; spacing: 8px; Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #38ff6618; border-width: 1px; border-color: #38ff6645; Text { text: "Save recent gameplay"; color: #38ff66; font-size: 10px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: root.settings-background-replay; clicked => { root.recorder-command("save-replay"); } } } Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #ffffff0d; Text { text: root.settings-background-replay ? "Stop replay" : "Start replay"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.update-setting("background-replay", !root.settings-background-replay); } } } } HorizontalLayout { height: 34px; spacing: 7px; Text { text: "SAVE LAST"; color: #71877f; font-size: 7px; width: 50px; vertical-alignment: center; } for seconds in [30, 45, 60]: Rectangle { horizontal-stretch: 1; border-radius: 14px; background: duration-touch.has-hover ? #38ff6624 : #ffffff09; Text { text: seconds < 60 ? seconds + " sec" : "1 min"; color: root.settings-background-replay ? #38ff66 : #61716c; font-size: 8px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } duration-touch := TouchArea { enabled: root.settings-background-replay; clicked => { root.recorder-command("save-replay:" + seconds); } } } } Rectangle { height: 38px; border-radius: 19px; background: root.settings-run-startup ? #38ff6617 : #ffffff08; HorizontalLayout { padding: 11px; Text { text: "Run Zink at sign-in for capture hotkeys"; color: white; font-size: 9px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.settings-run-startup ? "ON" : "OFF"; color: root.settings-run-startup ? #38ff66 : #71877f; font-size: 8px; font-weight: 700; vertical-alignment: center; } } TouchArea { clicked => { root.update-setting("startup", !root.settings-run-startup); } } } Rectangle { vertical-stretch: 1; background: transparent; } HorizontalLayout { height: 40px; spacing: 8px; Rectangle { horizontal-stretch: 1; border-radius: 20px; background: #001016a0; Text { text: "Replay options"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("background-recording-settings"); } } } Rectangle { horizontal-stretch: 1; border-radius: 20px; background: #001016a0; Text { text: "Open recordings"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("recordings"); } } } } } }
                }
            }

            if root.current-route == "recordings": VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                spacing: 14px;
                HorizontalLayout { height: 52px; VerticalLayout { Text { text: "Recordings Library"; color: white; font-size: 30px; font-weight: 650; } Text { text: "Saved Zink recordings and replay clips"; color: #d6e2eaa9; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 112px; border-radius: 18px; background: #00161dbd; border-width: 1px; border-color: #11d8e850; Text { text: "Refresh"; color: white; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.refresh-recordings(); } } } Rectangle { width: 122px; border-radius: 18px; background: #38ff66; Text { text: "Open folder"; color: #051109; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-recordings-folder(); } } } }
                Rectangle { vertical-stretch: 1; border-radius: 20px; background: #00101680; border-width: 1px; border-color: #ffffff12;
                    if root.recording-items.length == 0: VerticalLayout { alignment: center; spacing: 10px; FluentGlyph { glyph: ""; color: #38ff66; font-size: 36px; horizontal-alignment: center; } Text { text: "No recordings yet"; color: white; font-size: 20px; font-weight: 700; horizontal-alignment: center; } Text { text: "Record a screen region or save recent gameplay and it will appear here."; color: #8da29b; font-size: 10px; horizontal-alignment: center; } HorizontalLayout { height: 42px; alignment: center; Rectangle { width: 170px; height: 42px; border-radius: 21px; background: #ff5b65; Text { text: "Open recorder"; color: white; font-size: 10px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("screen-recorder"); } } } } }
                    if root.recording-items.length > 0: recording-scroll := ZinkScrollView { width: parent.width; height: parent.height; content-height: recording-list.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.always-on; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; recording-list := VerticalLayout { width: recording-scroll.visible-width - 14px; padding: 12px; spacing: 8px; for media in root.recording-items: Rectangle { visible: media.media-kind == "video"; height: self.visible ? 82px : 0px; border-radius: 15px; background: play-recording-touch.has-hover || external-touch.has-hover || delete-recording-touch.has-hover ? #ffffff12 : #00161dbd; border-width: 1px; border-color: play-recording-touch.has-hover || external-touch.has-hover ? #38ff6640 : delete-recording-touch.has-hover ? #ff5b6555 : #ffffff10; HorizontalLayout { padding: 10px; spacing: 12px; Rectangle { width: 62px; height: 62px; border-radius: 12px; clip: true; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 18px; } Image { source: media.artwork; image-fit: cover; width: parent.width; height: parent.height; } } VerticalLayout { alignment: center; spacing: 4px; Text { text: media.title; color: white; font-size: 12px; font-weight: 700; overflow: elide; } Text { text: media.duration; color: #38ff66; font-size: 8px; overflow: elide; } Text { text: media.path; color: #8da29b; font-size: 8px; overflow: elide; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 70px; height: 38px; border-radius: 19px; background: delete-recording-touch.has-hover ? #ff5b6530 : #ffffff0b; Text { text: "Recycle"; color: delete-recording-touch.has-hover ? #ff8d94 : white; font-size: 8px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } delete-recording-touch := TouchArea { clicked => { root.delete-recording(media.path); } } } Rectangle { width: 96px; height: 38px; border-radius: 19px; background: external-touch.has-hover ? #ffffff18 : #ffffff0b; Text { text: "Open in Windows"; color: white; font-size: 8px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } external-touch := TouchArea { clicked => { root.open-recording-external(media.path); } } } Rectangle { width: 86px; height: 38px; border-radius: 19px; background: play-recording-touch.has-hover ? #62ff82 : #38ff66; Text { text: "Play in Zink"; color: #051109; font-size: 8px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } play-recording-touch := TouchArea { clicked => { root.play-library-item(media.path); root.navigate("video-player"); } } } } } } }
                }
            }

            if root.current-route == "social": HorizontalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                spacing: 16px;
                Rectangle { width: 280px; border-radius: 16px; background: #00161dbd; VerticalLayout { padding: 18px; spacing: 8px; Text { text: "Zink Social"; color: white; font-size: 26px; font-weight: 650; } Text { text: "Friends, messages, calls and profiles"; color: #d6e2eaa9; wrap: word-wrap; } for label in ["Friends", "Friend requests", "Messages", "Voice call", "Video call", "My profile", "Add friends", "Developer settings"]: Rectangle { height: 44px; border-radius: 9px; background: social-nav-touch.has-hover ? #38ff6618 : #001016a0; Text { text: label; color: white; horizontal-alignment: center; vertical-alignment: center; } social-nav-touch := TouchArea { clicked => { root.navigate(label == "Friends" || label == "Add friends" ? "friends" : label == "Friend requests" ? "friend-requests" : label == "Messages" ? "messages" : label == "Voice call" || label == "Video call" ? "call" : label == "My profile" ? "profile" : "social-developer"); } } } } }
                Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #00161ddb; border-width: 1px; border-color: #ffffff14; VerticalLayout { padding: 26px; spacing: 16px; Text { text: root.social-signed-in ? "Welcome, " + (root.social-display-name == "" ? root.social-username : root.social-display-name) : "Your Zink circle"; color: white; font-size: 28px; font-weight: 700; } Rectangle { height: 94px; border-radius: 16px; background: root.social-signed-in ? #38ff6610 : #001016a0; border-width: 1px; border-color: root.social-signed-in ? #38ff6635 : #ffffff0d; HorizontalLayout { padding: 16px; spacing: 14px; Rectangle { width: 58px; height: 58px; border-radius: 20px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 24px; } } VerticalLayout { alignment: center; spacing: 4px; Text { text: root.social-signed-in ? root.social-status : "Sign in to see friends, messages and calls"; color: white; font-size: 12px; font-weight: 650; } Text { text: root.social-signed-in ? root.social-friends.length + " friends • " + root.social-requests.length + " requests" : "Use your existing Zink Social account or create a new one."; color: #91a69f; font-size: 9px; } } } } Text { text: "Quick actions"; color: white; font-size: 18px; font-weight: 700; } GridLayout { height: 180px; spacing: 10px; for action[index] in [{title:"Friends", detail:"Presence and profiles", route:"friends", icon:""}, {title:"Messages", detail:"Private conversations", route:"messages", icon:""}, {title:"Calls", detail:"Voice and screen sharing", route:"call", icon:""}, {title:"Friend requests", detail:"Review new connections", route:"friend-requests", icon:""}]: Rectangle { row: index / 2; col: Math.mod(index, 2); border-radius: 15px; background: action-touch.has-hover ? #38ff6617 : #ffffff08; HorizontalLayout { padding: 14px; spacing: 11px; Rectangle { width: 40px; height: 40px; border-radius: 13px; background: #38ff6615; FluentGlyph { glyph: action.icon; color: #38ff66; font-size: 17px; } } VerticalLayout { alignment: center; Text { text: action.title; color: white; font-size: 11px; font-weight: 650; } Text { text: action.detail; color: #839992; font-size: 8px; } } } action-touch := TouchArea { clicked => { root.navigate(root.social-signed-in ? action.route : "social-login"); } } } } Rectangle { vertical-stretch: 1; background: transparent; } HorizontalLayout { height: 46px; spacing: 10px; Rectangle { horizontal-stretch: 1; border-radius: 23px; background: #38ff66; Text { text: root.social-signed-in ? "Refresh presence" : "Sign in"; color: #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { if root.social-signed-in { root.social-refresh(); } else { root.navigate("social-login"); } } } } Rectangle { horizontal-stretch: 1; border-radius: 23px; background: #ffffff0d; Text { text: root.social-signed-in ? "My profile" : "Create account"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate(root.social-signed-in ? "profile" : "social-register"); } } } } } }
            }

            if root.current-route == "social-web": Rectangle { border-radius: 24px; background: @linear-gradient(135deg, #0d3537 0%, #081b22 55%, #050d13 100%); border-width: 1px; border-color: #ffffff16; VerticalLayout { padding: 36px; spacing: 18px; Text { text: "ZINK SOCIAL"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: "Your social home"; color: white; font-size: 31px; font-weight: 750; } Text { text: "Move between your Zink circle and the services you use every day."; color: #9db0aa; font-size: 11px; } Rectangle { height: 190px; border-radius: 24px; background: #ffffff08; HorizontalLayout { padding: 24px; spacing: 20px; Rectangle { width: 132px; height: 132px; border-radius: 40px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 48px; } } VerticalLayout { alignment: center; spacing: 8px; Text { text: root.social-signed-in ? "Welcome back, " + (root.social-display-name == "" ? root.social-username : root.social-display-name) : "Connect with Zink Social"; color: white; font-size: 23px; font-weight: 720; } Text { text: root.social-signed-in ? "Friends, messages, presence and calls are ready." : "Sign in or create an account to use native Zink friends, messages and calls."; color: #b7cac4; font-size: 10px; wrap: word-wrap; } HorizontalLayout { height: 40px; spacing: 9px; Rectangle { width: 130px; border-radius: 20px; background: #38ff66; Text { text: root.social-signed-in ? "Open friends" : "Sign in"; color: #051109; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate(root.social-signed-in ? "friends" : "social-login"); } } } Rectangle { width: 130px; border-radius: 20px; background: #ffffff0c; Text { text: "Messages"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("messages"); } } } } } } } Text { text: "Your services"; color: white; font-size: 20px; font-weight: 700; } GridLayout { vertical-stretch: 1; spacing: 11px; for service[index] in [{name:"Discord", route:"discord"}, {name:"YouTube", route:"youtube"}, {name:"Twitch", route:"twitch"}, {name:"Instagram", route:"instagram"}, {name:"WhatsApp", route:"whatsapp"}, {name:"Reddit", route:"reddit"}]: Rectangle { row: index / 3; col: Math.mod(index, 3); border-radius: 18px; background: social-service-touch.has-hover ? #38ff6617 : #ffffff07; VerticalLayout { padding: 17px; Rectangle { vertical-stretch: 1; background: transparent; } Text { text: service.name; color: white; font-size: 14px; font-weight: 700; } Text { text: "Open in Zink Connect  ›"; color: #38ff66; font-size: 8px; } } social-service-touch := TouchArea { clicked => { root.navigate(service.route); } } } } } }

            if root.current-route == "social-login" || root.current-route == "social-register": Rectangle {
                horizontal-stretch: 1; vertical-stretch: 1;
                border-radius: 24px; clip: true; background: @linear-gradient(135deg, #0a2b31 0%, #07171d 55%, #050d13 100%); border-width: 1px; border-color: #ffffff16;
                auth-scroll := ZinkScrollView {
                    width: parent.width; height: parent.height;
                    content-height: Math.max(self.visible-height, auth-form-row.height + 40px);
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                    auth-form-row := HorizontalLayout {
                        y: Math.max(20px, (auth-scroll.content-height - self.height) / 2);
                        width: auth-scroll.visible-width; height: auth-fields.preferred-height;
                        alignment: center;
                    Rectangle { width: Math.min(510px, auth-scroll.visible-width - 44px); height: auth-fields.preferred-height; border-radius: 24px; background: #06141be8; border-width: 1px; border-color: #ffffff18; auth-fields := VerticalLayout { width: parent.width; padding: 26px; spacing: 12px; Text { text: "ZINK SOCIAL"; color: #38ff66; font-size: 11px; font-weight: 750; } Text { text: root.current-route == "social-login" ? "Sign in" : "Create account"; color: white; font-size: 26px; font-weight: 750; } Text { text: root.current-route == "social-login" ? "Use your Zink Social username." : "Set up your public Zink identity."; color: #8da29b; font-size: 10px; }
                        if root.current-route == "social-register": VerticalLayout { height: 62px; spacing: 5px; Text { text: "Display name"; color: #b8c8c3; font-size: 9px; } Rectangle { height: 42px; border-radius: 12px; background: #ffffff0a; TextInput { x: 13px; width: parent.width - 26px; height: parent.height; text: root.social-display-name; color: white; single-line: true; edited => { root.social-display-name = self.text; } } } }
                        if root.current-route == "social-register": VerticalLayout { height: 62px; spacing: 5px; Text { text: "Username"; color: #b8c8c3; font-size: 9px; } Rectangle { height: 42px; border-radius: 12px; background: #ffffff0a; TextInput { x: 13px; width: parent.width - 26px; height: parent.height; text: root.social-username; color: white; single-line: true; edited => { root.social-username = self.text; } } } }
                        if root.current-route == "social-login": VerticalLayout { height: 62px; spacing: 5px; Text { text: "Username"; color: #b8c8c3; font-size: 9px; } Rectangle { height: 42px; border-radius: 12px; background: #ffffff0a; TextInput { x: 13px; width: parent.width - 26px; height: parent.height; text: root.current-route == "social-login" ? root.social-identity : root.social-email; color: white; single-line: true; edited => { if (root.current-route == "social-login") { root.social-identity = self.text; } else { root.social-email = self.text; } } } } }
                        VerticalLayout { height: 62px; spacing: 5px; Text { text: "Password"; color: #b8c8c3; font-size: 9px; } Rectangle { height: 42px; border-radius: 12px; background: #ffffff0a; TextInput { x: 13px; width: parent.width - 26px; height: parent.height; text: root.social-password; color: white; single-line: true; input-type: password; edited => { root.social-password = self.text; } accepted => { if (root.current-route == "social-login") { root.social-login(root.social-identity, root.social-password); } else { root.social-register(root.social-display-name, root.social-username, root.social-email, root.social-password); } } } } }
                        Rectangle { height: 46px; border-radius: 23px; background: #38ff66; Text { text: root.current-route == "social-login" ? "Sign in" : "Create account"; color: #051109; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { if (root.current-route == "social-login") { root.social-login(root.social-identity, root.social-password); } else { root.social-register(root.social-display-name, root.social-username, root.social-email, root.social-password); } } } }
                        Text { text: root.social-status; color: root.social-signed-in ? #38ff66 : #8da29b; font-size: 9px; wrap: word-wrap; }
                        Rectangle { height: 4px; background: transparent; }
                        HorizontalLayout { height: 40px; spacing: 8px; Rectangle { horizontal-stretch: 1; border-radius: 20px; background: #ffffff0a; Text { text: root.current-route == "social-login" ? "Create account" : "Back to sign in"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate(root.current-route == "social-login" ? "social-register" : "social-login"); } } } Rectangle { visible: root.current-route == "social-register"; width: self.visible ? 150px : 0px; border-radius: 20px; background: #ffffff0a; Text { text: "Developer settings"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("social-developer"); } } } }
                    } }
                    }
                }
            }

            if root.current-route == "friends" || root.current-route == "friend-requests": Rectangle {
                horizontal-stretch: 1; vertical-stretch: 1; border-radius: 24px; background: #06161cde; border-width: 1px; border-color: #ffffff14; VerticalLayout { width: parent.width; height: parent.height; padding: 30px; spacing: 18px;
                    HorizontalLayout { height: 64px; VerticalLayout { Text { text: "ZINK SOCIAL"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: root.current-route == "friends" ? "Friends" : "Friend requests"; color: white; font-size: 30px; font-weight: 750; } Text { text: root.current-route == "friends" ? "Find people, see presence, message and call your Zink circle." : "Review incoming requests and decide who joins your circle."; color: #8da29b; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } for action in [root.current-route == "friends" ? "Requests" : "Friends", "Profile", "Refresh"]: Rectangle { width: 104px; height: 40px; border-radius: 20px; background: #ffffff0c; Text { text: action; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { if (action == "Requests") { root.navigate("friend-requests"); } else if (action == "Friends") { root.navigate("friends"); } else if (action == "Profile") { root.navigate("profile"); } else { root.social-refresh(); } } } } }
                    if root.current-route == "friends" && root.social-signed-in: HorizontalLayout { height: 48px; spacing: 10px; Rectangle { horizontal-stretch: 1; border-radius: 24px; background: #ffffff0a; FluentGlyph { glyph: ""; x: 16px; width: 22px; color: #82978f; font-size: 15px; } Text { x: 48px; width: parent.width - 60px; vertical-alignment: center; visible: root.social-search == ""; text: "Search by username or display name"; color: #8da29b; } TextInput { x: 48px; width: parent.width - 60px; height: parent.height; text: root.social-search; color: white; single-line: true; edited => { root.social-search = self.text; } accepted => { root.social-search-friends(self.text); } } } Rectangle { width: 112px; border-radius: 24px; background: #38ff66; Text { text: "Search"; color: #051109; font-weight: 700; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.social-search-friends(root.social-search); } } } }
                    if root.social-signed-in: HorizontalLayout { height: 96px; spacing: 12px; for stat in [{label:"Friends", value:"" + root.social-friends.length, icon:""}, {label:"Online", value:"" + root.social-online-count, icon:""}, {label:"Requests", value:"" + root.social-requests.length, icon:""}]: Rectangle { horizontal-stretch: 1; border-radius: 18px; background: #ffffff08; VerticalLayout { padding: 16px; Text { text: stat.icon; font-family: "Segoe Fluent Icons"; color: #38ff66; font-size: 17px; } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: stat.value; color: white; font-size: 24px; font-weight: 750; } Text { text: stat.label; color: #82978f; font-size: 9px; } } } }
                    Rectangle { vertical-stretch: 1; border-radius: 22px; background: #ffffff06; ZinkScrollView { width: parent.width; height: parent.height; content-height: social-list.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.as-needed; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; social-list := VerticalLayout { width: parent.visible-width - 12px; padding: 14px; spacing: 10px;
                        if !root.social-signed-in: VerticalLayout { height: 190px; alignment: center; spacing: 10px; FluentGlyph { glyph: ""; color: #38ff66; font-size: 35px; } Text { text: "Sign in to Zink Social"; color: white; font-size: 18px; font-weight: 700; horizontal-alignment: center; } Text { text: root.social-status; color: #8da29b; font-size: 10px; horizontal-alignment: center; wrap: word-wrap; } HorizontalLayout { height: 40px; alignment: center; Rectangle { width: 140px; height: 40px; border-radius: 20px; background: #38ff66; Text { text: "Sign in"; color: #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("social-login"); } } } } }
                        if root.social-signed-in && root.current-route == "friends" && root.social-search-results.length > 0: Text { text: "Search results"; color: white; font-size: 15px; font-weight: 700; }
                        if root.social-signed-in && root.current-route == "friend-requests" && root.social-requests.length > 0: Text { text: "Incoming requests  ·  " + root.social-requests.length; color: white; font-size: 17px; font-weight: 700; }
                        if root.social-signed-in && root.current-route == "friends": VerticalLayout { spacing: 10px; for person in root.social-search-results: Rectangle { height: 72px; border-radius: 16px; background: #ffffff08; HorizontalLayout { padding: 12px; spacing: 12px; Rectangle { width: 46px; height: 46px; border-radius: 23px; background: #38ff6618; Text { text: person.display-name == "" ? person.username : person.display-name; color: #38ff66; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; overflow: elide; } } VerticalLayout { alignment: center; Text { text: person.display-name == "" ? person.username : person.display-name; color: white; font-size: 12px; font-weight: 700; } Text { text: "@" + person.username; color: #82978f; font-size: 9px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 108px; height: 38px; border-radius: 19px; background: person.is-friend ? #ffffff0a : #38ff66; Text { text: person.is-friend ? "Already friends" : "Add friend"; color: person.is-friend ? white : #051109; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: !person.is-friend; clicked => { root.social-add-friend(person.username); } } } } } }
                        if root.social-signed-in && root.current-route == "friends" && root.social-friends.length > 0: Text { text: "Your circle"; color: white; font-size: 15px; font-weight: 700; }
                        if root.social-signed-in && root.current-route == "friends": VerticalLayout { spacing: 10px; for friend in root.social-friends: Rectangle { height: 76px; border-radius: 16px; background: #ffffff08; HorizontalLayout { padding: 12px; spacing: 12px; Rectangle { width: 48px; height: 48px; border-radius: 24px; background: friend.is-online ? #38ff6624 : #ffffff0a; Text { text: friend.display-name == "" ? friend.username : friend.display-name; color: friend.is-online ? #38ff66 : #b4c4bf; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; overflow: elide; } } VerticalLayout { alignment: center; Text { text: friend.display-name == "" ? friend.username : friend.display-name; color: white; font-size: 12px; font-weight: 700; } Text { text: "@" + friend.username + "  •  " + (friend.is-online ? "Online" : "Offline"); color: friend.is-online ? #38ff66 : #82978f; font-size: 9px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 88px; height: 38px; border-radius: 19px; background: #ffffff0c; Text { text: "Message"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.social-select-friend(friend.user-id, friend.username, friend.display-name); root.navigate("messages"); } } } Rectangle { width: 70px; height: 38px; border-radius: 19px; background: #38ff661c; Text { text: "Call"; color: #38ff66; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.social-select-friend(friend.user-id, friend.username, friend.display-name); root.call-auto-share = false; root.navigate("call"); root.social-start-call(friend.user-id); } } } Rectangle { width: 92px; height: 38px; border-radius: 19px; background: #ffffff0c; Text { text: "Share screen"; color: white; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.social-select-friend(friend.user-id, friend.username, friend.display-name); root.call-auto-share = true; root.navigate("call"); root.social-start-call(friend.user-id); } } } } } }
                        if root.social-signed-in && root.current-route == "friend-requests": VerticalLayout { spacing: 10px; for request in root.social-requests: Rectangle { height: 82px; border-radius: 16px; background: #ffffff08; HorizontalLayout { padding: 12px; spacing: 12px; VerticalLayout { alignment: center; Text { text: request.display-name == "" ? request.username : request.display-name; color: white; font-size: 12px; font-weight: 700; } Text { text: "@" + request.username + (request.created == "" ? "" : "  •  " + request.created); color: #82978f; font-size: 9px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 90px; height: 38px; border-radius: 19px; background: #38ff66; Text { text: "Accept"; color: #051109; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.social-respond-request(request.request-id, true); } } } Rectangle { width: 90px; height: 38px; border-radius: 19px; background: #ffffff0c; Text { text: "Decline"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.social-respond-request(request.request-id, false); } } } } } }
                        if root.social-signed-in && ((root.current-route == "friends" && root.social-friends.length == 0 && root.social-search-results.length == 0) || (root.current-route == "friend-requests" && root.social-requests.length == 0)): VerticalLayout { height: 220px; alignment: center; spacing: 12px; FluentGlyph { glyph: root.current-route == "friends" ? "" : ""; color: #38ff66; font-size: 36px; horizontal-alignment: center; } Text { text: root.current-route == "friends" ? "No friends to show yet" : "No pending friend requests"; color: white; font-size: 19px; font-weight: 700; horizontal-alignment: center; } Text { text: root.current-route == "friends" ? "Search by username above to grow your Zink circle." : "New requests will appear here with Accept and Decline controls."; color: #8da29b; font-size: 10px; horizontal-alignment: center; wrap: word-wrap; } Text { text: root.social-status; color: #38ff66; font-size: 9px; horizontal-alignment: center; wrap: word-wrap; } }
                    } } }
                }
            }

            if root.current-route == "messages": HorizontalLayout { horizontal-stretch: 1; vertical-stretch: 1; spacing: 14px;
                Rectangle { width: 330px; border-radius: 22px; background: #06161cde; VerticalLayout { padding: 20px; spacing: 12px; HorizontalLayout { height: 42px; VerticalLayout { Text { text: "Inbox"; color: white; font-size: 23px; font-weight: 750; } Text { text: root.social-conversations.length == 0 ? "No saved conversations" : "" + root.social-conversations.length + " saved conversation(s)"; color: #82978f; font-size: 8px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 36px; height: 36px; border-radius: 18px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 15px; } TouchArea { clicked => { root.navigate("friends"); } } } } Rectangle { height: 44px; border-radius: 22px; background: #ffffff09; Text { text: "Choose a saved conversation"; color: #82978f; font-size: 9px; x: 16px; vertical-alignment: center; } } Rectangle { vertical-stretch: 1; background: transparent; ZinkScrollView { width: parent.width; height: parent.height; content-height: conversation-list.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.as-needed; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; conversation-list := VerticalLayout { width: parent.visible-width - 10px; spacing: 8px; for conversation in root.social-conversations: Rectangle { height: 68px; border-radius: 15px; background: conversation.display-name == root.social-active-name && conversation.username == root.social-active-username ? #38ff6618 : conversation-touch.has-hover ? #ffffff10 : #ffffff07; HorizontalLayout { padding: 11px; spacing: 10px; Rectangle { width: 42px; height: 42px; border-radius: 21px; background: #38ff6618; Text { text: conversation.display-name == "" ? conversation.username : conversation.display-name; color: #38ff66; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; overflow: elide; } } VerticalLayout { alignment: center; Text { text: conversation.display-name == "" ? conversation.username : conversation.display-name; color: white; font-size: 11px; font-weight: 700; overflow: elide; } Text { text: conversation.preview == "" ? "No messages yet" : conversation.preview; color: #82978f; font-size: 8px; overflow: elide; } } } conversation-touch := TouchArea { clicked => { root.social-select-friend(conversation.user-id, conversation.username, conversation.display-name); } } } } } } Rectangle { height: 40px; border-radius: 20px; background: #ffffff0a; Text { text: "Back to friends"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("friends"); } } } } }
                Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #06161cde; VerticalLayout { padding: 22px; spacing: 12px; HorizontalLayout { height: 52px; Rectangle { width: 44px; height: 44px; border-radius: 22px; background: #38ff6618; Text { text: root.social-active-name == "" ? "Z" : root.social-active-name; color: #38ff66; font-size: 10px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; overflow: elide; } } VerticalLayout { alignment: center; Text { text: root.social-active-name == "" ? "Messages" : root.social-active-name; color: white; font-size: 18px; font-weight: 700; } Text { text: root.social-active-username == "" ? "Choose a conversation or select a friend" : "@" + root.social-active-username + " • Saved on this device"; color: #82978f; font-size: 9px; } } } Rectangle { vertical-stretch: 1; border-radius: 18px; background: #02090d80; ZinkScrollView { width: parent.width; height: parent.height; content-height: message-list.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.as-needed; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; message-list := VerticalLayout { width: parent.visible-width - 12px; padding: 16px; spacing: 9px; if root.social-messages.length == 0: VerticalLayout { height: 150px; alignment: center; spacing: 8px; Text { text: root.social-active-name == "" ? "Choose a conversation" : "Start your conversation"; color: white; font-size: 16px; horizontal-alignment: center; } Text { text: "Messages are stored locally for this Zink Social account."; color: #82978f; font-size: 9px; horizontal-alignment: center; } } for message in root.social-messages: HorizontalLayout { height: 58px; alignment: message.is-from-me ? end : start; Rectangle { width: 520px; height: 52px; border-radius: 17px; background: message.is-from-me ? #235780d8 : #161d26d8; VerticalLayout { padding: 10px; Text { text: message.text; color: white; font-size: 10px; wrap: word-wrap; } Text { text: message.sent; color: #b8d8e4; font-size: 7px; horizontal-alignment: message.is-from-me ? right : left; } } } } } } } HorizontalLayout { height: 48px; spacing: 10px; Rectangle { horizontal-stretch: 1; border-radius: 24px; background: #ffffff0a; TextInput { x: 15px; width: parent.width - 30px; height: parent.height; text: root.social-message; color: white; single-line: true; enabled: root.social-active-username != ""; edited => { root.social-message = self.text; } accepted => { root.social-send-message(self.text); } } if root.social-active-username == "" && root.social-message == "": Text { x: 15px; text: "Choose a friend first"; color: #82978f; font-size: 9px; vertical-alignment: center; } } Rectangle { width: 96px; border-radius: 24px; background: root.social-active-username == "" ? #ffffff0b : #38ff66; Text { text: "Send"; color: root.social-active-username == "" ? #82978f : #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: root.social-active-username != ""; clicked => { root.social-send-message(root.social-message); } } } } Text { text: root.social-status; color: #82978f; font-size: 8px; } } }
            }

            if root.current-route == "call": call-room := Rectangle {
                private property <bool> settings-open: false;
                private property <bool> receiving-share: root.call-remote-visible || root.call-viewing-hdr10;
                private property <bool> microphone-off: root.call-muted || root.call-deafened;

                background: #050506;
                clip: true;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    HorizontalLayout {
                        height: 34px;
                        spacing: 10px;
                        FluentGlyph { glyph: ""; width: 22px; font-size: 17px; color: #bfc0c8; }
                        Text { text: "Zink Call"; color: white; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                        if root.social-active-name != "": Text {
                            text: "·   " + root.social-active-name;
                            color: #bfc0c8;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if root.social-active-name == "": Rectangle { horizontal-stretch: 1; }
                        CallBadge {
                            label: root.call-connected ? root.call-duration + "  CONNECTED" : root.call-in-progress ? "CONNECTING" : "IDLE";
                            fill: root.call-connected ? #153025 : #212127;
                        }
                        if root.call-screen-sharing: CallBadge { label: root.call-share-quality; }
                        if call-room.receiving-share || root.call-screen-sharing: CallBadge { label: "LIVE"; fill: #c42e40; }
                        CallAction {
                            glyph: ""; label: "Open messages";
                            activated => { root.navigate("messages"); }
                        }
                    }

                    call-stage := Rectangle {
                        vertical-stretch: 1;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #26272d;
                        clip: true;
                        background: root.call-remote-visible ? #000000 : @radial-gradient(circle, #20232c 0%, #111217 68%);

                        if root.call-remote-visible: Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.call-remote-image;
                            image-fit: contain;
                        }

                        if !root.call-remote-visible: VerticalLayout {
                            alignment: center;
                            padding: 24px;
                            spacing: 10px;
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 78px; height: 78px; border-radius: 39px;
                                    background: #2a303c;
                                    border-width: 1px; border-color: #ffffff24;
                                    FluentGlyph { glyph: call-room.receiving-share || root.call-screen-sharing ? "" : ""; font-size: 32px; color: #e6eaf4; }
                                }
                            }
                            Text {
                                text: root.call-viewing-hdr10 ? "HDR10 screen share" : root.call-screen-sharing ? "You’re sharing your screen" : root.social-active-name == "" ? "Choose a friend to start a call" : root.social-active-name;
                                color: white;
                                font-size: 24px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: root.call-viewing-hdr10 ? "Playing in the HDR viewer" : root.call-status;
                                color: #b5b8c4;
                                font-size: 12px;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }

                        if root.call-send-stats != "" || root.call-view-stats != "": Rectangle {
                            x: 12px; y: 12px;
                            width: stream-info.preferred-width;
                            height: stream-info.preferred-height;
                            border-radius: 8px;
                            background: #08090cde;
                            stream-info := VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                Text { text: "Stream info"; color: white; font-size: 11px; font-weight: 700; }
                                if root.call-view-stats != "": Text { text: "Receiving  " + root.call-view-stats; color: #d0d2db; font-size: 11px; }
                                if root.call-send-stats != "": Text { text: "Sending  " + root.call-send-stats; color: #d0d2db; font-size: 11px; }
                            }
                        }

                        if root.call-remote-visible: Rectangle {
                            y: parent.height - self.height;
                            height: 48px;
                            width: parent.width;
                            background: @linear-gradient(180deg, #00000000 0%, #000000d9 100%);
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 8px;
                                alignment: start;
                                spacing: 7px;
                                FluentGlyph { glyph: ""; width: 17px; font-size: 14px; }
                                Text { text: root.social-active-name + " · Screen share"; color: white; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                CallAction {
                                    glyph: ""; label: "View shared screen fullscreen";
                                    activated => { root.set-call-share-fullscreen(true); }
                                }
                            }
                        }

                        if call-room.settings-open: Rectangle {
                            x: parent.width - self.width - 10px;
                            y: parent.height - self.height - 10px;
                            width: 286px;
                            height: call-settings-content.preferred-height;
                            border-radius: 12px;
                            border-width: 1px; border-color: #41424d;
                            background: #18191f;

                            call-settings-content := VerticalLayout {
                                padding: 12px;
                                spacing: 6px;
                                HorizontalLayout {
                                    height: 32px;
                                    Text { text: "Call settings"; color: white; font-size: 14px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                                    CallAction {
                                        glyph: ""; label: "Close call settings";
                                        activated => { call-room.settings-open = false; }
                                    }
                                }
                                Text { text: "Screen share quality"; color: #c2c3cd; font-size: 11px; }
                                ComboBox {
                                    height: 30px;
                                    model: ["720p 30 FPS", "1080p 30 FPS", "1080p 60 FPS", "1440p 30 FPS", "1440p 60 FPS"];
                                    current-value <=> root.call-share-quality;
                                    enabled: !root.call-screen-sharing;
                                }
                                Button {
                                    height: 30px;
                                    text: root.call-share-audio ? "Share PC audio: On" : "Share PC audio: Off";
                                    clicked => { root.social-call-control("share-audio", !root.call-share-audio); }
                                }
                                if root.call-share-audio-error != "": Text { text: "PC audio unavailable"; color: #ffb5ac; font-size: 11px; }
                                for device in [
                                    {label: "Speaker", value: root.call-output-device-name, output: true},
                                    {label: "Microphone", value: root.call-input-device-name, output: false}
                                ]: Button {
                                    height: 30px;
                                    text: device.label + " · " + (device.value == "" ? "Windows default" : device.value);
                                    enabled: !root.call-in-progress;
                                    clicked => { root.cycle-call-audio-device(device.output); }
                                }
                                HorizontalLayout {
                                    height: 30px;
                                    spacing: 6px;
                                    Button {
                                        text: "Reconnect";
                                        enabled: root.social-active-name != "";
                                        clicked => { root.social-call-control("reconnect", true); }
                                    }
                                    Button { text: "Reset call"; clicked => { root.social-call-control("reset", true); } }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 94px;
                        spacing: 8px;
                        alignment: center;

                        if call-room.receiving-share: CallTile {
                            name: root.social-active-name + " · Screen";
                            glyph: "";
                            picture: root.call-remote-image;
                            preview: root.call-remote-visible;
                            status: root.call-viewing-hdr10 ? "HDR10" : "LIVE";
                            live: true;
                        }
                        if root.call-screen-sharing: CallTile {
                            name: "Your screen";
                            glyph: "";
                            status: "LIVE";
                            live: true;
                        }
                        if root.social-active-name != "": CallTile {
                            name: root.social-active-name;
                            glyph: "";
                            tint: #2d283e;
                            status: root.call-connected ? "IN CALL" : "";
                        }
                        CallTile {
                            name: root.social-display-name == "" ? "You" : root.social-display-name + " (you)";
                            glyph: call-room.microphone-off ? "" : "";
                            picture: root.social-avatar-image;
                            avatar: root.social-avatar-set;
                            tint: #213636;
                            status: call-room.microphone-off ? "MUTED" : "";
                        }
                    }

                    HorizontalLayout {
                        height: 46px;
                        spacing: 8px;
                        CallAction { glyph: ""; label: "Open friends"; activated => { root.navigate("friends"); } }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: 96px; border-radius: 12px;
                            background: #111114; border-width: 1px; border-color: #3a3b42;
                            HorizontalLayout {
                                padding: 4px; spacing: 4px;
                                CallAction {
                                    glyph: call-room.microphone-off ? "" : "";
                                    label: root.call-muted ? "Unmute microphone" : "Mute microphone";
                                    normal-background: root.call-muted ? #44232b : transparent;
                                    activated => { root.social-call-control("mute", !root.call-muted); }
                                }
                                CallAction {
                                    glyph: root.call-deafened ? "" : "";
                                    label: root.call-deafened ? "Undeafen" : "Deafen";
                                    normal-background: root.call-deafened ? #44232b : transparent;
                                    activated => { root.social-call-control("deafen", !root.call-deafened); }
                                }
                            }
                        }
                        Rectangle {
                            width: 96px; border-radius: 12px;
                            background: #111114; border-width: 1px; border-color: #3a3b42;
                            HorizontalLayout {
                                padding: 4px; spacing: 4px;
                                CallAction {
                                    glyph: "";
                                    label: root.call-screen-sharing ? "Stop sharing screen" : "Share screen";
                                    normal-background: root.call-screen-sharing ? #1b3e2d : transparent;
                                    visible: root.social-active-name != "" || root.call-in-progress;
                                    activated => { root.social-call-control("share", !root.call-screen-sharing); }
                                }
                                CallAction {
                                    glyph: ""; label: call-room.settings-open ? "Close call settings" : "Open call settings";
                                    normal-background: call-room.settings-open ? #31313c : transparent;
                                    activated => { call-room.settings-open = !call-room.settings-open; }
                                }
                            }
                        }
                        if root.social-active-name != "" || root.call-in-progress: CallAction {
                            width: 56px;
                            glyph: root.call-in-progress ? "" : "";
                            label: root.call-in-progress ? "End call" : "Start call";
                            normal-background: root.call-in-progress ? #c82d40 : #1c593b;
                            hover-background: root.call-in-progress ? #e54052 : #26784f;
                            activated => {
                                if root.call-in-progress { root.social-end-call(); }
                                else { root.social-start-call(0); }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        CallAction {
                            glyph: root.app-fullscreen ? "" : "";
                            label: root.app-fullscreen ? "Exit app fullscreen" : "Enter app fullscreen";
                            activated => { root.set-app-fullscreen(!root.app-fullscreen); }
                        }
                    }
                }
            }


            if root.current-route == "profile" || root.current-route == "social-developer": Rectangle { border-radius: 24px; background: #06161cde; border-width: 1px; border-color: #ffffff14; ZinkScrollView { width: parent.width; height: parent.height; content-height: social-settings-content.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.always-on; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; social-settings-content := VerticalLayout { width: parent.visible-width - 16px; padding: 30px; spacing: 18px; HorizontalLayout { height: 62px; VerticalLayout { Text { text: "ZINK SOCIAL"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: root.current-route == "profile" ? "Profile" : "Developer settings"; color: white; font-size: 30px; font-weight: 750; } Text { text: root.current-route == "profile" ? "Manage how your account appears to friends." : "Offline testing, mock calls and endpoint diagnostics."; color: #8da29b; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 110px; height: 40px; border-radius: 20px; background: #ffffff0c; Text { text: "Back"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate(root.current-route == "profile" ? "friends" : "social-register"); } } } }
                    if root.current-route == "profile" && root.social-signed-in: HorizontalLayout { height: 245px; spacing: 18px; Rectangle { width: 245px; border-radius: 24px; background: @linear-gradient(145deg, #123f3a 0%, #0b252d 100%); VerticalLayout { alignment: center; spacing: 10px; HorizontalLayout { height: 112px; alignment: center; Rectangle { width: 112px; height: 112px; border-radius: 56px; background: #38ff6618; Text { text: root.social-display-name == "" ? "Z" : root.social-display-name; color: #38ff66; font-size: 25px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; overflow: elide; } } } Text { horizontal-alignment: center; text: root.social-username == "" ? "Not signed in" : "@" + root.social-username; color: white; font-size: 12px; } Text { horizontal-alignment: center; text: root.social-signed-in ? "Connected" : "Offline"; color: root.social-signed-in ? #38ff66 : #82978f; font-size: 9px; } } } Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #ffffff07; VerticalLayout { padding: 22px; spacing: 10px; Text { text: "Public identity"; color: white; font-size: 19px; font-weight: 700; } Text { text: "Your display name appears in friends lists, messages and calls."; color: #9db0aa; font-size: 11px; wrap: word-wrap; } Text { text: "Display name"; color: #8da29b; font-size: 9px; } Rectangle { height: 44px; border-radius: 12px; background: #ffffff0a; TextInput { x: 14px; width: parent.width - 28px; height: parent.height; text: root.social-display-name; color: white; single-line: true; edited => { root.social-display-name = self.text; } } } Text { text: "Email  •  " + (root.social-email == "" ? "Not set" : root.social-email); color: #8da29b; font-size: 9px; } Rectangle { vertical-stretch: 1; background: transparent; } HorizontalLayout { height: 42px; spacing: 10px; Rectangle { width: 120px; border-radius: 21px; background: #38ff66; Text { text: "Save profile"; color: #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.social-save-profile(root.social-display-name); } } } Rectangle { width: 100px; border-radius: 21px; background: #ffffff0c; Text { text: "Logout"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.social-logout(); } } } } } } }
                    if root.current-route == "profile" && !root.social-signed-in: Rectangle {
                        height: 220px; border-radius: 22px; background: #ffffff07;
                        VerticalLayout { alignment: center; spacing: 12px;
                            Text { text: "Your Zink profile"; color: white; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
                            Text { text: "Sign in to manage your display name, profile picture and links."; color: #9db0aa; horizontal-alignment: center; wrap: word-wrap; }
                            HorizontalLayout { height: 42px; alignment: center; Rectangle { width: 140px; border-radius: 21px; background: #38ff66;
                                Text { text: "Sign in"; color: #051109; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.navigate("social-login"); } }
                            } }
                        }
                    }
                    if root.current-route == "profile" && root.social-signed-in: Rectangle { height: 390px; border-radius: 22px; background: #ffffff07; HorizontalLayout { padding: 22px; spacing: 20px;
                        VerticalLayout { width: 220px; spacing: 10px; Text { text: "Profile picture"; color: white; font-size: 16px; font-weight: 700; } Rectangle { width: 180px; height: 180px; border-radius: 90px; background: #38ff6618; clip: true; Text { visible: !root.social-avatar-set; text: root.social-display-name == "" ? "Z" : root.social-display-name; color: #38ff66; font-size: 34px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; overflow: elide; } Image { visible: root.social-avatar-set; width: parent.width; height: parent.height; source: root.social-avatar-image; image-fit: cover; } } Rectangle { width: 180px; height: 42px; border-radius: 21px; background: #ffffff0d; Text { text: "Choose profile picture"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.social-choose-avatar(); } } } Text { text: "Signed up to Zink: " + root.social-signed-up; color: #82978f; font-size: 8px; wrap: word-wrap; } }
                        VerticalLayout { horizontal-stretch: 1; spacing: 9px; Text { text: "Social media links"; color: white; font-size: 17px; font-weight: 700; } Text { text: "Add links friends can use to find you elsewhere. Only http and https links are saved."; color: #8da29b; font-size: 9px; wrap: word-wrap; }
                            for link[index] in [{service:root.social-link-one-service, url:root.social-link-one-url}, {service:root.social-link-two-service, url:root.social-link-two-url}, {service:root.social-link-three-service, url:root.social-link-three-url}]: HorizontalLayout { height: 48px; spacing: 8px; Rectangle { width: 150px; border-radius: 12px; background: #ffffff0a; TextInput { x: 12px; width: parent.width - 24px; height: parent.height; text: link.service; color: white; single-line: true; edited => { if (index == 0) { root.social-link-one-service = self.text; } else if (index == 1) { root.social-link-two-service = self.text; } else { root.social-link-three-service = self.text; } } } } Rectangle { horizontal-stretch: 1; border-radius: 12px; background: #ffffff0a; TextInput { x: 12px; width: parent.width - 24px; height: parent.height; text: link.url; color: white; single-line: true; edited => { if (index == 0) { root.social-link-one-url = self.text; } else if (index == 1) { root.social-link-two-url = self.text; } else { root.social-link-three-url = self.text; } } } } Rectangle { width: 78px; border-radius: 20px; background: #ffffff0c; Text { text: "Clear"; color: white; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { if (index == 0) { root.social-link-one-service = ""; root.social-link-one-url = ""; } else if (index == 1) { root.social-link-two-service = ""; root.social-link-two-url = ""; } else { root.social-link-three-service = ""; root.social-link-three-url = ""; } } } } }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                            Rectangle { height: 44px; border-radius: 22px; background: #38ff66; Text { text: "Save social links"; color: #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.social-save-profile-details(root.social-link-one-service, root.social-link-one-url, root.social-link-two-service, root.social-link-two-url, root.social-link-three-service, root.social-link-three-url); } } }
                        }
                    } }
                    if root.current-route == "social-developer": VerticalLayout { spacing: 14px;
                        HorizontalLayout { height: 92px; spacing: 12px; for setting in [{title:"Offline testing mode", detail:"Use local test identity and data", enabled:root.social-dev-offline}, {title:"Mock call environment", detail:"Exercise controls without live signaling", enabled:root.social-dev-mock-calls}]: Rectangle { horizontal-stretch: 1; border-radius: 18px; background: setting.enabled ? #38ff6615 : #ffffff07; border-width: 1px; border-color: setting.enabled ? #38ff6640 : #ffffff10; HorizontalLayout { padding: 16px; VerticalLayout { alignment: center; Text { text: setting.title; color: white; font-size: 12px; font-weight: 700; } Text { text: setting.detail; color: #8da29b; font-size: 8px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 54px; height: 28px; border-radius: 14px; background: setting.enabled ? #38ff66 : #ffffff18; Rectangle { x: setting.enabled ? 28px : 4px; y: 4px; width: 20px; height: 20px; border-radius: 10px; background: setting.enabled ? #051109 : white; } } } TouchArea { clicked => { if (setting.title == "Offline testing mode") { root.social-dev-offline = !root.social-dev-offline; } else { root.social-dev-mock-calls = !root.social-dev-mock-calls; } root.save-social-developer-settings(root.social-dev-offline, root.social-dev-mock-calls, root.social-dev-display-name, root.social-dev-username, root.social-dev-email, root.social-dev-call-server); } } } }
                        GridLayout { height: 210px; spacing: 12px; for field[index] in [{label:"Test display name", value:root.social-dev-display-name}, {label:"Test username", value:root.social-dev-username}, {label:"Test email", value:root.social-dev-email}, {label:"Call server endpoint", value:root.social-dev-call-server}]: VerticalLayout { row: index / 2; col: Math.mod(index, 2); spacing: 6px; Text { text: field.label; color: #b8c8c3; font-size: 9px; font-weight: 650; } Rectangle { height: 46px; border-radius: 13px; background: #ffffff0a; TextInput { x: 14px; width: parent.width - 28px; height: parent.height; text: field.value; color: white; single-line: true; edited => { if (field.label == "Test display name") { root.social-dev-display-name = self.text; } else if (field.label == "Test username") { root.social-dev-username = self.text; } else if (field.label == "Test email") { root.social-dev-email = self.text; } else { root.social-dev-call-server = self.text; } } accepted => { root.save-social-developer-settings(root.social-dev-offline, root.social-dev-mock-calls, root.social-dev-display-name, root.social-dev-username, root.social-dev-email, root.social-dev-call-server); } } } } }
                        Rectangle { height: 150px; border-radius: 20px; background: #ffffff07; HorizontalLayout { padding: 20px; spacing: 18px; VerticalLayout { width: 420px; spacing: 8px; Text { text: "Register test account"; color: white; font-size: 17px; font-weight: 700; } Text { text: "Creates an account through the configured Zink Social service using the developer identity above."; color: #8da29b; font-size: 9px; wrap: word-wrap; } Rectangle { height: 44px; border-radius: 12px; background: #ffffff0a; TextInput { x: 14px; width: parent.width - 28px; height: parent.height; text: root.social-dev-password; color: white; input-type: password; single-line: true; edited => { root.social-dev-password = self.text; } accepted => { root.register-social-developer(root.social-dev-display-name, root.social-dev-username, root.social-dev-password); } } } } Rectangle { horizontal-stretch: 1; background: transparent; } VerticalLayout { alignment: center; spacing: 9px; Rectangle { width: 170px; height: 44px; border-radius: 22px; background: #ffffff0d; Text { text: "Save settings"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.save-social-developer-settings(root.social-dev-offline, root.social-dev-mock-calls, root.social-dev-display-name, root.social-dev-username, root.social-dev-email, root.social-dev-call-server); } } } Rectangle { width: 170px; height: 44px; border-radius: 22px; background: #38ff66; Text { text: "Register account"; color: #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.register-social-developer(root.social-dev-display-name, root.social-dev-username, root.social-dev-password); } } } } } }
                    }
                    Text { text: root.social-status; color: #8da29b; font-size: 9px; }
                } } }

            if root.current-route == "social-developer" && !root.social-dev-unlocked: Rectangle { background: #02080ded; border-radius: 24px; TouchArea { } Rectangle { x: (parent.width - 520px) / 2; y: (parent.height - 320px) / 2; width: 520px; height: 320px; border-radius: 28px; background: @linear-gradient(145deg, #12343a 0%, #07151c 100%); border-width: 1px; border-color: #38ff6640; VerticalLayout { padding: 30px; spacing: 14px; Rectangle { width: 58px; height: 58px; border-radius: 18px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 24px; } } Text { text: "Developer settings locked"; color: white; font-size: 24px; font-weight: 750; } Text { text: "Enter the developer password used by the original Zink page. These controls can change offline identities and call endpoints."; color: #9db0aa; font-size: 10px; wrap: word-wrap; } Rectangle { height: 46px; border-radius: 13px; background: #ffffff0d; TextInput { x: 14px; width: parent.width - 28px; height: parent.height; text: root.social-dev-unlock-password; input-type: password; color: white; single-line: true; edited => { root.social-dev-unlock-password = self.text; } accepted => { root.unlock-social-developer(self.text); } } } HorizontalLayout { height: 44px; spacing: 10px; Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #38ff66; Text { text: "Unlock"; color: #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.unlock-social-developer(root.social-dev-unlock-password); } } } Rectangle { width: 130px; border-radius: 22px; background: #ffffff0d; Text { text: "Cancel"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.social-dev-unlock-password = ""; root.navigate("social-register"); } } } } } } }

            if root.current-route == "twitch" || root.current-route == "discord" || root.current-route == "youtube" || root.current-route == "tiktok" || root.current-route == "instagram" || root.current-route == "x" || root.current-route == "facebook" || root.current-route == "telegram" || root.current-route == "whatsapp" || root.current-route == "messenger" || root.current-route == "linkedin" || root.current-route == "threads" || root.current-route == "bluesky" || root.current-route == "mastodon" || root.current-route == "pinterest" || root.current-route == "tumblr" || root.current-route == "reddit": Rectangle {
                border-radius: 24px; clip: true; background: @linear-gradient(135deg, #10272e 0%, #08181e 55%, #050d13 100%); border-width: 1px; border-color: #ffffff14;
                Rectangle { x: parent.width - 420px; y: -220px; width: 650px; height: 650px; border-radius: 325px; background: #38ff6609; }
                VerticalLayout { padding: 36px; spacing: 20px; HorizontalLayout { height: 66px; VerticalLayout { Text { text: "ZINK SOCIAL"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: root.page-title; color: white; font-size: 30px; font-weight: 750; } Text { text: "Stay connected through Zink's managed browser."; color: #8da29b; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 124px; height: 40px; border-radius: 20px; background: #ffffff0c; Text { text: "Social hub"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("social"); } } } }
                    Rectangle { vertical-stretch: 1; border-radius: 28px; background: #02090dce; border-width: 1px; border-color: #ffffff18; VerticalLayout { alignment: center; spacing: 16px; Rectangle { width: 112px; height: 112px; border-radius: 34px; background: #38ff6615; Text { text: root.current-route == "youtube" ? "▶" : root.current-route == "x" ? "X" : root.current-route == "reddit" ? "R" : root.current-route == "discord" ? "D" : root.current-route == "twitch" ? "T" : root.current-route == "instagram" ? "IG" : "◉"; color: #38ff66; font-size: 36px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } } Text { text: "Open " + root.page-title; color: white; font-size: 26px; font-weight: 750; horizontal-alignment: center; } Text { width: 560px; text: "Sign in once in Zink Connect and keep your service session, history, downloads, fullscreen video and privacy controls together."; color: #94a9a2; font-size: 11px; wrap: word-wrap; horizontal-alignment: center; } Rectangle { width: 190px; height: 48px; border-radius: 24px; background: #38ff66; Text { text: "Open service  ↗"; color: #051109; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-web-service(root.current-route == "twitch" ? "https://www.twitch.tv" : root.current-route == "discord" ? "https://discord.com/app" : root.current-route == "youtube" ? "https://www.youtube.com" : root.current-route == "tiktok" ? "https://www.tiktok.com" : root.current-route == "instagram" ? "https://www.instagram.com" : root.current-route == "x" ? "https://x.com" : root.current-route == "facebook" ? "https://www.facebook.com" : root.current-route == "telegram" ? "https://web.telegram.org" : root.current-route == "whatsapp" ? "https://web.whatsapp.com" : root.current-route == "messenger" ? "https://www.messenger.com" : root.current-route == "linkedin" ? "https://www.linkedin.com" : root.current-route == "threads" ? "https://www.threads.net" : root.current-route == "bluesky" ? "https://bsky.app" : root.current-route == "mastodon" ? "https://mastodon.social" : root.current-route == "pinterest" ? "https://www.pinterest.com" : root.current-route == "tumblr" ? "https://www.tumblr.com" : "https://www.reddit.com"); } } } Text { text: "Opens as a fresh managed browser window while retaining the selected service profile."; color: #617a73; font-size: 8px; } } }
                }
            }

            if root.current-route == "streaming": Rectangle { border-radius: 24px; background: #06161cde; border-width: 1px; border-color: #ffffff14; ZinkScrollView { width: parent.width; height: parent.height; content-height: streaming-home-content.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.as-needed; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; streaming-home-content := VerticalLayout { width: parent.visible-width - 16px; padding: 30px; spacing: 18px;
                HorizontalLayout { height: 70px; VerticalLayout { Text { text: "ZINK CREATOR"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: "Streaming Studio"; color: white; font-size: 31px; font-weight: 750; } Text { text: "Choose a destination, prepare native Windows capture and keep every broadcast in one studio."; color: #8da29b; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 122px; height: 40px; border-radius: 20px; background: root.stream-live ? #e84855 : #ffffff0c; Text { text: root.stream-live ? "●  LIVE" : "○  OFFLINE"; color: white; font-size: 9px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; } } }
                Rectangle { height: 224px; border-radius: 26px; background: @linear-gradient(125deg, #0c403d 0%, #0a242d 52%, #08131d 100%); border-width: 1px; border-color: #38ff6630; HorizontalLayout { padding: 28px; spacing: 24px; VerticalLayout { width: 570px; spacing: 10px; Text { text: "Go live with Zink"; color: white; font-size: 28px; font-weight: 750; } Text { text: "Windows Graphics Capture, Media Foundation hardware encoding, WASAPI audio and direct RTMP publishing — without a .NET runtime."; color: #b6cbc4; font-size: 11px; wrap: word-wrap; } Rectangle { vertical-stretch: 1; background: transparent; } HorizontalLayout { height: 42px; spacing: 9px; Rectangle { width: 158px; border-radius: 21px; background: #38ff66; Text { text: "Set up Twitch"; color: #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("twitch-streaming"); } } } Rectangle { width: 158px; border-radius: 21px; background: #ffffff0c; Text { text: "Set up YouTube"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("youtube-streaming"); } } } } } Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #02090da0; VerticalLayout { alignment: center; spacing: 8px; FluentGlyph { glyph: ""; color: #38ff66; font-size: 42px; } Text { text: "Native broadcast pipeline"; color: white; font-size: 15px; font-weight: 700; } Text { text: "Capture  ›  Encode  ›  Publish"; color: #82978f; font-size: 9px; } } } } }
                Text { text: "Streaming destinations"; color: white; font-size: 20px; font-weight: 700; }
                GridLayout { height: 320px; spacing: 12px; for provider[index] in [{name:"Twitch", detail:"RTMP • live.twitch.tv", route:"twitch-streaming", accent:#a970ff}, {name:"YouTube", detail:"Live Control Room", route:"youtube-streaming", accent:#ff5c62}, {name:"Kick", detail:"Creator dashboard", route:"kick-streaming", accent:#53fc18}, {name:"Instagram", detail:"Live Producer", route:"instagram-streaming", accent:#e66fc7}, {name:"TikTok", detail:"LIVE Studio output", route:"tiktok-streaming", accent:#59f0ed}, {name:"Facebook", detail:"Facebook Live", route:"facebook-streaming", accent:#6d9dff}, {name:"X", detail:"Media Studio Live", route:"x-streaming", accent:#ffffff}, {name:"Custom RTMP", detail:"Use Twitch setup with your server", route:"twitch-streaming", accent:#38ff66}]: Rectangle { row: index / 4; col: Math.mod(index, 4); border-radius: 21px; background: provider-touch.has-hover ? #ffffff12 : #ffffff07; border-width: 1px; border-color: provider-touch.has-hover ? provider.accent : #ffffff0c; VerticalLayout { padding: 18px; Rectangle { width: 43px; height: 43px; border-radius: 14px; background: provider.accent; Text { text: provider.name == "YouTube" ? "▶" : provider.name == "Instagram" ? "◎" : provider.name == "Custom RTMP" ? "↗" : provider.name; color: #071016; font-size: 8px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; overflow: elide; } } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: provider.name; color: white; font-size: 14px; font-weight: 700; } Text { text: provider.detail; color: #82978f; font-size: 8px; } Text { text: "Configure  ›"; color: provider.accent; font-size: 8px; } } provider-touch := TouchArea { clicked => { root.navigate(provider.route); } } } }
                HorizontalLayout { height: 120px; spacing: 12px; for feature in [{title:"Native capture", detail:"Choose a display, window or game with Windows Graphics Capture.", icon:""}, {title:"Audio mixer", detail:"Combine Windows system audio and your selected microphone.", icon:""}, {title:"Hardware encode", detail:"Media Foundation H.264 uses the Windows GPU encoder path.", icon:""}, {title:"Low latency", detail:"Tune capture and publishing for responsive live output.", icon:""}]: Rectangle { horizontal-stretch: 1; border-radius: 19px; background: #ffffff06; VerticalLayout { padding: 16px; FluentGlyph { glyph: feature.icon; color: #38ff66; font-size: 17px; } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: feature.title; color: white; font-size: 11px; font-weight: 700; } Text { text: feature.detail; color: #82978f; font-size: 8px; wrap: word-wrap; } } } }
            } } }

            if root.current-route == "twitch-streaming" || root.current-route == "youtube-streaming" || root.current-route == "kick-streaming" || root.current-route == "instagram-streaming" || root.current-route == "tiktok-streaming" || root.current-route == "facebook-streaming" || root.current-route == "x-streaming": Rectangle {
                border-radius: 24px; background: #06161cde; border-width: 1px; border-color: #ffffff14; clip: true;
                studio-scroll := ZinkScrollView {
                    width: parent.width; height: parent.height;
                    content-height: Math.max(self.visible-height, 800px);
                    vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    VerticalLayout { width: studio-scroll.visible-width; height: studio-scroll.content-height; padding: 26px; spacing: 14px;
                    HorizontalLayout { height: 58px; VerticalLayout { Text { text: "ZINK STREAMING STUDIO"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: root.page-title; color: white; font-size: 27px; font-weight: 750; } Text { text: "Windows Graphics Capture, native audio mixing and direct RTMP destination setup."; color: #8da29b; font-size: 9px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 118px; height: 38px; border-radius: 19px; background: root.stream-live ? #e84855 : #ffffff0c; Text { text: root.stream-live ? "LIVE" : "OFFLINE"; color: white; font-size: 9px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; } } }
                    HorizontalLayout { height: 104px; spacing: 10px; for stat in [{label:"MEASURED FPS", value:root.stream-measured-fps}, {label:"ENCODER", value:"MF H.264"}, {label:"HEALTH", value:root.stream-health}, {label:"MEASURED RATE", value:root.stream-measured-rate}, {label:"SESSION", value:root.stream-duration}]: Rectangle { horizontal-stretch: 1; border-radius: 17px; background: #ffffff07; VerticalLayout { padding: 14px; Text { text: stat.label; color: #71877f; font-size: 7px; font-weight: 700; } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: stat.value; color: stat.label == "HEALTH" && root.stream-health != "GOOD" && root.stream-health != "READY" ? #ffb657 : white; font-size: stat.label == "ENCODER" || stat.label == "HEALTH" ? 13px : 19px; font-weight: 700; overflow: elide; } } } }
                    HorizontalLayout { vertical-stretch: 1; spacing: 14px;
                        Rectangle { horizontal-stretch: 2; min-width: 0px; border-radius: 22px; background: #02070b; border-width: 1px; border-color: #ffffff12; clip: true; VerticalLayout { Rectangle { vertical-stretch: 1; background: root.stream-preview-available ? transparent : @radial-gradient(circle, #15353b 0%, #02070b 68%); Image { visible: root.stream-preview-available; width: parent.width; height: parent.height; source: root.stream-preview-image; image-fit: cover; } Rectangle { visible: root.stream-preview-available; width: parent.width; height: parent.height; background: #00000062; } VerticalLayout { alignment: center; spacing: 9px; FluentGlyph { glyph: ""; color: #38ff6655; font-size: 47px; } Text { text: root.stream-selected-target; color: white; font-size: 19px; font-weight: 700; horizontal-alignment: center; } Text { text: root.stream-preview-available ? root.stream-preview-status : root.stream-selected-pid == 0 ? "The primary Windows display is the active native capture source." : "The selected window is the active native capture source."; color: root.stream-preview-available ? #d8e6e1 : #71877f; font-size: 9px; horizontal-alignment: center; } HorizontalLayout { height: 40px; alignment: center; spacing: 9px; Rectangle { width: 178px; border-radius: 20px; background: #38ff6614; border-width: 1px; border-color: #38ff6640; Text { text: "●  Ready to capture"; color: #38ff66; font-size: 9px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } } Rectangle { width: 126px; border-radius: 20px; background: #ffffff0c; Text { text: "Refresh sources"; color: white; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: !root.stream-live && !root.stream-busy; clicked => { root.refresh-recorder-targets(); } } } } stream-targets := ZinkScrollView { height: 64px; content-width: stream-target-row.preferred-width; horizontal-scrollbar-policy: ScrollBarPolicy.as-needed; vertical-scrollbar-policy: ScrollBarPolicy.always-off; stream-target-row := HorizontalLayout { height: 46px; spacing: 8px; Rectangle { width: 130px; border-radius: 16px; background: root.stream-selected-pid == 0 ? #38ff6622 : #ffffff0a; Text { text: "Primary display"; color: white; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: !root.stream-live && !root.stream-busy; clicked => { root.stream-selected-pid = 0; root.stream-selected-target = "Primary display"; } } } for target in root.recorder-target-items: Rectangle { width: 170px; border-radius: 16px; background: root.stream-selected-pid == target.pid ? #38ff6622 : #ffffff0a; Text { text: target.title; color: white; font-size: 8px; x: 10px; width: parent.width - 20px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; } TouchArea { enabled: !root.stream-live && !root.stream-busy; clicked => { root.stream-selected-pid = target.pid; root.stream-selected-target = target.title; } } } } } } } HorizontalLayout { height: 50px; padding: 10px; spacing: 10px; for control in [{name:"System audio", enabled:root.stream-system-audio}, {name:"Microphone", enabled:root.stream-microphone}, {name:"Low latency", enabled:root.stream-low-latency}]: Rectangle { horizontal-stretch: 1; border-radius: 15px; background: control.enabled ? #38ff6618 : #ffffff08; Text { text: (control.enabled ? "●  " : "○  ") + control.name; color: control.enabled ? #38ff66 : #b0c0bb; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: !root.stream-live && !root.stream-busy; clicked => { if (control.name == "System audio") { root.stream-system-audio = !root.stream-system-audio; } else if (control.name == "Microphone") { root.stream-microphone = !root.stream-microphone; } else { root.stream-low-latency = !root.stream-low-latency; } } } } } } }
                        Rectangle { width: Math.min(390px, parent.width * 0.47); border-radius: 22px; background: #ffffff07; VerticalLayout { padding: 20px; spacing: 8px; Text { text: root.current-route == "twitch-streaming" ? "Twitch" : root.current-route == "youtube-streaming" ? "YouTube" : root.current-route == "kick-streaming" ? "Kick" : root.current-route == "instagram-streaming" ? "Instagram" : root.current-route == "tiktok-streaming" ? "TikTok" : root.current-route == "facebook-streaming" ? "Facebook Live" : "X Live"; color: white; font-size: 20px; font-weight: 700; } if root.current-route == "twitch-streaming": Rectangle { height: 204px; border-radius: 16px; background: root.stream-twitch-live ? #38ff6612 : #ffffff06; VerticalLayout { padding: 12px; spacing: 6px; HorizontalLayout { height: 24px; Text { text: root.stream-twitch-live ? "Twitch live • " + root.stream-twitch-viewers + " viewers" : "Twitch account telemetry"; color: root.stream-twitch-live ? #38ff66 : white; font-size: 10px; font-weight: 700; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.stream-twitch-busy ? "CHECKING" : root.stream-twitch-live ? "LIVE" : "OFFLINE"; color: root.stream-twitch-live ? #38ff66 : #82978f; font-size: 7px; font-weight: 700; vertical-alignment: center; } } for field[index] in [{label:"Channel", value:root.stream-twitch-channel, secret:false}, {label:"Client ID", value:root.stream-twitch-client-id, secret:false}, {label:"Access token", value:root.stream-twitch-access-token, secret:true}]: Rectangle { height: 32px; border-radius: 10px; background: #ffffff09; Text { x: 10px; width: 72px; text: field.label; color: #71877f; font-size: 7px; vertical-alignment: center; } TextInput { x: 82px; width: parent.width - 94px; height: parent.height; text: field.value; color: white; font-size: 8px; single-line: true; input-type: field.secret ? password : text; edited => { if index == 0 { root.stream-twitch-channel = self.text; } else if index == 1 { root.stream-twitch-client-id = self.text; } else { root.stream-twitch-access-token = self.text; } } } } HorizontalLayout { height: 32px; spacing: 6px; Rectangle { horizontal-stretch: 1; border-radius: 16px; background: #38ff6618; Text { text: root.stream-twitch-busy ? "Checking…" : "Refresh viewers"; color: #38ff66; font-size: 8px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: !root.stream-twitch-busy; clicked => { root.refresh-twitch-telemetry(); } } } Rectangle { width: 78px; border-radius: 16px; background: #ffffff09; Text { text: "Save"; color: white; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.save-twitch-streaming-settings(root.stream-twitch-channel, root.stream-twitch-client-id, root.stream-twitch-access-token); } } } Rectangle { width: 78px; border-radius: 16px; background: #ffffff09; Text { text: "Disconnect"; color: white; font-size: 7px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.disconnect-twitch-streaming(); } } } } Text { text: root.stream-twitch-status; color: #82978f; font-size: 7px; overflow: elide; } } } Text { text: "Server"; color: #82978f; font-size: 8px; } Rectangle { height: 38px; border-radius: 12px; background: #ffffff09; TextInput { x: 12px; width: parent.width - 24px; height: parent.height; text: root.stream-server; color: white; font-size: 9px; single-line: true; enabled: !root.stream-live && !root.stream-busy; edited => { root.stream-server = self.text; } } } Text { text: "Stream key"; color: #82978f; font-size: 8px; } Rectangle { height: 38px; border-radius: 12px; background: #ffffff09; TextInput { x: 12px; width: parent.width - 24px; height: parent.height; text: root.stream-key; color: white; font-size: 9px; single-line: true; input-type: password; enabled: !root.stream-live && !root.stream-busy; edited => { root.stream-key = self.text; } } } Text { text: "Quality"; color: #82978f; font-size: 8px; } HorizontalLayout { height: 34px; spacing: 8px; for quality in ["720p 30 FPS", "1080p 60 FPS", "1440p 60 FPS"]: Rectangle { horizontal-stretch: 1; border-radius: 12px; background: root.stream-quality == quality ? #38ff6625 : #ffffff08; Text { text: quality; color: root.stream-quality == quality ? #38ff66 : white; font-size: 7px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: !root.stream-live && !root.stream-busy; clicked => { root.stream-quality = quality; } } } } Text { text: "Audio endpoints"; color: #82978f; font-size: 8px; } HorizontalLayout { height: 34px; spacing: 6px; Rectangle { horizontal-stretch: 1; border-radius: 11px; background: #ffffff09; Text { x: 9px; width: parent.width - 18px; text: root.recorder-output-device-id == "" ? "Output: Windows default" : "Output: selected device"; color: white; font-size: 7px; vertical-alignment: center; overflow: elide; } TouchArea { enabled: !root.stream-live && !root.stream-busy; clicked => { if root.recorder-output-devices.length > 0 { root.recorder-output-device-id = root.recorder-output-device-id == "" ? root.recorder-output-devices[0].id : ""; root.save-recorder-audio-devices(root.recorder-output-device-id, root.recorder-input-device-id); } } } } Rectangle { horizontal-stretch: 1; border-radius: 11px; background: #ffffff09; Text { x: 9px; width: parent.width - 18px; text: root.recorder-input-device-id == "" ? "Mic: Windows default" : "Mic: selected device"; color: white; font-size: 7px; vertical-alignment: center; overflow: elide; } TouchArea { enabled: !root.stream-live && !root.stream-busy; clicked => { if root.recorder-input-devices.length > 0 { root.recorder-input-device-id = root.recorder-input-device-id == "" ? root.recorder-input-devices[0].id : ""; root.save-recorder-audio-devices(root.recorder-output-device-id, root.recorder-input-device-id); } } } } } Rectangle { height: 34px; border-radius: 17px; background: #ffffff09; Text { text: "Open provider dashboard  ↗"; color: white; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-external-link(root.current-route == "twitch-streaming" ? "https://dashboard.twitch.tv" : root.current-route == "youtube-streaming" ? "https://studio.youtube.com" : root.current-route == "kick-streaming" ? "https://kick.com/dashboard" : root.current-route == "instagram-streaming" ? "https://www.instagram.com" : root.current-route == "tiktok-streaming" ? "https://www.tiktok.com/studio/download" : root.current-route == "facebook-streaming" ? "https://www.facebook.com/live/producer" : "https://studio.x.com"); } } } Text { text: root.stream-status; color: root.stream-live ? #38ff66 : #82978f; font-size: 8px; wrap: word-wrap; } Rectangle { vertical-stretch: 1; background: transparent; } HorizontalLayout { height: 44px; spacing: 9px; Rectangle { horizontal-stretch: 1; border-radius: 22px; background: root.stream-live ? #38ff6650 : root.stream-busy ? #ffffff12 : #38ff66; Text { text: root.stream-live ? "Streaming" : root.stream-busy ? "Starting…" : "Start stream"; color: root.stream-busy ? #82978f : #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: !root.stream-live && !root.stream-busy; clicked => { root.configure-stream-destination(root.current-route, root.stream-server, root.stream-key); } } } Rectangle { width: 90px; border-radius: 22px; background: root.stream-live && !root.stream-busy ? #e84855 : #ffffff08; Text { text: root.stream-busy && root.stream-live ? "Stopping…" : "Stop"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: root.stream-live && !root.stream-busy; clicked => { root.stop-stream(); } } } } } }
                    }
                    Rectangle { height: 116px; border-radius: 17px; background: #0b2026f2; border-width: 1px; border-color: #ffffff18; VerticalLayout { padding: 14px; spacing: 9px; Text { text: "Live audio mixer"; color: white; font-size: 11px; font-weight: 700; } for channel in [{name:"Desktop / game", gain:root.stream-desktop-volume, desktop:true}, {name:"Microphone", gain:root.stream-microphone-volume, desktop:false}]: HorizontalLayout { height: 29px; spacing: 9px; Text { text: channel.name; color: #b7cac4; font-size: 8px; width: 92px; vertical-alignment: center; } stream-gain-track := Rectangle { horizontal-stretch: 1; height: 29px; background: transparent; Rectangle { y: 11px; height: 7px; border-radius: 3.5px; background: #ffffff24; Rectangle { x: 0px; width: parent.width * channel.gain / 2; height: parent.height; border-radius: 3.5px; background: #38ff66; } } stream-gain-touch := TouchArea { enabled: !root.stream-live && !root.stream-busy; clicked => { if channel.desktop { root.stream-desktop-volume = Math.max(0, Math.min(2, self.mouse-x / stream-gain-track.width * 2)); } else { root.stream-microphone-volume = Math.max(0, Math.min(2, self.mouse-x / stream-gain-track.width * 2)); } } moved => { if self.pressed { if channel.desktop { root.stream-desktop-volume = Math.max(0, Math.min(2, self.mouse-x / stream-gain-track.width * 2)); } else { root.stream-microphone-volume = Math.max(0, Math.min(2, self.mouse-x / stream-gain-track.width * 2)); } } } } } Text { text: Math.round(channel.gain * 100) + "%"; color: #38ff66; font-size: 8px; width: 38px; horizontal-alignment: right; vertical-alignment: center; } } } }
                    }
                }
            }

            if root.current-route == "background-recording-settings": Rectangle { border-radius: 24px; background: #06161cde; border-width: 1px; border-color: #ffffff14; ZinkScrollView { width: parent.width; height: parent.height; content-height: replay-settings-content.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.always-on; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; replay-settings-content := VerticalLayout { width: parent.visible-width - 16px; padding: 30px; spacing: 18px;
                HorizontalLayout { height: 64px; VerticalLayout { Text { text: "ZINK CAPTURE"; color: #ff666f; font-size: 10px; font-weight: 750; } Text { text: "Background recording settings"; color: white; font-size: 29px; font-weight: 750; } Text { text: "Choose clip length, audio sources, track layout and quality."; color: #8da29b; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 118px; height: 40px; border-radius: 20px; background: #ffffff0c; Text { text: "Back to recorder"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("screen-recorder"); } } } }
                Rectangle { height: 205px; border-radius: 21px; background: #ffffff07; VerticalLayout { padding: 20px; spacing: 11px; Text { text: "Clip length"; color: white; font-size: 18px; font-weight: 700; } Text { text: "The hotkey and taskbar command save this amount of recent gameplay."; color: #8da29b; font-size: 9px; } GridLayout { height: 98px; spacing: 9px; for duration[index] in [30, 45, 60, 120, 240, 300, 420, 480, 600]: Rectangle { row: index / 5; col: Math.mod(index, 5); border-radius: 15px; background: root.replay-duration-seconds == duration ? #38ff6625 : #ffffff08; border-width: 1px; border-color: root.replay-duration-seconds == duration ? #38ff6655 : #ffffff0c; Text { text: duration < 60 ? duration + " sec" : duration / 60 + " min"; color: root.replay-duration-seconds == duration ? #38ff66 : white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.replay-duration-seconds = duration; root.save-replay-settings(root.replay-duration-seconds, root.replay-system-audio, root.replay-microphone, root.replay-separate-tracks, root.replay-audio-bitrate); } } } } } }
                HorizontalLayout { height: 190px; spacing: 14px; Rectangle { horizontal-stretch: 1; border-radius: 21px; background: #ffffff07; VerticalLayout { padding: 20px; spacing: 10px; Text { text: "Audio sources"; color: white; font-size: 18px; font-weight: 700; } for source in [{title:"Desktop and game audio", detail:"Game, Windows and voice-chat output", enabled:root.replay-system-audio}, {title:"Microphone", detail:"Selected Windows input device", enabled:root.replay-microphone}]: Rectangle { height: 55px; border-radius: 14px; background: source.enabled ? #38ff6615 : #ffffff06; HorizontalLayout { padding: 12px; VerticalLayout { Text { text: source.title; color: white; font-size: 10px; font-weight: 650; } Text { text: source.detail; color: #82978f; font-size: 8px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: source.enabled ? "ON" : "OFF"; color: source.enabled ? #38ff66 : #71877f; font-size: 9px; font-weight: 700; vertical-alignment: center; } } TouchArea { clicked => { if (source.title == "Microphone") { root.replay-microphone = !root.replay-microphone; } else { root.replay-system-audio = !root.replay-system-audio; } root.save-replay-settings(root.replay-duration-seconds, root.replay-system-audio, root.replay-microphone, root.replay-separate-tracks, root.replay-audio-bitrate); } } } } } Rectangle { horizontal-stretch: 1; border-radius: 21px; background: #ffffff07; VerticalLayout { padding: 20px; spacing: 10px; Text { text: "Track layout"; color: white; font-size: 18px; font-weight: 700; } Text { text: "A combined track stays compatible with ordinary players. Separate tracks give editors isolated desktop and microphone audio."; color: #8da29b; font-size: 9px; wrap: word-wrap; } Rectangle { height: 48px; border-radius: 14px; background: root.replay-separate-tracks ? #38ff6615 : #ffffff06; HorizontalLayout { padding: 13px; Text { text: "Separate editing tracks"; color: white; font-size: 10px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.replay-separate-tracks ? "ON" : "OFF"; color: root.replay-separate-tracks ? #38ff66 : #71877f; font-size: 9px; font-weight: 700; vertical-alignment: center; } } TouchArea { clicked => { root.replay-separate-tracks = !root.replay-separate-tracks; root.save-replay-settings(root.replay-duration-seconds, root.replay-system-audio, root.replay-microphone, root.replay-separate-tracks, root.replay-audio-bitrate); } } } } } }
                if root.replay-separate-tracks: Rectangle { height: 126px; border-radius: 21px; background: #ffffff07; VerticalLayout { padding: 18px; spacing: 9px; Text { text: "Separate editing tracks"; color: white; font-size: 15px; font-weight: 700; } HorizontalLayout { height: 52px; spacing: 10px; for track in [{name:"Desktop / game track", enabled:root.replay-separate-desktop-track, available:root.replay-system-audio}, {name:"Microphone track", enabled:root.replay-separate-microphone-track, available:root.replay-microphone}]: Rectangle { horizontal-stretch: 1; border-radius: 14px; background: track.enabled && track.available ? #38ff6615 : #ffffff06; HorizontalLayout { padding: 13px; Text { text: track.name; color: track.available ? white : #61716c; font-size: 9px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: !track.available ? "SOURCE OFF" : track.enabled ? "ON" : "OFF"; color: track.enabled && track.available ? #38ff66 : #71877f; font-size: 8px; font-weight: 700; vertical-alignment: center; } } TouchArea { enabled: track.available; clicked => { if (track.name == "Microphone track") { root.replay-separate-microphone-track = !root.replay-separate-microphone-track; } else { root.replay-separate-desktop-track = !root.replay-separate-desktop-track; } root.save-replay-settings(root.replay-duration-seconds, root.replay-system-audio, root.replay-microphone, root.replay-separate-tracks, root.replay-audio-bitrate); } } } } } }
                Rectangle { height: 145px; border-radius: 21px; background: #ffffff07; VerticalLayout { padding: 20px; spacing: 10px; Text { text: "Audio quality"; color: white; font-size: 18px; font-weight: 700; } Text { text: "Native AAC-LC at 48 kHz stereo. Higher quality creates larger clips."; color: #8da29b; font-size: 9px; } HorizontalLayout { height: 42px; spacing: 9px; for bitrate in [128, 160, 192, 256, 320, 384]: Rectangle { horizontal-stretch: 1; border-radius: 14px; background: root.replay-audio-bitrate == bitrate ? #38ff6625 : #ffffff08; Text { text: bitrate + " kbps"; color: root.replay-audio-bitrate == bitrate ? #38ff66 : white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.replay-audio-bitrate = bitrate; root.save-replay-settings(root.replay-duration-seconds, root.replay-system-audio, root.replay-microphone, root.replay-separate-tracks, root.replay-audio-bitrate); } } } } } }
                HorizontalLayout { height: 48px; spacing: 10px; Rectangle { horizontal-stretch: 1; border-radius: 24px; background: root.settings-background-replay ? #38ff6624 : #38ff66; Text { text: root.settings-background-replay ? "Replay running" : "Start replay buffer"; color: root.settings-background-replay ? #38ff66 : #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: !root.settings-background-replay; clicked => { root.update-setting("background-replay", true); } } } Rectangle { horizontal-stretch: 1; border-radius: 24px; background: #38ff6617; border-width: 1px; border-color: #38ff6650; Text { text: "Save recent clip"; color: #38ff66; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: root.settings-background-replay; clicked => { root.recorder-command("save-replay"); } } } Rectangle { width: 150px; border-radius: 24px; background: root.settings-background-replay ? #e84855 : #ffffff08; Text { text: "Stop"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: root.settings-background-replay; clicked => { root.update-setting("background-replay", false); } } } }
                Text { text: root.replay-status; color: #82978f; font-size: 9px; }
                Text { text: "Settings apply to new replay sessions. Zink uses Windows-native capture and media APIs."; color: #71877f; font-size: 9px; }
            } } }

            if root.current-route == "recorder": Rectangle { border-radius: 24px; background: @linear-gradient(135deg, #1f1116 0%, #0b171c 55%, #061016 100%); border-width: 1px; border-color: #ffffff14; VerticalLayout { padding: 32px; spacing: 18px; HorizontalLayout { height: 66px; VerticalLayout { Text { text: "ZINK RECORDER"; color: #ff666f; font-size: 10px; font-weight: 750; } Text { text: "Screen Recorder"; color: white; font-size: 30px; font-weight: 750; } Text { text: "Manual recordings and instant replay controls in one place."; color: #9babad; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 142px; height: 42px; border-radius: 21px; background: #ffffff0c; Text { text: "Replay settings"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("background-recording-settings"); } } } }
                HorizontalLayout { vertical-stretch: 1; spacing: 16px; Rectangle { horizontal-stretch: 1; border-radius: 23px; background: #ffffff08; VerticalLayout { padding: 22px; spacing: 12px; Rectangle { width: 64px; height: 64px; border-radius: 32px; background: #ff5b65; FluentGlyph { glyph: ""; color: white; font-size: 24px; } } Text { text: "Manual recording"; color: white; font-size: 22px; font-weight: 700; } Text { text: "Choose a display, window or region and record until you stop. The Windows-native picker keeps permissions and source selection visible."; color: #9babad; font-size: 10px; wrap: word-wrap; } Rectangle { vertical-stretch: 1; background: transparent; } Rectangle { height: 46px; border-radius: 23px; background: #ff5b65; Text { text: "Choose capture target"; color: white; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.launch-native-recorder(); } } } } } Rectangle { horizontal-stretch: 1; border-radius: 23px; background: #ffffff08; VerticalLayout { padding: 22px; spacing: 12px; Rectangle { width: 64px; height: 64px; border-radius: 22px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 24px; } } Text { text: "Instant replay"; color: white; font-size: 22px; font-weight: 700; } Text { text: "Keep up to " + root.replay-duration-seconds + " seconds available for a replay clip, with desktop audio" + (root.replay-microphone ? " and microphone." : "."); color: #9babad; font-size: 10px; wrap: word-wrap; } Rectangle { vertical-stretch: 1; background: transparent; } Rectangle { height: 46px; border-radius: 23px; background: #38ff6618; border-width: 1px; border-color: #38ff6645; Text { text: "Configure replay buffer"; color: #38ff66; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("background-recording-settings"); } } } } } }
                HorizontalLayout { height: 48px; spacing: 10px; Rectangle { horizontal-stretch: 1; border-radius: 24px; background: root.recorder-active ? #ff5b65 : #38ff66; Text { text: root.recorder-active ? "Stop native recording" : "Start native recording"; color: root.recorder-active ? white : #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.recorder-command("toggle-recording"); } } } Rectangle { horizontal-stretch: 1; border-radius: 24px; background: #ffffff0b; Text { text: "Open recordings library"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("recordings"); } } } Rectangle { horizontal-stretch: 1; border-radius: 24px; background: #ffffff0b; Text { text: "Open captures folder"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-recordings-folder(); } } } } } }

            if root.current-route == "version-history": Rectangle {
                border-radius: 24px; background: #06161cde; border-width: 1px; border-color: #ffffff14; clip: true;
                VerticalLayout { padding: 30px; spacing: 18px;
                    HorizontalLayout { height: 72px; spacing: 12px; Rectangle { width: 46px; height: 46px; border-radius: 23px; background: back-history-touch.has-hover ? #ffffff14 : #ffffff0b; FluentGlyph { glyph: ""; color: white; font-size: 16px; } back-history-touch := TouchArea { clicked => { root.navigate("about"); } } } VerticalLayout { Text { text: "ZINK RELEASES"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: "Version History"; color: white; font-size: 31px; font-weight: 750; } Text { text: "Every major Zink generation, including the original WinUI releases and the native Rust migration."; color: #8da29b; font-size: 10px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 210px; height: 42px; border-radius: 21px; background: #38ff6614; border-width: 1px; border-color: #38ff6640; Text { text: "Current  •  " + root.current-app-version; color: #38ff66; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } } }
                    HorizontalLayout { vertical-stretch: 1; spacing: 14px;
                        Rectangle { width: 400px; border-radius: 22px; background: #ffffff06; ZinkScrollView { width: parent.width; height: parent.height; content-height: release-list.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.as-needed; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; release-list := VerticalLayout { width: parent.visible-width - 12px; padding: 12px; spacing: 8px; for release in root.version-releases: Rectangle { height: 68px; border-radius: 16px; background: root.selected-version == release.version ? #38ff6616 : version-release-touch.has-hover ? #ffffff0d : #ffffff07; border-width: 1px; border-color: root.selected-version == release.version ? #38ff6655 : #ffffff09; HorizontalLayout { padding: 13px; spacing: 10px; Rectangle { width: 38px; height: 38px; border-radius: 13px; background: root.selected-version == release.version ? #38ff6622 : #ffffff08; Text { text: release.version == "5.0.0-alpha.1" ? "R" : "Z"; color: #38ff66; font-size: 13px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } } VerticalLayout { alignment: center; Text { text: "Version " + release.version; color: white; font-size: 10px; font-weight: 700; } Text { text: release.summary; color: #82978f; font-size: 8px; overflow: elide; } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "›"; color: #38ff66; font-size: 16px; vertical-alignment: center; } } version-release-touch := TouchArea { clicked => { root.selected-version = release.version; root.select-version(release.version); } } } } } }
                        Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #ffffff07; VerticalLayout { padding: 26px; spacing: 13px; Text { text: "RELEASE NOTES"; color: #38ff66; font-size: 8px; font-weight: 750; } Text { text: root.selected-version == "5.0.0-alpha.1" ? "Zink 5 native migration" : "Version " + root.selected-version; color: white; font-size: 26px; font-weight: 750; } Text { text: root.selected-version-date; color: #82978f; font-size: 9px; } Rectangle { height: 1px; background: #ffffff12; } ZinkScrollView { horizontal-stretch: 1; vertical-stretch: 1; content-height: release-notes.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.as-needed; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; release-notes := VerticalLayout { width: parent.visible-width - 12px; padding: 4px; Text { text: root.selected-version-notes; color: #c1d0cb; font-size: 11px; wrap: word-wrap; } } } Text { text: root.settings-status; color: #82978f; font-size: 8px; overflow: elide; } HorizontalLayout { height: 40px; spacing: 9px; Rectangle { width: 132px; border-radius: 20px; background: #38ff6614; Text { text: "About Zink  ›"; color: #38ff66; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("about"); } } } Rectangle { width: 150px; border-radius: 20px; background: root.settings-update-active ? #ffcc6618 : #ffffff09; Text { text: root.settings-update-active ? "Checking…" : root.localized-check-updates; color: root.settings-update-active ? #ffcc66 : white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: !root.settings-update-active; clicked => { root.check-app-updates(); } } } } } }
                    }
                }
            }

            if root.current-route == "app-theme": Rectangle {
                border-radius: 24px; background: @linear-gradient(135deg, #06161c 0%, #08252b 48%, #061016 100%); border-width: 1px; border-color: #ffffff14; clip: true;
                ZinkScrollView { width: parent.width; height: parent.height; content-height: theme-content.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.as-needed; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; theme-content := VerticalLayout { width: parent.visible-width - 14px; padding: 30px; spacing: 18px;
                    Text { text: "ZINK APPEARANCE"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: "App theme"; color: white; font-size: 31px; font-weight: 750; } Text { text: "Choose the app mode and tint the Fluent-inspired glass UI across Zink."; color: #8da29b; font-size: 10px; }
                    HorizontalLayout {
                        height: 220px; spacing: 14px;
                        Rectangle {
                            horizontal-stretch: 3; border-radius: 24px; background: #ffffff07;
                            VerticalLayout { padding: 20px; spacing: 12px;
                                Text { text: "Mode"; color: white; font-size: 20px; font-weight: 700; }
                                Text { text: "Current: " + root.ui-theme-choice; color: #82978f; font-size: 9px; }
                                HorizontalLayout { vertical-stretch: 1; spacing: 10px;
                                    for theme in ["System", "Light", "Dark"]: Rectangle {
                                        horizontal-stretch: 1; border-radius: 18px;
                                        background: theme == "Light" ? #e9f2ef : theme == "Dark" ? #071319 : @linear-gradient(135deg, #e4efec 0%, #071319 100%);
                                        border-width: 2px; border-color: root.ui-theme-choice == theme ? #38ff66 : #ffffff12;
                                        VerticalLayout { padding: 15px; Rectangle { vertical-stretch: 1; background: transparent; } Text { text: theme == "Dark" ? "Zink default" : theme; color: theme == "Light" ? #071319 : white; font-size: 14px; font-weight: 700; } Text { text: theme == "System" ? "Match Windows" : theme == "Light" ? "Bright surfaces" : "Dark teal glass"; color: theme == "Light" ? #44544f : #82978f; font-size: 8px; } }
                                        TouchArea { clicked => { root.ui-theme-choice = theme; root.save-customization(root.ui-theme-choice, root.ui-accent-choice, root.compact-navigation, root.reduce-motion, root.lighter-sdr-theme); } }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 2; border-radius: 24px; background: #ffffff07;
                            VerticalLayout { padding: 20px; spacing: 12px;
                                Text { text: "Live preview"; color: white; font-size: 20px; font-weight: 700; }
                                Rectangle { vertical-stretch: 1; border-radius: 20px; background: #081820; border-width: 1px; border-color: #ffffff18;
                                    VerticalLayout { padding: 15px;
                                        HorizontalLayout { height: 42px; spacing: 10px; Rectangle { width: 42px; border-radius: 14px; background: #38ff6620; Text { text: "Z"; color: #38ff66; font-size: 16px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } } VerticalLayout { alignment: center; Text { text: "Zink"; color: white; font-size: 11px; font-weight: 700; } Text { text: root.ui-accent-choice; color: #82978f; font-size: 8px; } } }
                                        Rectangle { vertical-stretch: 1; background: transparent; }
                                        Rectangle { height: 18px; border-radius: 9px; background: #38ff6640; }
                                        Rectangle { height: 12px; border-radius: 6px; background: #ffffff14; }
                                    }
                                }
                            }
                        }
                    }
                    Text { text: "Glass colour presets"; color: white; font-size: 20px; font-weight: 700; }
                    GridLayout { height: 150px; spacing: 10px; for accent[index] in [{name:"Zink green", hex:"#38FF66", color:#38ff66}, {name:"Cyan", hex:"#14D8E8", color:#14d8e8}, {name:"Emerald", hex:"#1EDC8A", color:#1edc8a}, {name:"Lime", hex:"#9EFF4F", color:#9eff4f}, {name:"Forest", hex:"#0E7B5A", color:#0e7b5a}, {name:"Zink teal", hex:"#06404A", color:#06404a}, {name:"Ocean blue", hex:"#123B64", color:#123b64}, {name:"Graphite", hex:"#252A35", color:#252a35}]: Rectangle { row: index / 4; col: Math.mod(index, 4); border-radius: 17px; background: #ffffff07; border-width: 2px; border-color: root.ui-accent-choice == accent.name || root.ui-accent-choice == accent.hex ? accent.color : #ffffff0e; HorizontalLayout { padding: 13px; spacing: 10px; Rectangle { width: 38px; height: 38px; border-radius: 13px; background: accent.color; } VerticalLayout { alignment: center; Text { text: accent.name; color: white; font-size: 10px; font-weight: 650; } Text { text: accent.hex; color: #71877f; font-size: 7px; } } } TouchArea { clicked => { root.ui-accent-choice = accent.name; root.ui-custom-accent-hex = accent.hex; root.save-customization(root.ui-theme-choice, root.ui-accent-choice, root.compact-navigation, root.reduce-motion, root.lighter-sdr-theme); } } } }
                    Rectangle { height: 118px; border-radius: 21px; background: #ffffff07; HorizontalLayout { padding: 19px; spacing: 15px; VerticalLayout { horizontal-stretch: 1; spacing: 8px; Text { text: "Custom tint"; color: white; font-size: 17px; font-weight: 700; } Text { text: "Enter a six-digit RGB colour such as #7C3AED."; color: #82978f; font-size: 8px; } Rectangle { height: 40px; border-radius: 13px; background: #ffffff09; TextInput { x: 13px; width: parent.width - 26px; height: parent.height; text: root.ui-custom-accent-hex; color: white; single-line: true; edited => { root.ui-custom-accent-hex = self.text; } } } } Rectangle { width: 150px; height: 44px; border-radius: 22px; background: #38ff66; Text { text: "Apply custom tint"; color: #051109; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.ui-accent-choice = root.ui-custom-accent-hex; root.save-customization(root.ui-theme-choice, root.ui-accent-choice, root.compact-navigation, root.reduce-motion, root.lighter-sdr-theme); } } } } }
                    for setting in [{name:"Lighter for non-HDR displays", enabled:root.lighter-sdr-theme}, {name:"Compact navigation", enabled:root.compact-navigation}, {name:"Reduce motion", enabled:root.reduce-motion}]: Rectangle { height: 58px; border-radius: 16px; background: setting.enabled ? #38ff6610 : #ffffff07; HorizontalLayout { padding: 15px; VerticalLayout { alignment: center; Text { text: setting.name; color: white; font-size: 10px; font-weight: 650; } Text { text: setting.name == "Lighter for non-HDR displays" ? "Gently brighten the dark theme while retaining its colours" : setting.name == "Compact navigation" ? "Fit more destinations in the sidebar" : "Limit decorative transitions"; color: #71877f; font-size: 8px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: setting.enabled ? "ON" : "OFF"; color: setting.enabled ? #38ff66 : #71877f; font-size: 9px; font-weight: 700; vertical-alignment: center; } } TouchArea { clicked => { if (setting.name == "Lighter for non-HDR displays") { root.lighter-sdr-theme = !root.lighter-sdr-theme; } else if (setting.name == "Compact navigation") { root.compact-navigation = !root.compact-navigation; } else { root.reduce-motion = !root.reduce-motion; } root.save-customization(root.ui-theme-choice, root.ui-accent-choice, root.compact-navigation, root.reduce-motion, root.lighter-sdr-theme); } } }
                    Rectangle { height: 44px; border-radius: 22px; background: #ffffff09; Text { text: "Restore Zink default theme"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.ui-theme-choice = "Dark"; root.ui-accent-choice = "Zink teal"; root.ui-custom-accent-hex = "#06404A"; root.compact-navigation = false; root.reduce-motion = false; root.lighter-sdr-theme = false; root.save-customization(root.ui-theme-choice, root.ui-accent-choice, root.compact-navigation, root.reduce-motion, root.lighter-sdr-theme); } } }
                } }
            }

            if root.current-route == "customization": Rectangle {
                border-radius: 24px; background: @linear-gradient(135deg, #08232b 0%, #073440 48%, #061016 100%); border-width: 1px; border-color: #ffffff14;
                VerticalLayout { padding: 32px; spacing: 20px;
                    Text { text: "ZINK APPEARANCE"; color: #38ff66; font-size: 10px; font-weight: 750; }
                    Text { text: "App customisation"; color: white; font-size: 31px; font-weight: 750; }
                    Text { text: "Tune the look and dashboard layout without digging through settings."; color: #9db0aa; font-size: 10px; }
                    HorizontalLayout { vertical-stretch: 1; spacing: 16px;
                        Rectangle { horizontal-stretch: 1; border-radius: 28px; background: theme-card-touch.has-hover ? #ffffff11 : #ffffff08; border-width: 1px; border-color: theme-card-touch.has-hover ? #38ff6650 : #ffffff14; VerticalLayout { padding: 25px; spacing: 14px; Rectangle { width: 62px; height: 62px; border-radius: 21px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 25px; } } Text { text: "App theme and glass"; color: white; font-size: 22px; font-weight: 700; } Text { text: "Choose Light, Dark or follow Windows, then select a preset or custom Fluent glass tint."; color: #a8bbb5; font-size: 10px; wrap: word-wrap; } Rectangle { vertical-stretch: 1; background: transparent; } HorizontalLayout { height: 54px; spacing: 8px; Rectangle { horizontal-stretch: 1; border-radius: 14px; background: #f1f5f8; } Rectangle { horizontal-stretch: 1; border-radius: 14px; background: #1a222b; } Rectangle { horizontal-stretch: 1; border-radius: 14px; background: @linear-gradient(90deg, #f1f5f8 0%, #f1f5f8 50%, #1a222b 50%, #1a222b 100%); } } Text { text: "Open theme controls  ›"; color: #38ff66; font-size: 9px; } theme-card-touch := TouchArea { clicked => { root.navigate("app-theme"); } } } }
                        Rectangle { horizontal-stretch: 1; border-radius: 28px; background: home-card-touch.has-hover ? #ffffff11 : #ffffff08; border-width: 1px; border-color: home-card-touch.has-hover ? #38ff6650 : #ffffff14; VerticalLayout { padding: 25px; spacing: 14px; Rectangle { width: 62px; height: 62px; border-radius: 21px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 25px; } } Text { text: "Home dashboard"; color: white; font-size: 22px; font-weight: 700; } Text { text: "Show or hide dashboard sections, choose a Smart Space and pin the tools you use every day."; color: #a8bbb5; font-size: 10px; wrap: word-wrap; } Rectangle { vertical-stretch: 1; background: transparent; } for line in ["Zink Flow", "Live activities", "Private insights"]: Rectangle { height: 22px; border-radius: 11px; background: #ffffff12; Text { text: line; color: #82978f; font-size: 7px; x: 9px; vertical-alignment: center; } } Text { text: "Edit Home  ›"; color: #38ff66; font-size: 9px; } home-card-touch := TouchArea { clicked => { root.home-edit-open = true; root.navigate("home"); } } } }
                    }
                    Rectangle { height: 88px; border-radius: 22px; background: #ffffff08; HorizontalLayout { padding: 20px; spacing: 14px; Rectangle { width: 48px; height: 48px; border-radius: 16px; background: #ffffff0d; FluentGlyph { glyph: ""; color: white; font-size: 18px; } } VerticalLayout { horizontal-stretch: 1; alignment: center; Text { text: "Restore the Zink default"; color: white; font-size: 13px; font-weight: 700; } Text { text: "Dark mode, Zink teal glass, full navigation and standard motion."; color: #82978f; font-size: 8px; } } Rectangle { width: 180px; height: 44px; border-radius: 22px; background: #38ff6615; border-width: 1px; border-color: #38ff6645; Text { text: "Use Zink default"; color: #38ff66; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.ui-theme-choice = "Dark"; root.ui-accent-choice = "Zink teal"; root.ui-custom-accent-hex = "#06404A"; root.compact-navigation = false; root.reduce-motion = false; root.lighter-sdr-theme = false; root.save-customization(root.ui-theme-choice, root.ui-accent-choice, root.compact-navigation, root.reduce-motion, root.lighter-sdr-theme); } } } } }
                }
            }

            if root.current-route == "feedback" || root.current-route == "notifications" || root.current-route == "privacy" || root.current-route == "feature-tour" || root.current-route == "widget-hub" || root.current-route == "review": Rectangle {
                border-radius: 24px; background: #06161cde; border-width: 1px; border-color: #ffffff14; clip: true;
                ZinkScrollView { width: parent.width; height: parent.height; content-height: footer-content.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.always-on; horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    footer-content := VerticalLayout { width: parent.visible-width - 16px; padding: 32px; spacing: 18px;
                        Text { text: "ZINK"; color: #38ff66; font-size: 10px; font-weight: 750; }
                        Text { text: root.page-title; color: white; font-size: 31px; font-weight: 750; }
                        Text { text: root.current-route == "feedback" ? "Tell us what works, what feels wrong, or what Zink should do next." : root.current-route == "version-history" ? "The story of Zink, from the original player to the native Rust migration." : root.current-route == "app-theme" || root.current-route == "customization" ? "Make Zink feel like your space while keeping every page consistent." : root.current-route == "notifications" ? "Choose which moments deserve your attention." : root.current-route == "privacy" ? "Understand what Zink stores, shares and keeps on your PC." : root.current-route == "feature-tour" ? "A guided look at everything Zink brings together." : root.current-route == "widget-hub" ? "Keep useful controls close while you work and play." : "Share your experience and help Zink improve."; color: #8da29b; font-size: 10px; wrap: word-wrap; }

                        if root.current-route == "feedback": Rectangle { height: 500px; border-radius: 22px; background: #ffffff07; HorizontalLayout { padding: 22px; spacing: 18px; VerticalLayout { width: 280px; spacing: 12px; Text { text: "Help shape Zink"; color: white; font-size: 22px; font-weight: 700; } Text { text: "Bug reports, feature ideas and design feedback all go directly to the developer."; color: #9db0aa; font-size: 10px; wrap: word-wrap; } Rectangle { height: 74px; border-radius: 16px; background: #38ff6610; VerticalLayout { padding: 14px; Text { text: "Useful reports include"; color: #38ff66; font-size: 10px; font-weight: 700; } Text { text: "What you opened • what happened • what you expected"; color: #b7cac4; font-size: 8px; wrap: word-wrap; } } } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: "Contact\nfrancehayle@outlook.com"; color: #71877f; font-size: 9px; } } VerticalLayout { horizontal-stretch: 1; spacing: 10px; HorizontalLayout { height: 48px; spacing: 10px; Rectangle { horizontal-stretch: 1; border-radius: 14px; background: #ffffff09; TextInput { x: 14px; width: parent.width - 28px; height: parent.height; text: root.feedback-name; color: white; single-line: true; edited => { root.feedback-name = self.text; } } } Rectangle { horizontal-stretch: 1; border-radius: 14px; background: #ffffff09; TextInput { x: 14px; width: parent.width - 28px; height: parent.height; text: root.feedback-email; color: white; single-line: true; edited => { root.feedback-email = self.text; } } } } Text { text: "Your message"; color: white; font-size: 11px; font-weight: 650; } Rectangle { vertical-stretch: 1; border-radius: 16px; background: #ffffff09; TextInput { x: 15px; y: 12px; width: parent.width - 30px; height: parent.height - 24px; text: root.feedback-text; color: white; wrap: word-wrap; edited => { root.feedback-text = self.text; } } } Text { text: root.feedback-status; color: #82978f; font-size: 8px; wrap: word-wrap; } Rectangle { height: 46px; border-radius: 23px; background: root.feedback-text == "" ? #38ff6650 : #38ff66; Text { text: "Prepare feedback email"; color: #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: root.feedback-text != ""; clicked => { root.submit-feedback(root.feedback-name, root.feedback-email, root.feedback-text); } } } } } }

                        if root.current-route == "version-history": HorizontalLayout { spacing: 14px; Rectangle { width: 420px; border-radius: 22px; background: #ffffff05; ZinkScrollView { width: parent.width; height: parent.height; content-height: history-list.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.as-needed; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; history-list := VerticalLayout { width: parent.visible-width - 12px; padding: 12px; spacing: 9px; Rectangle { height: 118px; border-radius: 22px; background: @linear-gradient(110deg, #0e3d2c 0%, #09252a 100%); VerticalLayout { padding: 20px; Text { text: "CURRENT NATIVE BUILD"; color: #38ff66; font-size: 8px; font-weight: 750; } Text { text: "Zink 5.0.0 alpha 1"; color: white; font-size: 24px; font-weight: 750; } Text { text: "Rust + Slint • Native Windows media • No .NET runtime"; color: #b7cac4; font-size: 9px; } } } for release in root.version-releases: Rectangle { height: 68px; border-radius: 15px; background: root.selected-version == release.version ? #38ff6613 : release-touch.has-hover ? #ffffff0c : #ffffff07; border-width: 1px; border-color: root.selected-version == release.version ? #38ff6655 : #ffffff08; HorizontalLayout { padding: 13px; VerticalLayout { Text { text: "Version " + release.version; color: white; font-size: 10px; font-weight: 700; } Text { text: release.summary; color: #82978f; font-size: 8px; overflow: elide; } Text { text: release.date; color: #536b63; font-size: 7px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "View  ›"; color: #38ff66; font-size: 8px; vertical-alignment: center; } } release-touch := TouchArea { clicked => { root.selected-version = release.version; root.select-version(release.version); } } } } } } Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #ffffff07; VerticalLayout { padding: 24px; spacing: 13px; Text { text: "RELEASE NOTES"; color: #38ff66; font-size: 8px; font-weight: 750; } Text { text: root.selected-version == "5.0.0-alpha.1" ? "Zink 5 native migration" : "Version " + root.selected-version; color: white; font-size: 24px; font-weight: 750; } Text { text: root.selected-version-date; color: #82978f; font-size: 9px; } Rectangle { height: 1px; background: #ffffff12; } ZinkScrollView { horizontal-stretch: 1; vertical-stretch: 1; content-height: version-notes.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.as-needed; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; version-notes := VerticalLayout { width: parent.visible-width - 12px; padding: 4px; Text { text: root.selected-version-notes; color: #c1d0cb; font-size: 11px; wrap: word-wrap; } } } } } }

                        if root.current-route == "app-theme" || root.current-route == "customization": VerticalLayout { spacing: 16px; Text { text: "Appearance"; color: white; font-size: 19px; font-weight: 700; } HorizontalLayout { height: 170px; spacing: 14px; for theme in ["System", "Dark", "Light"]: Rectangle { horizontal-stretch: 1; border-radius: 22px; background: theme == "Light" ? #e9f2ef : theme == "Dark" ? #071319 : @linear-gradient(135deg, #e4efec 0%, #071319 100%); border-width: 2px; border-color: root.ui-theme-choice == theme ? #38ff66 : #ffffff10; VerticalLayout { padding: 18px; Rectangle { vertical-stretch: 1; background: transparent; } Text { text: theme; color: theme == "Light" ? #071319 : white; font-size: 17px; font-weight: 700; } Text { text: theme == "System" ? "Follow Windows" : theme + " appearance"; color: theme == "Light" ? #44544f : #82978f; font-size: 9px; } } TouchArea { clicked => { root.ui-theme-choice = theme; root.save-customization(root.ui-theme-choice, root.ui-accent-choice, root.compact-navigation, root.reduce-motion, root.lighter-sdr-theme); } } } } Text { text: "Glass colour"; color: white; font-size: 19px; font-weight: 700; } HorizontalLayout { height: 70px; spacing: 10px; for accent in [{name:"Zink green", color:#38ff66}, {name:"Ocean", color:#11d8e8}, {name:"Violet", color:#9a77ff}, {name:"Sunset", color:#ff7b68}, {name:"Windows", color:#60a5fa}]: Rectangle { horizontal-stretch: 1; border-radius: 16px; background: #ffffff07; border-width: 1px; border-color: root.ui-accent-choice == accent.name ? accent.color : #ffffff10; HorizontalLayout { padding: 12px; spacing: 8px; Rectangle { width: 30px; height: 30px; border-radius: 15px; background: accent.color; } Text { text: accent.name; color: white; font-size: 8px; vertical-alignment: center; } } TouchArea { clicked => { root.ui-accent-choice = accent.name; root.save-customization(root.ui-theme-choice, root.ui-accent-choice, root.compact-navigation, root.reduce-motion, root.lighter-sdr-theme); } } } } for setting in [{name:"Lighter SDR theme", enabled:root.lighter-sdr-theme}, {name:"Compact navigation", enabled:root.compact-navigation}, {name:"Reduce motion", enabled:root.reduce-motion}]: Rectangle { height: 58px; border-radius: 15px; background: setting.enabled ? #38ff6610 : #ffffff07; HorizontalLayout { padding: 15px; VerticalLayout { alignment: center; Text { text: setting.name; color: white; font-size: 10px; } Text { text: setting.name == "Lighter SDR theme" ? "Lift dark surfaces on standard-dynamic-range displays" : setting.name == "Compact navigation" ? "Show more destinations in the sidebar" : "Limit decorative transitions"; color: #71877f; font-size: 7px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: setting.enabled ? "ON" : "OFF"; color: setting.enabled ? #38ff66 : #71877f; font-size: 9px; font-weight: 700; vertical-alignment: center; } } TouchArea { clicked => { if (setting.name == "Lighter SDR theme") { root.lighter-sdr-theme = !root.lighter-sdr-theme; } else if (setting.name == "Compact navigation") { root.compact-navigation = !root.compact-navigation; } else { root.reduce-motion = !root.reduce-motion; } root.save-customization(root.ui-theme-choice, root.ui-accent-choice, root.compact-navigation, root.reduce-motion, root.lighter-sdr-theme); } } } Rectangle { height: 44px; border-radius: 22px; background: #ffffff09; Text { text: "Reset to Zink default"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.ui-theme-choice = "Dark"; root.ui-accent-choice = "Zink green"; root.compact-navigation = false; root.reduce-motion = false; root.lighter-sdr-theme = false; root.save-customization(root.ui-theme-choice, root.ui-accent-choice, root.compact-navigation, root.reduce-motion, root.lighter-sdr-theme); } } } }

                        if root.current-route == "notifications": VerticalLayout { spacing: 12px; HorizontalLayout { height: 78px; spacing: 10px; for setting in [{name:"Playback", detail:"Media changes", enabled:root.notifications-playback}, {name:"Social", detail:"Messages and calls", enabled:root.notifications-social}, {name:"Updates", detail:"Zink and WebView2", enabled:root.notifications-updates}]: Rectangle { horizontal-stretch: 1; border-radius: 17px; background: setting.enabled ? #38ff6611 : #ffffff07; HorizontalLayout { padding: 17px; VerticalLayout { Text { text: setting.name; color: white; font-size: 11px; font-weight: 650; } Text { text: setting.detail; color: #82978f; font-size: 8px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: setting.enabled ? "ON" : "OFF"; color: setting.enabled ? #38ff66 : #71877f; font-size: 9px; font-weight: 700; vertical-alignment: center; } } TouchArea { clicked => { if (setting.name == "Playback") { root.notifications-playback = !root.notifications-playback; } else if (setting.name == "Social") { root.notifications-social = !root.notifications-social; } else { root.notifications-updates = !root.notifications-updates; } root.save-notification-settings(root.notifications-playback, root.notifications-social, root.notifications-updates); } } } }
                            HorizontalLayout { height: 42px; spacing: 9px; Text { text: "Notification history"; color: white; font-size: 19px; font-weight: 700; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 128px; border-radius: 21px; background: #38ff66; Text { text: "Send test alert"; color: #051109; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.send-test-notification(); } } } Rectangle { width: 112px; border-radius: 21px; background: #ffffff0b; Text { text: "Clear all"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: root.notification-items.length > 0; clicked => { root.clear-notifications(); } } } Rectangle { width: 150px; border-radius: 21px; background: #ffffff0b; Text { text: "Windows settings  ↗"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-external-link("ms-settings:notifications"); } } } }
                            Rectangle { vertical-stretch: 1; border-radius: 20px; background: #ffffff05; if root.notification-items.length == 0: VerticalLayout { alignment: center; spacing: 8px; FluentGlyph { glyph: ""; color: #38ff66; font-size: 30px; } Text { text: "No notifications yet"; color: white; font-size: 16px; font-weight: 700; horizontal-alignment: center; } Text { text: "Playback, Social and update activity will appear here."; color: #82978f; font-size: 9px; horizontal-alignment: center; } } if root.notification-items.length > 0: ZinkScrollView { width: parent.width; height: parent.height; content-height: notification-list.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.as-needed; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; notification-list := VerticalLayout { width: parent.visible-width - 12px; padding: 12px; spacing: 9px; for item in root.notification-items: Rectangle { height: 88px; border-radius: 16px; background: #ffffff08; HorizontalLayout { padding: 14px; spacing: 12px; Rectangle { width: 46px; height: 46px; border-radius: 15px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 18px; } } VerticalLayout { alignment: center; Text { text: item.title; color: white; font-size: 12px; font-weight: 700; } Text { text: item.message; color: #9db0aa; font-size: 9px; overflow: elide; } Text { text: item.timestamp; color: #617a73; font-size: 7px; } } Rectangle { horizontal-stretch: 1; background: transparent; } if item.action-uri != "": Rectangle { width: 96px; height: 36px; border-radius: 18px; background: #38ff6618; Text { text: item.action-label == "" ? "Open" : item.action-label; color: #38ff66; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-external-link(item.action-uri); } } } Rectangle { width: 42px; height: 36px; border-radius: 18px; background: #ffffff0b; FluentGlyph { glyph: ""; color: #b9c9c4; font-size: 13px; } TouchArea { clicked => { root.delete-notification(item.id); } } } } } } } } }
                        if root.current-route == "privacy": VerticalLayout { spacing: 12px; HorizontalLayout { height: 54px; spacing: 9px; Rectangle { width: 180px; border-radius: 18px; background: #38ff6617; Text { text: "Windows privacy settings  ↗"; color: #38ff66; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-external-link("ms-settings:privacy"); } } } Rectangle { width: 150px; border-radius: 18px; background: #ffffff09; Text { text: "Browser settings  ›"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("zink-connect"); } } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "Last updated 21 May 2026"; color: #71877f; font-size: 8px; vertical-alignment: center; } } for section in [{title:"Local media and libraries", text:"Zink reads only files and folders you select. Paths, metadata, artwork caches, libraries and playback preferences remain on this PC; media is not uploaded automatically."}, {title:"Accounts and third-party services", text:"Spotify, Microsoft, Xbox, social and web services control their own sign-in data. Zink stores access tokens locally where needed and never stores your Spotify password."}, {title:"Zink Connect and browsing", text:"WebView2 can keep browser history, cookies and site data in its local profile. Content filtering is applied locally where supported. Third-party sites use their own privacy policies."}, {title:"Microphone, audio, camera and screen", text:"Windows permission is requested only for a feature you start, including calls, recording, replay capture, screen sharing and streaming. Capture stops when you stop that feature."}, {title:"Diagnostics and support", text:"Diagnostic logs and support bundles stay local unless you explicitly choose to share or upload them. Failed support uploads may leave a local report for you to inspect."}, {title:"Your controls", text:"Stop capture at any time, clear browsing data and history, sign out of connected services, remove local libraries, clear settings, or revoke Zink permissions in Windows Settings."}, {title:"Our commitment", text:"Zink does not sell personal data. Internet access is used for services you choose, including streaming, radio, sign-in, calling, browsing, updates and diagnostics."}]: Rectangle { height: 78px; border-radius: 17px; background: #ffffff07; VerticalLayout { padding: 14px; Text { text: section.title; color: white; font-size: 12px; font-weight: 700; } Text { text: section.text; color: #9db0aa; font-size: 8px; wrap: word-wrap; } } } }

                        if root.current-route == "feature-tour" || root.current-route == "widget-hub": GridLayout { height: 450px; spacing: 12px; for feature[index] in root.current-route == "feature-tour" ? [{icon:"↶", title:"Replay Clips", detail:"Start a buffer and save recent moments", route:"recorder"}, {icon:"▣", title:"Recording Library", detail:"Open saved recordings from one place", route:"recordings"}, {icon:"✦", title:"Widgets", detail:"Compact radio, Spotify and gaming tools", route:"widget-hub"}, {icon:"◉", title:"Radio Discovery", detail:"Find stations, liked songs and mini controls", route:"radio-discovery"}, {icon:"●", title:"Streaming", detail:"Jump into the live creator studio", route:"streaming"}, {icon:"◎", title:"Zink Connect", detail:"Browser, sharing and connected services", route:"zink-connect"}] : [{icon:"♫", title:"Now Playing", detail:"Full playback and compact controls", route:"music-player"}, {icon:"◉", title:"Radio Widget", detail:"Floating live station controls", route:"radio-widget"}, {icon:"S", title:"Spotify Widget", detail:"Compact Spotify session controls", route:"spotify-widget"}, {icon:"↗", title:"FPS Widget", detail:"Performance and capture overlay", route:"fps-recorder"}, {icon:"●", title:"Recording Controls", detail:"Replay clips and capture status", route:"recorder"}, {icon:"⌂", title:"Dashboard Actions", detail:"Mode-aware shortcuts on Home", route:"home"}]: Rectangle { row: index / 3; col: Math.mod(index, 3); border-radius: 20px; background: feature-touch.has-hover ? #38ff6617 : #ffffff07; border-width: 1px; border-color: feature-touch.has-hover ? #38ff6655 : #ffffff0b; VerticalLayout { padding: 18px; Rectangle { width: 46px; height: 46px; border-radius: 15px; background: #38ff6615; Text { text: feature.icon; color: #38ff66; font-size: 19px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: feature.title; color: white; font-size: 17px; font-weight: 700; } Text { text: feature.detail; color: #82978f; font-size: 9px; } Text { text: "Open  ›"; color: #38ff66; font-size: 9px; } } feature-touch := TouchArea { clicked => { root.navigate(feature.route); } } } }

                        if root.current-route == "review": Rectangle { height: 440px; border-radius: 26px; background: @linear-gradient(135deg, #11382b 0%, #092329 100%); HorizontalLayout { padding: 30px; spacing: 24px; VerticalLayout { horizontal-stretch: 3; alignment: center; spacing: 15px; Text { text: "★★★★★"; color: #ffd75e; font-size: 34px; } Text { text: "Enjoying Zink?"; color: white; font-size: 30px; font-weight: 750; } Text { text: "A quick Store review helps Zink get discovered and keeps the project moving. The Microsoft Store handles your rating and comment; Zink only opens the correct page."; color: #b7cac4; font-size: 11px; wrap: word-wrap; } HorizontalLayout { height: 48px; spacing: 10px; Rectangle { horizontal-stretch: 1; border-radius: 24px; background: #38ff66; Text { text: "Leave a review"; color: #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-external-link("ms-windows-store://review/?ProductId=9NX0L20X52L7"); } } } Rectangle { horizontal-stretch: 1; border-radius: 24px; background: #ffffff0d; Text { text: "Open Store page"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-external-link("ms-windows-store://pdp/?ProductId=9NX0L20X52L7"); } } } } Text { text: "If Store links are disabled, search for Zink in Microsoft Store."; color: #71877f; font-size: 8px; } } Rectangle { horizontal-stretch: 2; border-radius: 22px; background: #ffffff09; VerticalLayout { padding: 22px; spacing: 13px; Text { text: "What opens"; color: white; font-size: 18px; font-weight: 700; } for step[index] in ["Microsoft Store opens", "Choose a star rating", "Add a short comment"]: HorizontalLayout { height: 48px; spacing: 10px; Rectangle { width: 30px; height: 30px; border-radius: 15px; background: #38ff6618; Text { text: "" + (index + 1); color: #38ff66; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } } Text { text: step; color: #c0d0ca; font-size: 10px; vertical-alignment: center; } } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: "Your review is managed by Microsoft."; color: #71877f; font-size: 8px; } } } } }
                    }
                }
            }

            if root.current-route == "settings": Rectangle { border-radius: 24px; background: #06161cde; border-width: 1px; border-color: #ffffff14; ZinkScrollView { width: parent.width; height: parent.height; content-height: settings-content.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.always-on; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; settings-content := VerticalLayout { width: parent.visible-width - 16px; padding: 30px; spacing: 18px;
                Text { text: "ZINK SETTINGS"; color: #38ff66; font-size: 10px; font-weight: 750; } Text { text: root.localized-settings; color: white; font-size: 31px; font-weight: 750; } Text { text: root.localized-settings-subtitle; color: #8da29b; font-size: 10px; }
                Text { text: root.localized-personalise; color: white; font-size: 20px; font-weight: 700; }
                GridLayout { height: 180px; spacing: 12px;
                    for destination[index] in [
                        {route:"customization", title:root.localized-appearance, detail:root.localized-appearance-description, glyph:""},
                        {route:"notifications", title:root.localized-notifications, detail:root.localized-notifications-description, glyph:""},
                        {route:"privacy", title:root.localized-privacy, detail:root.localized-privacy-description, glyph:""},
                        {route:"about", title:root.localized-about + " Zink", detail:root.localized-about-description, glyph:""}
                    ]: Rectangle { row: index / 2; col: Math.mod(index, 2); border-radius: 19px; background: destination-touch.has-hover ? #38ff6614 : #ffffff07; border-width: 1px; border-color: destination-touch.has-hover ? #38ff6640 : #ffffff10;
                        HorizontalLayout { padding: 17px; spacing: 14px; Rectangle { width: 46px; height: 46px; border-radius: 15px; background: #38ff6617; FluentGlyph { glyph: destination.glyph; color: #38ff66; font-size: 19px; } } VerticalLayout { alignment: center; spacing: 3px; Text { text: destination.title; color: white; font-size: 12px; font-weight: 700; } Text { text: destination.detail; color: #82978f; font-size: 8px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "›"; color: #38ff66; font-size: 22px; vertical-alignment: center; } }
                        destination-touch := TouchArea { clicked => { root.navigate(destination.route); } }
                    }
                }
                HorizontalLayout { height: 205px; spacing: 14px;
                    Rectangle { horizontal-stretch: 1; border-radius: 20px; background: #ffffff07; VerticalLayout { padding: 20px; spacing: 9px;
                        Text { text: root.localized-language; color: white; font-size: 18px; font-weight: 700; }
                        Text { text: root.localized-language-description; color: #82978f; font-size: 9px; }
                        Rectangle { height: 38px; border-radius: 13px; background: #38ff6610; HorizontalLayout { padding: 11px; Text { text: "Current: " + root.settings-language; color: white; font-size: 9px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.settings-language == "System default" ? "WINDOWS" : "SAVED"; color: #38ff66; font-size: 7px; font-weight: 700; vertical-alignment: center; } } }
                        Rectangle { height: 32px; border-radius: 11px; background: #001219c0; border-width: 1px; border-color: #ffffff16; FluentGlyph { x: 9px; width: 18px; glyph: ""; color: #71877f; font-size: 11px; } TextInput { x: 30px; width: parent.width - 40px; height: parent.height; text: root.settings-language-search; color: white; font-size: 8px; single-line: true; edited => { root.settings-language-search = self.text; root.filter-settings-languages(self.text); } } }
                        GridLayout { vertical-stretch: 1; spacing: 6px; for language[index] in root.settings-language-options: Rectangle { row: index / 4; col: Math.mod(index, 4); border-radius: 11px; background: root.settings-language == language ? #38ff6620 : language-touch.has-hover ? #ffffff10 : #ffffff07; Text { text: language; color: root.settings-language == language ? #38ff66 : white; font-size: 7px; horizontal-alignment: center; vertical-alignment: center; } language-touch := TouchArea { clicked => { root.select-language(language); } } } }
                    } }
                    Rectangle { horizontal-stretch: 1; border-radius: 20px; background: #ffffff07; VerticalLayout { padding: 20px; spacing: 9px; Text { text: root.localized-integrations; color: white; font-size: 18px; font-weight: 700; } Text { text: root.localized-integrations-description; color: #82978f; font-size: 9px; } Rectangle { height: 48px; border-radius: 14px; background: root.settings-discord-presence ? #38ff6615 : #ffffff06; HorizontalLayout { padding: 13px; Text { text: "Discord Rich Presence"; color: white; font-size: 10px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.settings-discord-presence ? root.localized-on : root.localized-off; color: root.settings-discord-presence ? #38ff66 : #71877f; font-size: 9px; font-weight: 700; vertical-alignment: center; } } TouchArea { clicked => { root.update-setting("discord", !root.settings-discord-presence); } } } Rectangle { vertical-stretch: 1; background: transparent; } Text { text: root.localized-discord-description; color: #71877f; font-size: 8px; wrap: word-wrap; } } }
                }
                Text { text: root.localized-background-startup; color: white; font-size: 20px; font-weight: 700; } GridLayout { height: 250px; spacing: 12px; for setting[index] in [{id:"startup", name:root.localized-run-sign-in, detail:root.localized-startup-description, enabled:root.settings-run-startup}, {id:"reopen-last-page", name:root.localized-reopen-last-page, detail:root.localized-reopen-description, enabled:root.settings-reopen-last-page}, {id:"background-notifications", name:root.localized-background + " / " + root.localized-notifications, detail:root.localized-alerts-description, enabled:root.settings-background-notifications}, {id:"low-resource", name:root.localized-low-resource, detail:root.localized-low-resource-description, enabled:root.settings-low-resource}]: Rectangle { row: index / 2; col: Math.mod(index, 2); border-radius: 19px; background: setting.enabled ? #38ff6611 : #ffffff07; HorizontalLayout { padding: 18px; spacing: 14px; FluentGlyph { width: 28px; glyph: setting.id == "startup" ? "" : setting.id == "reopen-last-page" ? "" : setting.id == "background-notifications" ? "" : ""; color: #38ff66; font-size: 18px; } VerticalLayout { alignment: center; Text { text: setting.name; color: white; font-size: 11px; font-weight: 650; } Text { text: setting.detail; color: #82978f; font-size: 8px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: setting.enabled ? root.localized-on : root.localized-off; color: setting.enabled ? #38ff66 : #71877f; font-size: 8px; font-weight: 700; vertical-alignment: center; } } TouchArea { clicked => { root.update-setting(setting.id, !setting.enabled); } } } }
                Text { text: root.localized-replay-hotkeys; color: white; font-size: 20px; font-weight: 700; } HorizontalLayout { height: 100px; spacing: 12px; for setting in [{id:"background-replay", name:root.localized-background-replay, enabled:root.settings-background-replay}, {id:"clip-hotkey", name:root.localized-clip-hotkey, enabled:root.settings-hotkey-recording}]: Rectangle { horizontal-stretch: 1; border-radius: 18px; background: setting.enabled ? #38ff6611 : #ffffff07; HorizontalLayout { padding: 18px; VerticalLayout { Text { text: setting.name; color: white; font-size: 12px; font-weight: 650; } Text { text: setting.id == "background-replay" ? root.localized-background-replay-description : root.localized-hotkey-description; color: #82978f; font-size: 8px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: setting.enabled ? root.localized-on : root.localized-off; color: setting.enabled ? #38ff66 : #71877f; font-size: 9px; font-weight: 700; vertical-alignment: center; } } TouchArea { clicked => { root.update-setting(setting.id, !setting.enabled); } } } Rectangle { width: 150px; border-radius: 18px; background: #ffffff07; Text { text: root.localized-replay-settings + "  ›"; color: #38ff66; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("background-recording-settings"); } } } }
                Text { text: root.localized-diagnostics; color: white; font-size: 20px; font-weight: 700; } Rectangle { height: 205px; border-radius: 20px; background: #ffffff07; VerticalLayout { padding: 18px; spacing: 10px; HorizontalLayout { height: 42px; Text { text: root.localized-diagnostic-log; color: white; font-size: 11px; font-weight: 650; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: root.settings-diagnostic-log ? root.localized-on : root.localized-off; color: root.settings-diagnostic-log ? #38ff66 : #71877f; font-size: 9px; font-weight: 700; vertical-alignment: center; } TouchArea { width: 90px; clicked => { root.update-setting("diagnostic-log", !root.settings-diagnostic-log); } } } HorizontalLayout { height: 42px; spacing: 9px; for action in [{id:"open", title:root.localized-open-log-folder}, {id:"clear", title:root.localized-clear-log}, {id:"health", title:root.localized-run-health-check}]: Rectangle { horizontal-stretch: 1; border-radius: 14px; background: #ffffff09; Text { text: action.title; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { if (action.id == "open") { root.open-log-folder(); } else if (action.id == "clear") { root.clear-log(); } else { root.run-health-check(); } } } } } HorizontalLayout { height: 42px; spacing: 9px; Rectangle { horizontal-stretch: 1; border-radius: 14px; background: #ffffff09; Text { text: root.localized-open-health-report; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-health-report(); } } } Rectangle { horizontal-stretch: 1; border-radius: 14px; background: #38ff6617; Text { text: root.localized-upload-support-bundle; color: #38ff66; font-size: 9px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.send-health-report(); } } } } Text { text: root.settings-status; color: #8da29b; font-size: 8px; overflow: elide; } } }
                Text { text: root.localized-maintenance; color: white; font-size: 20px; font-weight: 700; } HorizontalLayout { height: 54px; spacing: 10px; Rectangle { width: root.settings-reset-armed ? 220px : 150px; border-radius: 18px; background: root.settings-reset-armed ? #ff5968 : #ffffff0a; Text { text: root.settings-reset-armed ? root.localized-confirm-reset : root.localized-reset-defaults; color: white; font-size: 9px; font-weight: root.settings-reset-armed ? 700 : 400; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { if (root.settings-reset-armed) { root.reset-settings(); } else { root.settings-reset-armed = true; root.settings-status = root.localized-reset-instruction; } } } } Rectangle { width: 184px; border-radius: 18px; background: root.settings-update-active ? #ffcc6618 : #38ff6618; Text { text: root.settings-update-active ? root.localized-checking-store : root.localized-check-updates; color: root.settings-update-active ? #ffcc66 : #38ff66; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: !root.settings-update-active; clicked => { root.check-app-updates(); } } } Rectangle { width: 138px; border-radius: 18px; background: #ffffff0a; Text { text: root.localized-open-store-updates + "  ↗"; color: white; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-external-link("ms-windows-store://downloadsandupdates"); } } } } }
            } }

            if root.current-route == "about": Rectangle { border-radius: 24px; background: #06161cde; border-width: 1px; border-color: #ffffff14; ZinkScrollView { width: parent.width; height: parent.height; content-height: about-content.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.as-needed; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; about-content := VerticalLayout { width: parent.visible-width - 14px; padding: 30px; spacing: 18px; HorizontalLayout { height: 220px; spacing: 18px; Rectangle { width: 340px; border-radius: 24px; background: @linear-gradient(145deg, #103b30 0%, #092229 100%); HorizontalLayout { padding: 24px; spacing: 18px; Rectangle { width: 104px; height: 104px; border-radius: 28px; background: #38ff6618; clip: true; Image { source: @image-url("../../../../Assets/ZinkLogo.png"); width: 78px; height: 78px; x: 13px; y: 13px; image-fit: contain; } } VerticalLayout { alignment: center; spacing: 7px; Text { text: "About Zink"; color: white; font-size: 29px; font-weight: 750; } Text { text: "Media, gaming and social — together."; color: #b7cac4; font-size: 10px; wrap: word-wrap; } Text { text: "Version " + root.current-app-version + "\n" + root.current-runtime-summary + "\nBuilt " + root.current-build-time; color: #38ff66; font-size: 9px; wrap: word-wrap; } } } } Rectangle { horizontal-stretch: 1; border-radius: 24px; background: #ffffff07; VerticalLayout { padding: 22px; spacing: 10px; Text { text: "Everything you use, in one place"; color: white; font-size: 22px; font-weight: 750; } Text { text: "Music, video, radio, streaming, gaming, recording, social tools and a managed browser share one Zink design language."; color: #9db0aa; font-size: 10px; wrap: word-wrap; } Text { text: root.current-installation-summary; color: #38ff66; font-size: 9px; font-weight: 650; } Text { text: "Local data: " + root.current-data-path; color: #71877f; font-size: 8px; overflow: elide; } GridLayout { vertical-stretch: 1; spacing: 8px; for feature[index] in [{title:"Music", route:"music-player"}, {title:"Watch", route:"video-player"}, {title:"Create", route:"screen-recorder"}, {title:"Gaming", route:"gaming"}, {title:"Social", route:"social"}, {title:"Browser", route:"zink-connect"}]: Rectangle { row: index / 3; col: Math.mod(index, 3); border-radius: 13px; background: about-feature-touch.has-hover ? #38ff6617 : #ffffff07; Text { text: feature.title; color: white; font-size: 10px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } about-feature-touch := TouchArea { clicked => { root.navigate(feature.route); } } } } } } } Text { text: "Version history"; color: white; font-size: 21px; font-weight: 700; } Text { text: "Every shipped Zink generation, including the complete WinUI history."; color: #82978f; font-size: 9px; } GridLayout { height: 450px; spacing: 10px; for release[index] in root.version-releases: Rectangle { row: index / 3; col: Math.mod(index, 3); border-radius: 16px; background: about-release-touch.has-hover ? #38ff6613 : #ffffff07; border-width: 1px; border-color: #ffffff0e; HorizontalLayout { padding: 14px; VerticalLayout { alignment: center; Text { text: "Version " + release.version; color: white; font-size: 10px; font-weight: 700; } Text { text: release.summary; color: #71877f; font-size: 8px; overflow: elide; } Text { text: release.date; color: #536b63; font-size: 7px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "Learn more  ›"; color: #38ff66; font-size: 8px; vertical-alignment: center; } } about-release-touch := TouchArea { clicked => { root.selected-version = release.version; root.select-version(release.version); root.navigate("version-history"); } } } } HorizontalLayout { height: 44px; spacing: 10px; Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #38ff66; Text { text: "All version history"; color: #051109; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("version-history"); } } } Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #ffffff0b; Text { text: root.localized-privacy; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("privacy"); } } } Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #ffffff0b; Text { text: "Feedback"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.navigate("feedback"); } } } } HorizontalLayout { height: 44px; spacing: 10px; Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #38ff6614; Text { text: root.settings-update-active ? "Checking…" : root.localized-check-updates; color: root.settings-update-active ? #ffcc66 : #38ff66; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { enabled: !root.settings-update-active; clicked => { root.check-app-updates(); } } } Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #ffffff0b; Text { text: "Open diagnostic logs"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-log-folder(); } } } Rectangle { horizontal-stretch: 1; border-radius: 22px; background: #ffffff0b; Text { text: "Run health check"; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.run-health-check(); } } } } Text { text: root.settings-status; color: #82978f; font-size: 8px; horizontal-alignment: center; overflow: elide; } Text { text: "Created by Francis Hayle • Copyright 2026"; color: #71877f; font-size: 8px; horizontal-alignment: center; } } } }

            if root.current-route == "zink-connect": Rectangle {
                border-radius: 18px; background: @linear-gradient(135deg, #062d34c8 0%, #001016e8 100%); border-width: 1px; border-color: #11d8e850;
                VerticalLayout { padding: 42px; spacing: 18px; alignment: center; HorizontalLayout { height: 108px; alignment: center; Rectangle { width: 108px; height: 108px; border-radius: 28px; background: #05acb718; Text { text: "◎"; color: #38ff66; font-size: 52px; horizontal-alignment: center; vertical-alignment: center; } } } Text { text: "Zink Connect"; color: white; font-size: 36px; font-weight: 650; horizontal-alignment: center; } Text { text: "Zink's native multi-tab WebView2 browser, with filtering, fullscreen video and a fresh session whenever Zink starts."; color: #d6e2eaa9; font-size: 15px; horizontal-alignment: center; wrap: word-wrap; } HorizontalLayout { height: 48px; spacing: 12px; alignment: center; Rectangle { width: 180px; border-radius: 18px; background: open-connect.has-hover ? #118bdc : #0078d7; Text { text: "Open Zink Connect"; color: white; horizontal-alignment: center; vertical-alignment: center; } open-connect := TouchArea { clicked => { root.open-zink-connect(); } } } Rectangle { width: 180px; border-radius: 18px; background: bring-connect.has-hover ? #11d8e838 : #00161dbd; border-width: 1px; border-color: #11d8e850; Text { text: "Bring browser forward"; color: white; horizontal-alignment: center; vertical-alignment: center; } bring-connect := TouchArea { clicked => { root.open-zink-connect(); } } } } HorizontalLayout { height: 82px; spacing: 12px; alignment: center; for action in [{title:"Browser settings", detail:"Privacy, filtering and updates", page:"settings"}, {title:"Browsing history", detail:"Review this browser session", page:"history"}]: Rectangle { width: 250px; border-radius: 18px; background: connect-action.has-hover ? #38ff6615 : #ffffff08; border-width: 1px; border-color: #ffffff14; VerticalLayout { padding: 14px; Text { text: action.title; color: white; font-size: 12px; font-weight: 700; } Text { text: action.detail; color: #8da29b; font-size: 8px; } Text { text: "Open  ›"; color: #38ff66; font-size: 8px; } } connect-action := TouchArea { clicked => { root.open-zink-connect-page(action.page); } } } } Text { text: "Powered by the installed Microsoft Edge WebView2 Evergreen runtime."; color: #d6e2ea83; font-size: 11px; horizontal-alignment: center; } }
            }

            if root.current-route == "zink-vpn": Rectangle {
                border-radius: 26px; background: #141820d8; border-width: 1px; border-color: #ffffff33;
                horizontal-stretch: 1; vertical-stretch: 1;
