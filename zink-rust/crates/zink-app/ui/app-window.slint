    in-out property <bool> app-fullscreen: false;
    private property <bool> call-share-fullscreen: false;
    private property <bool> call-share-restore-fullscreen: false;
    private property <bool> call-share-exit-visible: false;

    call-share-exit-timer := Timer {
        interval: 2500ms;
        running: false;
        triggered => {
            self.running = false;
            root.call-share-exit-visible = false;
        }
    }

    function reveal-call-share-exit() {
        root.call-share-exit-visible = true;
        call-share-exit-timer.running = true;
        call-share-exit-timer.restart();
    }

    function set-call-share-fullscreen(fullscreen: bool) {
        if fullscreen && !root.call-share-fullscreen && root.call-remote-visible && root.current-route == "call" {
            root.call-share-restore-fullscreen = root.app-fullscreen;
            root.call-share-fullscreen = true;
            root.set-app-fullscreen(true);
            player-shortcuts.focus();
        } else if !fullscreen && root.call-share-fullscreen {
            root.call-share-fullscreen = false;
            root.call-share-exit-visible = false;
            call-share-exit-timer.running = false;
            root.set-app-fullscreen(root.call-share-restore-fullscreen);
        }
    }

    changed call-remote-visible => {
        if !root.call-remote-visible { root.set-call-share-fullscreen(false); }
    }
    changed current-route => {
        if root.current-route != "call" { root.set-call-share-fullscreen(false); }
    }
