import { Button, ComboBox, ListView } from "std-widgets.slint";

export struct NavItem {
    id: string,
    title: string,
    group: string,
}

export struct LibraryItem {
    path: string,
    title: string,
    artist: string,
    album: string,
    media-kind: string,
    duration: string,
    artwork: image,
}

export struct SearchFacetItem {
    name: string,
    detail: string,
    artwork: image,
    path: string,
}

export struct SearchStationItem {
    name: string,
    genre: string,
    stream-url: string,
    user-defined: bool,
}

export struct MusicTrackItem {
    path: string,
    title: string,
    artist: string,
    album: string,
}

export struct PlaylistItem {
    name: string,
    detail: string,
}

export struct AudioDeviceItem {
    id: string,
    name: string,
}

export struct AudioTrackItem {
    index: int,
    name: string,
    language: string,
    selected: bool,
}

export struct TrackStatisticItem {
    path: string,
    title: string,
    artist: string,
    detail: string,
}

export struct LyricLineItem {
    start-ms: int,
    text: string,
}

export struct VideoSubtitleItem {
    start-ms: int,
    end-ms: int,
    text: string,
}

export struct ArtistReleaseItem {
    id: string,
    title: string,
    release-type: string,
    release-date: string,
    artwork: image,
}

export struct HomeActivityItem {
    title: string,
    detail: string,
    route: string,
    icon: string,
}

export struct RadioLikeItem {
    station: string,
    title: string,
    artist: string,
}

export struct LikedRadioSongItem {
    id: string,
    title: string,
    artist: string,
    album: string,
    station: string,
    artwork: image,
    added-to-spotify: bool,
}

export struct SpotifyTrackItem {
    id: string,
    title: string,
    artist: string,
    album: string,
}

export struct SpotifyDeviceItem {
    id: string,
    name: string,
    detail: string,
    active: bool,
}

export struct DuplicateVideoItem {
    group: string,
    name: string,
    path: string,
    size: string,
    copies: int,
}

export struct FpsProcessItem {
    pid: int,
    title: string,
}

export struct TorrentMoveEntry {
    key: string,
    name: string,
    detail: string,
    selected: bool,
}

export struct SocialFriendItem {
    user-id: int,
    username: string,
    display-name: string,
    avatar-url: string,
    presence: string,
    is-online: bool,
    is-friend: bool,
}

export struct SocialRequestItem {
    request-id: int,
    username: string,
    display-name: string,
    created: string,
}

export struct SocialConversationItem {
    user-id: int,
    username: string,
    display-name: string,
    preview: string,
    updated: string,
}

export struct SocialMessageItem {
    text: string,
    sent: string,
    is-from-me: bool,
}

export struct NotificationItem {
    id: string,
    title: string,
    message: string,
    timestamp: string,
    action-label: string,
    action-uri: string,
}

export struct VersionReleaseItem {
    version: string,
    date: string,
    summary: string,
}

component NavButton inherits Rectangle {
    in property <string> label;
    in property <string> route-id;
    in property <bool> selected;
    in property <color> accent: #38ff66;
    callback activated(string);
    height: 38px;
    border-radius: 10px;
    background: selected ? @linear-gradient(90deg, #11d8e838 0%, #38ff661c 100%) : touch.has-hover ? #11d8e828 : transparent;
    border-width: selected ? 1px : 0px;
    border-color: root.accent;

    Rectangle {
        width: root.selected ? 3px : 0px;
        height: 20px;
        x: 1px;
        y: 9px;
        border-radius: 2px;
        background: root.accent;
    }
    Text {
        text: root.route-id == "home" ? "" : root.route-id == "search" ? "" : root.route-id == "music-player" ? "" : root.route-id == "music-library" ? "" : root.route-id == "equalizer" ? "" : root.route-id == "visualizer" ? "" : root.route-id == "radio" ? "" : root.route-id == "video-player" ? "" : root.route-id == "video-library" ? "" : root.route-id == "screen-recorder" ? "" : root.route-id == "social" ? "" : root.route-id == "streaming" ? "" : root.route-id == "settings" ? "" : "";
        font-family: "Segoe Fluent Icons";
        color: root.selected ? root.accent : #e7fff6bd;
        font-size: 16px;
        x: 14px;
        width: 20px;
        vertical-alignment: center;
    }
    Text {
        text: root.label;
        color: root.selected ? #ffffff : #cfe7df;
        font-size: 13px;
        font-weight: root.selected ? 700 : 500;
        x: 46px;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.activated(root.route-id); } }
}

component PulseTile inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <string> route-id;
    in property <color> accent: #5ae8e0;
    callback activated(string);
    width: 158px;
    height: 114px;
    border-radius: 22px;
    border-width: 1px;
    border-color: tile-touch.has-hover ? #11d8e8b0 : #78d9dd70;
    background: tile-touch.has-hover ? @linear-gradient(135deg, #063440b0 0%, #07505a8a 55%, #11d8e868 100%) : @linear-gradient(135deg, #021a249c 0%, #03293578 50%, #03132058 100%);
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        Text { text: root.icon; color: root.accent; font-size: 25px; font-weight: 700; }
        Rectangle { vertical-stretch: 1; background: transparent; }
        Text { text: root.title; color: white; font-size: 14px; font-weight: 650; }
        Text { text: root.subtitle; color: #d6e2eab7; font-size: 11px; }
    }
    tile-touch := TouchArea { clicked => { root.activated(root.route-id); } }
}

component CompactTile inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <string> route-id;
    callback activated(string);
    width: 142px;
    height: 92px;
    border-radius: 18px;
    border-width: 1px;
    border-color: compact-touch.has-hover ? #38ff6680 : #ffffff20;
    background: compact-touch.has-hover ? #0a424bb8 : #001117a8;
    VerticalLayout {
        padding: 10px;
        spacing: 3px;
        Text { text: root.icon; color: #38ff66; font-size: 20px; horizontal-alignment: center; }
        Text { text: root.title; color: #cfe7df; font-size: 12px; font-weight: 650; horizontal-alignment: center; overflow: elide; }
        Text { text: root.subtitle; color: #9fb2ac; font-size: 10px; horizontal-alignment: center; overflow: elide; }
    }
    compact-touch := TouchArea { clicked => { root.activated(root.route-id); } }
}

component FluentGlyph inherits Text {
    in property <string> glyph;
    text: root.glyph;
    font-family: "Segoe Fluent Icons";
    color: white;
    horizontal-alignment: center;
    vertical-alignment: center;
}

component CallBadge inherits Rectangle {
    in property <string> label;
    in property <brush> fill: #292a31;

    width: badge-text.preferred-width + 16px;
    height: 22px;
    border-radius: 11px;
    background: root.fill;
    badge-text := Text {
        text: root.label;
        color: white;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component CallTile inherits Rectangle {
    in property <string> name;
    in property <string> glyph;
    in property <image> picture;
    in property <bool> preview;
    in property <bool> avatar;
    in property <bool> live;
    in property <string> status;
    in property <color> tint: #22252e;

    width: 158px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #ffffff16;
    background: @linear-gradient(180deg, root.tint 0%, #111217 100%);
    clip: true;
    if root.preview: Image {
        width: parent.width; height: parent.height;
        source: root.picture;
        image-fit: cover;
    }
    if !root.preview: Rectangle {
        x: (parent.width - self.width) / 2;
        y: 14px;
        width: 46px; height: 46px;
        border-radius: 23px;
        background: #ffffff14;
        clip: true;
        if root.avatar: Image { width: parent.width; height: parent.height; source: root.picture; image-fit: cover; }
        if !root.avatar: FluentGlyph { glyph: root.glyph; font-size: 20px; color: #ececf3; }
    }
    Rectangle {
        x: 6px; y: parent.height - self.height - 6px;
        width: Math.min(parent.width - 12px, tile-name.preferred-width + 14px);
        height: 22px;
        border-radius: 5px;
        background: #08090bd9;
        tile-name := Text {
            x: 7px; width: parent.width - 14px;
            text: root.name;
            color: white;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if root.status != "": CallBadge {
        x: parent.width - self.width - 6px;
        y: 6px;
        height: 18px;
        label: root.status;
        fill: root.live ? #c42e40 : #22232be8;
    }
}

component EqualizerBand inherits Rectangle {
    in property <string> frequency;
    in-out property <float> gain;
    callback changed(float);
    width: 68px;
    height: 330px;
    background: transparent;
    VerticalLayout {
        spacing: 7px;
        Text { text: root.frequency; color: white; font-size: 11px; font-weight: 650; horizontal-alignment: center; }
        Text { text: (root.gain > 0 ? "+" : "") + Math.round(root.gain) + " dB"; color: root.gain == 0 ? #8da29b : #38ff66; font-size: 10px; horizontal-alignment: center; }
        band-track := Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: transparent;
            Rectangle { x: (parent.width - 6px) / 2; width: 6px; height: parent.height; border-radius: 3px; background: #ffffff22; }
            Rectangle { x: 8px; y: parent.height / 2; width: parent.width - 16px; height: 1px; background: #ffffff28; }
            Rectangle {
                x: (parent.width - 6px) / 2;
                y: root.gain >= 0 ? parent.height * (0.5 - root.gain / 24) : parent.height / 2;
                width: 6px;
                height: Math.abs(root.gain) * parent.height / 24;
                border-radius: 3px;
                background: @linear-gradient(180deg, #11d8e8 0%, #38ff66 100%);
            }
            Rectangle {
                x: (parent.width - 24px) / 2;
                y: Math.max(0px, Math.min(parent.height - 14px, parent.height * (0.5 - root.gain / 24) - 7px));
                width: 24px; height: 14px; border-radius: 7px;
                background: band-touch.has-hover ? #ffffff : #dfffee;
                border-width: 3px; border-color: #38ff66;
            }
            band-touch := TouchArea {
                clicked => {
                    root.gain = Math.max(-12, Math.min(12, 12 - self.mouse-y / band-track.height * 24));
                    root.changed(root.gain);
                }
                moved => {
                    if self.pressed {
                        root.gain = Math.max(-12, Math.min(12, 12 - self.mouse-y / band-track.height * 24));
                        root.changed(root.gain);
                    }
                }
            }
        }
        Text { text: "−12     +12"; color: #5f746e; font-size: 7px; horizontal-alignment: center; }
    }
}

component AccessiblePlayerButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <brush> normal-background: transparent;
    in property <brush> hover-background: #ffffff18;
    in property <color> glyph-color: white;
    in property <length> glyph-size: 20px;
    callback activated();

    border-radius: root.height / 2;
    background: action-touch.has-hover ? root.hover-background : root.normal-background;
    border-width: action-focus.has-focus ? 2px : 0px;
    border-color: #b8fff0;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.label + " music control";
    accessible-action-default => { root.activated(); }
    forward-focus: action-focus;

    FluentGlyph {
        glyph: root.glyph;
        color: root.glyph-color;
        font-size: root.glyph-size;
    }
    action-touch := TouchArea {
        clicked => {
            action-focus.focus();
            root.activated();
        }
    }
    action-focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.activated();
                return accept;
            }
            return reject;
        }
    }
}

component CallAction inherits AccessiblePlayerButton {
    width: 42px;
    height: 36px;
    border-radius: 9px;
    glyph-size: 17px;
    accessible-description: root.label;
}

component AccessiblePlayerSlider inherits Rectangle {
    in property <float> value;
    in property <string> label;
    in property <float> keyboard-step: 0.05;
    callback changed(float);

    background: transparent;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-value-minimum: 0.0;
    accessible-value-maximum: 1.0;
    accessible-value-step: root.keyboard-step;
    accessible-action-increment => {
        root.changed(Math.min(1.0, root.value + root.keyboard-step));
    }
    accessible-action-decrement => {
        root.changed(Math.max(0.0, root.value - root.keyboard-step));
    }
    accessible-action-set-value(new-value) => {
        if (new-value.is-float()) {
            root.changed(Math.max(0.0, Math.min(1.0, new-value.to-float())));
        }
    }
    forward-focus: slider-focus;

    Rectangle {
        y: (parent.height - 6px) / 2;
        width: parent.width;
        height: 6px;
        border-radius: 3px;
        background: #ffffff35;
        Rectangle {
            x: 0px;
            width: Math.max(0px, Math.min(parent.width, parent.width * root.value));
            height: parent.height;
            border-radius: 3px;
            background: #38ff66;
            animate width { duration: 120ms; easing: ease-out; }
        }
    }
    if slider-focus.has-focus: Rectangle {
        x: Math.max(0px, parent.width * root.value - 7px);
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: white;
        border-width: 2px;
        border-color: #38ff66;
    }
    slider-touch := TouchArea {
        clicked => {
            slider-focus.focus();
            root.changed(Math.max(0.0, Math.min(1.0, self.mouse-x / root.width)));
        }
    }
    slider-focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.changed(Math.max(0.0, root.value - root.keyboard-step));
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.changed(Math.min(1.0, root.value + root.keyboard-step));
                return accept;
            }
            if (event.text == Key.Home) {
                root.changed(0.0);
                return accept;
            }
            if (event.text == Key.End) {
                root.changed(1.0);
                return accept;
            }
            return reject;
        }
    }
}

// Zink's media scrollbar keeps a generous hit target while the visible rail
// stays slim, rounded, and out of the artwork's way.
component ZinkScrollBar inherits Rectangle {
    in-out property <bool> horizontal;
    in-out property <length> maximum;
    in-out property <length> page-size;
    in-out property <length> value;
    in property <ScrollBarPolicy> policy: ScrollBarPolicy.as-needed;
    in property <bool> enabled: true;
    callback scrolled();

    property <length> rail-size: scroll-touch.has-hover || scroll-touch.pressed ? 8px : 5px;
    property <length> inset: 5px;
    property <length> track-size: root.horizontal ? root.width - 2 * root.inset : root.height - 2 * root.inset;

    background: transparent;
    visible: root.policy == ScrollBarPolicy.always-on || (root.policy == ScrollBarPolicy.as-needed && root.maximum > 0px);

    Rectangle {
        x: root.horizontal ? root.inset : (parent.width - root.rail-size) / 2;
        y: root.horizontal ? (parent.height - root.rail-size) / 2 : root.inset;
        width: root.horizontal ? root.track-size : root.rail-size;
        height: root.horizontal ? root.rail-size : root.track-size;
        border-radius: root.rail-size / 2;
        background: scroll-touch.has-hover || scroll-touch.pressed ? #ffffff1c : #ffffff0d;
        animate width, height, x, y, background { duration: 120ms; easing: ease-out; }
    }

    thumb := Rectangle {
        width: !root.horizontal ? root.rail-size : root.maximum <= 0px ? root.track-size : Math.max(42px, root.track-size * root.page-size / (root.maximum + root.page-size));
        height: root.horizontal ? root.rail-size : root.maximum <= 0px ? root.track-size : Math.max(42px, root.track-size * root.page-size / (root.maximum + root.page-size));
        x: !root.horizontal ? (parent.width - self.width) / 2 : root.inset + (root.track-size - self.width) * (root.maximum <= 0px ? 0 : -root.value / root.maximum);
        y: root.horizontal ? (parent.height - self.height) / 2 : root.inset + (root.track-size - self.height) * (root.maximum <= 0px ? 0 : -root.value / root.maximum);
        border-radius: root.rail-size / 2;
        background: scroll-touch.pressed ? #79ff91 : scroll-touch.has-hover ? #54ff75 : #38ff66c8;
        border-width: scroll-touch.has-hover || scroll-touch.pressed ? 1px : 0px;
        border-color: #b9ffc6a0;
        animate width, height, x, y, background { duration: 120ms; easing: ease-out; }
    }

    scroll-touch := TouchArea {
        property <{pressed-value: length, maximum: length, x: length, y: length}> saved-values;

        function update-saved-values() {
            self.saved-values = { pressed-value: -root.value, maximum: root.maximum, x: self.mouse-x, y: self.mouse-y };
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.update-saved-values();
            }
        }
        moved => {
            if (root.enabled && self.pressed && root.maximum > 0px) {
                if (self.saved-values.maximum != root.maximum) {
                    self.update-saved-values();
                }
                root.value = -Math.max(0px, Math.min(root.maximum, self.saved-values.pressed-value + (
                    root.horizontal
                        ? (self.mouse-x - self.saved-values.x) * (root.maximum / Math.max(1px, root.track-size - thumb.width))
                        : (self.mouse-y - self.saved-values.y) * (root.maximum / Math.max(1px, root.track-size - thumb.height))
                )));
                root.scrolled();
            }
        }
        scroll-event(event) => {
            if (root.horizontal && event.delta-x != 0px) {
                root.value = Math.max(-root.maximum, Math.min(0px, root.value + event.delta-x));
                root.scrolled();
                return accept;
            }
            if (!root.horizontal && event.delta-y != 0px) {
                root.value = Math.max(-root.maximum, Math.min(0px, root.value + event.delta-y));
                root.scrolled();
                return accept;
            }
            return reject;
        }
    }
}

component ZinkScrollView {
    in property <bool> enabled: true;
    out property <length> visible-width <=> scroll-content.width;
    out property <length> visible-height <=> scroll-content.height;
    in-out property <length> content-width <=> scroll-content.content-width;
    in-out property <length> content-height <=> scroll-content.content-height;
    in-out property <length> content-x <=> scroll-content.content-x;
    in-out property <length> content-y <=> scroll-content.content-y;
    in property <ScrollBarPolicy> vertical-scrollbar-policy <=> vertical-scroll.policy;
    in property <ScrollBarPolicy> horizontal-scrollbar-policy <=> horizontal-scroll.policy;
    callback scrolled <=> scroll-content.flicked;

    min-height: 50px;
    min-width: 50px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    preferred-height: 100%;
    preferred-width: 100%;

    scroll-content := Flickable {
        mouse-drag-pan-enabled: false;
        content-y <=> vertical-scroll.value;
        content-x <=> horizontal-scroll.value;
        // Overlay the slim rails instead of feeding their visibility back into
        // the viewport size. This keeps content measurements stable while the
        // bars animate between their resting and active widths.
        width: parent.width;
        height: parent.height;
        @children
    }
    vertical-scroll := ZinkScrollBar {
        enabled: root.enabled;
        width: 14px;
        x: parent.width - self.width;
        y: 3px;
        height: parent.height - (horizontal-scroll.visible ? horizontal-scroll.height : 0px) - 6px;
        horizontal: false;
        maximum: Math.max(0px, scroll-content.content-height - scroll-content.height);
        page-size: scroll-content.height;
        scrolled => { root.scrolled(); }
    }
    horizontal-scroll := ZinkScrollBar {
        enabled: root.enabled;
        width: parent.width - (vertical-scroll.visible ? vertical-scroll.width : 0px) - 6px;
        height: 14px;
        x: 3px;
        y: parent.height - self.height;
        horizontal: true;
        maximum: Math.max(0px, scroll-content.content-width - scroll-content.width);
        page-size: scroll-content.width;
        scrolled => { root.scrolled(); }
    }
}

component AccessibleQueueList inherits Rectangle {
    in property <[MusicTrackItem]> tracks;
    in property <int> current-index: -1;
    in property <bool> is-playing;
    in-out property <int> focused-index: root.current-index >= 0 ? root.current-index : 0;
    callback play(int);
    callback remove(int);
    callback move-item(int, int);

    background: transparent;
    accessible-role: list;
    accessible-label: "Music queue";
    accessible-item-count: root.tracks.length;
    accessible-delegate-focus: root.focused-index;
    forward-focus: queue-focus;

    queue-view := ListView {
        width: parent.width;
        height: parent.height;
        for track[index] in root.tracks: Rectangle {
            height: 66px;
            border-radius: 10px;
            background: index == root.current-index ? #38ff661b : index == root.focused-index && queue-focus.has-focus ? #ffffff18 : queue-item-touch.has-hover ? #ffffff0d : transparent;
            border-width: index == root.focused-index && queue-focus.has-focus ? 2px : 0px;
            border-color: #b8fff0;
            accessible-role: list-item;
            accessible-label: track.title + " by " + (track.artist == "" ? "Unknown artist" : track.artist);
            accessible-description: track.album + (index == root.current-index ? ", currently selected" : "");
            accessible-action-default => { root.play(index); }
            Rectangle {
                x: 0px;
                width: index == root.current-index ? 3px : 0px;
                height: parent.height;
                border-radius: 2px;
                background: #38ff66;
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                spacing: 10px;
                Text { text: index == root.current-index && root.is-playing ? "♪" : index + 1; color: index == root.current-index ? #38ff66 : #82958f; font-size: 11px; width: 24px; vertical-alignment: center; horizontal-alignment: center; }
                VerticalLayout {
                    alignment: center;
                    Text { text: track.title; color: white; font-size: 13px; font-weight: index == root.current-index ? 650 : 500; overflow: elide; }
                    Text { text: track.artist == "" ? "Unknown artist" : track.artist; color: #9db0aa; font-size: 10px; overflow: elide; }
                }
                Text { text: track.album; color: #71857f; font-size: 9px; width: 95px; overflow: elide; vertical-alignment: center; horizontal-alignment: right; }
            }
            queue-item-touch := TouchArea {
                clicked => {
                    root.focused-index = index;
                    queue-focus.focus();
                    root.play(index);
                }
            }
        }
    }
    queue-focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if (root.tracks.length == 0) { return reject; }
            if (event.modifiers.alt && event.text == Key.UpArrow) {
                root.move-item(root.focused-index, root.focused-index - 1);
                root.focused-index = Math.max(0, root.focused-index - 1);
                return accept;
            }
            if (event.modifiers.alt && event.text == Key.DownArrow) {
                root.move-item(root.focused-index, root.focused-index + 1);
                root.focused-index = Math.min(root.tracks.length - 1, root.focused-index + 1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.focused-index = Math.min(root.tracks.length - 1, root.focused-index + 1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.focused-index = Math.max(0, root.focused-index - 1);
                return accept;
            }
            if (event.text == Key.Home) {
                root.focused-index = 0;
                return accept;
            }
            if (event.text == Key.End) {
                root.focused-index = root.tracks.length - 1;
                return accept;
            }
            if (event.text == Key.Space || event.text == Key.Return) {
                root.play(root.focused-index);
                return accept;
            }
            if (event.text == Key.Delete) {
                root.remove(root.focused-index);
                root.focused-index = Math.min(root.focused-index, root.tracks.length - 1);
                return accept;
            }
            return reject;
        }
    }
}

component AccessibleLibraryShelf inherits Rectangle {
    in property <[LibraryItem]> tracks;
    in-out property <int> focused-index: 0;
    callback play(string);
    background: transparent;
    accessible-role: list;
    accessible-label: "Local music library";
    accessible-item-count: root.tracks.length;
    accessible-delegate-focus: root.focused-index;
    forward-focus: shelf-focus;

    shelf := Flickable {
        width: parent.width;
        height: parent.height;
        content-width: shelf-row.preferred-width;
        shelf-row := HorizontalLayout {
            height: shelf.height;
            spacing: 12px;
            for media[index] in root.tracks: Rectangle {
                width: 230px;
                height: 136px;
                border-radius: 14px;
                background: index == root.focused-index && shelf-focus.has-focus ? #ffffff1d : library-track-touch.has-hover ? #ffffff15 : #ffffff08;
                border-width: index == root.focused-index && shelf-focus.has-focus ? 2px : 0px;
                border-color: #b8fff0;
                accessible-role: list-item;
                accessible-label: media.title + " by " + (media.artist == "" ? "Unknown artist" : media.artist);
                accessible-description: media.album + ", " + media.duration;
                accessible-action-default => { root.play(media.path); }
                VerticalLayout {
                    padding: 14px;
                    spacing: 5px;
                    Rectangle { width: 34px; height: 34px; border-radius: 10px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 15px; } }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Text { text: media.title; color: white; font-size: 13px; font-weight: 650; overflow: elide; }
                    Text { text: media.artist == "" ? "Unknown artist" : media.artist; color: #9db0aa; font-size: 10px; overflow: elide; }
                }
                library-track-touch := TouchArea {
                    clicked => {
                        root.focused-index = index;
                        shelf-focus.focus();
                        root.play(media.path);
                    }
                }
                /* Home overlays are declared on AppWindow below.
                if root.home-edit-open: Rectangle {
                    x: parent.width - 390px; y: 18px; width: 372px; height: parent.height - 36px; border-radius: 22px; background: #10191bfc; border-width: 1px; border-color: #ffffff25;
                    VerticalLayout { padding: 18px; spacing: 12px;
                        HorizontalLayout { height: 38px; VerticalLayout { Text { text: "Edit Home"; color: white; font-size: 22px; font-weight: 750; } Text { text: "Your layout is saved automatically"; color: #839992; font-size: 8px; } } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 34px; height: 34px; border-radius: 17px; background: edit-close-touch.has-hover ? #ffffff20 : #ffffff0c; FluentGlyph { glyph: ""; font-size: 13px; } edit-close-touch := TouchArea { clicked => { root.home-edit-open = false; } } } }
                        Text { text: "SECTIONS"; color: #71857f; font-size: 9px; font-weight: 700; }
                        for section in ["flow", "live", "insights", "devices"]: Rectangle { height: 46px; border-radius: 12px; background: section-touch.has-hover ? #ffffff14 : #ffffff08; HorizontalLayout { padding: 12px; spacing: 10px; Text { text: section == "flow" ? "Zink Flow" : section == "live" ? "Live activities" : section == "insights" ? "Private insights" : "Device Centre"; color: white; font-size: 11px; font-weight: 650; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 38px; height: 22px; border-radius: 11px; background: (section == "flow" ? root.home-show-flow : section == "live" ? root.home-show-live-activities : section == "insights" ? root.home-show-insights : root.home-show-devices) ? #38ff66 : #ffffff18; Rectangle { width: 16px; height: 16px; x: (section == "flow" ? root.home-show-flow : section == "live" ? root.home-show-live-activities : section == "insights" ? root.home-show-insights : root.home-show-devices) ? 19px : 3px; y: 3px; border-radius: 8px; background: white; } } } section-touch := TouchArea { clicked => { root.toggle-home-section(section); } } }
                        Text { text: "PIN OR UNPIN"; color: #71857f; font-size: 9px; font-weight: 700; }
                        edit-pin-scroll := ZinkScrollView { vertical-stretch: 1; content-height: edit-pin-list.preferred-height; vertical-scrollbar-policy: ScrollBarPolicy.always-on; horizontal-scrollbar-policy: ScrollBarPolicy.always-off; edit-pin-list := VerticalLayout { width: edit-pin-scroll.visible-width - 12px; spacing: 7px; for option in [{id:"music-player", title:"Music Player", group:"Music"}, {id:"music-library", title:"Music Library", group:"Music"}, {id:"video-player", title:"Video Player", group:"Video"}, {id:"radio", title:"Internet Radio", group:"Music"}, {id:"zink-connect", title:"Zink Connect", group:"Zink"}, {id:"screen-recorder", title:"Screen Recorder", group:"Create"}, {id:"social", title:"Zink Social", group:"Social"}, {id:"gaming", title:"Gaming", group:"Play"}, {id:"settings", title:"Settings", group:"Zink"}]: Rectangle { height: 44px; border-radius: 11px; background: option-touch.has-hover ? #38ff6617 : #ffffff08; HorizontalLayout { padding: 11px; spacing: 9px; Text { text: option.title; color: white; font-size: 10px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "Toggle pin"; color: #38ff66; font-size: 8px; vertical-alignment: center; } } option-touch := TouchArea { clicked => { root.toggle-home-pin(option.id); } } } } }
                    }
                }
                if root.home-command-open: Rectangle {
                    width: parent.width; height: parent.height; background: #000000a5;
                    TouchArea { clicked => { root.home-command-open = false; } }
                    Rectangle { x: (parent.width - 620px) / 2; y: 94px; width: 620px; height: 360px; border-radius: 22px; background: #11191bfc; border-width: 1px; border-color: #ffffff2c;
                        VerticalLayout { padding: 20px; spacing: 12px;
                            HorizontalLayout { height: 28px; Text { text: "Zink Command"; color: white; font-size: 20px; font-weight: 750; } Rectangle { horizontal-stretch: 1; background: transparent; } Text { text: "ESC to close"; color: #71857f; font-size: 8px; vertical-alignment: center; } }
                            Rectangle { height: 50px; border-radius: 14px; background: #ffffff0d; border-width: 1px; border-color: #38ff6650; FluentGlyph { glyph: ""; x: 15px; width: 22px; font-size: 17px; } command-input := TextInput { x: 48px; width: parent.width - 66px; height: parent.height; text: root.home-command-query; color: white; font-size: 13px; single-line: true; edited => { root.home-command-query = self.text; } accepted => { root.execute-home-command(self.text); } } }
                            Text { text: "Try a command"; color: #9db0aa; font-size: 10px; }
                            GridLayout { vertical-stretch: 1; spacing: 8px; for command[index] in ["Play or pause music", "Open Music Library", "Record my screen", "Open Zink Connect", "Open Zink Social", "Play Internet Radio"]: Rectangle { row: Math.floor(index / 2); col: Math.mod(index, 2); border-radius: 11px; background: command-option-touch.has-hover ? #38ff6618 : #ffffff08; Text { text: command; color: white; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } command-option-touch := TouchArea { clicked => { root.execute-home-command(command); } } } }
                        }
                    }
                }
                */
            }
        }
    }
    shelf-focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if (root.tracks.length == 0) { return reject; }
            if (event.text == Key.RightArrow) { root.focused-index = Math.min(root.tracks.length - 1, root.focused-index + 1); return accept; }
            if (event.text == Key.LeftArrow) { root.focused-index = Math.max(0, root.focused-index - 1); return accept; }
            if (event.text == Key.Home) { root.focused-index = 0; return accept; }
            if (event.text == Key.End) { root.focused-index = root.tracks.length - 1; return accept; }
            if (event.text == Key.Space || event.text == Key.Return) { root.play(root.tracks[root.focused-index].path); return accept; }
            return reject;
        }
    }
}

component AccessibleTrackShelf inherits Rectangle {
    in property <[MusicTrackItem]> tracks;
    in property <int> current-index: -1;
    in property <bool> is-playing;
    in-out property <int> focused-index: root.current-index >= 0 ? root.current-index : 0;
    callback play(int);
    background: transparent;
    accessible-role: list;
    accessible-label: "Up next";
    accessible-item-count: root.tracks.length;
    accessible-delegate-focus: root.focused-index;
    forward-focus: track-shelf-focus;

    track-shelf := ZinkScrollView {
        width: parent.width;
        height: parent.height;
        content-width: track-row.preferred-width;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-on;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        track-row := HorizontalLayout {
            height: track-shelf.visible-height - 14px;
            spacing: 12px;
            for track[index] in root.tracks: Rectangle {
                width: 230px;
                height: 132px;
                border-radius: 14px;
                background: index == root.focused-index && track-shelf-focus.has-focus ? #ffffff1d : track-touch.has-hover ? #ffffff15 : #ffffff08;
                border-width: index == root.focused-index && track-shelf-focus.has-focus ? 2px : 0px;
                border-color: #b8fff0;
                accessible-role: list-item;
                accessible-label: track.title + " by " + (track.artist == "" ? "Unknown artist" : track.artist);
                accessible-description: track.album + (index == root.current-index ? ", currently selected" : "");
                accessible-action-default => { root.play(index); }
                VerticalLayout {
                    padding: 14px;
                    spacing: 5px;
                    FluentGlyph { glyph: index == root.current-index && root.is-playing ? "" : ""; color: index == root.current-index ? #38ff66 : #9db0aa; font-size: 24px; horizontal-alignment: left; }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Text { text: track.title; color: white; font-size: 13px; font-weight: 650; overflow: elide; }
                    Text { text: track.artist == "" ? "Unknown artist" : track.artist; color: #9db0aa; font-size: 10px; overflow: elide; }
                }
                track-touch := TouchArea {
                    clicked => {
                        root.focused-index = index;
                        track-shelf-focus.focus();
                        root.play(index);
                    }
                }
            }
        }
    }
    track-shelf-focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if (root.tracks.length == 0) { return reject; }
            if (event.text == Key.RightArrow) { root.focused-index = Math.min(root.tracks.length - 1, root.focused-index + 1); return accept; }
            if (event.text == Key.LeftArrow) { root.focused-index = Math.max(0, root.focused-index - 1); return accept; }
            if (event.text == Key.Home) { root.focused-index = 0; return accept; }
            if (event.text == Key.End) { root.focused-index = root.tracks.length - 1; return accept; }
            if (event.text == Key.Space || event.text == Key.Return) { root.play(root.focused-index); return accept; }
            return reject;
        }
    }
}

// This window is deliberately owned by Slint's existing event loop. Wry attaches
// its native WebView2 children to it from Rust, keeping Zink Connect inside the
// zink-app.exe process instead of starting a second application process.
export component ZinkConnectWindow inherits Window {
    title: "Zink Connect";
    width: 1440px;
    height: 900px;
    background: #001016;
}

export component SpotifyWidgetWindow inherits Window {
    title: "Zink • Spotify Widget";
    preferred-width: 760px;
    preferred-height: 330px;
    min-width: 620px;
    min-height: 280px;
    background: #07130f;
    in property <string> account-name: "Spotify";
    in property <string> account-detail: "Not connected";
    in property <bool> connected: false;
    in property <string> track-title: "Nothing playing";
    in property <string> track-artist: "Start Spotify on a connected device";
    in property <string> track-album: "";
    in property <string> device-name: "No active device";
    in property <bool> playing: false;
    callback open-spotify();
    callback refresh();
    callback previous();
    callback toggle-playback();
    callback next();
    callback hide-widget();
    Rectangle {
        background: @linear-gradient(135deg, #103e27 0%, #071711 62%, #050b0d 100%);
        border-width: 1px; border-color: #1ed76055;
        HorizontalLayout { padding: 24px; spacing: 24px;
            Rectangle { width: 250px; height: 250px; border-radius: 36px; background: @linear-gradient(145deg, #1ed76030 0%, #06140bd0 100%); border-width: 1px; border-color: #1ed76055;
                Text { text: root.playing ? "♫" : "◉"; color: #1ed760; font-size: 92px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                Rectangle { x: 18px; y: 206px; width: 72px; height: 26px; border-radius: 13px; background: #04110ad9; Text { text: root.playing ? "PLAYING" : "READY"; color: #1ed760; font-size: 8px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; } }
            }
            VerticalLayout { alignment: center; spacing: 7px;
                HorizontalLayout { height: 24px; Text { text: root.connected ? root.account-name + " • " + root.account-detail : "SPOTIFY NOT CONNECTED"; color: #1ed760; font-size: 9px; font-weight: 750; overflow: elide; } Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { width: 30px; height: 30px; border-radius: 15px; background: #ffffff0d; FluentGlyph { glyph: ""; color: white; font-size: 11px; } TouchArea { clicked => { root.hide-widget(); } } } }
                Text { text: root.track-title; color: white; font-size: 28px; font-weight: 780; overflow: elide; }
                Text { text: root.track-artist; color: #dce9e4; font-size: 15px; font-weight: 650; overflow: elide; }
                Text { text: root.track-album == "" ? "Spotify playback" : root.track-album; color: #82988f; font-size: 10px; overflow: elide; }
                Text { text: "Playing on " + root.device-name; color: #1ed760; font-size: 9px; overflow: elide; }
                Rectangle { height: 4px; border-radius: 2px; background: #ffffff20; Rectangle { width: root.playing ? parent.width * 0.62 : 0px; height: 4px; border-radius: 2px; background: #1ed760; } }
                HorizontalLayout { height: 58px; alignment: center; spacing: 10px;
                    AccessiblePlayerButton { width: 44px; height: 44px; glyph: ""; label: "Previous Spotify track"; glyph-size: 17px; normal-background: #ffffff0d; activated => { root.previous(); } }
                    AccessiblePlayerButton { width: 58px; height: 58px; glyph: root.playing ? "" : ""; label: root.playing ? "Pause Spotify" : "Play Spotify"; glyph-size: 22px; glyph-color: #06110a; normal-background: #1ed760; activated => { root.toggle-playback(); } }
                    AccessiblePlayerButton { width: 44px; height: 44px; glyph: ""; label: "Next Spotify track"; glyph-size: 17px; normal-background: #ffffff0d; activated => { root.next(); } }
                }
                HorizontalLayout { height: 40px; spacing: 9px;
                    Rectangle { width: 122px; border-radius: 20px; background: #1ed760; Text { text: "Open Spotify"; color: #06110a; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.open-spotify(); } } }
                    Rectangle { width: 104px; border-radius: 20px; background: #ffffff0d; Text { text: "Refresh state"; color: white; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.refresh(); } } }
                }
            }
        }
    }
}

export component RadioWidgetWindow inherits Window {
    title: "Zink • Radio Widget";
    preferred-width: 500px;
    preferred-height: 250px;
    min-width: 420px;
    min-height: 220px;
    background: #06171b;
    in property <string> station-name: "No station selected";
    in property <string> song-title: "";
    in property <string> artist-name: "";
    in property <int> volume-percent: 80;
    in property <bool> playing: false;
    callback toggle-playback();
    callback stop();
    callback previous();
    callback next();
    callback set-volume(float);
    Rectangle {
        background: @linear-gradient(135deg, #0b3d43 0%, #071820 58%, #040d13 100%);
        border-width: 1px; border-color: #38ff6650;
        HorizontalLayout { padding: 22px; spacing: 20px;
            Rectangle { width: 116px; height: 116px; border-radius: 30px; background: #38ff6618; FluentGlyph { glyph: ""; color: #38ff66; font-size: 48px; } }
            VerticalLayout { alignment: center; spacing: 10px;
                Text { text: root.station-name; color: white; font-size: 22px; font-weight: 750; overflow: elide; }
                Text { text: root.artist-name == "" ? (root.station-name == "No station selected" ? "Choose a station in Zink Radio" : "Live internet radio") : root.artist-name; color: #8da29b; font-size: 10px; overflow: elide; }
                Text { visible: root.song-title != ""; text: root.song-title; color: #dfffe8; font-size: 11px; font-weight: 650; overflow: elide; }
                HorizontalLayout { height: 52px; spacing: 9px;
                    AccessiblePlayerButton { width: 42px; height: 42px; glyph: ""; label: "Previous station"; glyph-size: 16px; normal-background: #ffffff0d; activated => { root.previous(); } }
                    AccessiblePlayerButton { width: 52px; height: 52px; glyph: root.playing ? "" : ""; label: root.playing ? "Pause" : "Play"; glyph-size: 20px; glyph-color: #051109; normal-background: #f2fff6; activated => { root.toggle-playback(); } }
                    AccessiblePlayerButton { width: 42px; height: 42px; glyph: ""; label: "Next station"; glyph-size: 16px; normal-background: #ffffff0d; activated => { root.next(); } }
                    AccessiblePlayerButton { width: 42px; height: 42px; glyph: ""; label: "Stop"; glyph-size: 15px; normal-background: #ffffff0d; activated => { root.stop(); } }
                }
                HorizontalLayout { height: 24px; spacing: 8px; FluentGlyph { glyph: root.volume-percent == 0 ? "" : ""; width: 18px; font-size: 13px; } radio-widget-volume := Rectangle { horizontal-stretch: 1; height: 16px; background: transparent; Rectangle { y: 5px; height: 6px; border-radius: 3px; background: #ffffff25; Rectangle { width: parent.width * root.volume-percent / 100; height: parent.height; border-radius: 3px; background: #38ff66; } } TouchArea { clicked => { root.set-volume(self.mouse-x / radio-widget-volume.width); } } } Text { text: root.volume-percent + "%"; color: #91a59f; font-size: 9px; width: 32px; vertical-alignment: center; } }
            }
        }
    }
}

export component FpsWidgetWindow inherits Window {
    title: "Zink • FPS Overlay";
    preferred-width: 330px;
    preferred-height: 150px;
    min-width: 250px;
    min-height: 110px;
    background: #07151bcc;
    in property <string> target-name: "No game selected";
    in property <string> current-fps: "--";
    in property <string> frame-time: "-- ms";
    in property <bool> text-only: false;
    in property <int> glass-opacity: 92;
    callback close-widget();
    Rectangle {
        background: #07151b;
        opacity: root.glass-opacity / 100;
        border-width: 1px; border-color: #51d6ff65; border-radius: 20px;
        HorizontalLayout { padding: 18px; spacing: 14px;
            Rectangle { visible: !root.text-only; width: self.visible ? 54px : 0px; height: 54px; border-radius: 16px; background: #51d6ff1c; FluentGlyph { glyph: ""; color: #51d6ff; font-size: 22px; } }
            VerticalLayout { alignment: center; spacing: 3px;
                Text { text: root.target-name; color: #a8bbc0; font-size: 9px; overflow: elide; }
                HorizontalLayout { height: 48px; spacing: 8px; Text { text: root.current-fps; color: white; font-size: 34px; font-weight: 800; vertical-alignment: center; } Text { text: root.text-only ? "FPS" : root.frame-time; color: #51d6ff; font-size: 11px; vertical-alignment: center; } }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Rectangle { width: 30px; height: 30px; border-radius: 15px; background: #ffffff0d; FluentGlyph { glyph: ""; font-size: 11px; } TouchArea { clicked => { root.close-widget(); } } }
        }
    }
}

export component SplashWindow inherits Window {
    title: "Zink";
    width: 960px;
    height: 540px;
    no-frame: true;
    background: #000814;

    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../../../../Assets/ZinkSplashPage.png");
        image-fit: cover;
    }
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(180deg, #00081415 0%, #00081470 100%);
    }
    VerticalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        alignment: end;
        padding-bottom: 54px;
        spacing: 12px;
        HorizontalLayout {
            height: 76px;
            alignment: center;
            Rectangle {
                width: 76px;
                height: 76px;
                border-radius: 38px;
                background: #00040ab8;
                border-width: 1px;
                border-color: #38ff668a;
                Rectangle {
                    width: 46px;
                    height: 46px;
                    x: 15px;
                    y: 15px;
                    border-radius: 23px;
                    border-width: 4px;
                    border-color: #38ff6645;
                }
                Rectangle {
                    width: 12px;
                    height: 12px;
                    x: 32px;
                    y: 9px;
                    border-radius: 6px;
                    background: #38ff66;
                }
            }
        }
        Text {
            text: "Starting Zink";
            color: #eaf7f2;
            font-size: 12px;
            font-weight: 650;
            horizontal-alignment: center;
        }
        Text {
            text: "Music, video, gaming and everything you use every day";
            color: #91a69f;
            font-size: 8px;
            horizontal-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    title: "Zink";
    preferred-width: 2200px;
    preferred-height: 1200px;
    min-width: 1280px;
    min-height: 760px;
    forward-focus: player-shortcuts;
    background: #0d1416;
    in property <[NavItem]> nav-items;
    in property <[LibraryItem]> library-items;
    in property <[string]> library-source-folders;
    in property <[SearchFacetItem]> search-albums;
    in property <[SearchFacetItem]> search-artists;
    in property <[SearchStationItem]> search-stations;
    in property <[SearchStationItem]> radio-stations;
    in-out property <string> radio-new-name: "";
    in-out property <string> radio-new-url: "";
    in-out property <string> radio-new-genre: "Music";
    in-out property <bool> radio-manager-open: false;
    in property <[MusicTrackItem]> music-queue;
    in property <[MusicTrackItem]> selected-music;
    in property <[MusicTrackItem]> recently-played;
    in property <[PlaylistItem]> music-playlists;
    in property <[AudioDeviceItem]> audio-output-devices;
    in property <[AudioTrackItem]> video-audio-tracks;
